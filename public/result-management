    examHtml = `<div style="text-align:left; max-height:290px; overflow-y:auto; background:#f8fafc; padding:10px; border-radius:12px; border:1.5px solid #cbd5e1; margin-top:10px;">`;
    combinedExams.forEach((ex, i) => {
      let linked = existingExamMap[ex.name];
      let isChecked = !!linked;
      let cqVal = linked ? (linked.fm.parts[0] || 0) : (ex.type === "Main" ? 100 : 50);
      let mcqVal = linked ? (linked.fm.parts[1] || "") : "";
      let pracVal = linked ? (linked.fm.parts[2] || "") : "";
      let totVal = (parseFloat(cqVal) || 0) + (parseFloat(mcqVal) || 0) + (parseFloat(pracVal) || 0);

      examHtml += `
        <div style="background:#fff; padding:10px 12px; border-radius:10px; border:1px solid #cbd5e1; margin-bottom:10px;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <label style="font-weight:800; color:#0f172a; font-size:13px; cursor:pointer; display:flex; align-items:center; gap:7px;">
              <input type="checkbox" id="chkEx-${i}" ${isChecked ? 'checked' : ''} style="width:17px; height:17px; accent-color:var(--main);">
              ${ex.name} <span style="font-size:11px; color:var(--main);">(${ex.type})</span>
            </label>
            <span style="font-size:11px; font-weight:800; color:var(--main); background:#ecfdf5; padding:2px 8px; border-radius:10px;">
              মোট পূর্ণমান: <b id="add-tot-${i}">${totVal}</b>
            </span>
          </div>
          <div class="part-grid-row" style="margin-top:8px;">
            <div class="part-box">
              <label>CQ / লিখিত পূর্ণমান</label>
              <input type="number" id="add-cq-${i}" value="${cqVal}" oninput="updateSubAddLiveFull(${i})">
            </div>
            <div class="part-box">
              <label>MCQ পূর্ণমান</label>
              <input type="number" id="add-mcq-${i}" value="${mcqVal}" placeholder="0" oninput="updateSubAddLiveFull(${i})">
            </div>
