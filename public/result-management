<style>
:root {
  --main: #005f40;
  --main-dark: #003d29;
  --main-light: #ecfdf5;
  --gold: #d97706;
  --bg: #f1f5f9;
  --text-dark: #0f172a;
  --text-muted: #64748b;
  --border: #cbd5e1;
}
* { box-sizing: border-box; }
body {
  font-family: 'Poppins', sans-serif;
  background-color: var(--bg);
  margin: 0;
  color: var(--text-dark);
  -webkit-font-smoothing: antialiased;
}
.main-padding { padding: 20px; max-width: 1440px; margin: 0 auto; }

@keyframes fadeInUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
@keyframes spin { 100% { transform: rotate(360deg); } }

/* Loader */
.loader-overlay {
  position: fixed;
  top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(8px);
  z-index: 9999;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.spinner {
  width: 54px; height: 54px;
  border: 5px solid #e2e8f0;
  border-top: 5px solid var(--main);
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
  margin-bottom: 14px;
}
.loader-text {
  font-weight: 800;
  color: var(--main);
  font-size: 15px;
  letter-spacing: 0.6px;
  text-align: center;
}

#appContainer { display: none; }

.app-header {
  background: #ffffff;
  padding: 22px 26px;
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(0, 95, 64, 0.07);
  margin-bottom: 22px;
  border-top: 6px solid var(--main);
  border-bottom: 1px solid #e2e8f0;
  animation: fadeInUp 0.3s ease-out forwards;
}
.header-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
  flex-wrap: wrap;
  gap: 12px;
  border-bottom: 2px solid #f1f5f9;
  padding-bottom: 14px;
}
.header-brand {
  display: flex;
  align-items: center;
  gap: 14px;
}
.header-brand img {
  height: 56px;
  width: 56px;
  border-radius: 50%;
  object-fit: cover;
  border: 2.5px solid var(--gold);
  padding: 2px;
  background: #fff;
}
.header-brand h2 {
  margin: 0;
  color: var(--main);
  font-size: 21px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}
.header-brand p {
  margin: 2px 0 0 0;
  font-size: 12px;
  color: var(--text-muted);
  font-weight: 600;
}

.control-group { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.weight-controls {
  display: flex;
  gap: 8px;
  align-items: center;
  background: #f8fafc;
  padding: 8px 14px;
  border-radius: 12px;
  border: 1.5px solid #cbd5e1;
}
.weight-controls input {
  border: 1.5px solid #94a3b8;
  border-radius: 8px;
  padding: 6px;
  font-weight: 800;
  color: var(--main);
  width: 52px;
  text-align: center;
  background: #fff;
}
input[type=number]::-webkit-inner-spin-button,
input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }

select, button {
  padding: 11px 16px;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 700;
  font-family: 'Poppins', sans-serif;
  cursor: pointer;
  border: 1.5px solid #cbd5e1;
  outline: none;
  transition: all 0.2s ease;
  background: #fff;
}
select:focus { border-color: var(--main); box-shadow: 0 0 0 3px rgba(0, 95, 64, 0.12); }
button {
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  color: white;
}
button:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(0,0,0,0.14); }
button:disabled { opacity: 0.6; cursor: not-allowed; }

.btn-open { background: linear-gradient(135deg, var(--main), var(--main-dark)); }
.btn-reset { background: linear-gradient(135deg, #ef4444, #b91c1c); }
.btn-tool { background: linear-gradient(135deg, #475569, #1e293b); }
.btn-add-sub { background: linear-gradient(135deg, #7c3aed, #5b21b6); }
.btn-edit-sub { background: linear-gradient(135deg, #0284c7, #0369a1); }
.btn-link-ex { background: linear-gradient(135deg, #0d9488, #0f766e); }
.btn-calc { background: linear-gradient(135deg, #2563eb, #1d4ed8); font-weight: 800; }
.btn-print { background: linear-gradient(135deg, #0f172a, #1e293b); }
.btn-report { background: linear-gradient(135deg, #d97706, #b45309); }
.btn-publish { background: linear-gradient(135deg, #059669, #047857); font-weight: 800; }
.btn-back { background: #f1f5f9; color: var(--text-dark); border: 1.5px solid #cbd5e1; }
.btn-back:hover { background: var(--main); color: #fff; border-color: var(--main); }

.mgr-list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  background: #ffffff;
  border: 1.5px solid #cbd5e1;
  border-radius: 12px;
  padding: 10px 14px;
  margin-bottom: 8px;
  text-align: left;
}
.mgr-badge {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 10.5px;
  font-weight: 800;
}
.mgr-actions {
  display: flex;
  gap: 6px;
  flex-shrink: 0;
}
.mgr-actions button {
  padding: 6px 11px;
  font-size: 11.5px;
  border-radius: 8px;
}

#feature-panel {
  display: none;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
  border-top: 1.5px dashed #cbd5e1;
  padding-top: 16px;
  margin-top: 14px;
}

.quick-search-bar {
  display: none;
  margin-top: 14px;
  background: #f8fafc;
  padding: 10px 14px;
  border-radius: 12px;
  border: 1px solid #e2e8f0;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}
.quick-search-bar input {
  flex: 1;
  min-width: 240px;
  padding: 10px 14px;
  border-radius: 10px;
  border: 1.5px solid #cbd5e1;
  font-family: inherit;
  font-size: 13.5px;
  outline: none;
}
.quick-search-bar input:focus { border-color: var(--main); }

#student-list-container {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
  gap: 18px;
  margin-top: 18px;
  animation: fadeInUp 0.35s ease;
}
.student-card {
  background: white;
  border-radius: 16px;
  box-shadow: 0 4px 15px rgba(15, 23, 42, 0.04);
  border: 1.5px solid #e2e8f0;
  overflow: hidden;
  transition: 0.25s;
  display: flex;
  flex-direction: column;
}
.student-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 24px rgba(0, 95, 64, 0.1);
  border-color: #a7f3d0;
}
.card-header {
  background: #f8fafc;
  padding: 14px 18px;
  border-bottom: 1px solid #e2e8f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}
.card-header h4 {
  margin: 0;
  color: var(--main);
  font-size: 15.5px;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.roll-badge {
  background: var(--main);
  color: white;
  font-size: 11px;
  font-weight: 800;
  padding: 4px 10px;
  border-radius: 20px;
  flex-shrink: 0;
}
.card-body { padding: 16px 18px; flex-grow: 1; }
.card-body p { margin: 0 0 10px 0; font-size: 12.5px; color: #475569; font-weight: 600; }
.result-mini {
  display: flex;
  justify-content: space-between;
  background: #ecfdf5;
  border: 1px solid #a7f3d0;
  padding: 9px 12px;
  border-radius: 10px;
  font-size: 12.5px;
  font-weight: 800;
  color: #065f46;
}
.result-mini.failed { background: #fef2f2; border-color: #fecaca; color: #991b1b; }
.result-mini.incomp { background: #fffbeb; border-color: #fde68a; color: #b45309; }
.card-footer {
  padding: 12px 18px;
  background: #f8fafc;
  border-top: 1px solid #e2e8f0;
  display: flex;
  gap: 10px;
}
.btn-edit-marks { background: linear-gradient(135deg, #0284c7, #0369a1); color: white; flex: 1; border-radius: 10px; padding: 10px; font-size: 13px; }
.btn-view-result { background: linear-gradient(135deg, var(--main), var(--main-dark)); color: white; flex: 1; border-radius: 10px; padding: 10px; font-size: 13px; }

.part-grid-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(95px, 1fr));
  gap: 8px;
  margin-top: 6px;
}
.part-box {
  background: #ffffff;
  border: 1.5px solid #cbd5e1;
  border-radius: 9px;
  padding: 6px 8px;
  text-align: center;
}
.part-box label {
  display: block;
  font-size: 10.5px;
  font-weight: 800;
  color: #334155;
  margin-bottom: 3px;
  text-transform: uppercase;
}
.part-box input {
  width: 100%;
  border: 1.5px solid #94a3b8;
  border-radius: 6px;
  padding: 6px;
  text-align: center;
  font-weight: 800;
  font-size: 13.5px;
  color: var(--main);
  outline: none;
}
.part-box input:focus { border-color: var(--main); background: #f0fdf4; }

@media (max-width: 768px) {
  .main-padding { padding: 10px; }
  .control-group, #feature-panel { justify-content: center; }
  button { flex: 1 1 45%; font-size: 12px; padding: 9px 10px; }
  #student-list-container { grid-template-columns: 1fr; }
}

/* ============================================================================
   🖨️ ENTERPRISE PRINT PREVIEW & A4 LANDSCAPE / PORTRAIT ENGINE
============================================================================ */
#print-area { display: none; background: #475569; min-height: 100vh; padding: 20px 0; }
.print-toolbar {
  position: sticky;
  top: 0;
  background: #0f172a;
  padding: 12px 24px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  box-shadow: 0 4px 20px rgba(0,0,0,0.25);
  z-index: 1000;
  margin-bottom: 20px;
}
.print-toolbar button { font-size: 13.5px; padding: 10px 20px; border-radius: 10px; }
#print-content {
  width: 285mm;
  margin: 0 auto;
  background: transparent;
  box-sizing: border-box;
}
#print-content.portrait-preview {
  width: 198mm;
}

/* Marksheet Screen Preview Card */
.report-card {
  width: 285mm;
  height: 192mm;
  min-height: 192mm;
  max-height: 192mm;
  margin: 0 auto 15mm auto;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border: 3px double #005f40;
  padding: 5mm 6.5mm;
  border-radius: 6px;
  background: #ffffff;
  position: relative;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0,0,0,0.25);
}
.rc-watermark {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%) rotate(-24deg);
  font-size: 74px;
  font-weight: 900;
  color: rgba(0, 95, 64, 0.038);
  pointer-events: none;
  white-space: nowrap;
  z-index: 0;
  letter-spacing: 6px;
}
.rc-top-section, .rc-middle-section, .rc-bottom-section { position: relative; z-index: 1; }
.rc-middle-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 12px; /* Standard gap for clean layout */
  margin: 5px 0;
  min-height: 0;
}

.school-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2.5px solid #005f40;
  padding-bottom: 5px;
  margin-bottom: 5px;
  gap: 10px;
}
.school-logo { width: 52px; height: 52px; border-radius: 50%; object-fit: contain; border: 1.5px solid #005f40; padding: 2px; background: #fff; }
.header-center { text-align: center; flex: 1; }
.header-center h1 {
  margin: 0;
  font-size: 19px;
  text-transform: uppercase;
  color: #005f40;
  font-weight: 900;
  letter-spacing: 0.6px;
  font-family: 'Times New Roman', Times, serif;
}
.school-address { font-size: 9.8px; font-weight: 700; color: #334155; margin: 2px 0 0 0; }
.transcript-badge-wrap { text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: 3px; }
.transcript-title {
  background: #005f40 !important;
  color: white !important;
  padding: 4px 12px;
  border-radius: 15px;
  font-size: 9.8px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}
.grade-scale-mini {
  font-size: 8px;
  color: #1e293b;
  font-weight: 700;
  background: #f1f5f9 !important;
  border: 1px solid #cbd5e1;
  padding: 2px 6px;
  border-radius: 4px;
  white-space: nowrap;
}

.student-info {
  width: 100%;
  margin-bottom: 4px;
  font-size: 10.5px;
  font-weight: 700;
  border: 1px solid #94a3b8;
  border-radius: 5px;
  background: #f8fafc !important;
  border-collapse: collapse;
}
.student-info td { padding: 4px 9px; border-right: 1px dashed #cbd5e1; }
.student-info td:last-child { border-right: none; }

.legend-box {
  font-size: 8.8px;
  color: #005f40;
  background: #ecfdf5 !important;
  border: 1px dashed #005f40;
  padding: 3px 9px;
  border-radius: 4px;
  margin-bottom: 2px;
  display: flex;
  justify-content: space-between;
  font-weight: 700;
}

.marks-wrapper {
  flex: 1;
  display: flex;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  align-items: flex-start;
  min-height: 0;
  margin-bottom: 12px; /* Force margin at bottom of marks wrapper */
}
.marks-table {
  width: 100%;
  height: 100%;
  border-collapse: collapse;
  font-size: 9.5px;
  background: rgba(255, 255, 255, 0.92);
  table-layout: auto;
}
.marks-table th, .marks-table td {
  border: 1px solid #1e293b;
  padding: 3.5px 3px;
  text-align: center;
  vertical-align: middle;
  line-height: 1.18;
  white-space: nowrap;
}
.marks-table th {
  background-color: #e2e8f0 !important;
  font-weight: 800;
  color: #0f172a;
  font-size: 8.4px;
  text-transform: uppercase;
  height: auto;
}
.marks-table td.sub-name {
  text-align: left;
  padding-left: 5px;
  padding-right: 4px;
  font-weight: 800;
  color: #0f172a;
  white-space: nowrap;
}
.divider-col { border-right: 1.8px solid #000 !important; }

/* Tier 1: Few Subjects (1-6 Subjects) Spacious Full-Width Layout */
.report-card.spacious-card .marks-table th,
.report-card.spacious-card .marks-table td {
  padding: 5.5px 7px;
  font-size: 10.8px;
}

/* Tier 2: Standard Subjects (7-12 Subjects, up to 6 rows per column) */
.report-card.standard-card .marks-table th,
.report-card.standard-card .marks-table td {
  padding: 4px 3px;
  font-size: 9.3px;
}

/* Tier 3: Dense Subjects (13+ Subjects) */
.report-card.dense-card .marks-table th,
.report-card.dense-card .marks-table td {
  padding: 2.5px 2px;
  font-size: 8.4px;
}

/* Class Overview & QR Verification Panel inside Marksheet */
.rc-overview-qr-strip {
  display: grid;
  grid-template-columns: 1.35fr 1.65fr 1.05fr;
  gap: 8px;
  align-items: stretch;
  margin-top: 16px; /* Added proper gap */
  margin-bottom: 8px;
}
.rc-ov-card {
  border: 1px solid #94a3b8;
  border-radius: 6px;
  background: #f8fafc !important;
  padding: 5px 9px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.rc-ov-title {
  font-size: 8.6px;
  font-weight: 900;
  color: #005f40;
  text-transform: uppercase;
  border-bottom: 1px solid #cbd5e1;
  padding-bottom: 2.5px;
  margin-bottom: 4px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.rc-ov-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 3.5px 6px;
  font-size: 8.8px;
  font-weight: 700;
  color: #1e293b;
}
.rc-grade-pills {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 3.5px;
  text-align: center;
  font-size: 8.2px;
  font-weight: 800;
}
.rc-grade-pill {
  background: #ffffff !important;
  border: 1px solid #cbd5e1;
  border-radius: 4px;
  padding: 2px 2px;
}
.rc-qr-card {
  border: 1.5px solid #005f40;
  border-radius: 6px;
  background: #ecfdf5 !important;
  padding: 4px 8px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.rc-qr-box {
  width: 52px;
  height: 52px;
  background: #fff !important;
  border: 1px solid #005f40;
  border-radius: 4px;
  padding: 2px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.rc-qr-box svg { width: 100% !important; height: 100% !important; display: block; }
.rc-qr-meta { font-size: 8px; line-height: 1.3; color: #0f172a; font-weight: 700; }
.rc-qr-badge {
  display: inline-block;
  background: #005f40 !important;
  color: #fff !important;
  font-size: 7.5px;
  font-weight: 800;
  padding: 1.5px 6px;
  border-radius: 3px;
  margin-bottom: 2px;
  text-transform: uppercase;
}

.summary-box {
  border: 1.5px solid #005f40;
  padding: 6px 14px;
  width: 100%;
  margin-top: 10px; /* Added gap */
  margin-bottom: 10px;
  border-radius: 6px;
  background: #f0fdf4 !important;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}
.summary-metrics {
  display: flex;
  gap: 16px;
  font-size: 11.5px;
  font-weight: 800;
  color: #005f40;
  align-items: center;
}
.remark-text {
  font-size: 10px;
  font-weight: 800;
  color: #b91c1c;
  margin: 0;
  text-transform: uppercase;
}

/* Fixed Signature Row at Bottom of Every Marksheet */
.footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 15px 16px 0 16px; /* Increased top padding */
  margin-top: auto;
}
.signature {
  border-top: 1.5px solid #000;
  width: 175px;
  text-align: center;
  padding-top: 3.5px;
  font-weight: 800;
  font-size: 10px;
  color: #000;
  text-transform: uppercase;
}

/* Tabulation Sheet Page Frame (Both Landscape & Portrait Locked) */
.tab-page {
  width: 285mm;
  height: 192mm;
  min-height: 192mm;
  max-height: 192mm;
  margin: 0 auto 15mm auto;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border: 2.5px solid #005f40;
  padding: 4.5mm 5.5mm;
  border-radius: 6px;
  background: #ffffff;
  position: relative;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0,0,0,0.25);
}
#print-content.portrait-preview .tab-page,
.tab-page.portrait-page {
  width: 198mm;
  height: 283mm;
  min-height: 283mm;
  max-height: 283mm;
  padding: 5mm 4mm;
}
.tab-top-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}
.tab-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 8.2px;
  text-align: center;
  table-layout: fixed;
}
.tab-table th {
  background: #e2e8f0 !important;
  padding: 3.5px 1.5px;
  border: 1px solid #000;
  font-weight: 800;
  color: #000;
  font-size: 7.8px;
  word-wrap: break-word;
  line-height: 1.15;
}
.tab-table td {
  padding: 2.8px 1.5px;
  border: 1px solid #000;
  vertical-align: middle;
  font-size: 7.8px;
  font-weight: 600;
  line-height: 1.18;
  color: #000;
