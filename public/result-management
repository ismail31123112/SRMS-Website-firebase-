                            var tObt = parseFloat(tValRaw);
                            var mMStr = String(mValRaw || "").trim();

                            var hasTest = !isNaN(tObt); var hasMain = mMStr !== "";
                            
                            if(hasTest || hasMain || optNameVal) {
                                var safeOptName = (optNameVal !== null && optNameVal !== undefined) ? String(optNameVal) : "";
                                var finalSubName = safeOptName.trim() !== "" ? safeOptName : "Optional Subject";

                                var totalMain = 0;
                                if(hasMain) {
                                    if(mMStr.includes("+")) { totalMain = mMStr.split('+').reduce((sum, val) => sum + (parseFloat(val) || 0), 0); } 
                                    else { totalMain = parseFloat(mMStr) || 0; }
                                }

                                var tVal = hasTest ? tObt : 0; 
                                var finalMark = 0;
                                var tFullMatch = (headers[colIndex + 1]||"").match(/\((\d+)\)/); var tFull = tFullMatch ? parseInt(tFullMatch[1]) : 50;
                                var mFullMatch = (headers[colIndex + 2]||"").match(/\((\d+)\)/); var mFull = mFullMatch ? mFullMatch[0].replace(/[()]/g, '').split('+').reduce((a,b)=>a+(parseInt(b)||0), 0) : 100;
                                
                                if (hasTest && hasMain) finalMark = Math.round(((tVal / tFull) * testWeight) + ((totalMain / mFull) * mainWeight));
                                else if (!hasTest && hasMain) finalMark = Math.round((totalMain / mFull) * 100);
                                else if (hasTest && !hasMain) finalMark = Math.round((tVal / tFull) * 100);

                                var subGP = getGP_JS(finalMark); var subGrade = getGrade_JS(subGP);
                                
                                if(subGP > 2.00) filterOptExtraGP += (subGP - 2.00);
                                filterTotalMarks += finalMark; filterTotalSubCount++;

                                rowsHtmlArray.push(`<tr><td class="sub-name">${finalSubName} (Opt)</td>
                                <td class="exam-name">${hasTest ? tVal : '-'}</td>
                                <td class="exam-name">${hasMain ? mMStr : '-'}</td>
                                <td>${finalMark}</td>
                                <td><strong>${subGrade}</strong></td><td><strong>${subGP.toFixed(2)}</strong></td></tr>`);
                            }
                        }
                        colIndex += 3; 
                    } else {
                        var mInfo = extractSubAndExam(getSafeHeader(headers[colIndex + 1]), 'main');
                        
                        if (examFilter === "All" || mInfo.exam === examFilter) {
                            var tInfo = extractSubAndExam(getSafeHeader(headers[colIndex]), 'test');
                            var cleanSub = tInfo.sub;
                            
                            var tValRaw = row[colIndex];
                            var mValRaw = row[colIndex+1];
                            var tObt = parseFloat(tValRaw);
                            var mMStr = String(mValRaw || "").trim();

                            var hasTest = !isNaN(tObt); var hasMain = mMStr !== "";

                            if(hasTest || hasMain) {
                                var isSubFail = false;
                                var totalMain = 0;
                                var mFullMatch = (headers[colIndex+1]||"").match(/\((\d+)\+?(\d+)?\+?(\d+)?\)/); 
                                
                                if(hasMain && mMStr.includes("+")) { 
                                    let obtParts = mMStr.split('+').map(p => parseFloat(p) || 0);
                                    if(mFullMatch) {
                                        let fullParts = mFullMatch[0].replace(/[()]/g, '').split('+').map(p => parseInt(p) || 0);
                                        if(fullParts.length > 0 && obtParts[0] < Math.ceil(fullParts[0] * passRatio)) { isSubFail = true; }
                                        else if(fullParts.length > 1 && obtParts[1] < Math.ceil(fullParts[1] * passRatio)) { isSubFail = true; }
                                        else if(fullParts.length > 2 && fullParts[2] > 0 && obtParts[2] < Math.ceil(fullParts[2] * passRatio)) { isSubFail = true; }
                                    }
                                    totalMain = obtParts.reduce((a,b)=>a+b, 0); 
                                } 
                                else if (hasMain) { totalMain = parseFloat(mMStr) || 0; }

                                var tVal = hasTest ? tObt : 0; 
                                var finalMark = 0;
                                var tFullMatch = (headers[colIndex]||"").match(/\((\d+)\)/); var tFull = tFullMatch ? parseInt(tFullMatch[1]) : 50;
                                var mFullTotal = mFullMatch ? mFullMatch[0].replace(/[()]/g, '').split('+').reduce((a,b)=>a+(parseInt(b)||0), 0) : 100;
                                
                                if (hasTest && hasMain) finalMark = Math.round(((tVal / tFull) * testWeight) + ((totalMain / mFullTotal) * mainWeight));
                                else if (!hasTest && hasMain) finalMark = Math.round((totalMain / mFullTotal) * 100);
                                else if (hasTest && !hasMain) finalMark = Math.round((tVal / tFull) * 100);

                                if(!isSubFail && finalMark < Math.ceil(100 * passRatio)) isSubFail = true;

                                var subGP = getGP_JS(finalMark); var subGrade = getGrade_JS(subGP);
                                if(isSubFail || subGP === 0.00) filterIsFail = true;
                                
                                filterTotalRegularGP += subGP; filterTotalMarks += finalMark;
                                filterRegularSubCount++; filterTotalSubCount++; 

                                rowsHtmlArray.push(`<tr><td class="sub-name">${cleanSub}</td>
                                <td class="exam-name">${hasTest ? tVal : '-'}</td>
                                <td class="exam-name">${hasMain ? mMStr : '-'}</td>
                                <td>${finalMark}</td>
                                <td><strong>${subGrade}</strong></td><td><strong>${subGP.toFixed(2)}</strong></td></tr>`);
                            }
                        }
                        colIndex += 2; 
                    }
                }
            }

            // Recalculate Summary for Filtered View
            let dispGPA = gpa; let dispGrade = grade; let dispAvg = totalAvg; let dispPos = pos;
            if(examFilter !== "All") {
                if(filterRegularSubCount > 0) {
                    if (filterIsFail) { dispGPA = "0.00"; dispGrade = "F"; } 
                    else {
                        let combinedGP = filterTotalRegularGP + filterOptExtraGP;
                        let rawGPA = combinedGP / filterRegularSubCount; 
                        if (rawGPA > 5.00) rawGPA = 5.00; 
                        dispGPA = rawGPA.toFixed(2);
                        dispGrade = getGrade_JS(parseFloat(dispGPA));
                    }
                } else { dispGPA = "0.00"; dispGrade = "N/A"; }
                dispAvg = filterTotalSubCount > 0 ? (filterTotalMarks / filterTotalSubCount).toFixed(2) : "0.00";
                dispPos = "N/A"; // Rank is only valid for combined
            }

            var finalTableHtml = "";
            if(rowsHtmlArray.length === 0) {
                finalTableHtml = `<table class="marks-table"><thead>${theadHtml}</thead><tbody><tr><td colspan="6" style="padding:15px; color:#dc2626;">No Subject Data Found for ${examFilter}!</td></tr></tbody></table>`;
            } else if(rowsHtmlArray.length > 12) {
                var half = Math.ceil(rowsHtmlArray.length / 2);
                var col1 = rowsHtmlArray.slice(0, half).join("");
                var col2 = rowsHtmlArray.slice(half).join("");
                finalTableHtml = `<div class="marks-wrapper"><table class="marks-table" style="width: 49%;"><thead>${theadHtml}</thead><tbody>${col1}</tbody></table><table class="marks-table" style="width: 49%;"><thead>${theadHtml}</thead><tbody>${col2}</tbody></table></div>`;
            } else {
                finalTableHtml = `<div class="marks-wrapper"><table class="marks-table"><thead>${theadHtml}</thead><tbody>${rowsHtmlArray.join("")}</tbody></table></div>`;
            }

            printHtml += `
            <div class="report-card">
            <div class="school-header">
            <img src="${SCHOOL_LOGO}" class="school-logo" alt="School Logo">
            <div class="header-center">
            <h1>SAIDPUR RESIDENTIAL MODEL SCHOOL</h1>
            <p class="school-address">Sultan Nagar, Saidpur, Nilphamari | School Code: 481931 | EMIS Code: 00704061312</p>
            <p class="school-address">Email: info@srms2012.edu.bd | Web: www.srms2012.edu.bd</p>
            </div>
            <div class="transcript-title">Academic Transcript - ${examFilter === "All" ? term : examFilter} (${year})</div>
            </div>

            <table class="student-info">
            <tr><td width="33%"><strong>Student Name:</strong> ${name}</td><td width="33%"><strong>Class:</strong> ${baseClassName}</td><td width="33%"><strong>Group:</strong> ${groupName}</td></tr>
            <tr><td><strong>Student ID:</strong> ${id}</td><td><strong>Roll Number:</strong> ${roll}</td><td></td></tr>
            </table>
            
            ${legendHtml}
            ${finalTableHtml}

            <div class="summary-box">
            <div style="display: flex; justify-content: space-around; margin-bottom: 5px; font-size: 15px; font-weight: 800; color: #005f40; flex-wrap: wrap;">
            <span>Total Avg: ${dispAvg}</span>
            <span>GPA: ${dispGPA}</span>
            <span>Grade: ${dispGrade}</span>
            <span>Position: ${dispPos}</span>
            </div>
            <p class="remark-text">Remark: ${teacherRemark}</p>
            </div>

            <div class="footer"><div class="signature">Class Teacher</div><div class="signature">Headmaster</div><div class="signature">Guardian</div></div>
            </div>`;
        });
        
        if (printCount === 0) {
            swalPro.fire('Warning', 'No completed results to print. Please ensure Term/Main marks are entered before generating Marksheets. Tabulation can still be printed.', 'warning');
            return;
        }

        document.getElementById("print-area").innerHTML = printHtml;
        window.print();
    } catch (err) {
        swalPro.fire('Error Generating Marksheet', 'Format Error: ' + err.message, 'error');
    }
}

