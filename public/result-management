// ==========================================
// PARSING & HELPERS
// ==========================================
function isOptHeader(h) { return h ? String(h).toLowerCase().includes("opt") && String(h).toLowerCase().includes("name") : false; }
function getSafeHeader(h) { return h ? String(h) : ""; }

function extractSubAndExam(headerText) {
    if(!headerText) return { sub: "Unknown", exam: "Exam", type: "Test" };
    var clean = String(headerText).replace(/\[.*\]/g, '').trim();
    var parts = clean.split(" - ");
    if(parts.length >= 3) {
        return { sub: parts[0].trim(), exam: parts[1].trim(), type: parts[2].includes("Main") ? "Main" : "Test" };
    }
    return { sub: clean, exam: "Exam", type: "Test" };
}

function parseSubjectHeaders(headers) {
    let firstEmpty = headers.indexOf("");
    if(firstEmpty === -1) firstEmpty = headers.length;
    let subjects = {};
    let testSeq = [];
    let mainSeq = [];
    
    let c = 3;
    while(c < firstEmpty && c < headers.length) {
        if (isOptHeader(headers[c])) {
            let optSubName = headers[c].replace(" Opt Name", "").trim();
            if(!subjects[optSubName]) subjects[optSubName] = { isOpt: true, nameCol: c, tests: [], mains: [] };
            
            let j = c + 1;
            while(j < firstEmpty && headers[j].startsWith(optSubName + " - ")) {
                let info = extractSubAndExam(headers[j]);
                if(info.type === "Test") { subjects[optSubName].tests.push({ col: j, name: info.exam }); if(!testSeq.includes(info.exam)) testSeq.push(info.exam); }
                else { subjects[optSubName].mains.push({ col: j, name: info.exam }); if(!mainSeq.includes(info.exam)) mainSeq.push(info.exam); }
                j++;
            }
            c = j;
        } else {
            let subName = headers[c].split(" - ")[0].trim();
            if(!subjects[subName]) subjects[subName] = { isOpt: false, tests: [], mains: [] };
            
            let j = c;
            while(j < firstEmpty && headers[j].startsWith(subName + " - ")) {
                let info = extractSubAndExam(headers[j]);
                if(info.type === "Test") { subjects[subName].tests.push({ col: j, name: info.exam }); if(!testSeq.includes(info.exam)) testSeq.push(info.exam); }
                else { subjects[subName].mains.push({ col: j, name: info.exam }); if(!mainSeq.includes(info.exam)) mainSeq.push(info.exam); }
                j++;
            }
            c = j;
        }
    }
    return { subjects, testSeq, mainSeq, firstEmpty };
}

// 🚀 LIGHTNING FAST FRONTEND LOAD 
async function loadData() {
    var className = document.getElementById("classSelector").value;
    if(!className) { swalPro.fire({title: 'Hold On!', text: 'Please select a class first.', icon: 'warning'}); return; }

    showLoader(true, "FETCHING DATA...<br><span style='font-size:11px; color:#64748b;'>Directly reading from Firebase...</span>");
    document.getElementById("feature-panel").style.display = "none";
    document.getElementById("student-list-container").innerHTML = "";

    try {
        let docName = className.replace(/\s+/g, '_'); 
        let headerDoc = await db.collection('ClassHeaders').doc(docName).get();
        cachedHeaders = headerDoc.exists ? JSON.parse(headerDoc.data().headers) : ["ID", "Name", "Roll", "", "Total Avg", "GPA", "Grade", "Position", "Fail_Reason", "Year", "Pass_Marks_Rules"];

        let rawCls = className.trim(); let searchGroup = "";
        if(rawCls.toLowerCase().includes("science")) { searchGroup = "Science"; rawCls = rawCls.replace(/Science/i, "").trim(); }
        else if(rawCls.toLowerCase().includes("arts")) { searchGroup = "Arts"; rawCls = rawCls.replace(/Arts/i, "").trim(); }
        else if(rawCls.toLowerCase().includes("commerce")) { searchGroup = "Commerce"; rawCls = rawCls.replace(/Commerce/i, "").trim(); }
        let searchClass = rawCls.replace(/Class/i, "").trim(); 

        let snap = await db.collection('Students').where('class', '==', searchClass).get();
        appData = [];
        snap.forEach(doc => {
            let f = doc.data();
            let dbGroup = f.group ? String(f.group).trim() : "";
            if(searchGroup === "" || dbGroup.toLowerCase() === searchGroup.toLowerCase()) {
                let row = new Array(cachedHeaders.length).fill("");
                row[0] = f.studentID || ""; row[1] = f.name || ""; row[2] = f.roll || "";
                row[row.length - 2] = f.phone || ""; row[row.length - 1] = doc.id; 
                if (f.resultMarks) {
                    let marks = JSON.parse(f.resultMarks);
                    for(let i=3; i<cachedHeaders.length; i++) { if(marks[i] !== undefined) row[i] = marks[i]; }
                }
                appData.push(row);
            }
        });
        
        appData.sort((a,b) => (parseInt(a[2])||9999) - (parseInt(b[2])||9999));
        showLoader(false);
        renderStudentCards();
        document.getElementById("feature-panel").style.display = "flex";
    } catch (err) { showLoader(false); swalPro.fire('Error', err.message, 'error'); }
}

function renderStudentCards() {
    var container = document.getElementById("student-list-container");
    container.innerHTML = "";
    var firstEmpty = cachedHeaders.indexOf("");
    if(appData.length === 0) {
        container.innerHTML = '<div style="grid-column: 1 / -1; text-align:center; padding: 40px; color:#94a3b8;"><i class="fa-solid fa-users-slash fa-3x mb-3"></i><br><h3>No Students Found</h3></div>';
        return;
    }

    appData.forEach((row, index) => {
        if(!row[0] && !row[1]) return; 
        var id = row[0] || 'N/A';
        var name = row[1] || 'Unknown Student';
        var roll = row[2] || 'N/A';
        
        var gpa = firstEmpty !== -1 ? (row[firstEmpty+2] || '0.00') : 'N/A';
        var grade = firstEmpty !== -1 ? (row[firstEmpty+3] || '-') : 'N/A';
        
        var isFailed = (grade === 'F' || gpa === '0.00');
        var isIncomp = (grade === 'Incomplete');
        var resClass = 'result-mini';
        if(isFailed) resClass += ' failed';
        if(isIncomp) resClass += ' incomp';

        var card = document.createElement("div");
        card.className = "student-card";
        card.innerHTML = `
        <div class="card-header"><h4><i class="fa-solid fa-user-graduate" style="color:var(--main);"></i> ${name}</h4><span class="roll-badge">Roll: ${roll}</span></div>
        <div class="card-body">
        <p><i class="fa-solid fa-id-badge" style="color:#94a3b8; width:20px;"></i> <b>ID:</b> ${id}</p>
        <div class="${resClass}"><span>GPA: ${gpa}</span><span>Grade: ${grade}</span></div>
        </div>
        <div class="card-footer">
        <button class="btn-edit-marks" onclick="openDataEntryForm(${index})"><i class="fa-solid fa-pen-to-square"></i> Input Marks</button>
        <button class="btn-view-result" onclick="viewSingleResult(${index})"><i class="fa-solid fa-eye"></i> View Result</button>
        </div>
        `;
        container.appendChild(card);
    });
}

function getGP_JS(p) { if(p>=80) return 5.00; if(p>=70) return 4.00; if(p>=60) return 3.50; if(p>=50) return 3.00; if(p>=40) return 2.00; if(p>=33) return 1.00; return 0.00; }
function getGrade_JS(g) { if(g>=5.00) return "A+"; if(g>=4.00) return "A"; if(g>=3.50) return "A-"; if(g>=3.00) return "B"; if(g>=2.00) return "C"; if(g>=1.00) return "D"; return "F"; }

