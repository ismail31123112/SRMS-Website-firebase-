}

// Ensure auth persistence
try {
  auth.setPersistence(firebase.auth.Auth.Persistence.LOCAL).catch(() => {});
} catch (e) {}

// Non-blocking Auth State check for instant loading
auth.onAuthStateChanged(async (user) => {
  let hasTokenInUrl = SERVER_TOKEN && SERVER_TOKEN.trim() !== "" && SERVER_TOKEN.indexOf("serverToken") === -1;

  if (user || hasTokenInUrl) {
