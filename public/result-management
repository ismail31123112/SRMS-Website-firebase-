// 🚀 VIEW SINGLE PROFILE
function viewSingleResult(rowIndex) {
    let row = appData[rowIndex];
    let parsed = parseSubjectHeaders(cachedHeaders);
    var firstEmpty = parsed.firstEmpty;
    var testWeight = parseFloat(document.getElementById('testWeight').value) || 25;
    var mainWeight = parseFloat(document.getElementById('mainWeight').value) || 75;
    var passRatio = (parseFloat(document.getElementById('genPass').value) || 33) / 100;
    
    var html = `<div style="text-align:left; background:#fff; padding:15px; border-radius:10px;">
    <h3 style="color:#005f40; border-bottom:2px solid #005f40; padding-bottom:5px; margin-top:0;">ACADEMIC PROFILE</h3>
    <p><b>Name:</b> ${row[1]} <br><b>ID:</b> ${row[0]} \vert{} <b>Roll:</b>${row[2]}</p>`;

    if(firstEmpty !== -1 && row[firstEmpty+2]) {
        let failReason = row[firstEmpty+5];
        let failHtml = (failReason && failReason !== "None") ? `<p style="color:#dc2626; font-weight:bold; font-size:12px;">Failed In: ${failReason}</p>` : ``;
        html += `<p><b>GPA:</b> ${row[firstEmpty+2]} | <b>Grade:</b> <span style="color:${row[firstEmpty+3]==='F'?'#dc2626':'#16a34a'}; font-weight:bold;">${row[firstEmpty+3]}</span> | <b>Pos:</b> ${row[firstEmpty+4]}</p>${failHtml}
        
        <div style="border: 1px dashed #005f40; padding: 6px; font-size: 10px; color: #005f40; margin-bottom: 8px; border-radius: 4px; background: #f0fdf4;">
        <b>Tests:</b> [ ${parsed.testSeq.join(", ")} ] | <b>Mains:</b> [ ${parsed.mainSeq.join(", ")} ]
        </div>

        <table style="width:100%; border-collapse:collapse; font-size:12px; margin-top:10px;">
        <tr style="background:#e2e8f0;"><th style="border:1px solid #ccc; padding:5px;">Subject</th><th style="border:1px solid #ccc; padding:5px;">Test(s)</th><th style="border:1px solid #ccc; padding:5px;">Main(s)</th><th style="border:1px solid #ccc; padding:5px;">Total</th><th style="border:1px solid #ccc; padding:5px;">Grade</th></tr>`;

        Object.keys(parsed.subjects).forEach(subName => {
            let sub = parsed.subjects[subName];
            let actualSubName = sub.isOpt ? (row[sub.nameCol] || "Optional") + " (Opt)" : subName;
            
            let tMarks = []; let mMarks = []; let tCalc = 0; let mCalc = 0;
            let hasTest = false; let hasMain = false; let isSubFail = false;
            let totalTFull = 0; let totalMFull = 0;

            sub.tests.forEach(t => { 
                let v = parseFloat(row[t.col]); 
                if(!isNaN(v)) { tMarks.push(v); tCalc += v; hasTest = true; } else { tMarks.push("-"); }
                let fullMatch = (cachedHeaders[t.col]||"").match(/\((\d+)\)/); totalTFull += fullMatch ? parseInt(fullMatch[1]) : 50;
            });
            sub.mains.forEach(m => { 
                let vStr = String(row[m.col] || "").trim();
                if(vStr !== "") {
                    mMarks.push(vStr); hasMain = true;
                    if(vStr.includes("+")) {
                        let obtParts = vStr.split('+').map(p=>parseFloat(p)||0);
                        mCalc += obtParts.reduce((a,b)=>a+b, 0);
                        let mFullMatch = (cachedHeaders[m.col]||"").match(/\((\d+)\+?(\d+)?\+?(\d+)?\)/); 
                        if(mFullMatch) {
                            let fullParts = mFullMatch[0].replace(/[()]/g, '').split('+').map(p=>parseInt(p)||0);
                            if(fullParts.length > 0 && obtParts[0] < Math.ceil(fullParts[0] * passRatio)) isSubFail = true;
                            else if(fullParts.length > 1 && obtParts[1] < Math.ceil(fullParts[1] * passRatio)) isSubFail = true;
                            else if(fullParts.length > 2 && fullParts[2] > 0 && obtParts[2] < Math.ceil(fullParts[2] * passRatio)) isSubFail = true;
                        }
                    } else { mCalc += parseFloat(vStr) || 0; }
                } else { mMarks.push("-"); }
                
                let mFMatch = (cachedHeaders[m.col]||"").match(/\((\d+)\+?(\d+)?\+?(\d+)?\)/); 
                totalMFull += mFMatch ? mFMatch[0].replace(/[()]/g, '').split('+').reduce((a,b)=>a+(parseInt(b)||0), 0) : 100;
            });

            if(hasTest || hasMain) {
                let finalMark = 0;
                if (hasTest && hasMain) finalMark = Math.round(((tCalc / totalTFull) * testWeight) + ((mCalc / totalMFull) * mainWeight));
                else if (!hasTest && hasMain) finalMark = Math.round((mCalc / totalMFull) * 100);
                else if (hasTest && !hasMain) finalMark = Math.round((tCalc / totalTFull) * 100);

                if(!isSubFail && finalMark < Math.ceil(100 * passRatio)) isSubFail = true;
                var subGP = getGP_JS(finalMark); var subGrade = getGrade_JS(subGP);
                if(isSubFail) subGrade = "F";

                html += `<tr>
                <td style="border:1px solid #ccc; padding:5px;">${actualSubName}</td>
                <td style="border:1px solid #ccc; padding:5px;">${tMarks.join(", ")}</td>
                <td style="border:1px solid #ccc; padding:5px;">${mMarks.join(", ")}</td>
                <td style="border:1px solid #ccc; padding:5px;">${finalMark}</td>
                <td style="border:1px solid #ccc; padding:5px;"><b>${subGrade}</b></td></tr>`;
            }
        });
        html += '</table></div>';
    } else { html += `<p style="color:#dc2626; font-weight:bold;">Result not calculated yet.</p></div>`; }
    swalPro.fire({ title: 'Student Profile', html: html, confirmButtonText: 'Close' });
}

