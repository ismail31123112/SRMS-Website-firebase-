    if(rawClassName.includes("Science")) { groupName = "Science"; baseClassName = rawClassName.replace(" Science", ""); }
    else if(rawClassName.includes("Arts")) { groupName = "Arts"; baseClassName = rawClassName.replace(" Arts", ""); }
    else if(rawClassName.includes("Commerce")) { groupName = "Commerce"; baseClassName = rawClassName.replace(" Commerce", ""); }

    var printHtml = "";
    var theadHtml = `
    <tr>
    <th width="22%">Subject / Exam</th>
    <th width="15%">Test Type</th>
    <th width="12%">Marks</th>
    <th width="15%">Main Type</th>
    <th width="12%">Marks</th>
    <th width="12%">Grade</th>
    <th width="12%">GP</th>
    </tr>`;

    try {
        data.forEach(row => {
            if(!row[0] && !row[1]) return; 
            var id = row[0]; var name = row[1]; var roll = row[2];
            var totalAvg = row[firstEmpty+1]; var gpa = row[firstEmpty+2]; var grade = row[firstEmpty+3]; var pos = row[firstEmpty+4];
            if(!gpa || gpa === "") { gpa = "0.00"; grade = "F"; totalAvg = "0.00"; pos = "N/A"; }

            var teacherRemark = "";
            if(grade === "A+") teacherRemark = "Outstanding!";
            else if(grade === "A") teacherRemark = "Very Good!";
            else if(grade === "A-") teacherRemark = "Good performance.";
            else if(grade === "B") teacherRemark = "Satisfactory.";
            else if(grade === "C") teacherRemark = "Average result.";
            else if(grade === "D") teacherRemark = "Needs improvement.";
            else teacherRemark = "Failed. Consult parents.";

            var rowsHtmlArray = [];
            if(firstEmpty > 3) {
                var colIndex = 3;
                while(colIndex < firstEmpty && colIndex < headers.length) {
                    if (isOptHeader(headers[colIndex])) {
                        var optNameVal = row[colIndex]; 
                        var testHeader = getSafeHeader(headers[colIndex + 1]);
                        var mainHeader = getSafeHeader(headers[colIndex + 2]);
                        if (!testHeader || !mainHeader) break;

                        var tObt = parseFloat(row[colIndex + 1]);
                        var mMStr = String(row[colIndex + 2]);
                        var hasTest = !isNaN(tObt); var hasMain = mMStr.trim() !== "";

                        var tInfo = extractSubAndExam(testHeader, 'test');
                        var mInfo = extractSubAndExam(mainHeader, 'main');
                        var testMatch = testHeader.match(/\((\d+)\)/); var testFull = testMatch ? parseInt(testMatch[1]) : 50;
                        var mainMatch = mainHeader.match(/\((\d+)\)/); var mainFull = mainMatch ? parseInt(mainMatch[1]) : 100;

                        if(hasTest || hasMain || optNameVal) {
                            var safeOptName = (optNameVal !== null && optNameVal !== undefined) ? String(optNameVal) : "";
                            var finalSubName = safeOptName.trim() !== "" ? safeOptName : "Optional Subject";

                            var totalMain = 0;
                            if(hasMain) {
                                if(mMStr.includes("+")) { totalMain = mMStr.split('+').reduce((sum, val) => sum + (parseFloat(val) || 0), 0); } 
                                else { totalMain = parseFloat(mMStr) || 0; }
                            }

                            var tVal = hasTest ? tObt : 0; 
                            var finalMark = 0;
                            if (hasTest && hasMain) finalMark = Math.round(((tVal / testFull) * testWeight) + ((totalMain / mainFull) * mainWeight));
                            else if (!hasTest && hasMain) finalMark = Math.round((totalMain / mainFull) * 100);
                            else if (hasTest && !hasMain) finalMark = Math.round((tVal / testFull) * 100);

                            var subGP = getGP_JS(finalMark); var subGrade = getGrade_JS(subGP);

                            rowsHtmlArray.push(`<tr><td class="sub-name">${finalSubName}</td>
                            <td class="exam-name">${tInfo.exam}</td><td>${hasTest ? tVal : '-'}</td>
                            <td class="exam-name">${mInfo.exam}</td><td>${hasMain ? totalMain : '-'}</td>
                            <td><strong>${subGrade}</strong></td><td><strong>${subGP.toFixed(2)}</strong></td></tr>`);
                        }
                        colIndex += 3; 
                    } else {
                        var testHeader = getSafeHeader(headers[colIndex]); 
                        var mainHeader = getSafeHeader(headers[colIndex+1]);
                        if (!testHeader || !mainHeader) break;

                        var tInfo = extractSubAndExam(testHeader, 'test');
                        var mInfo = extractSubAndExam(mainHeader, 'main');
                        var testMatch = testHeader.match(/\((\d+)\)/); var testFull = testMatch ? parseInt(testMatch[1]) : 50;
                        var mainMatch = mainHeader.match(/\((\d+)\)/); var mainFull = mainMatch ? parseInt(mainMatch[1]) : 100;

                        var tObt = parseFloat(row[colIndex]); 
                        var mMStr = String(row[colIndex+1]);
                        var hasTest = !isNaN(tObt); var hasMain = mMRaw.trim() !== "";

                        if(hasTest || hasMain) {
                            var totalMain = 0;
                            if(hasMain) {
                                if(mMStr.includes("+")) { totalMain = mMStr.split('+').reduce((sum, val) => sum + (parseFloat(val) || 0), 0); } 
                                else { totalMain = parseFloat(mMStr) || 0; }
                            }

                            var tVal = hasTest ? tObt : 0; 
                            var finalMark = 0;
                            if (hasTest && hasMain) finalMark = Math.round(((tM / tFull) * testWeight) + ((totalMain / mFull) * mainWeight));
                            else if (!hasTest && hasMain) finalMark = Math.round((totalMain / mFull) * 100);
                            else if (hasTest && !hasMain) finalMark = Math.round((tM / tFull) * 100);

                            var subGP = getGP_JS(finalMark); var subGrade = getGrade_JS(subGP);

                            rowsHtmlArray.push(`<tr><td class="sub-name">${tInfo.sub}</td>
                            <td class="exam-name">${tInfo.exam}</td><td>${hasTest ? tVal : '-'}</td>
                            <td class="exam-name">${mInfo.exam}</td><td>${hasMain ? totalMain : '-'}</td>
                            <td><strong>${subGrade}</strong></td><td><strong>${subGP.toFixed(2)}</strong></td></tr>`);
                        }
                        colIndex += 2; 
                    }
                }
            }

            var finalTableHtml = "";
            if(rowsHtmlArray.length === 0) {
                finalTableHtml = `<table class="marks-table"><thead>${theadHtml}</thead><tbody><tr><td colspan="7" style="padding:15px; color:#dc2626;">No Exam/Subject Data Found!</td></tr></tbody></table>`;
            } else if(rowsHtmlArray.length > 12) {
                var half = Math.ceil(rowsHtmlArray.length / 2);
                var col1 = rowsHtmlArray.slice(0, half).join("");
                var col2 = rowsHtmlArray.slice(half).join("");
                finalTableHtml = `<div class="marks-wrapper"><table class="marks-table" style="width: 49%;"><thead>${theadHtml}</thead><tbody>${col1}</tbody></table><table class="marks-table" style="width: 49%;"><thead>${theadHtml}</thead><tbody>${col2}</tbody></table></div>`;
            } else {
                finalTableHtml = `<div class="marks-wrapper"><table class="marks-table"><thead>${theadHtml}</thead><tbody>${rowsHtmlArray.join("")}</tbody></table></div>`;
            }

            printHtml += `
            <div class="report-card">
            <div class="school-header">
            <img src="${SCHOOL_LOGO}" class="school-logo" alt="School Logo">
            <div class="header-center">
            <h1>SAIDPUR RESIDENTIAL MODEL SCHOOL</h1>
            <p class="school-address">Sultan Nagar, Saidpur, Nilphamari</p>
            </div>
            <div class="transcript-title">Academic Transcript - ${term} (${year})</div>
            </div>

            <table class="student-info">
            <tr><td width="33%"><strong>Student Name:</strong> ${name}</td><td width="33%"><strong>Class:</strong> ${baseClassName}</td><td width="33%"><strong>Group:</strong> ${groupName}</td></tr>
