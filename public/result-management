function buildTabulationPagesForOrientation(orientation) {
  setPrintPageOrientation(orientation);

  var cls = document.getElementById("classSelector").value;
  var year = document.getElementById("yearSelector").value;
  var testWeight = parseFloat(document.getElementById('testWeight').value) || 25;
  var mainWeight = parseFloat(document.getElementById('mainWeight').value) || 75;
  var passRatio = (parseFloat(document.getElementById('genPass').value) || 33) / 100;

  var parsed = parseSubjectHeaders(cachedHeaders);
  var firstEmpty = parsed.firstEmpty;
  if (firstEmpty === -1) return;

  var stats = { 'A+': 0, 'A': 0, 'A-': 0, 'B': 0, 'C': 0, 'D': 0, 'F': 0, 'Total': 0 };
  var validRows = [];

  appData.forEach(row => {
    if (!row[0] && !row[1]) return;
    stats['Total']++;
    validRows.push(row);
    var g = row[firstEmpty + 3];
    if (g === 'Incomplete') return;
    if (stats[g] !== undefined) stats[g]++;
    else stats['F']++;
  });

  var passed = stats['Total'] - stats['F'];
  var passRate = stats['Total'] > 0 ? ((passed / stats['Total']) * 100).toFixed(2) : "0.00";
  var subKeys = Object.keys(parsed.subjects);

  // Build table header HTML
  var theadHtml = `
    <thead>
      <tr>
        <th style="width:3.2%;">Roll</th>
        <th style="width:11%; text-align:left; padding-left:3px;">Student Name &amp; ID</th>`;
  subKeys.forEach(subName => {
    let sub = parsed.subjects[subName];
    let htmlLabel = sub.isOpt ? `${subName}<br><span style="font-size:6.5px; color:#b45309;">(4th)</span>` : subName;
    theadHtml += `<th>${htmlLabel}</th>`;
  });
  theadHtml += `
        <th style="width:4%;">Avg</th>
        <th style="width:4%;">GPA</th>
        <th style="width:4%;">Grade</th>
        <th style="width:4%;">Merit</th>
      </tr>
    </thead>`;

  // Build each student row HTML with non-wrapping "Test:", "Main:", "Total:" labels
  var bodyRowsHtml = validRows.map(row => {
    let dispGrade = row[firstEmpty + 3] || '-';
    let dispPos = (dispGrade === 'F' || !row[firstEmpty + 2]) ? 'N/A' : (row[firstEmpty + 4] || '-');

    let tr = `<tr>
      <td><b>${row[2] || '-'}</b></td>
      <td style="text-align:left; padding-left:3px;"><b>${row[1] || '-'}</b><br><span style="color:#475569; font-size:7px;">ID: ${row[0] || '-'}</span></td>`;

    subKeys.forEach(subName => {
      let sub = parsed.subjects[subName];
      let ev = evaluateStudentSubjectForFilter(row, sub, "All", passRatio, testWeight, mainWeight);
      let tDisp = ev.hasTest ? ev.tCalc : "-";
      let mDisp = ev.hasMain ? ev.mCalc : "-";
      let totDisp = ev.attended ? `${ev.finalMark} (${ev.subGrade})` : "-";

      tr += `<td>
        <div class="tab-cell-lines">
          <span style="color:#334155;">Test: <b>${tDisp}</b></span><br>
          <span style="color:#334155;">Main: <b>${mDisp}</b></span><br>
          <strong style="color:${ev.subGrade === 'F' ? '#dc2626' : '#005f40'};">Total: ${totDisp}</strong>
        </div>
      </td>`;
    });

    tr += `
      <td><b>${row[firstEmpty + 1] || '-'}</b></td>
      <td><strong style="font-size:8.5px;">${row[firstEmpty + 2] || '-'}</strong></td>
      <td><strong style="font-size:8.5px; color:${dispGrade === 'F' ? '#dc2626' : '#059669'};">${dispGrade}</strong></td>
      <td><b>${dispPos}</b></td>
    </tr>`;
    return tr;
  });
  // Portrait mode fits 11 rows per page comfortably; Landscape mode fits 7 rows per page so summary + signatures never clip
  var rowsPerPage = (orientation === 'portrait') ? 11 : 7;
  var pagesArr = [];
  for (let i = 0; i < bodyRowsHtml.length; i += rowsPerPage) {
    pagesArr.push(bodyRowsHtml.slice(i, i + rowsPerPage));
  }
  if (pagesArr.length === 0) pagesArr.push([]);

  var summaryTableHtml = `
    <div style="margin-top:6px; border:1.5px solid #005f40; border-radius:5px; overflow:hidden; width:96%; margin-left:auto; margin-right:auto; page-break-inside:avoid;">
      <table style="width:100%; border-collapse:collapse; font-size:8px; text-align:center;">
        <tr style="font-weight:800; background:#e2e8f0; color:#005f40;">
          <td style="border:1px solid #000; padding:2.5px;">Total Students</td>
          <td style="border:1px solid #000; padding:2.5px;">Passed</td>
          <td style="border:1px solid #000; padding:2.5px;">Failed</td>
          <td style="border:1px solid #000; padding:2.5px;">Pass Rate</td>
          <td style="border:1px solid #000; padding:2.5px;">A+</td>
          <td style="border:1px solid #000; padding:2.5px;">A</td>
          <td style="border:1px solid #000; padding:2.5px;">A-</td>
          <td style="border:1px solid #000; padding:2.5px;">B</td>
          <td style="border:1px solid #000; padding:2.5px;">C</td>
          <td style="border:1px solid #000; padding:2.5px;">D</td>
        </tr>
        <tr style="font-weight:800; background:#fff;">
          <td style="border:1px solid #000; padding:3px;">${stats['Total']}</td>
          <td style="border:1px solid #000; padding:3px; color:#059669;">${passed}</td>
          <td style="border:1px solid #000; padding:3px; color:#dc2626;">${stats['F']}</td>
          <td style="border:1px solid #000; padding:3px;">${passRate}%</td>
          <td style="border:1px solid #000; padding:3px;">${stats['A+']}</td>
          <td style="border:1px solid #000; padding:3px;">${stats['A']}</td>
          <td style="border:1px solid #000; padding:3px;">${stats['A-']}</td>
          <td style="border:1px solid #000; padding:3px;">${stats['B']}</td>
          <td style="border:1px solid #000; padding:3px;">${stats['C']}</td>
          <td style="border:1px solid #000; padding:3px;">${stats['D']}</td>
        </tr>
      </table>
    </div>`;

  var totalPages = pagesArr.length;
  var pageOrientClass = (orientation === 'portrait') ? 'portrait-page' : 'landscape-page';
  var finalPagesHtml = pagesArr.map((pageRows, pageIdx) => {
    var isLastPage = (pageIdx === totalPages - 1);
    return `
      <div class="tab-page ${pageOrientClass}">
        <div class="tab-top-wrap">
          <div style="text-align:center; margin-bottom:4px; border-bottom:2px solid #005f40; padding-bottom:3px; display:flex; align-items:center; justify-content:space-between;">
            <img src="${SCHOOL_LOGO}" alt="Logo" style="height:40px; width:40px; border-radius:50%; border:1.5px solid #005f40; padding:1.5px;">
            <div>
              <h1 style="margin:0; font-size:16.5px; color:#005f40; text-transform:uppercase; font-weight:900; font-family:'Times New Roman', serif;">SAIDPUR RESIDENTIAL MODEL SCHOOL</h1>
              <p style="margin:1px 0 0 0; color:#334155; font-size:9.5px; font-weight:800;">OFFICIAL MASTER TABULATION SHEET — ${cls.toUpperCase()} (SESSION: ${year})</p>
            </div>
            <div style="text-align:right;">
              <div style="font-size:9px; font-weight:800; background:#ecfdf5; border:1px solid #005f40; padding:2px 7px; border-radius:8px; color:#005f40;">
                Total: ${stats['Total']} | Pass: ${passed} (${passRate}%)
              </div>
              <div style="font-size:7.5px; font-weight:700; color:#475569; margin-top:2px;">Page ${pageIdx + 1} of ${totalPages}</div>
            </div>
          </div>

          <div class="legend-box" style="margin-bottom:3px; font-size:8px; padding:2px 6px;">
            <span><b>Abbreviations:</b> Test = Test Exam Marks (${testWeight}% Weight) | Main = Main Exam Marks (${mainWeight}% Weight) | Total = Final Score (100%) &amp; Letter Grade</span>
            <span><b>Pass Rule:</b> ${Math.round(passRatio * 100)}% (Separate CQ, MCQ &amp; Practical)</span>
          </div>

          <table class="tab-table">
            ${theadHtml}
            <tbody>
              ${pageRows.join('')}
            </tbody>
          </table>

          ${isLastPage ? summaryTableHtml : ''}
        </div>

        <div class="tab-fixed-signatures">
          <div class="tab-sig-box">Prepared &amp; Tabulated By</div>
          <div class="tab-sig-box">Exam Controller</div>
          <div class="tab-sig-box">Principal / Headmaster</div>
        </div>
      </div>
    `;
  }).join('');

  document.getElementById('print-content').innerHTML = finalPagesHtml;
}

function publishResults() {
  var cls = document.getElementById("classSelector").value;
  if (!cls) return swalPro.fire('লক্ষ্য করুন', 'প্রথমে শ্রেণি নির্বাচন করুন!', 'warning');
  var yr = document.getElementById("yearSelector").value;
  var sendSms = document.getElementById('smsPublishChk').checked;

  swalPro.fire({
    title: 'ফলাফল প্রকাশ করবেন?',
    html: `আপনি <b>${cls}</b>-এর চূড়ান্ত ফলাফল প্রকাশ করতে যাচ্ছেন।<br>${sendSms ? '<b style="color:#059669;">সকল শিক্ষার্থীর অভিভাবকের মোবাইলে SMS ও Email পাঠানো হবে!</b>' : ''}`,
    icon: 'question',
    showCancelButton: true,
    cancelButtonText: 'বাতিল',
    confirmButtonText: 'হ্যাঁ, প্রকাশ করুন'
  }).then(async (result) => {
    if (result.isConfirmed) {
      const { value: examTerm } = await swalPro.fire({
        title: 'পরীক্ষার নাম লিখুন',
        input: 'text',
        inputLabel: 'এই নামটি SMS ও ট্রান্সক্রিপ্টে প্রদর্শিত হবে (যেমন: 1st Term / Annual Exam)',
        inputValue: 'Annual Examination',
        showCancelButton: true,
        inputValidator: (value) => { if (!value) return 'পরীক্ষার নাম লিখতে হবে!'; }
      });

      if (examTerm) {
        showLoader(true, "ফলাফল প্রকাশিত হচ্ছে এবং নোটিফিকেশন পাঠানো হচ্ছে...");
        try {
          let res = await apiCall('publishAndSendSMS', {
            className: cls,
            examTerm: examTerm,
            year: yr,
            sendSmsCheck: sendSms
          });
          showLoader(false);
          swalPro.fire('আলহামদুলিল্লাহ!', res.msg, 'success');
        } catch (err) {
          showLoader(false);
          swalPro.fire('ত্রুটি', err.message, 'error');
        }
      }
    }
  });
}
</script>
