function isOptHeader(h) {
  return h ? String(h).toLowerCase().includes("opt") && String(h).toLowerCase().includes("name") : false;
}

function parseHeaderFullMarksInfo(headerStr, defaultTotal) {
  let match = String(headerStr || "").match(/\(([^)]+)\)/);
  if (!match || !match[1]) {
    return { parts: [defaultTotal], total: defaultTotal, hasBreakdown: false, raw: String(defaultTotal) };
  }
  let raw = match[1].trim();
  let hasBreakdown = raw.includes("+");
  let parts = raw.split('+').map(p => parseFloat(p) || 0);
  let total = parts.reduce((a, b) => a + b, 0) || defaultTotal;
  return { parts: parts, total: total, hasBreakdown: hasBreakdown, raw: raw };
}

function extractSubAndExam(headerText) {
  if (!headerText) return { sub: "Unknown", exam: "Exam", type: "Test" };
  var clean = String(headerText).replace(/\[.*\]/g, '').trim();
  var parts = clean.split(" - ");
  if (parts.length >= 3) {
    return {
      sub: parts[0].trim(),
      exam: parts[1].trim(),
      type: parts[2].includes("Main") ? "Main" : "Test"
    };
  }
  return { sub: clean, exam: "Exam", type: "Test" };
}

function parseSubjectHeaders(headers) {
  let firstEmpty = headers.indexOf("");
  if (firstEmpty === -1) firstEmpty = headers.length;
  let subjects = {};
  let testSeq = [];
  let mainSeq = [];

  let c = 3;
  while (c < firstEmpty && c < headers.length) {
    let startC = c;

    if (isOptHeader(headers[c])) {
      let optSubName = headers[c].replace(" Opt Name", "").trim();
      if (!subjects[optSubName]) subjects[optSubName] = { isOpt: true, nameCol: c, tests: [], mains: [] };

      let j = c + 1;
      while (j < firstEmpty && headers[j].startsWith(optSubName + " - ")) {
        let info = extractSubAndExam(headers[j]);
        let fm = parseHeaderFullMarksInfo(headers[j], info.type === "Main" ? 100 : 50);
        if (info.type === "Test") {
          subjects[optSubName].tests.push({ col: j, name: info.exam, fm: fm });
          if (!testSeq.includes(info.exam)) testSeq.push(info.exam);
        } else {
          subjects[optSubName].mains.push({ col: j, name: info.exam, fm: fm });
          if (!mainSeq.includes(info.exam)) mainSeq.push(info.exam);
        }
        j++;
      }
      c = j;
    } else {
      let subName = headers[c].split(" - ")[0].trim();
      if (!subjects[subName]) subjects[subName] = { isOpt: false, tests: [], mains: [] };

      let j = c;
      while (j < firstEmpty && headers[j].startsWith(subName + " - ")) {
        let info = extractSubAndExam(headers[j]);
        let fm = parseHeaderFullMarksInfo(headers[j], info.type === "Main" ? 100 : 50);
        if (info.type === "Test") {
          subjects[subName].tests.push({ col: j, name: info.exam, fm: fm });
          if (!testSeq.includes(info.exam)) testSeq.push(info.exam);
        } else {
          subjects[subName].mains.push({ col: j, name: info.exam, fm: fm });
          if (!mainSeq.includes(info.exam)) mainSeq.push(info.exam);
        }
        j++;
      }
      c = j;
    }

    if (c === startC) c++;
  }
  return { subjects, testSeq, mainSeq, firstEmpty };
}

async function loadData() {
  if (!isAuthReady) return;
  var className = document.getElementById("classSelector").value;
  if (!className) {
    swalPro.fire({ title: 'লক্ষ্য করুন', text: 'অনুগ্রহ করে প্রথমে একটি শ্রেণি নির্বাচন করুন।', icon: 'warning' });
    return;
  }

  showLoader(true, "তথ্য লোড হচ্ছে...<br><span style='font-size:11px; color:#64748b;'>শিক্ষার্থী ও বিষয়ের তালিকা প্রস্তুত করা হচ্ছে</span>");
  document.getElementById("feature-panel").style.display = "none";
  document.getElementById("quickSearchBar").style.display = "none";
  document.getElementById("student-list-container").innerHTML = "";

  try {
    let docName = className.replace(/\s+/g, '_');
    let rawCls = className.trim();
    let searchGroup = "";
    if (rawCls.toLowerCase().includes("science")) { searchGroup = "Science"; rawCls = rawCls.replace(/Science/i, "").trim(); }
    else if (rawCls.toLowerCase().includes("arts")) { searchGroup = "Arts"; rawCls = rawCls.replace(/Arts/i, "").trim(); }
    else if (rawCls.toLowerCase().includes("commerce")) { searchGroup = "Commerce"; rawCls = rawCls.replace(/Commerce/i, "").trim(); }
    let searchClass = rawCls.replace(/Class/i, "").trim();

    const [headerDoc, snap] = await Promise.all([
      db.collection('ClassHeaders').doc(docName).get(),
      db.collection('Students').where('class', '==', searchClass).get()
    ]);

    cachedHeaders = (headerDoc.exists && headerDoc.data().headers)
      ? JSON.parse(headerDoc.data().headers)
      : ["ID", "Name", "Roll", "", "Total Avg", "GPA", "Grade", "Position", "Fail_Reason", "Year", "Pass_Marks_Rules"];

    appData = [];
    snap.forEach(doc => {
      let f = doc.data();
      let dbGroup = f.group ? String(f.group).trim() : "";
      if (searchGroup === "" || dbGroup.toLowerCase() === searchGroup.toLowerCase()) {
        let row = new Array(cachedHeaders.length + 2).fill("");
        row[0] = f.studentID || "";
        row[1] = f.name || "";
        row[2] = f.roll || "";
        if (f.resultMarks) {
          try {
            let marks = JSON.parse(f.resultMarks);
            for (let i = 3; i < cachedHeaders.length; i++) {
              if (marks[i] !== undefined) row[i] = marks[i];
            }
          } catch (e) {}
        }
        row[cachedHeaders.length] = f.phone || "";
        row[cachedHeaders.length + 1] = doc.id;
        appData.push(row);
      }
    });

    appData.sort((a, b) => (parseInt(a[2]) || 9999) - (parseInt(b[2]) || 9999));
    showLoader(false);
    renderStudentCards();
    document.getElementById("feature-panel").style.display = "flex";
    document.getElementById("quickSearchBar").style.display = "flex";
    document.getElementById("classSummaryPill").innerText = `মোট শিক্ষার্থী: ${appData.length}`;
  } catch (err) {
    showLoader(false);
    swalPro.fire('ত্রুটি', err.message, 'error');
  }
}

