  if (pracMax > 0 || fParts.length >= 3) {
    boxesHtml += `
      <div class="part-box">
        <label>Practical (${pracMax})</label>
        <input type="number" step="any" id="edit-prac-${colIdx}" value="${pracVal}" placeholder="Max ${pracMax}" oninput="updateSplitLiveSum(${colIdx})">
      </div>
    `;
  }

  let initSum = (parseFloat(cqVal) || 0) + (parseFloat(mcqVal) || 0) + (parseFloat(pracVal) || 0);
  let initSumTxt = (cqVal !== "" || mcqVal !== "" || pracVal !== "") ? initSum : "-";

