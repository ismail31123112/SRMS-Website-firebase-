            <input type="number" step="any" id="edit-single-${colIdx}" data-mode="single" value="${valStr}" placeholder="0 - ${fmInfo.total}">
          </div>
        </div>
      </div>
    `;
  }

  let cqMax = fParts[0] || 0;
  let mcqMax = fParts[1] || 0;
  let pracMax = fParts[2] || 0;

  let cqVal = partsObt[0] !== undefined ? partsObt[0] : "";
  let mcqVal = partsObt[1] !== undefined ? partsObt[1] : "";
  let pracVal = partsObt[2] !== undefined ? partsObt[2] : "";

  let boxesHtml = `
    <div class="part-box">
      <label>CQ / লিখিত (${cqMax})</label>
      <input type="number" step="any" id="edit-cq-${colIdx}" value="${cqVal}" placeholder="Max ${cqMax}" oninput="updateSplitLiveSum(${colIdx})">
    </div>
  `;

  if (mcqMax > 0 || fParts.length >= 2) {
    boxesHtml += `
      <div class="part-box">
        <label>MCQ (${mcqMax})</label>
        <input type="number" step="any" id="edit-mcq-${colIdx}" value="${mcqVal}" placeholder="${mcqMax > 0 ? 'Max ' + mcqMax : '0'}" ${mcqMax === 0 ? 'disabled style="background:#f1f5f9;"' : ''} oninput="updateSplitLiveSum(${colIdx})">
      </div>
    `;
