<style>
:root {
  --main: #005f40;
  --main-dark: #003d29;
  --main-light: #ecfdf5;
  --gold: #d97706;
  --bg: #f1f5f9;
  --text-dark: #0f172a;
  --text-muted: #64748b;
  --border: #cbd5e1;
}
* { box-sizing: border-box; }
body {
  font-family: 'Poppins', sans-serif;
  background-color: var(--bg);
  margin: 0;
  color: var(--text-dark);
  -webkit-font-smoothing: antialiased;
}
.main-padding { padding: 20px; max-width: 1440px; margin: 0 auto; }

@keyframes fadeInUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
@keyframes spin { 100% { transform: rotate(360deg); } }

/* Loader */
.loader-overlay {
  position: fixed;
  top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(8px);
  z-index: 9999;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.spinner {
  width: 54px; height: 54px;
  border: 5px solid #e2e8f0;
  border-top: 5px solid var(--main);
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
  margin-bottom: 14px;
}
.loader-text {
  font-weight: 800;
  color: var(--main);
  font-size: 15px;
  letter-spacing: 0.6px;
  text-align: center;
}

#appContainer { display: none; }

.app-header {
  background: #ffffff;
  padding: 22px 26px;
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(0, 95, 64, 0.07);
  margin-bottom: 22px;
  border-top: 6px solid var(--main);
  border-bottom: 1px solid #e2e8f0;
  animation: fadeInUp 0.3s ease-out forwards;
}
.header-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
  flex-wrap: wrap;
  gap: 12px;
  border-bottom: 2px solid #f1f5f9;
  padding-bottom: 14px;
}
.header-brand {
  display: flex;
  align-items: center;
  gap: 14px;
}
.header-brand img {
  height: 56px;
  width: 56px;
  border-radius: 50%;
  object-fit: cover;
  border: 2.5px solid var(--gold);
  padding: 2px;
  background: #fff;
}
.header-brand h2 {
  margin: 0;
  color: var(--main);
  font-size: 21px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}
.header-brand p {
  margin: 2px 0 0 0;
  font-size: 12px;
  color: var(--text-muted);
  font-weight: 600;
}

.control-group { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.weight-controls {
  display: flex;
  gap: 8px;
  align-items: center;
  background: #f8fafc;
  padding: 8px 14px;
  border-radius: 12px;
  border: 1.5px solid #cbd5e1;
}
.weight-controls input {
  border: 1.5px solid #94a3b8;
  border-radius: 8px;
  padding: 6px;
  font-weight: 800;
  color: var(--main);
  width: 52px;
  text-align: center;
  background: #fff;
}
input[type=number]::-webkit-inner-spin-button,
input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }

select, button {
  padding: 11px 16px;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 700;
  font-family: 'Poppins', sans-serif;
  cursor: pointer;
  border: 1.5px solid #cbd5e1;
  outline: none;
  transition: all 0.2s ease;
  background: #fff;
}
select:focus { border-color: var(--main); box-shadow: 0 0 0 3px rgba(0, 95, 64, 0.12); }
button {
  border: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  color: white;
}
button:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(0,0,0,0.14); }
button:disabled { opacity: 0.6; cursor: not-allowed; }

.btn-open { background: linear-gradient(135deg, var(--main), var(--main-dark)); }
.btn-reset { background: linear-gradient(135deg, #ef4444, #b91c1c); }
.btn-tool { background: linear-gradient(135deg, #475569, #1e293b); }
.btn-add-sub { background: linear-gradient(135deg, #7c3aed, #5b21b6); }
.btn-calc { background: linear-gradient(135deg, #2563eb, #1d4ed8); font-weight: 800; }
.btn-print { background: linear-gradient(135deg, #0f172a, #1e293b); }
.btn-report { background: linear-gradient(135deg, #d97706, #b45309); }
.btn-publish { background: linear-gradient(135deg, #059669, #047857); font-weight: 800; }
.btn-back { background: #f1f5f9; color: var(--text-dark); border: 1.5px solid #cbd5e1; }
.btn-back:hover { background: var(--main); color: #fff; border-color: var(--main); }

#feature-panel {
  display: none;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
  border-top: 1.5px dashed #cbd5e1;
  padding-top: 16px;
  margin-top: 14px;
}

.quick-search-bar {
  display: none;
  margin-top: 14px;
  background: #f8fafc;
  padding: 10px 14px;
  border-radius: 12px;
  border: 1px solid #e2e8f0;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}
.quick-search-bar input {
  flex: 1;
  min-width: 240px;
  padding: 10px 14px;
  border-radius: 10px;
  border: 1.5px solid #cbd5e1;
  font-family: inherit;
  font-size: 13.5px;
  outline: none;
}
.quick-search-bar input:focus { border-color: var(--main); }

#student-list-container {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
  gap: 18px;
  margin-top: 18px;
  animation: fadeInUp 0.35s ease;
}
.student-card {
  background: white;
  border-radius: 16px;
  box-shadow: 0 4px 15px rgba(15, 23, 42, 0.04);
  border: 1.5px solid #e2e8f0;
  overflow: hidden;
  transition: 0.25s;
  display: flex;
  flex-direction: column;
}
.student-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 24px rgba(0, 95, 64, 0.1);
  border-color: #a7f3d0;
}
.card-header {
  background: #f8fafc;
  padding: 14px 18px;
  border-bottom: 1px solid #e2e8f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}
.card-header h4 {
  margin: 0;
  color: var(--main);
  font-size: 15.5px;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.roll-badge {
  background: var(--main);
  color: white;
  font-size: 11px;
  font-weight: 800;
  padding: 4px 10px;
  border-radius: 20px;
  flex-shrink: 0;
}
.card-body { padding: 16px 18px; flex-grow: 1; }
.card-body p { margin: 0 0 10px 0; font-size: 12.5px; color: #475569; font-weight: 600; }
.result-mini {
  display: flex;
  justify-content: space-between;
  background: #ecfdf5;
  border: 1px solid #a7f3d0;
  padding: 9px 12px;
  border-radius: 10px;
  font-size: 12.5px;
  font-weight: 800;
  color: #065f46;
}
.result-mini.failed { background: #fef2f2; border-color: #fecaca; color: #991b1b; }
.result-mini.incomp { background: #fffbeb; border-color: #fde68a; color: #b45309; }
.card-footer {
  padding: 12px 18px;
  background: #f8fafc;
  border-top: 1px solid #e2e8f0;
  display: flex;
  gap: 10px;
}
.btn-edit-marks { background: linear-gradient(135deg, #0284c7, #0369a1); color: white; flex: 1; border-radius: 10px; padding: 10px; font-size: 13px; }
.btn-view-result { background: linear-gradient(135deg, var(--main), var(--main-dark)); color: white; flex: 1; border-radius: 10px; padding: 10px; font-size: 13px; }

.part-grid-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(95px, 1fr));
  gap: 8px;
  margin-top: 6px;
}
.part-box {
  background: #ffffff;
  border: 1.5px solid #cbd5e1;
  border-radius: 9px;
  padding: 6px 8px;
  text-align: center;
}
.part-box label {
  display: block;
  font-size: 10.5px;
  font-weight: 800;
  color: #334155;
  margin-bottom: 3px;
  text-transform: uppercase;
}
.part-box input {
  width: 100%;
  border: 1.5px solid #94a3b8;
  border-radius: 6px;
  padding: 6px;
  text-align: center;
  font-weight: 800;
  font-size: 13.5px;
  color: var(--main);
  outline: none;
}
.part-box input:focus { border-color: var(--main); background: #f0fdf4; }

@media (max-width: 768px) {
  .main-padding { padding: 10px; }
  .control-group, #feature-panel { justify-content: center; }
  button { flex: 1 1 45%; font-size: 12px; padding: 9px 10px; }
  #student-list-container { grid-template-columns: 1fr; }
}

/* ============================================================================
   🖨️ ENTERPRISE PRINT PREVIEW & A4 LANDSCAPE TRANSCRIPT / TABULATION ENGINE
============================================================================ */
#print-area { display: none; background: #475569; min-height: 100vh; padding: 20px 0; }
.print-toolbar {
  position: sticky;
  top: 0;
  background: #0f172a;
  padding: 12px 24px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 15px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.25);
  z-index: 1000;
  margin-bottom: 20px;
}
.print-toolbar button { font-size: 14px; padding: 11px 24px; border-radius: 10px; }
#print-content {
  width: 297mm;
  margin: 0 auto;
  background: transparent;
  box-sizing: border-box;
}

/* Marksheet Screen Preview Card */
.report-card {
  width: 281mm;
  height: 192mm;
  max-height: 192mm;
  margin: 0 auto 15mm auto;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border: 3px double #005f40;
  padding: 6mm 8mm;
  border-radius: 6px;
  background: #ffffff;
  position: relative;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0,0,0,0.25);
}
.rc-watermark {
  position: absolute;
  top: 52%; left: 50%;
  transform: translate(-50%, -50%) rotate(-25deg);
  font-size: 72px;
  font-weight: 900;
  color: rgba(0, 95, 64, 0.035);
  pointer-events: none;
  white-space: nowrap;
  z-index: 0;
  letter-spacing: 6px;
}
.rc-top-section, .rc-middle-section, .rc-bottom-section { position: relative; z-index: 1; }
.rc-middle-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  overflow: hidden;
}

.school-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2px solid #005f40;
  padding-bottom: 4px;
  margin-bottom: 5px;
  gap: 10px;
}
.school-logo { width: 52px; height: 52px; border-radius: 50%; object-fit: contain; border: 1.5px solid #005f40; padding: 2px; background: #fff; }
.header-center { text-align: center; flex: 1; }
.header-center h1 {
  margin: 0;
  font-size: 19px;
  text-transform: uppercase;
  color: #005f40;
  font-weight: 900;
  letter-spacing: 0.6px;
  font-family: 'Times New Roman', Times, serif;
}
.school-address { font-size: 10px; font-weight: 700; color: #334155; margin: 1px 0 0 0; }
.transcript-badge-wrap { text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: 3px; }
.transcript-title {
  background: #005f40 !important;
  color: white !important;
  padding: 4px 12px;
  border-radius: 15px;
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.grade-scale-mini {
  font-size: 8px;
  color: #1e293b;
  font-weight: 700;
  background: #f1f5f9 !important;
  border: 1px solid #cbd5e1;
  padding: 2px 6px;
  border-radius: 4px;
  white-space: nowrap;
}

.student-info {
  width: 100%;
  margin-bottom: 4px;
  font-size: 10.5px;
  font-weight: 700;
  border: 1px solid #94a3b8;
  border-radius: 5px;
  background: #f8fafc !important;
  border-collapse: collapse;
}
.student-info td { padding: 3px 8px; border-right: 1px dashed #cbd5e1; }
.student-info td:last-child { border-right: none; }

.legend-box {
  font-size: 9px;
  color: #005f40;
  background: #ecfdf5 !important;
  border: 1px dashed #005f40;
  padding: 2px 8px;
  border-radius: 4px;
  margin-bottom: 4px;
  display: flex;
  justify-content: space-between;
  font-weight: 700;
}

.marks-wrapper {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  align-items: flex-start;
}
.marks-table { width: 100%; border-collapse: collapse; font-size: 10px; background: #fff; }
.marks-table th, .marks-table td {
  border: 1px solid #1e293b;
  padding: 3.5px 4px;
  text-align: center;
  vertical-align: middle;
  line-height: 1.15;
}
.marks-table th {
  background-color: #e2e8f0 !important;
  font-weight: 800;
  color: #0f172a;
  font-size: 9px;
  text-transform: uppercase;
}
.marks-table td.sub-name {
  text-align: left;
  padding-left: 6px;
  font-weight: 800;
  color: #0f172a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 135px;
}
.divider-col { border-right: 1.8px solid #000 !important; }

/* Auto-Adaptive Dense Mode for Many Subjects / 6 Exams */
.report-card.dense-card .marks-table th,
.report-card.dense-card .marks-table td {
  padding: 2.2px 3px;
  font-size: 9px;
}
.report-card.dense-card .marks-table td.sub-name { font-size: 9px; max-width: 120px; }

.summary-box {
  border: 1.5px solid #005f40;
  padding: 5px 12px;
  width: 100%;
  margin-top: 4px;
  border-radius: 6px;
  background: #f0fdf4 !important;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}
.summary-metrics {
  display: flex;
  gap: 18px;
  font-size: 12px;
  font-weight: 800;
  color: #005f40;
  align-items: center;
}
.remark-text {
  font-size: 10.5px;
  font-weight: 800;
  color: #b91c1c;
  margin: 0;
  text-transform: uppercase;
}

/* Fixed Signature Row at Bottom of Every Marksheet */
.footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 16px 15px 0 15px;
  margin-top: 4px;
}
.signature {
  border-top: 1.5px solid #000;
  width: 175px;
  text-align: center;
  padding-top: 4px;
  font-weight: 800;
  font-size: 10.5px;
  color: #000;
  text-transform: uppercase;
}

/* Tabulation Sheet Print Styles */
.tabulation-print {
  background: #fff;
  padding: 8mm;
  border-radius: 6px;
  position: relative;
}
.tab-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 9.5px;
  text-align: center;
  table-layout: auto;
}
.tab-table th {
  background: #e2e8f0 !important;
  padding: 6px 4px;
  border: 1px solid #000;
  font-weight: 800;
  color: #000;
  font-size: 9.5px;
}
.tab-table td {
  padding: 5px 4px;
  border: 1px solid #000;
  vertical-align: middle;
  font-size: 9px;
  font-weight: 600;
  line-height: 1.25;
  color: #000;
}
.tab-table tr { page-break-inside: avoid; break-inside: avoid; }
.tab-print-spacer td { height: 22mm; border: none !important; background: transparent !important; }
.tab-fixed-signatures {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 12px 25px 0 25px;
  margin-top: 15px;
}
.tab-sig-box {
  border-top: 1.5px solid #000;
  width: 185px;
  text-align: center;
  padding-top: 4px;
  font-weight: 800;
  font-size: 10.5px;
  color: #000;
  text-transform: uppercase;
}

@media print {
  .app-header, #student-list-container, .loader-overlay, .swal2-container, .print-toolbar, .quick-search-bar {
    display: none !important;
  }
  body {
    background: white !important;
    margin: 0 !important;
    padding: 0 !important;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
  #appContainer { display: none !important; }
  #print-area { display: block !important; background: transparent !important; padding: 0 !important; margin: 0 !important; }
  #print-content { width: 100% !important; margin: 0 !important; padding: 0 !important; }

  @page { size: A4 landscape; margin: 7mm; }

  .report-card {
    width: 100% !important;
    height: 194mm !important;
    max-height: 194mm !important;
    margin: 0 !important;
    box-shadow: none !important;
    page-break-after: always !important;
    break-after: page !important;
    page-break-inside: avoid !important;
    break-inside: avoid !important;
  }
  .report-card:last-child {
    page-break-after: auto !important;
    break-after: auto !important;
  }

  .tabulation-print { padding: 0 !important; box-shadow: none !important; }
  .tab-table thead { display: table-header-group; }
  .tab-table tfoot { display: table-footer-group; }
  .tab-fixed-signatures {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 18mm;
    background: #fff;
    z-index: 100;
  }
}
</style>
</head>
