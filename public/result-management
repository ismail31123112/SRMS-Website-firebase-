          <td style="border:1px solid #000; padding:5px;">${passRate}%</td>
          <td style="border:1px solid #000; padding:5px;">${stats['A+']}</td>
          <td style="border:1px solid #000; padding:5px;">${stats['A']}</td>
          <td style="border:1px solid #000; padding:5px;">${stats['A-']}</td>
          <td style="border:1px solid #000; padding:5px;">${stats['B']}</td>
          <td style="border:1px solid #000; padding:5px;">${stats['C']}</td>
          <td style="border:1px solid #000; padding:5px;">${stats['D']}</td>
        </tr>
      </table>
    </div>

    <div class="tab-fixed-signatures">
      <div class="tab-sig-box">Prepared &amp; Tabulated By</div>
      <div class="tab-sig-box">Exam Controller</div>
      <div class="tab-sig-box">Principal / Headmaster</div>
    </div>
  </div>`;

  executePrint(printHtml);
}

function publishResults() {
  var cls = document.getElementById("classSelector").value;
  if (!cls) return swalPro.fire('লক্ষ্য করুন', 'প্রথমে শ্রেণি নির্বাচন করুন!', 'warning');
  var yr = document.getElementById("yearSelector").value;
  var sendSms = document.getElementById('smsPublishChk').checked;

  swalPro.fire({
    title: 'ফলাফল প্রকাশ করবেন?',
    html: `আপনি <b>${cls}</b>-এর চূড়ান্ত ফলাফল প্রকাশ করতে যাচ্ছেন।<br>${sendSms ? '<b style="color:#059669;">সকল শিক্ষার্থীর অভিভাবকের মোবাইলে SMS ও Email পাঠানো হবে!</b>' : ''}`,
    icon: 'question',
    showCancelButton: true,
    cancelButtonText: 'বাতিল',
    confirmButtonText: 'হ্যাঁ, প্রকাশ করুন'
  }).then(async (result) => {
    if (result.isConfirmed) {
      const { value: examTerm } = await swalPro.fire({
        title: 'পরীক্ষার নাম লিখুন',
        input: 'text',
        inputLabel: 'এই নামটি SMS ও ট্রান্সক্রিপ্টে প্রদর্শিত হবে (যেমন: 1st Term / Annual Exam)',
        inputValue: 'Annual Examination',
        showCancelButton: true,
        inputValidator: (value) => { if (!value) return 'পরীক্ষার নাম লিখতে হবে!'; }
      });

      if (examTerm) {
        showLoader(true, "ফলাফল প্রকাশিত হচ্ছে এবং নোটিফিকেশন পাঠানো হচ্ছে...");
        try {
          let res = await apiCall('publishAndSendSMS', {
            className: cls,
            examTerm: examTerm,
            year: yr,
            sendSmsCheck: sendSms
          });
          showLoader(false);
          swalPro.fire('আলহামদুলিল্লাহ!', res.msg, 'success');
        } catch (err) {
          showLoader(false);
          swalPro.fire('ত্রুটি', err.message, 'error');
        }
      }
    }
  });
}
</script>
