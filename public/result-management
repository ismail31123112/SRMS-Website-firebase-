function evaluateStudentSubjectForFilter(row, sub, examFilter, passRatio, testWeight, mainWeight) {
  let tMarks = [];
  let cqs = [], mcqs = [], pracs = [];
  let tCalc = 0, mCalc = 0;
  let hasTest = false, hasMain = false, isSubFail = false;
  let totalTFull = 0, totalMFull = 0;

  sub.tests.forEach(t => {
    if (examFilter === "All" || examFilter === t.name || t.name === "Test") {
      let vStr = String(row[t.col] || "").trim();
      totalTFull += t.fm.total;
      if (vStr !== "") {
        hasTest = true;
        let sumT = 0;
        if (vStr.includes("+")) {
          let obtParts = vStr.split('+').map(p => parseFloat(p) || 0);
          sumT = obtParts.reduce((a, b) => a + b, 0);
        } else {
          sumT = parseFloat(vStr) || 0;
        }
        if (sumT > t.fm.total) sumT = t.fm.total;
        tCalc += sumT;
        tMarks.push(sumT);
      }
    }
  });

  sub.mains.forEach(m => {
    if (examFilter === "All" || examFilter === m.name || m.name === "Main") {
      let vStr = String(row[m.col] || "").trim();
      totalMFull += m.fm.total;
      if (vStr !== "") {
        hasMain = true;
        let fullParts = m.fm.parts; 
        let hasMultiParts = (fullParts[1] > 0 || fullParts[2] > 0 || vStr.includes("+"));

        if (hasMultiParts) {
          let obtParts = vStr.split('+').map(p => parseFloat(p) || 0);
          let cqObt = obtParts[0] || 0;
          let mcqObt = obtParts[1] || 0;
          let pracObt = obtParts[2] || 0;

          if (fullParts[0] > 0 && cqObt > fullParts[0]) cqObt = fullParts[0];
          if (fullParts[1] > 0 && mcqObt > fullParts[1]) mcqObt = fullParts[1];
          if (fullParts[2] > 0 && pracObt > fullParts[2]) pracObt = fullParts[2];

          let sumM = cqObt + mcqObt + pracObt;
          if (sumM > m.fm.total) sumM = m.fm.total;
          mCalc += sumM;

          cqs.push(fullParts[0] > 0 ? cqObt : "-");
          mcqs.push(fullParts[1] > 0 ? mcqObt : "-");
          pracs.push(fullParts[2] > 0 ? pracObt : "-");

          if (fullParts[0] > 0 && cqObt < Math.ceil(fullParts[0] * passRatio)) isSubFail = true;
          else if (fullParts[1] > 0 && mcqObt < Math.ceil(fullParts[1] * passRatio)) isSubFail = true;
          else if (fullParts[2] > 0 && pracObt < Math.ceil(fullParts[2] * passRatio)) isSubFail = true;
        } else {
          let singleM = parseFloat(vStr) || 0;
          if (singleM > m.fm.total) singleM = m.fm.total;
          mCalc += singleM;
          cqs.push(singleM);
          mcqs.push("-");
          pracs.push("-");
          if (singleM < Math.ceil(m.fm.total * passRatio)) isSubFail = true;
        }
      }
    }
  });

  let finalMark = 0;
  if (hasTest || hasMain) {
    if (hasTest && hasMain && totalTFull > 0 && totalMFull > 0) {
      finalMark = Math.round(((tCalc / totalTFull) * testWeight) + ((mCalc / totalMFull) * mainWeight));
    } else if (!hasTest && hasMain && totalMFull > 0) {
      finalMark = Math.round((mCalc / totalMFull) * 100);
    } else if (hasTest && !hasMain && totalTFull > 0) {
      finalMark = Math.round((tCalc / totalTFull) * 100);
    }
    if (finalMark > 100) finalMark = 100;
    if (!isSubFail && finalMark < Math.ceil(100 * passRatio)) isSubFail = true;
  }

  let subGP = getGP_JS(finalMark);
  let subGrade = getGrade_JS(subGP);
  if (isSubFail || subGP === 0) {
    subGP = 0.00;
    subGrade = "F";
  }

  return {
    attended: hasTest || hasMain,
    hasTest,
    hasMain,
    tMarks,
    cqs,
    mcqs,
    pracs,
    tCalc,
    mCalc,
    finalMark,
    subGP,
    subGrade,
    isSubFail
  };
}

