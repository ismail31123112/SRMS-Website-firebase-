function recalculateClassStatsInMemory() {
  let parsed = parseSubjectHeaders(cachedHeaders);
  let firstEmpty = parsed.firstEmpty;
  if (firstEmpty === -1) return;

  let passRatio = (parseFloat(document.getElementById('genPass').value) || 33) / 100;
  let testWeight = parseFloat(document.getElementById('testWeight').value) || 25;
  let mainWeight = parseFloat(document.getElementById('mainWeight').value) || 75;
  let selectedYear = document.getElementById('yearSelector').value;

  let validList = [];

  appData.forEach((row, idx) => {
    if (!row[0] && !row[1]) return;

    let totalMarks = 0;
    let totalRegularGP = 0;
    let optExtraGP = 0;
    let regularSubCount = 0;
    let totalSubCount = 0;
    let isFail = false;
    let attendedExams = 0;
    let incompleteTerm = false;
    let failReasonsArray = [];

    Object.keys(parsed.subjects).forEach(subName => {
      let sub = parsed.subjects[subName];
      let ev = evaluateStudentSubjectForFilter(row, sub, "All", passRatio, testWeight, mainWeight);

      if (ev.hasTest && !ev.hasMain && sub.mains.length > 0) {
        incompleteTerm = true;
      }

      if (ev.attended) {
        attendedExams++;
        if (ev.isSubFail && !sub.isOpt) {
          isFail = true;
          failReasonsArray.push(subName);
        }
        if (sub.isOpt && !ev.isSubFail && ev.subGP > 2.00) {
          optExtraGP += (ev.subGP - 2.00);
        } else if (!sub.isOpt) {
          totalRegularGP += ev.isSubFail ? 0 : ev.subGP;
          regularSubCount++;
        }
        totalMarks += ev.finalMark;
        totalSubCount++;
      }
    });

    if (attendedExams === 0) {
      row[firstEmpty + 1] = "";
      row[firstEmpty + 2] = "";
      row[firstEmpty + 3] = "";
      row[firstEmpty + 4] = "";
      row[firstEmpty + 5] = "";
      row[firstEmpty + 6] = "";
    } else {
      let finalGPA = 0.00;
      let finalGrade = "F";
      let grandTotalAvg = totalSubCount > 0 ? (totalMarks / totalSubCount).toFixed(2) : "0.00";

      if (incompleteTerm) {
        finalGPA = 0.00;
        finalGrade = "Incomplete";
        isFail = true;
        failReasonsArray = ["Exams Incomplete"];
      } else if (regularSubCount > 0) {
        if (isFail) {
          finalGPA = 0.00;
          finalGrade = "F";
        } else {
          let combinedGP = totalRegularGP + optExtraGP;
          finalGPA = combinedGP / regularSubCount;
          if (finalGPA > 5.00) finalGPA = 5.00;
          finalGrade = getGrade_JS(parseFloat(finalGPA));
        }
      }

      row[firstEmpty + 1] = grandTotalAvg;
      row[firstEmpty + 2] = regularSubCount > 0 ? parseFloat(finalGPA).toFixed(2) : "0.00";
      row[firstEmpty + 3] = finalGrade;
      row[firstEmpty + 5] = failReasonsArray.length > 0 ? failReasonsArray.join(", ") : "None";
      row[firstEmpty + 6] = selectedYear;

      validList.push({
        idx: idx,
        gpa: parseFloat(finalGPA) || 0,
        totalMarks: totalMarks,
        isFail: isFail,
        attendedExams: attendedExams
      });
    }
  });

  validList.sort((a, b) => {
    if (a.isFail && !b.isFail) return 1;
    if (!a.isFail && b.isFail) return -1;
    if (b.attendedExams !== a.attendedExams) return b.attendedExams - a.attendedExams;
    if (b.gpa !== a.gpa) return b.gpa - a.gpa;
    return b.totalMarks - a.totalMarks;
  });

  let currentRank = 1;
  for (let i = 0; i < validList.length; i++) {
    let st = validList[i];
    let targetRow = appData[st.idx];
    if (st.isFail) {
      targetRow[firstEmpty + 4] = "N/A";
    } else {
      if (
        i > 0 &&
        validList[i].attendedExams === validList[i - 1].attendedExams &&
        validList[i].gpa === validList[i - 1].gpa &&
        validList[i].totalMarks === validList[i - 1].totalMarks &&
        !validList[i - 1].isFail
      ) {
        targetRow[firstEmpty + 4] = appData[validList[i - 1].idx][firstEmpty + 4];
      } else {
        let s = ["th", "st", "nd", "rd"];
        let v = currentRank % 100;
        targetRow[firstEmpty + 4] = currentRank + (s[(v - 20) % 10] || s[v] || s[0]);
      }
      currentRank++;
    }
  }
}

