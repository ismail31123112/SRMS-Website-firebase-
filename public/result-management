function getGP_JS(p) {
  if (p >= 80) return 5.00;
  if (p >= 70) return 4.00;
  if (p >= 60) return 3.50;
  if (p >= 50) return 3.00;
  if (p >= 40) return 2.00;
  if (p >= 33) return 1.00;
  return 0.00;
}
function getGrade_JS(g) {
  if (g >= 5.00) return "A+";
  if (g >= 4.00) return "A";
  if (g >= 3.50) return "A-";
  if (g >= 3.00) return "B";
  if (g >= 2.00) return "C";
  if (g >= 1.00) return "D";
  return "F";
}

