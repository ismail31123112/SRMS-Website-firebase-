function generateMarkSheets(examFilter) {
  var data = appData;
  var parsed = parseSubjectHeaders(cachedHeaders);
  var firstEmpty = parsed.firstEmpty;
  var rawClassName = document.getElementById("classSelector").value;
  var year = document.getElementById("yearSelector").value;
  var passRatio = (parseFloat(document.getElementById('genPass').value) || 33) / 100;
  var testWeight = parseFloat(document.getElementById('testWeight').value) || 25;
  var mainWeight = parseFloat(document.getElementById('mainWeight').value) || 75;

  var groupName = "General";
  var baseClassName = rawClassName;
  if (rawClassName.includes("Science")) { groupName = "Science"; baseClassName = rawClassName.replace(" Science", ""); }
  else if (rawClassName.includes("Arts")) { groupName = "Arts"; baseClassName = rawClassName.replace(" Arts", ""); }
  else if (rawClassName.includes("Commerce")) { groupName = "Commerce"; baseClassName = rawClassName.replace(" Commerce", ""); }

  var theadHtml = `
    <tr>
      <th rowspan="2" width="25%">Subject</th>
      <th rowspan="2" width="14%" class="divider-col">Test<br>Marks</th>
      <th colspan="3" width="31%" class="divider-col">Main Exam Breakdown</th>
      <th rowspan="2" width="11%">Final<br>(100%)</th>
      <th rowspan="2" width="9%">Grade</th>
      <th rowspan="2" width="10%">GP</th>
    </tr>
    <tr>
      <th>CQ</th>
      <th>MCQ</th>
      <th class="divider-col">Prac</th>
    </tr>`;

  let activeTests = [];
  let activeMains = [];
  parsed.testSeq.forEach(t => { if (examFilter === "All" || t === examFilter) activeTests.push(t); });
  parsed.mainSeq.forEach(m => { if (examFilter === "All" || m === examFilter) activeMains.push(m); });

  let legendHtml = `
    <div class="legend-box">
      <span><b>Tests Included (${testWeight}%):</b> ${activeTests.join(" / ") || "N/A"}</span>
      <span><b>Main Exams (${mainWeight}%):</b> ${activeMains.join(" / ") || "N/A"}</span>
      <span><b>Pass Rule:</b> ${Math.round(passRatio * 100)}% (Separate CQ, MCQ & Practical)</span>
    </div>`;

  let cardsArr = [];
  let printCount = 0;

  data.forEach(row => {
    if (!row[0] && !row[1]) return;
    var grade = row[firstEmpty + 3];
    if (grade === "Incomplete") return;
    printCount++;

    var id = row[0];
    var name = row[1];
    var roll = row[2];
    var totalAvg = row[firstEmpty + 1];
    var gpa = row[firstEmpty + 2];
    var pos = row[firstEmpty + 4];
    var failReason = row[firstEmpty + 5];
    if (!gpa || gpa === "") { gpa = "0.00"; grade = "F"; totalAvg = "0.00"; pos = "N/A"; }

    var rowsHtmlArray = [];
    var filterTotalMarks = 0;
    var filterTotalRegularGP = 0;
    var filterOptExtraGP = 0;
    var filterRegularSubCount = 0;
    var filterTotalSubCount = 0;
    var filterIsFail = false;

    Object.keys(parsed.subjects).forEach(subName => {
      let sub = parsed.subjects[subName];
      let actualSubName = sub.isOpt
        ? (row[sub.nameCol] || subName) + " <span style='font-size:8.5px; font-weight:700; color:#b45309;'>(4th)</span>"
        : subName;

      let ev = evaluateStudentSubjectForFilter(row, sub, examFilter, passRatio, testWeight, mainWeight);
      if (ev.attended) {
        if (ev.isSubFail && !sub.isOpt) filterIsFail = true;
        if (sub.isOpt && !ev.isSubFail && ev.subGP > 2.00) {
          filterOptExtraGP += (ev.subGP - 2.00);
        } else if (!sub.isOpt) {
          filterTotalRegularGP += ev.isSubFail ? 0 : ev.subGP;
          filterRegularSubCount++;
        }
        filterTotalMarks += ev.finalMark;
        filterTotalSubCount++;

        let testStr = ev.tMarks.length > 0 ? ev.tMarks.join(" / ") : "-";
        let cqDisp = ev.cqs.length > 0 ? ev.cqs.join(" / ") : "-";
        let mcqDisp = ev.mcqs.length > 0 ? ev.mcqs.join(" / ") : "-";
        let pracDisp = ev.pracs.length > 0 ? ev.pracs.join(" / ") : "-";

        rowsHtmlArray.push(`<tr>
          <td class="sub-name">${actualSubName}</td>
          <td class="divider-col" style="white-space:nowrap;"><b>${testStr}</b></td>
          <td style="white-space:nowrap;">${cqDisp}</td>
          <td style="white-space:nowrap;">${mcqDisp}</td>
          <td class="divider-col" style="white-space:nowrap;">${pracDisp}</td>
          <td><b>${ev.finalMark}</b></td>
          <td><strong style="color:${ev.subGrade === 'F' ? '#dc2626' : '#005f40'};">${ev.subGrade}</strong></td>
          <td><strong>${ev.subGP.toFixed(2)}</strong></td>
        </tr>`);
      }
    });

    let dispGPA = gpa, dispGrade = grade, dispAvg = totalAvg, dispPos = pos;
    if (examFilter !== "All") {
      if (filterRegularSubCount > 0) {
        if (filterIsFail) { dispGPA = "0.00"; dispGrade = "F"; }
        else {
          let combinedGP = filterTotalRegularGP + filterOptExtraGP;
          let rawGPA = combinedGP / filterRegularSubCount;
          if (rawGPA > 5.00) rawGPA = 5.00;
          dispGPA = rawGPA.toFixed(2);
          dispGrade = getGrade_JS(parseFloat(dispGPA));
        }
      } else { dispGPA = "0.00"; dispGrade = "N/A"; }
      dispAvg = filterTotalSubCount > 0 ? (filterTotalMarks / filterTotalSubCount).toFixed(2) : "0.00";
      dispPos = "N/A";
    }

    var teacherRemark = "";
    if (dispGrade === "F") teacherRemark = `Failed in: ${failReason && failReason !== "None" ? failReason : "Subject(s)"} — Needs Special Care`;
    else if (dispGrade === "A+") teacherRemark = "Outstanding Performance! Keep it up.";
    else if (dispGrade === "A") teacherRemark = "Very Good Result! Strive for A+.";
    else if (dispGrade === "A-") teacherRemark = "Good Performance.";
    else if (dispGrade === "B") teacherRemark = "Satisfactory Result.";
    else teacherRemark = "Needs More Effort & Regular Study.";

    let isDense = rowsHtmlArray.length > 10 || activeTests.length > 2 || activeMains.length > 2;
    var finalTableHtml = "";

    if (rowsHtmlArray.length === 0) {
      finalTableHtml = `<table class="marks-table"><thead>${theadHtml}</thead><tbody><tr><td colspan="8" style="padding:15px; color:#dc2626;">কোনো বিষয়ের নম্বর পাওয়া যায়নি!</td></tr></tbody></table>`;
    } else if (rowsHtmlArray.length > 6) {
      var half = Math.ceil(rowsHtmlArray.length / 2);
      var col1 = rowsHtmlArray.slice(0, half).join("");
      var col2 = rowsHtmlArray.slice(half).join("");
      finalTableHtml = `
        <div class="marks-wrapper">
          <table class="marks-table" style="width: 49.4%;"><thead>${theadHtml}</thead><tbody>${col1}</tbody></table>
          <table class="marks-table" style="width: 49.4%;"><thead>${theadHtml}</thead><tbody>${col2}</tbody></table>
        </div>`;
    } else {
      finalTableHtml = `<div class="marks-wrapper"><table class="marks-table" style="width: 100%;"><thead>${theadHtml}</thead><tbody>${rowsHtmlArray.join("")}</tbody></table></div>`;
    }

    cardsArr.push(`
      <div class="report-card ${isDense ? 'dense-card' : ''}">
        <div class="rc-watermark">SRMS OFFICIAL</div>

        <div class="rc-top-section">
          <div class="school-header">
            <img src="${SCHOOL_LOGO}" class="school-logo" alt="Logo">
            <div class="header-center">
              <h1>SAIDPUR RESIDENTIAL MODEL SCHOOL</h1>
              <p class="school-address">Sultan Nagar, Saidpur, Nilphamari | School Code: 481931 | EMIS Code: 00704061312 | Web: www.srms2012.edu.bd</p>
            </div>
            <div class="transcript-badge-wrap">
              <div class="transcript-title">Academic Transcript — ${examFilter === "All" ? "Final Result" : examFilter} (${year})</div>
              <div class="grade-scale-mini">80-100:A+(5.0) | 70-79:A(4.0) | 60-69:A-(3.5) | 50-59:B(3.0) | 40-49:C(2.0) | 33-39:D(1.0)</div>
            </div>
          </div>

          <table class="student-info">
            <tr>
              <td width="34%">Student Name: <b style="color:#005f40; font-size:11.5px; text-transform:uppercase;">${name}</b></td>
              <td width="22%">Student ID: <b>${id}</b></td>
              <td width="22%">Class: <b>${baseClassName}</b> (${groupName})</td>
              <td width="22%">Roll No: <b>${roll}</b> | Merit: <b>${dispPos}</b></td>
            </tr>
          </table>
          ${legendHtml}
        </div>

        <div class="rc-middle-section">
          ${finalTableHtml}
        </div>

        <div class="rc-bottom-section">
          <div class="summary-box">
            <div class="summary-metrics">
              <span>Total Marks: <b>${filterTotalMarks}</b></span>
              <span>Average: <b>${dispAvg}</b></span>
              <span>GPA: <b style="font-size:15px;">${dispGPA}</b></span>
              <span>Letter Grade: <b style="font-size:15px; color:${dispGrade === 'F' ? '#dc2626' : '#059669'};">${dispGrade}</b></span>
              <span>Merit Position: <b>${dispPos}</b></span>
            </div>
            <p class="remark-text">${teacherRemark}</p>
          </div>

          <div class="footer">
            <div class="signature">Class Teacher</div>
            <div class="signature">Guardian's Signature</div>
            <div class="signature">Principal / Headmaster</div>
          </div>
        </div>
      </div>
    `);
  });

  if (printCount === 0) {
    swalPro.fire('লক্ষ্য করুন', 'প্রিন্ট করার মতো কোনো সম্পূর্ণ ফলাফল পাওয়া যায়নি।', 'warning');
    return;
  }

  executePrint(cardsArr.join(''));
}

