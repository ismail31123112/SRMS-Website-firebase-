async function apiCall(actionName, payloadData = {}) {
  let token = "";
  if (auth.currentUser) {
    try { token = await auth.currentUser.getIdToken(false); } catch (e) {
      try { token = await auth.currentUser.getIdToken(true); } catch (e2) {}
    }
  } else if (SERVER_TOKEN && SERVER_TOKEN.indexOf("serverToken") === -1) {
    token = SERVER_TOKEN;
  }

  let payload = { action: actionName, token: token, ...payloadData };
  let res = await fetch(SCRIPT_URL, {
    method: 'POST',
    body: JSON.stringify(payload),
    headers: { 'Content-Type': 'text/plain;charset=utf-8' }
  });
  let text = await res.text();
  if (text.includes("<html") || text.includes("<body")) {
    throw new Error("সার্ভার সংযোগ ত্রুটি! অনুগ্রহ করে পুনরায় চেষ্টা করুন।");
  }
  let data = JSON.parse(text);
  if (data.status === "error") throw new Error(data.message || data.error);
  return data;
}

