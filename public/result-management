window.editSubjectPopup = async function(subName) {
  var cls = document.getElementById("classSelector").value;
  var parsed = parseSubjectHeaders(cachedHeaders);
  var sub = parsed.subjects[subName];
  if (!sub) return swalPro.fire('ত্রুটি', 'বিষয়টি খুঁজে পাওয়া যায়নি!', 'error');

  showLoader(true, "পরীক্ষার কাঠামো লোড হচ্ছে...");
  let globalExams = [];
  try {
    globalExams = await fetchGlobalExamsFromDB();
    showLoader(false);
  } catch (e) {
    showLoader(false);
    return swalPro.fire('ত্রুটি', e.message, 'error');
  }

  let existingExamMap = {};
  sub.tests.forEach(t => { existingExamMap[t.name] = { type: "Test", fm: t.fm }; });
  sub.mains.forEach(m => { existingExamMap[m.name] = { type: "Main", fm: m.fm }; });

  let combinedExams = [...globalExams];
  Object.keys(existingExamMap).forEach(exN => {
    if (!combinedExams.some(g => g.name === exN)) {
      combinedExams.push({ name: exN, type: existingExamMap[exN].type });
    }
  });

  let examHtml = "";
  if (combinedExams.length === 0) {
    examHtml = `<div style="padding:12px; background:#fffbeb; border:1px dashed #f59e0b; border-radius:10px; font-size:12px; color:#92400e;">কোনো পরীক্ষা তৈরি করা নেই।</div>`;
