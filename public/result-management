<!-- ================= FIREBASE & FRONTEND LOGIC ================= -->
<script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-auth-compat.js"></script>

<script>
// 🚀 🚀 🚀 IMPORTANT: Insert your actual Google Apps Script Web App URL below 🚀 🚀 🚀
const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxxo0od8ZzHy7WaNDUJybjjqcISZf5fJLIN2CG2KiTN3r5f5uyWLclcw-nj4ugrK7_t/exec";

// ✅ Firebase Configuration
const firebaseConfig = {
    apiKey: "AIzaSyBhzidG1s5CsOaiY0RsBG6GJcrE12LLEuU",
    authDomain: "srms-website-management.firebaseapp.com",
    projectId: "srms-website-management"
};
if (!firebase.apps.length) { firebase.initializeApp(firebaseConfig); }
const auth = firebase.auth();

var appData = [];
var cachedHeaders = [];
var SCHOOL_LOGO = "https://i.postimg.cc/9FxBsqsj/IMG-20251220-WA0006.jpg"; 
var isAuthReady = false;

const swalPro = Swal.mixin({ customClass: { confirmButton: 'btn-open', cancelButton: 'btn-danger' }, buttonsStyling: false });

function showLoader(show, text="PROCESSING...") { 
    if(show) { document.getElementById('loaderText').innerHTML = text; document.getElementById('loader').style.display = 'flex'; }
    else { document.getElementById('loader').style.display = 'none'; }
}

// 🌐 BACKEND API CALLER 
async function apiCall(actionName, payloadData = {}) {
    let token = await auth.currentUser.getIdToken(true);
    let payload = { action: actionName, token: token, ...payloadData };
    try {
        let res = await fetch(SCRIPT_URL, {
            method: 'POST', body: JSON.stringify(payload), headers: { 'Content-Type': 'text/plain;charset=utf-8' }
        });
        return await res.json();
    } catch (error) {
        console.error("API Call Failed:", error); throw error;
    }
}

// 🛡️ Security Gate - Check Auth State
auth.setPersistence(firebase.auth.Auth.Persistence.LOCAL)
.then(() => {
    auth.onAuthStateChanged(function(user) {
        if (user) {
            isAuthReady = true;
            showLoader(false);
            document.getElementById('appContainer').style.display = 'block';
        } else {
            showLoader(true, "UNAUTHORIZED ACCESS!<br><span style='font-size:11px; color:#ef4444;'>Redirecting to Login...</span>");
            setTimeout(() => {
                var currentDomain = window.location.protocol + "//" + window.location.host;
                window.location.replace(currentDomain + "/login-panel/teacher-login-portal");
            }, 1000);
        }
    });
})
.catch(err => { console.error("Auth Persistence Error:", err); });

window.onload = function() {
    var yrSelect = document.getElementById("yearSelector");
    var currentYear = new Date().getFullYear();
    for(var i = 2024; i <= 2050; i++) {
        var opt = document.createElement("option");
        opt.value = i; opt.text = i;
        if(i === currentYear) opt.selected = true;
        yrSelect.appendChild(opt);
    }
};

function isOptHeader(h) {
    if (!h) return false;
    var str = String(h).toLowerCase();
    return str.includes("opt") && str.includes("name");
}

function getSafeHeader(h) { return h ? String(h) : ""; }

// 🚀 LOAD DATA (REST API)
async function loadData() {
    if(!isAuthReady) return;
    var className = document.getElementById("classSelector").value;
    if(!className) { swalPro.fire({title: 'Hold On!', text: 'Please select a class first.', icon: 'warning'}); return; }

    showLoader(true, "FETCHING DATA...<br><span style='font-size:11px; color:#64748b;'>Querying Server securely</span>");
    document.getElementById("feature-panel").style.display = "none";
    document.getElementById("student-list-container").innerHTML = "";

    try {
        let res = await apiCall('getData', { className: className });
        showLoader(false);
        if(res.error) { swalPro.fire('Error', res.error, 'error'); return; }
        
        cachedHeaders = res.headers;
        appData = res.data;
        renderStudentCards();
        document.getElementById("feature-panel").style.display = "flex";
    } catch (err) {
        showLoader(false); swalPro.fire('Error', err.message, 'error');
    }
}

// ==========================================
// RENDER APP-STYLE CARDS
// ==========================================
function renderStudentCards() {
    var container = document.getElementById("student-list-container");
    container.innerHTML = "";
    var firstEmpty = cachedHeaders.indexOf("");
    if(appData.length === 0) {
        container.innerHTML = '<div style="grid-column: 1 / -1; text-align:center; padding: 40px; color:#94a3b8;"><i class="fa-solid fa-users-slash fa-3x mb-3"></i><br><h3>No Students Found</h3><p>Ensure students exist in this class database.</p></div>';
        return;
    }

    appData.forEach((row, index) => {
        if(!row[0] && !row[1]) return; 
        var id = row[0] || 'N/A';
        var name = row[1] || 'Unknown Student';
        var roll = row[2] || 'N/A';
        var rowDbId = row[row.length - 1]; // Quick update doc ID
        
        var gpa = firstEmpty !== -1 ? (row[firstEmpty+2] || '0.00') : 'N/A';
        var grade = firstEmpty !== -1 ? (row[firstEmpty+3] || '-') : 'N/A';
        var isFailed = (grade === 'F' || gpa === '0.00');
        var resClass = isFailed ? 'result-mini failed' : 'result-mini';

        var optSubjectsHtml = '';
        if(firstEmpty > 3) {
            var cIdx = 3;
            while(cIdx < firstEmpty && cIdx < cachedHeaders.length) {
                if (isOptHeader(cachedHeaders[cIdx])) {
                    var stuOptName = row[cIdx];
                    if(stuOptName && String(stuOptName).trim() !== "") {
                        optSubjectsHtml += `<span style="background:#fef08a; color:#854d0e; font-size:11px; padding:3px 8px; border-radius:12px; margin-right:5px; font-weight:700; display:inline-block; margin-top:8px; border:1px solid #fde047;"><i class="fa-solid fa-star"></i> ${stuOptName}</span>`;
                    }
                    cIdx += 3;
                } else { cIdx += 2; }
            }
        }
        var optDisplay = optSubjectsHtml !== '' ? `<div>${optSubjectsHtml}</div>` : '';

        var card = document.createElement("div");
        card.className = "student-card";
        card.innerHTML = `
        <div class="card-header">
        <h4><i class="fa-solid fa-user-graduate" style="color:var(--main);"></i> ${name}</h4>
        <span class="roll-badge">Roll: ${roll}</span>
        </div>
        <div class="card-body">
        <p><i class="fa-solid fa-id-badge" style="color:#94a3b8; width:20px;"></i> <b>ID:</b> ${id}</p>
        <div class="${resClass}">
        <span>GPA: ${gpa}</span>
        <span>Grade: ${grade}</span>
        </div>
        ${optDisplay}
        </div>
        <div class="card-footer">
        <button class="btn-edit-marks" onclick="openDataEntryForm(${index})"><i class="fa-solid fa-pen-to-square"></i> Input Marks</button>
        <button class="btn-view-result" onclick="generateSingleResult(${index})"><i class="fa-solid fa-gears"></i> Create Result's</button>
        </div>
        `;
        container.appendChild(card);
    });
}

function getGP_JS(p) { if(p>=80) return 5.00; if(p>=70) return 4.00; if(p>=60) return 3.50; if(p>=50) return 3.00; if(p>=40) return 2.00; if(p>=33) return 1.00; return 0.00; }
function getGrade_JS(g) { if(g>=5.00) return "A+"; if(g>=4.00) return "A"; if(g>=3.50) return "A-"; if(g>=3.00) return "B"; if(g>=2.00) return "C"; if(g>=1.00) return "D"; return "F"; }

function extractSubAndExam(headerText, type) {
    if(!headerText) return { sub: "Unknown", exam: "Exam", isBoardFormat: false };
    var typeReg = type === 'test' ? /-?\s*Test\s*\(\d+\)/gi : /-?\s*Main\s*\(\d+\)/gi;
    var isBoardFormat = headerText.includes("[Board Format");
    var clean = String(headerText).replace(typeReg, '').replace(/\[.*\]/g, '').trim();
    var idx = clean.lastIndexOf(" - ");
    if(idx === -1) idx = clean.lastIndexOf("-"); 

    if(idx !== -1) { return { sub: clean.substring(0, idx).trim(), exam: clean.substring(idx + 1).replace(/^-/,'').trim(), isBoardFormat: isBoardFormat }; }
    return { sub: clean, exam: "Exam", isBoardFormat: isBoardFormat };
}

