function filterStudentCards() {
  let q = (document.getElementById('studentQuickSearch').value || "").toLowerCase().trim();
  let cards = document.querySelectorAll('#student-list-container .student-card');
  cards.forEach(c => {
    let s = c.getAttribute('data-search') || "";
    c.style.display = (!q || s.includes(q)) ? "flex" : "none";
  });
}

function getGP_JS(p) {
  if (p >= 80) return 5.00;
  if (p >= 70) return 4.00;
  if (p >= 60) return 3.50;
  if (p >= 50) return 3.00;
  if (p >= 40) return 2.00;
  if (p >= 33) return 1.00;
  return 0.00;
}
function getGrade_JS(g) {
  if (g >= 5.00) return "A+";
  if (g >= 4.00) return "A";
  if (g >= 3.50) return "A-";
  if (g >= 3.00) return "B";
  if (g >= 2.00) return "C";
  if (g >= 1.00) return "D";
  return "F";
}

function renderExamMarkInputBox(colIdx, examLabel, badgeType, fmInfo, existingValue) {
  let valStr = String(existingValue || "").trim();
  let partsObt = valStr !== "" ? valStr.split('+') : [];
  let fParts = fmInfo.parts || [fmInfo.total, 0, 0];

  let cqMax = fParts[0] || 0;
  let mcqMax = fParts[1] || 0;
  let pracMax = fParts[2] || 0;
  if (cqMax === 0 && mcqMax === 0 && pracMax === 0) cqMax = fmInfo.total;

  let cqVal = partsObt[0] !== undefined ? partsObt[0] : "";
  let mcqVal = partsObt[1] !== undefined ? partsObt[1] : "";
  let pracVal = partsObt[2] !== undefined ? partsObt[2] : "";

  let typeColor = badgeType === "Main" ? "#005f40" : "#0284c7";
  let typeBg = badgeType === "Main" ? "#ecfdf5" : "#f0f9ff";

  let initSum = (parseFloat(cqVal) || 0) + (parseFloat(mcqVal) || 0) + (parseFloat(pracVal) || 0);
  let initSumTxt = (cqVal !== "" || mcqVal !== "" || pracVal !== "") ? initSum : "-";

  return `
    <div style="flex: 1 1 290px; background:${typeBg}; border:1.5px solid #cbd5e1; border-radius:10px; padding:10px;" data-split-col="${colIdx}">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:5px; flex-wrap:wrap; gap:4px;">
        <span style="font-size:12px; font-weight:800; color:${typeColor};">${examLabel} (${badgeType})</span>
        <span style="font-size:10px; font-weight:800; background:#fff; padding:2px 8px; border-radius:10px; border:1px solid #cbd5e1;">
          পূর্ণমান: ${fmInfo.total} (CQ:${cqMax} | MCQ:${mcqMax} | Prac:${pracMax}) • মোট: <b id="live-sum-${colIdx}" style="color:var(--main);">${initSumTxt}</b>
        </span>
      </div>
      <div class="part-grid-row">
        <div class="part-box">
          <label>CQ / লিখিত (${cqMax})</label>
          <input type="number" step="any" min="0" max="${cqMax}" id="edit-cq-${colIdx}" data-max="${cqMax}" data-label="${examLabel} CQ" value="${cqVal}" placeholder="${cqMax > 0 ? '0 - ' + cqMax : 'N/A'}" ${cqMax === 0 ? 'disabled style="background:#f1f5f9; color:#94a3b8;"' : ''} oninput="updateSplitLiveSum(${colIdx})">
        </div>
        <div class="part-box">
          <label>MCQ (${mcqMax})</label>
          <input type="number" step="any" min="0" max="${mcqMax}" id="edit-mcq-${colIdx}" data-max="${mcqMax}" data-label="${examLabel} MCQ" value="${mcqVal}" placeholder="${mcqMax > 0 ? '0 - ' + mcqMax : 'N/A'}" ${mcqMax === 0 ? 'disabled style="background:#f1f5f9; color:#94a3b8;"' : ''} oninput="updateSplitLiveSum(${colIdx})">
        </div>
        <div class="part-box">
          <label>Practical (${pracMax})</label>
          <input type="number" step="any" min="0" max="${pracMax}" id="edit-prac-${colIdx}" data-max="${pracMax}" data-label="${examLabel} Practical" value="${pracVal}" placeholder="${pracMax > 0 ? '0 - ' + pracMax : 'N/A'}" ${pracMax === 0 ? 'disabled style="background:#f1f5f9; color:#94a3b8;"' : ''} oninput="updateSplitLiveSum(${colIdx})">
        </div>
      </div>
    </div>
  `;
}

window.updateSplitLiveSum = function(colIdx) {
  let cqEl = document.getElementById(`edit-cq-${colIdx}`);
  let mcqEl = document.getElementById(`edit-mcq-${colIdx}`);
  let pracEl = document.getElementById(`edit-prac-${colIdx}`);
  let sumEl = document.getElementById(`live-sum-${colIdx}`);
  if (!sumEl) return;

  let v1 = (cqEl && !cqEl.disabled) ? cqEl.value.trim() : "";
  let v2 = (mcqEl && !mcqEl.disabled) ? mcqEl.value.trim() : "";
  let v3 = (pracEl && !pracEl.disabled) ? pracEl.value.trim() : "";

  if (v1 === "" && v2 === "" && v3 === "") {
    sumEl.innerText = "-";
  } else {
    let total = (parseFloat(v1) || 0) + (parseFloat(v2) || 0) + (parseFloat(v3) || 0);
    sumEl.innerText = total;
  }
};

