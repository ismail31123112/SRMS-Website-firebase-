function evaluateStudentSubjectForFilter(row, sub, examFilter, passRatio, testWeight, mainWeight) {
  let tMarks = [];
  let cqs = [], mcqs = [], pracs = [];
  let tCalc = 0, mCalc = 0;
  let hasTest = false, hasMain = false, isSubFail = false;
  let totalTFull = 0, totalMFull = 0;

  sub.tests.forEach(t => {
    if (examFilter === "All" || examFilter === t.name || t.name === "Test") {
      let vStr = String(row[t.col] || "").trim();
      totalTFull += t.fm.total;
      if (vStr !== "") {
        hasTest = true;
        if (vStr.includes("+")) {
          let obtParts = vStr.split('+').map(p => parseFloat(p) || 0);
          let sumT = obtParts.reduce((a, b) => a + b, 0);
          tCalc += sumT;
          tMarks.push(sumT);
        } else {
          let num = parseFloat(vStr) || 0;
          tCalc += num;
          tMarks.push(num);
        }
      }
    }
  });

  sub.mains.forEach(m => {
    if (examFilter === "All" || examFilter === m.name || m.name === "Main") {
      let vStr = String(row[m.col] || "").trim();
      totalMFull += m.fm.total;
      if (vStr !== "") {
        hasMain = true;
        let fullParts = m.fm.parts;
        if (vStr.includes("+") || fullParts.length > 1) {
          let obtParts = vStr.split('+').map(p => parseFloat(p) || 0);
          mCalc += obtParts.reduce((a, b) => a + b, 0);

          let p = vStr.split("+");
          cqs.push(p[0] !== undefined && p[0] !== "" ? p[0] : "0");
          mcqs.push((fullParts.length > 1 && fullParts[1] > 0) ? (p[1] || "0") : "-");
          pracs.push((fullParts.length > 2 && fullParts[2] > 0) ? (p[2] || "0") : "-");

          if (fullParts.length > 0 && fullParts[0] > 0 && (obtParts[0] || 0) < Math.ceil(fullParts[0] * passRatio)) isSubFail = true;
          else if (fullParts.length > 1 && fullParts[1] > 0 && (obtParts[1] || 0) < Math.ceil(fullParts[1] * passRatio)) isSubFail = true;
          else if (fullParts.length > 2 && fullParts[2] > 0 && (obtParts[2] || 0) < Math.ceil(fullParts[2] * passRatio)) isSubFail = true;
        } else {
          mCalc += parseFloat(vStr) || 0;
          cqs.push(vStr);
          mcqs.push("-");
          pracs.push("-");
        }
      }
    }
  });

  let finalMark = 0;
  if (hasTest || hasMain) {
    if (hasTest && hasMain && totalTFull > 0 && totalMFull > 0) {
      finalMark = Math.round(((tCalc / totalTFull) * testWeight) + ((mCalc / totalMFull) * mainWeight));
    } else if (!hasTest && hasMain && totalMFull > 0) {
      finalMark = Math.round((mCalc / totalMFull) * 100);
    } else if (hasTest && !hasMain && totalTFull > 0) {
      finalMark = Math.round((tCalc / totalTFull) * 100);
    }
    if (!isSubFail && finalMark < Math.ceil(100 * passRatio)) isSubFail = true;
  }

  let subGP = getGP_JS(finalMark);
  let subGrade = getGrade_JS(subGP);
  if (isSubFail || subGP === 0) {
    subGP = 0.00;
    subGrade = "F";
  }

  return {
    attended: hasTest || hasMain,
    hasTest,
    hasMain,
    tMarks,
    cqs,
    mcqs,
    pracs,
    tCalc,
    mCalc,
    finalMark,
    subGP,
    subGrade,
    isSubFail
  };
}

