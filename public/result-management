<style>
/* === Global Styles & Theme === */
:root { --main: #005f40; --main-dark: #003d29; --gold: #f59e0b; --bg: #f4f6f9; }
body { font-family: 'Poppins', sans-serif; background-color: var(--bg); padding: 20px; margin: 0; color: #333; }
@keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
@keyframes spin { 100% { transform: rotate(360deg); } }

.loader-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px); z-index: 9999; display: flex; flex-direction: column; justify-content: center; align-items: center; }
.spinner { width: 60px; height: 60px; border: 5px solid #e2e8f0; border-top: 5px solid var(--main); border-radius: 50%; animation: spin 1s cubic-bezier(0.55, 0.15, 0.45, 0.85) infinite; margin-bottom: 15px; }
.loader-text { font-weight: 800; color: var(--main); font-size: 16px; letter-spacing: 1px; text-align: center; }

#appContainer { display: none; }
.app-header { background: #ffffff; padding: 20px 25px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0, 95, 64, 0.08); margin-bottom: 20px; border-top: 6px solid var(--main); animation: fadeInUp 0.5s ease-out forwards; }
.header-title { display: flex; align-items: center; justify-content: space-between; margin-bottom: 15px; flex-wrap: wrap; gap: 10px; }
.header-title h2 { margin: 0; color: var(--main); font-size: 24px; font-weight: 900; text-transform: uppercase; display: flex; align-items: center; gap: 10px; }

.control-group { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.weight-controls { display: flex; gap: 10px; align-items: center; background: #f8fafc; padding: 10px 15px; border-radius: 12px; border: 1px solid #e2e8f0; }
.weight-controls input { border: 1px solid #cbd5e1; border-radius: 6px; padding: 6px; font-weight: bold; color: var(--main); width: 50px; text-align: center; }
input[type=number]::-webkit-inner-spin-button, input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }

select, button { padding: 12px 18px; border-radius: 12px; font-size: 13px; font-weight: 700; font-family: 'Poppins', sans-serif; cursor: pointer; border: 1.5px solid #e2e8f0; outline: none; transition: 0.3s; background: #fff;}
select:focus { border-color: var(--main); box-shadow: 0 0 0 3px rgba(0, 95, 64, 0.1);}
button { border: none; display: flex; align-items: center; justify-content: center; gap: 8px; color: white;}
button:hover { transform: translateY(-2px); box-shadow: 0 6px 15px rgba(0,0,0,0.15); }

.btn-open { background: linear-gradient(135deg, var(--main), var(--main-dark)); }
.btn-reset { background: linear-gradient(135deg, #ef4444, #b91c1c); }
.btn-tool { background: linear-gradient(135deg, #475569, #1e293b); }
.btn-add-sub { background: linear-gradient(135deg, #8b5cf6, #6d28d9); }
.btn-calc { background: linear-gradient(135deg, #2563eb, #1d4ed8); font-weight: 900;}
.btn-print { background: linear-gradient(135deg, #1f2937, #111827); }
.btn-report { background: linear-gradient(135deg, var(--gold), #b45309); }
.btn-publish { background: linear-gradient(135deg, #10b981, #047857); font-weight: 900;}
.btn-back { background: linear-gradient(135deg, #64748b, #475569); }

#feature-panel { display: none; gap: 12px; align-items: center; flex-wrap: wrap; border-top: 1px dashed #cbd5e1; padding-top: 20px; margin-top: 15px; }

/* === NEW APP STYLE LIST VIEW === */
#student-list-container { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; margin-top: 20px; animation: fadeInUp 0.5s ease; }
.student-card { background: white; border-radius: 16px; box-shadow: 0 4px 15px rgba(0, 95, 64, 0.05); border: 1px solid #e2e8f0; overflow: hidden; transition: 0.3s; display: flex; flex-direction: column; }
.student-card:hover { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(0, 95, 64, 0.1); border-color: #cbd5e1; }
.card-header { background: #f8fafc; padding: 15px 20px; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; }
.card-header h4 { margin: 0; color: var(--main); font-size: 16px; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 70%; }
.roll-badge { background: var(--main); color: white; font-size: 11px; font-weight: bold; padding: 4px 10px; border-radius: 12px; }
.card-body { padding: 20px; flex-grow: 1; }
.card-body p { margin: 0 0 10px 0; font-size: 13px; color: #475569; font-weight: 500;}
.result-mini { display: flex; justify-content: space-between; background: #f0fdf4; border: 1px solid #bbf7d0; padding: 10px; border-radius: 8px; font-size: 13px; font-weight: 800; color: #166534; }
.result-mini.failed { background: #fef2f2; border-color: #fecaca; color: #991b1b; }
.result-mini.incomp { background: #fffbeb; border-color: #fde68a; color: #b45309; }
.card-footer { padding: 15px 20px; background: #f8fafc; border-top: 1px solid #e2e8f0; display: flex; gap: 10px; }
.btn-edit-marks { background: linear-gradient(135deg, #0ea5e9, #0284c7); color: white; flex-grow: 1; border-radius: 10px; padding: 12px; font-size: 14px;}
.btn-view-result { background: linear-gradient(135deg, var(--main), var(--main-dark)); color: white; flex-grow: 1; border-radius: 10px; padding: 12px; font-size: 14px;}

@media (max-width: 768px) {
body { padding: 10px; }
.control-group, #feature-panel { justify-content: center; }
button { flex: 1 1 45%; font-size: 12px; padding: 8px 10px; }
.mobile-swal { width: 95% !important; padding: 10px; }
#student-list-container { grid-template-columns: 1fr; }
}

/* =========================================
PRINT AREA (STRICT LANDSCAPE A4) 
========================================= */
#print-area { display: none; }

@media print {
.app-header, #student-list-container, .loader-overlay, .swal2-container { display: none !important; }
body { background: white; margin: 0; padding: 0; -webkit-print-color-adjust: exact; font-family: 'Poppins', sans-serif; }
#print-area { display: block !important; width: 100%; }
@page { size: A4 landscape; margin: 5mm; }

.report-card { width: 100%; height: 98vh; max-height: 98vh; page-break-after: always; box-sizing: border-box; display: flex; flex-direction: column; border: 2px solid #005f40; padding: 10px 15px; border-radius: 8px; background: #fff; overflow: hidden; }
.school-header { display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #005f40; padding-bottom: 5px; margin-bottom: 8px; }
.school-logo { width: 65px; height: auto; object-fit: contain;}
.header-center { text-align: center; flex-grow: 1; }
.header-center h1 { margin: 0; font-size: 22px; text-transform: uppercase; color: #005f40; font-weight: 800; letter-spacing: 1.5px; }
.school-address { font-size: 11px; font-weight: 500; color: #333; margin: 2px 0 0 0; }
.transcript-title { background: #005f40; color: white; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; }

.student-info { width: 100%; margin-bottom: 8px; font-size: 11px; font-weight: 600; border: 1px solid #ccc; border-radius: 6px; padding: 4px; background: #f8fafc !important; border-collapse: collapse; }
.student-info td { padding: 4px 8px; }

.legend-box { width: 100%; border: 1px dashed #005f40; padding: 5px; font-size: 9px; font-weight: bold; color: #005f40; text-align: center; margin-bottom: 8px; border-radius: 4px; background: #f0fdf4 !important; }

.marks-wrapper { display: flex; justify-content: space-between; gap: 10px; width: 100%; flex-grow: 1; align-items: flex-start; overflow: hidden; }
.marks-table { width: 100%; border-collapse: collapse; font-size: 10px; } 
.marks-table th, .marks-table td { border: 1px solid #333; padding: 3px 2px; text-align: center; word-wrap: break-word; }
.marks-table th { background-color: #e2e8f0 !important; font-weight: 700; color: #005f40; font-size: 10px; }
.marks-table td.sub-name { text-align: left; padding-left: 6px; font-weight: 700; }
.marks-table td.exam-name { font-weight: 600; color: #1e293b; background: #f8fafc !important; font-size: 9px; }

.summary-box { border: 2px solid #005f40; padding: 6px; width: 90%; margin: 5px auto; text-align: center; border-radius: 6px; background: #f0fdf4 !important; }
.remark-text { font-size: 12px; font-weight: 700; color: #dc2626; margin: 4px 0 0 0; }
.footer { display: flex; justify-content: space-between; margin-top: auto; padding-top: 15px; }
.signature { border-top: 1.5px solid #333; width: 150px; text-align: center; padding-top: 4px; font-weight: 700; font-size: 11px; color: #333; }

/* --- TABULATION SPECIFIC CSS --- */
.tabulation-print { width: 100%; font-family: 'Poppins', sans-serif; }
.tab-table { width: 100%; border-collapse: collapse; font-size: 10px; text-align: center; table-layout: auto; word-wrap: break-word; }
.tab-table th.vert-header { background: #e2e8f0 !important; padding: 10px 4px; border: 1px solid #1e293b; font-weight: bold; color: #005f40; font-size: 9px; writing-mode: vertical-rl; transform: rotate(180deg); height: 100px; white-space: nowrap;}
.tab-table th { background: #e2e8f0 !important; padding: 6px 3px; border: 1px solid #1e293b; font-weight: bold; color: #005f40; font-size: 9px; }
.tab-table td { padding: 6px 3px; border: 1px solid #1e293b; overflow: hidden; vertical-align: middle; }
.tab-table tr { page-break-inside: avoid; }
.tab-table tbody tr:nth-child(even) { background-color: #f8fafc !important; }
thead { display: table-header-group; }
}

@media print and (orientation: portrait) {
#print-area { display: none !important; }
body::before { content: "⚠️ PRINT ERROR: Please change the layout to 'Landscape' in your print settings."; display: flex; align-items: center; justify-content: center; height: 50vh; text-align: center; font-size: 24px; font-family: 'Poppins', sans-serif; font-weight: 800; color: #dc2626; padding: 40px; border: 4px dashed #dc2626; margin: 50px; background-color: #fef2f2; border-radius: 10px; }
}
</style>
