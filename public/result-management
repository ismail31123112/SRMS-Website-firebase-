function generateVerifyHash(id, cls, yr, gpa, grade, totalMarks) {
  let raw = `SRMS|${id}|${cls}|${yr}|${gpa}|${grade}|${totalMarks}|2012`;
  let h1 = 0x811c9dc5;
  for (let i = 0; i < raw.length; i++) {
    h1 ^= raw.charCodeAt(i);
    h1 = Math.imul(h1, 0x01000193);
  }
  return ("00000000" + (h1 >>> 0).toString(16)).slice(-8).toUpperCase();
}

function createVerificationQrSvg(verifyUrl) {
  try {
    if (typeof qrcode === "function") {
      let qr = qrcode(0, 'M');
      qr.addData(verifyUrl);
      qr.make();
      return qr.createSvgTag({ cellSize: 2, margin: 0, scalable: true });
    }
  } catch (e) {}
  return `<img src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=${encodeURIComponent(verifyUrl)}" style="width:100%;height:100%;" alt="QR">`;
}

function generateMarkSheets(examFilter) {
  recalculateClassStatsInMemory();
  var data = appData;
  var parsed = parseSubjectHeaders(cachedHeaders);
  var firstEmpty = parsed.firstEmpty;
  var rawClassName = document.getElementById("classSelector").value;
  var year = document.getElementById("yearSelector").value;
  var passRatio = (parseFloat(document.getElementById('genPass').value) || 33) / 100;
  var testWeight = parseFloat(document.getElementById('testWeight').value) || 25;
  var mainWeight = parseFloat(document.getElementById('mainWeight').value) || 75;

  var groupName = "General";
  var baseClassName = rawClassName;
  if (rawClassName.includes("Science")) { groupName = "Science"; baseClassName = rawClassName.replace(" Science", ""); }
  else if (rawClassName.includes("Arts")) { groupName = "Arts"; baseClassName = rawClassName.replace(" Arts", ""); }
  else if (rawClassName.includes("Commerce")) { groupName = "Commerce"; baseClassName = rawClassName.replace(" Commerce", ""); }

  // 1. Pre-compute Class Overview Statistics across all evaluated students
  let classStats = {
    totalStudents: 0,
    evaluatedStudents: 0,
    passed: 0,
    failed: 0,
    highestMarks: 0,
    gpaSum: 0,
    grades: { 'A+': 0, 'A': 0, 'A-': 0, 'B': 0, 'C': 0, 'D': 0, 'F': 0 }
  };

  let studentEvaluations = [];

  data.forEach(row => {
    if (!row[0] && !row[1]) return;
    classStats.totalStudents++;

    let subRows = [];
    let filterTotalMarks = 0;
    let filterTotalRegularGP = 0;
    let filterOptExtraGP = 0;
    let filterRegularSubCount = 0;
    let filterTotalSubCount = 0;
    let filterIsFail = false;
    let failedSubNames = [];

    Object.keys(parsed.subjects).forEach(subName => {
      let sub = parsed.subjects[subName];
      let actualSubName = sub.isOpt
        ? (row[sub.nameCol] || subName) + " <span style='font-size:8.5px; font-weight:700; color:#b45309;'>(4th)</span>"
        : subName;

      let ev = evaluateStudentSubjectForFilter(row, sub, examFilter, passRatio, testWeight, mainWeight);
      if (ev.attended) {
        if (ev.isSubFail && !sub.isOpt) {
          filterIsFail = true;
          failedSubNames.push(subName);
        }
        if (sub.isOpt && !ev.isSubFail && ev.subGP > 2.00) {
          filterOptExtraGP += (ev.subGP - 2.00);
        } else if (!sub.isOpt) {
          filterTotalRegularGP += ev.isSubFail ? 0 : ev.subGP;
          filterRegularSubCount++;
        }
        filterTotalMarks += ev.finalMark;
        filterTotalSubCount++;
        subRows.push({ actualSubName, ev });
      }
    });

    if (filterTotalSubCount === 0) return;
    let savedGrade = row[firstEmpty + 3];
    if (savedGrade === "Incomplete") return;

    let liveGPA = "0.00";
    let liveGrade = "F";
    if (filterRegularSubCount > 0) {
      if (filterIsFail) {
        liveGPA = "0.00";
        liveGrade = "F";
      } else {
        let combinedGP = filterTotalRegularGP + filterOptExtraGP;
        let rawGPA = combinedGP / filterRegularSubCount;
        if (rawGPA > 5.00) rawGPA = 5.00;
        liveGPA = rawGPA.toFixed(2);
        liveGrade = getGrade_JS(parseFloat(liveGPA));
      }
    }

    let liveAvg = (filterTotalMarks / filterTotalSubCount).toFixed(2);
    let savedPos = row[firstEmpty + 4] || "N/A";
    let dispPos = (examFilter === "All" && !filterIsFail) ? savedPos : "N/A";

    classStats.evaluatedStudents++;
    if (liveGrade === "F") {
      classStats.failed++;
      classStats.grades['F']++;
    } else {
      classStats.passed++;
      if (classStats.grades[liveGrade] !== undefined) classStats.grades[liveGrade]++;
    }
    if (filterTotalMarks > classStats.highestMarks) classStats.highestMarks = filterTotalMarks;
    classStats.gpaSum += parseFloat(liveGPA) || 0;

    studentEvaluations.push({
      row,
      subRows,
      filterTotalMarks,
      filterTotalSubCount,
      liveAvg,
      liveGPA,
      liveGrade,
      dispPos,
      failedSubNames
    });
  });

  if (studentEvaluations.length === 0) {
    swalPro.fire('লক্ষ্য করুন', 'প্রিন্ট করার মতো কোনো সম্পূর্ণ ফলাফল পাওয়া যায়নি।', 'warning');
    return;
  }

  let classPassRate = classStats.evaluatedStudents > 0
    ? ((classStats.passed / classStats.evaluatedStudents) * 100).toFixed(1)
