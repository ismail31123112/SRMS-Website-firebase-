    var firstEmpty = parsed.firstEmpty;
    var rawClassName = document.getElementById("classSelector").value;
    var year = document.getElementById("yearSelector").value;
    var passRatio = (parseFloat(document.getElementById('genPass').value) || 33) / 100;

    var groupName = "N/A"; var baseClassName = rawClassName;
    if(rawClassName.includes("Science")) { groupName = "Science"; baseClassName = rawClassName.replace(" Science", ""); }
    else if(rawClassName.includes("Arts")) { groupName = "Arts"; baseClassName = rawClassName.replace(" Arts", ""); }
    else if(rawClassName.includes("Commerce")) { groupName = "Commerce"; baseClassName = rawClassName.replace(" Commerce", ""); }

    var printHtml = "";
    var theadHtml = `<tr>
    <th width="22%">Subject</th>
    <th width="15%">Test Mark(s)</th>
    <th width="27%">Main Exam (CQ+MCQ+Prac)</th>
    <th width="12%">Total</th>
    <th width="12%">Grade</th>
    <th width="12%">GP</th>
    </tr>`;

    let activeTests = []; let activeMains = [];
    parsed.testSeq.forEach(t => { if(examFilter === "All" || t === examFilter) activeTests.push(t); });
    parsed.mainSeq.forEach(m => { if(examFilter === "All" || m === examFilter) activeMains.push(m); });
    var legendHtml = `<div class="legend-box"><b>Exams Reference:</b> [ Tests Sequence: ${activeTests.join(", ") || "None"} | Mains Sequence: ${activeMains.join(", ") || "None"} ]</div>`;

    try {
        let printCount = 0;
        data.forEach(row => {
            if(!row[0] && !row[1]) return; 
            var grade = row[firstEmpty+3]; 
            if(grade === "Incomplete") return; 
            printCount++;

            var id = row[0]; var name = row[1]; var roll = row[2];
            var totalAvg = row[firstEmpty+1]; var gpa = row[firstEmpty+2]; var pos = row[firstEmpty+4];
            var failReason = row[firstEmpty+5];
            
            if(!gpa || gpa === "") { gpa = "0.00"; grade = "F"; totalAvg = "0.00"; pos = "N/A"; }

            var teacherRemark = "";
            if(grade === "F") teacherRemark = `Failed in: ${failReason && failReason !== "None" ? failReason : "Subjects"}. Needs special care.`;
            else if(grade === "A+") teacherRemark = "Outstanding! Keep it up.";
            else if(grade === "A") teacherRemark = "Very Good!";
            else if(grade === "A-") teacherRemark = "Good performance.";
            else if(grade === "B") teacherRemark = "Satisfactory.";
            else if(grade === "C") teacherRemark = "Average result.";
            else if(grade === "D") teacherRemark = "Needs improvement.";

            var rowsHtmlArray = [];
            var filterTotalMarks = 0; var filterTotalRegularGP = 0; var filterOptExtraGP = 0;
            var filterRegularSubCount = 0; var filterTotalSubCount = 0; var filterIsFail = false;

            Object.keys(parsed.subjects).forEach(subName => {
                let sub = parsed.subjects[subName];
                let actualSubName = sub.isOpt ? (row[sub.nameCol] || "Optional") + " (Opt)" : subName;
                
                let tMarks = []; let mMarks = []; let tCalc = 0; let mCalc = 0;
                let hasTest = false; let hasMain = false; let isSubFail = false;
                let totalTFull = 0; let totalMFull = 0;

                sub.tests.forEach(t => { 
                    if(examFilter === "All" || examFilter === t.name || t.name === "Test") {
                        let v = parseFloat(row[t.col]); 
                        if(!isNaN(v)) { tMarks.push(v); tCalc += v; hasTest = true; } else { tMarks.push("-"); }
                        let fullMatch = (cachedHeaders[t.col]||"").match(/\((\d+)\)/); totalTFull += fullMatch ? parseInt(fullMatch[1]) : 50;
                    }
                });

                sub.mains.forEach(m => { 
                    if(examFilter === "All" || examFilter === m.name || m.name === "Main") {
                        let vStr = String(row[m.col] || "").trim();
                        if(vStr !== "") {
                            mMarks.push(vStr); hasMain = true;
                            if(vStr.includes("+")) {
                                let obtParts = vStr.split('+').map(p=>parseFloat(p)||0);
                                mCalc += obtParts.reduce((a,b)=>a+b, 0);
                                let mFullMatch = (cachedHeaders[m.col]||"").match(/\((\d+)\+?(\d+)?\+?(\d+)?\)/); 
                                if(mFullMatch) {
                                    let fullParts = mFullMatch[0].replace(/[()]/g, '').split('+').map(p=>parseInt(p)||0);
                                    if(fullParts.length > 0 && obtParts[0] < Math.ceil(fullParts[0] * passRatio)) isSubFail = true;
                                    else if(fullParts.length > 1 && obtParts[1] < Math.ceil(fullParts[1] * passRatio)) isSubFail = true;
                                    else if(fullParts.length > 2 && fullParts[2] > 0 && obtParts[2] < Math.ceil(fullParts[2] * passRatio)) isSubFail = true;
                                }
                            } else { mCalc += parseFloat(vStr) || 0; }
                        } else { mMarks.push("-"); }
                        
                        let mFMatch = (cachedHeaders[m.col]||"").match(/\((\d+)\+?(\d+)?\+?(\d+)?\)/); 
                        totalMFull += mFMatch ? mFMatch[0].replace(/[()]/g, '').split('+').reduce((a,b)=>a+(parseInt(b)||0), 0) : 100;
                    }
                });

                if(hasTest || hasMain) {
                    let finalMark = 0;
                    let testWeight = parseFloat(document.getElementById('testWeight').value) || 25;
                    let mainWeight = parseFloat(document.getElementById('mainWeight').value) || 75;

                    if (hasTest && hasMain) finalMark = Math.round(((tCalc / totalTFull) * testWeight) + ((mCalc / totalMFull) * mainWeight));
                    else if (!hasTest && hasMain) finalMark = Math.round((mCalc / totalMFull) * 100);
                    else if (hasTest && !hasMain) finalMark = Math.round((tCalc / totalTFull) * 100);

                    if(!isSubFail && finalMark < Math.ceil(100 * passRatio)) isSubFail = true;
                    var subGP = getGP_JS(finalMark); var subGrade = getGrade_JS(subGP);
                    if(isSubFail) { subGrade = "F"; filterIsFail = true; }
                    
                    if(sub.isOpt && subGP > 2.00) filterOptExtraGP += (subGP - 2.00);
                    else if (!sub.isOpt) { filterTotalRegularGP += subGP; filterRegularSubCount++; }
                    
                    filterTotalMarks += finalMark; filterTotalSubCount++;

                    rowsHtmlArray.push(`<tr><td class="sub-name">${actualSubName}</td>
                    <td class="exam-name">${tMarks.join(", ")}</td>
                    <td class="exam-name">${mMarks.join(", ")}</td>
                    <td>${finalMark}</td>
                    <td><strong>${subGrade}</strong></td><td><strong>${subGP.toFixed(2)}</strong></td></tr>`);
                }
            });

            // Filter Re-Calc
            let dispGPA = gpa; let dispGrade = grade; let dispAvg = totalAvg; let dispPos = pos;
            if(examFilter !== "All") {
                if(filterRegularSubCount > 0) {
                    if (filterIsFail) { dispGPA = "0.00"; dispGrade = "F"; } 
                    else {
                        let combinedGP = filterTotalRegularGP + filterOptExtraGP;
                        let rawGPA = combinedGP / filterRegularSubCount; 
                        if (rawGPA > 5.00) rawGPA = 5.00; 
                        dispGPA = rawGPA.toFixed(2);
                        dispGrade = getGrade_JS(parseFloat(dispGPA));
                    }
                } else { dispGPA = "0.00"; dispGrade = "N/A"; }
                dispAvg = filterTotalSubCount > 0 ? (filterTotalMarks / filterTotalSubCount).toFixed(2) : "0.00";
                dispPos = "N/A"; 
            }

            var finalTableHtml = "";
            if(rowsHtmlArray.length === 0) {
                finalTableHtml = `<table class="marks-table"><thead>${theadHtml}</thead><tbody><tr><td colspan="6" style="padding:15px; color:#dc2626;">No Subject Data Found for ${examFilter}!</td></tr></tbody></table>`;
            } else if(rowsHtmlArray.length > 12) {
                var half = Math.ceil(rowsHtmlArray.length / 2);
                var col1 = rowsHtmlArray.slice(0, half).join("");
                var col2 = rowsHtmlArray.slice(half).join("");
                finalTableHtml = `<div class="marks-wrapper"><table class="marks-table" style="width: 49%;"><thead>${theadHtml}</thead><tbody>${col1}</tbody></table><table class="marks-table" style="width: 49%;"><thead>${theadHtml}</thead><tbody>${col2}</tbody></table></div>`;
            } else {
                finalTableHtml = `<div class="marks-wrapper"><table class="marks-table"><thead>${theadHtml}</thead><tbody>${rowsHtmlArray.join("")}</tbody></table></div>`;
            }

            printHtml += `
            <div class="report-card">
            <div class="school-header">
            <img src="${SCHOOL_LOGO}" class="school-logo" alt="School Logo">
            <div class="header-center">
            <h1>SAIDPUR RESIDENTIAL MODEL SCHOOL</h1>
            <p class="school-address">Sultan Nagar, Saidpur, Nilphamari | School Code: 481931 | EMIS Code: 00704061312</p>
            <p class="school-address">Email: info@srms2012.edu.bd | Web: www.srms2012.edu.bd</p>
            </div>
            <div class="transcript-title">Academic Transcript - ${examFilter === "All" ? "Final Result" : examFilter} (${year})</div>
            </div>

            <table class="student-info">
            <tr><td width="33%"><strong>Student Name:</strong> ${name}</td><td width="33%"><strong>Class:</strong> ${baseClassName}</td><td width="33%"><strong>Group:</strong> ${groupName}</td></tr>
            <tr><td><strong>Student ID:</strong> ${id}</td><td><strong>Roll Number:</strong> ${roll}</td><td></td></tr>
            </table>
            
            ${legendHtml}
            ${finalTableHtml}

            <div class="summary-box">
            <div style="display: flex; justify-content: space-around; margin-bottom: 5px; font-size: 15px; font-weight: 800; color: #005f40; flex-wrap: wrap;">
            <span>Total Avg: ${dispAvg}</span>
            <span>GPA: ${dispGPA}</span>
            <span>Grade: <span style="color:${dispGrade==='F'?'#dc2626':'#16a34a'};">${dispGrade}</span></span>
            <span>Position: ${dispPos}</span>
            </div>
            <p class="remark-text">Remark: ${teacherRemark}</p>
            </div>

            <div class="footer"><div class="signature">Class Teacher</div><div class="signature">Headmaster</div><div class="signature">Guardian</div></div>
            </div>`;
        });
        
        if (printCount === 0) { swalPro.fire('Warning', 'No completed results to print. Only calculating results will be printed.', 'warning'); return; }
        document.getElementById("print-area").innerHTML = printHtml;
        window.print();
    } catch (err) { swalPro.fire('Error Generating Marksheet', err.message, 'error'); }
}

// ==========================================
// TABULATION GENERATOR
// ==========================================
async function printTabulation() {
    if(appData.length === 0) { swalPro.fire('Error', 'Load data first', 'error'); return; }
    var cls = document.getElementById("classSelector").value;
    var year = document.getElementById("yearSelector").value;
    
    var parsed = parseSubjectHeaders(cachedHeaders);
    var firstEmpty = parsed.firstEmpty;
    if (firstEmpty === -1) { swalPro.fire('Error', 'Format is broken. Fix format first.', 'error'); return; }

    var stats = {'A+': 0, 'A': 0, 'A-': 0, 'B': 0, 'C': 0, 'D': 0, 'F': 0, 'Total': 0};
    appData.forEach(row => {
        if(!row[0] && !row[1]) return;
        stats['Total']++;
        var g = row[firstEmpty + 3];
        if(g === 'Incomplete') return; 
        if(g === 'A+') stats['A+']++; else if(g === 'A') stats['A']++; else if(g === 'A-') stats['A-']++; else if(g === 'B') stats['B']++; else if(g === 'C') stats['C']++; else if(g === 'D') stats['D']++; else stats['F']++; 
    });

    var passed = stats['Total'] - stats['F'];
    var passRate = stats['Total'] > 0 ? ((passed / stats['Total']) * 100).toFixed(2) : "0.00";

    var printHtml = `<div class="tabulation-print" style="padding-top: 10px;">
    <div style="text-align:center; margin-bottom: 15px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
    <img src="${SCHOOL_LOGO}" alt="School Logo" style="height: 60px; margin-bottom: 8px;">
    <h1 style="margin:0; font-size:22px; color:#005f40; text-transform:uppercase; font-weight:900;">SAIDPUR RESIDENTIAL MODEL SCHOOL</h1>
    <h3 style="margin:2px 0 0 0; color:#333; font-size:15px; font-weight:bold;">Master Tabulation Sheet - ${cls} | Year: ${year}</h3>
    </div>
    <table class="tab-table">
    <thead>
    <tr>
    <th style="width:4%; padding:6px 2px;">ID</th>
    <th style="width:12%; text-align:left; padding-left:5px;">Student Name</th>
    <th style="width:4%;">Roll</th>`;

    Object.keys(parsed.subjects).forEach(subName => {
        let sub = parsed.subjects[subName];
        let htmlLabel = `${subName}<br><span style="font-size:8px; font-weight:normal;">[${sub.isOpt ? 'Opt' : 'Comp'}]</span>`;
        printHtml += `<th class="vert-header">${htmlLabel}</th>`;
    });

    printHtml += `<th style="background:#e2e8f0 !important;">Avg</th>
    <th style="background:#e2e8f0 !important;">GPA</th>
    <th style="background:#e2e8f0 !important;">Grade</th>
    <th style="background:#e2e8f0 !important;">Pos</th>
    </tr></thead><tbody>`;

    appData.forEach(row => {
        if(!row[0] && !row[1]) return;
        printHtml += `<tr><td>${row[0]||'-'}</td><td style="text-align:left; padding-left:5px; font-weight:bold;">${row[1]||'-'}</td><td>${row[2]||'-'}</td>`;
        
        Object.keys(parsed.subjects).forEach(subName => {
            let sub = parsed.subjects[subName];
            let tMarks = []; let mMarks = [];
            
            sub.tests.forEach(t => { let v = parseFloat(row[t.col]); if(!isNaN(v)) tMarks.push(v); });
            sub.mains.forEach(m => { let v = String(row[m.col]||"").trim(); if(v!=="") mMarks.push(v); });
            
            var cellHtml = "";
            if (sub.isOpt) {
                var optName = row[sub.nameCol] && row[sub.nameCol].trim() !== "" ? row[sub.nameCol] : 'N/A';
                cellHtml = `<span style="display:block; font-size:8px; color:#005f40; line-height:1; margin-bottom:2px; font-weight:bold;">${optName}</span>`;
            }

            if(mMarks.length > 0 && tMarks.length > 0) { cellHtml += `<b>M:${mMarks.join(",")}</b><br><span style="font-size:8px; color:#64748b;">T:${tMarks.join(",")}</span>`; }
            else if(mMarks.length > 0) { cellHtml += `<b>M:${mMarks.join(",")}</b>`; }
            else if(tMarks.length > 0) { cellHtml += `<span style="font-size:9px; color:#dc2626;">T:${tMarks.join(",")}</span>`; }
            else { cellHtml += `-`; }

            printHtml += `<td>${cellHtml}</td>`;
        });

        printHtml += `<td>${row[firstEmpty+1]||'-'}</td>
        <td><strong>${row[firstEmpty+2]||'-'}</strong></td>
        <td><strong style="color:${row[firstEmpty+3]==='F'?'#dc2626':'#16a34a'};">${row[firstEmpty+3]||'-'}</strong></td>
        <td>${row[firstEmpty+4]||'-'}</td></tr>`;
    });
    printHtml += `</tbody></table>`;

    printHtml += `
    <div style="margin-top: 25px; border: 2px solid #005f40; border-radius: 8px; overflow: hidden; page-break-inside: avoid; width: 80%; margin-left: auto; margin-right: auto;">
    <div style="background: #e2e8f0; color: #005f40; padding: 6px; text-align: center; font-weight: bold; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; border-bottom: 2px solid #005f40;">Class Result Summary & Grade Statistics</div>
    <table style="width: 100%; border-collapse: collapse; font-size: 12px; text-align: center;">
    <tr style="font-weight: bold; color: #005f40;">
    <td style="border: 1px solid #005f40; padding: 6px;">Total Students</td>
    <td style="border: 1px solid #005f40; padding: 6px;">Passed</td>
    <td style="border: 1px solid #005f40; padding: 6px;">Failed</td>
    <td style="border: 1px solid #005f40; padding: 6px;">Pass Rate</td>
    <td style="border: 1px solid #005f40; padding: 6px;">A+</td>
    <td style="border: 1px solid #005f40; padding: 6px;">A</td>
    <td style="border: 1px solid #005f40; padding: 6px;">A-</td>
    <td style="border: 1px solid #005f40; padding: 6px;">B</td>
    <td style="border: 1px solid #005f40; padding: 6px;">C</td>
    <td style="border: 1px solid #005f40; padding: 6px;">D</td>
    </tr>
    <tr>
    <td style="border: 1px solid #005f40; padding: 8px; font-weight: bold; font-size:14px;">${stats['Total']}</td>
    <td style="border: 1px solid #005f40; padding: 8px; font-weight: bold; font-size:14px; color:#166534;">${passed}</td>
    <td style="border: 1px solid #005f40; padding: 8px; font-weight: bold; font-size:14px; color:#dc2626;">${stats['F']}</td>
    <td style="border: 1px solid #005f40; padding: 8px; font-weight: bold; font-size:14px;">${passRate}%</td>
    <td style="border: 1px solid #005f40; padding: 8px; font-weight: bold;">${stats['A+']}</td>
    <td style="border: 1px solid #005f40; padding: 8px; font-weight: bold;">${stats['A']}</td>
    <td style="border: 1px solid #005f40; padding: 8px; font-weight: bold;">${stats['A-']}</td>
    <td style="border: 1px solid #005f40; padding: 8px; font-weight: bold;">${stats['B']}</td>
    <td style="border: 1px solid #005f40; padding: 8px; font-weight: bold;">${stats['C']}</td>
    <td style="border: 1px solid #005f40; padding: 8px; font-weight: bold;">${stats['D']}</td>
    </tr>
    </table>
    </div></div>`;

    document.getElementById("print-area").innerHTML = printHtml;
    window.print();
}

// 🚀 Publish Results (SMS & Email Notification)
function publishResults() {
    var cls = document.getElementById("classSelector").value;
    var yr = document.getElementById("yearSelector").value;
    var sendSms = document.getElementById('smsPublishChk').checked;

    swalPro.fire({
        title: 'Publish Results?',
        html: `You are about to publish the final results for <b>${cls}</b>.<br>${sendSms ? '<b style="color:green;">SMS & Email Notifications will be sent to all Valid Students!</b>' : ''}`,
        icon: 'warning', showCancelButton: true, cancelButtonText: '<i class="fas fa-times"></i> Cancel', confirmButtonText: 'Yes, Publish Now', confirmButtonColor: '#047857'
    }).then(async (result) => {
        if(result.isConfirmed) {
            const { value: examTerm } = await swalPro.fire({
                title: 'Enter Exam Name',
                input: 'text',
                inputLabel: 'This name will appear on the SMS (e.g. 1st Term)',
                inputValue: '1st Term Exam',
                showCancelButton: true,
                inputValidator: (value) => { if (!value) return 'You need to write something!' }
            });

            if(examTerm) {
                showLoader(true, "PUBLISHING...<br><span style='font-size:11px;'>Please do not close this window</span>");
                try {
                    let res = await apiCall('publishAndSendSMS', { className: cls, examTerm: examTerm, year: yr, sendSmsCheck: sendSms });
                    showLoader(false); swalPro.fire('Success', res.msg, 'success');
                } catch(err) { showLoader(false); swalPro.fire('Error', err.message, 'error'); }
            }
        }
    });
}
