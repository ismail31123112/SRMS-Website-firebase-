  async function updatePassword() {
    const p = document.getElementById('newPass').value.trim(); 
    const msgBox = document.getElementById('passMsg');
    const btn = document.getElementById('btnUpdatePass');
    
    if(!p || p.length < 6) { 
        msgBox.style.color = "var(--danger)"; 
        msgBox.innerText = "Password must be at least 6 characters."; 
        return; 
    }
    let docId = sessionStorage.getItem('srms_student_docId') || (std ? std.docId : null);
    if(!docId) {
        msgBox.style.color = "var(--danger)";
        msgBox.innerText = "Session error! Please logout and login again.";
        return;
    }

    btn.disabled = true;
    btn.innerHTML = "<span class='loader-spinner' style='border-top-color:#fff;'></span> UPDATING...";
    msgBox.style.color = "var(--primary)"; 
    msgBox.innerText = "Updating password directly...";

    let directSuccess = false;

    try { 
        if (auth.currentUser) {
            try {
                await auth.currentUser.updatePassword(p);
                directSuccess = true;
            } catch (authErr) {
                if (authErr.code === 'auth/requires-recent-login') {
                    let oldPass = sessionStorage.getItem('srms_active_pass');
                    if (!oldPass) {
                        const sDoc = await db.collection("Students").doc(docId).get();
                        oldPass = sDoc.data()?.pass || "123456";
                    }
                    const cred = firebase.auth.EmailAuthProvider.credential(auth.currentUser.email, oldPass);
                    await auth.currentUser.reauthenticateWithCredential(cred);
                    await auth.currentUser.updatePassword(p);
                    directSuccess = true;
                }
            }

            const targetDocs = (allChildrenData && allChildrenData.length > 0) ? allChildrenData.map(c => c.docId) : [docId];
            for (let dId of targetDocs) {
                if (!dId) continue;
                await db.collection("Students").doc(dId).update({ pass: p });
                directSuccess = true;
            }
        }

        try {
            await fetch(SCRIPT_URL, {
                method: "POST", headers: { "Content-Type": "text/plain;charset=utf-8" },
                body: JSON.stringify({ action: "updatePassword", docId: docId, id: std ? std.id : "", newPass: p })
            });
        } catch (scriptErr) { console.log("Background script sync notice:", scriptErr); }

        if(directSuccess) {
            sessionStorage.setItem('srms_active_pass', p);
            msgBox.style.color = "#059669"; 
            msgBox.innerText = "✅ Password Changed Successfully!"; 
            document.getElementById('newPass').value = "";
        } else {
            msgBox.style.color = "var(--danger)"; 
            msgBox.innerText = "Could not update password. Please logout and login again.";
        }
    } catch(e) { 
        console.error("Password Update Error:", e);
        msgBox.style.color = "var(--danger)"; 
        msgBox.innerText = "Error! Please check your network and try again."; 
    }
    btn.disabled = false;
    btn.innerHTML = "SAVE NEW PASSWORD";
  }

