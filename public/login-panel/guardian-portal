<script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-firestore-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-auth-compat.js"></script>

<script>
  // =====================================================================
  // FIREBASE CONFIGURATION & INITIALIZATION
  // =====================================================================
  const firebaseConfig = {
    apiKey: "AIzaSyBhzidG1s5CsOaiY0RsBG6GJcrE12LLEuU",
    authDomain: "srms-website-management.firebaseapp.com",
    projectId: "srms-website-management"
  };

  if (!firebase.apps.length) { firebase.initializeApp(firebaseConfig); }
  const auth = firebase.auth();
  const db = firebase.firestore();

  const FIREBASE_PROJECT_ID = firebaseConfig.projectId;
  const FIREBASE_DB_BASE = `https://firestore.googleapis.com/v1/projects/${FIREBASE_PROJECT_ID}/databases/(default)/documents`;
  
  const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbyXWc-JW1TpzHHgRp7viUvHW4pUm_lw600wOaHBIIT-_Hwn0K36bxbXjHcQLgtRfWvP/exec";
  const FEE_PAY_SCRIPT = "https://script.google.com/macros/s/AKfycbzUkDxT8bO6HrMMkBOGr_ewCDaMQg7bZxvPr_8Omh3kDEqeX1T_JmL1v9JXMW2jwo88hw/exec";

  let allChildrenData = [];
  let std = null;
  let markSheetHTML = "";
  
  let resettingDocId = null; 
  let resettingPhoneEmail = null;
  let allStudentAttendance = {}; 
  let allHolidays = {};

  function sanitizeHTML(str) {
      if (typeof str !== 'string') return str;
      return str.replace(/[&<>'"]/g, tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag]));
  }

  // 🛡️ Crash-Proof JSON Parser
  function safeJSONParse(str, fallback = null) {
      if (!str || typeof str !== 'string' || str.trim() === "") return fallback;
      try { return JSON.parse(str); } catch (e) { return fallback; }
  }

  // 🛡️ Non-stop Session & Auth Restoration on Page Reload
  window.onload = function() {
    const savedSession = sessionStorage.getItem('srms_guardian_session');
    if(savedSession) { 
        let sData = safeJSONParse(savedSession, null);
        if (sData && sData.currentChild) {
            std = sData.currentChild;
            allChildrenData = sData.allChildren || [std];
            showDashboardUI(); 
        }
    }
    auth.onAuthStateChanged(function(user) {
        if (user && std) {
            initDash();
        }
    });
  };

  function loader(s) { document.getElementById('loader').style.display = s ? 'flex' : 'none'; }
  function closeModal(id) { document.getElementById(id).style.display = 'none'; }

  // 🚀 Non-Stop Crash-Proof Login Flow with Multi-Child Support
  async function handleLogin() {
    let id = sanitizeHTML(document.getElementById('stuID').value.trim());
    let pass = document.getElementById('stuPass').value.trim();
    const btn = document.getElementById('lBtn');
    document.getElementById('err').innerText = "";
    
    if(!id || !pass) { document.getElementById('err').innerText = "Please provide Phone/Email and Password."; return; }
    if (pass.length > 0 && pass.length < 6) pass = pass.padEnd(6, '0');

    btn.innerHTML = "<span class='loader-spinner'></span> Authenticating..."; btn.disabled = true;
    try {
        let authEmail = id;
        if (!id.includes('@')) authEmail = id + "@guardian.srms.edu.bd";
        
        await auth.signInWithEmailAndPassword(authEmail, pass);
        
        let childrenFound = [];
        let snapshots = [];

        // Check if Guardian by Phone OR Email
        if (!id.includes('@')) {
            snapshots.push(await db.collection("Students").where("phone", "==", id).get());
            snapshots.push(await db.collection("Students").where("guardianPhone", "==", id).get());
        } else {
            snapshots.push(await db.collection("Students").where("email", "==", id).get());
        }

        snapshots.forEach(snap => {
            if (!snap.empty) {
                snap.forEach(doc => {
                    let f = doc.data() || {};
                    let childObj = {
                        docId: doc.id,
                        id: sanitizeHTML(f.studentID || ""),
                        name: sanitizeHTML(f.name || "Student"),
                        class: sanitizeHTML(f.class || ""),
                        roll: sanitizeHTML(f.roll || ""),
                        group: sanitizeHTML(f.group || ""),
                        phone: sanitizeHTML(f.phone || ""),
                        email: sanitizeHTML(f.email || ""),
                        schoolFeeDue: sanitizeHTML(f.schoolFeeDue || "0"),
                        schoolFeeStatus: sanitizeHTML(f.schoolFeeStatus || ""),
                        customFees: safeJSONParse(f.customFees, []),
                        resultMarks: safeJSONParse(f.resultMarks, null),
                        resultStatus: sanitizeHTML(f.resultStatus || "")
                    };
                    if (!childrenFound.find(c => c.id === childObj.id)) childrenFound.push(childObj);
                });
            }
        });
        
        if (childrenFound.length === 0) {
            document.getElementById('err').innerText = "No student found linked to this Phone/Email!";
            btn.innerHTML = "ENTER PORTAL"; btn.disabled = false;
            return;
        }

        allChildrenData = childrenFound;
        sessionStorage.setItem('srms_active_pass', pass);

        if (childrenFound.length === 1) {
            selectChild(0);
        } else {
            document.getElementById('login-container').style.display = "none";
            showChildSelectionModal();
        }
        document.getElementById('stuPass').value = '';
    } catch (e) { 
        console.error("Guardian Login Error:", e);
        document.getElementById('err').innerText = "Invalid Phone/Email or Password!";
    }
    btn.innerHTML = "ENTER PORTAL"; btn.disabled = false;
  }

  function showChildSelectionModal() {
      let container = document.getElementById('childListContainer');
      container.innerHTML = "";
      allChildrenData.forEach((child, index) => {
          container.innerHTML += `
            <div class="child-card" onclick="selectChild(${index})">
                <div>
                    <p class="child-name">${sanitizeHTML(child.name)}</p>
                    <p class="child-meta">ID: ${child.id} | Class: ${child.class}${child.group ? ' ('+child.group+')' : ''} | Roll: ${child.roll}</p>
                </div>
                <div style="font-size: 24px; color: var(--primary);">➡️</div>
            </div>`;
      });
      document.getElementById('childSelectionModal').style.display = 'flex';
  }

  function selectChild(index) {
      std = allChildrenData[index];
      markSheetHTML = "";
      document.getElementById('appGPA').innerText = "GPA: --";
      document.getElementById('appMeta').innerText = "Grade: -- | Rank: --";
      document.getElementById('appSession').innerText = "Session: --";
      document.getElementById('noticeBox').style.display = "none";

      sessionStorage.setItem('srms_guardian_session', JSON.stringify({ currentChild: std, allChildren: allChildrenData }));
      sessionStorage.setItem('srms_student_docId', std.docId);
      
      document.getElementById('childSelectionModal').style.display = 'none';
      if (allChildrenData.length > 1) document.getElementById('btnSwitchChild').style.display = 'block';
      else document.getElementById('btnSwitchChild').style.display = 'none';
      
      showDashboardUI();
      initDash();
  }

  function showDashboardUI() {
    document.getElementById('login-container').style.display = "none";
    document.getElementById('main-navbar').style.display = "flex";
    document.getElementById('main-banner').style.display = "flex";
    document.getElementById('dashboard-section').style.display = "block";
    if (allChildrenData.length > 1) document.getElementById('btnSwitchChild').style.display = 'block';
  }

  function logout() {
    if(auth) auth.signOut();
    sessionStorage.removeItem('srms_guardian_session');
    sessionStorage.removeItem('srms_student_docId');
    sessionStorage.removeItem('srms_active_pass');
    std = null; allChildrenData = [];
    markSheetHTML = ""; allStudentAttendance = {}; allHolidays = {};
    
    document.getElementById('dashboard-section').style.display = "none";
    document.getElementById('main-navbar').style.display = "none";
    document.getElementById('main-banner').style.display = "none";
    document.querySelectorAll('.modal-overlay').forEach(el => el.style.display = 'none');
    
    document.getElementById('stuID').value = '';
    document.getElementById('stuPass').value = '';
    document.getElementById('err').innerText = '';
    document.getElementById('login-container').style.display = "flex";
  }

  // ==========================================
  // FORGOT PASSWORD LOGIC
  // ==========================================
  function openForgotPassModal() {
    document.getElementById('fpStep1').style.display = 'block'; document.getElementById('fpStep2').style.display = 'none'; document.getElementById('fpStep3').style.display = 'none';
    document.getElementById('fpID').value = ''; document.getElementById('fpOTP').value = ''; document.getElementById('fpNewPass').value = ''; document.getElementById('fpMsg').innerText = '';
    document.getElementById('forgotPassModal').style.display = 'flex';
  }

  async function requestOTP() {
    const id = sanitizeHTML(document.getElementById('fpID').value.trim());
    if(!id) { document.getElementById('fpMsg').innerHTML = `<span style="color:var(--danger);">Please enter Phone Number or Email.</span>`; return; }
    
    const btn = document.getElementById('btnRequestOTP');
    btn.innerHTML = "<span class='loader-spinner' style='border-top-color:#fff;'></span> SENDING..."; btn.disabled = true;
    
    try {
        const res = await fetch(SCRIPT_URL, { method: "POST", headers: { "Content-Type": "text/plain;charset=utf-8" }, body: JSON.stringify({ action: "sendOTP", id: id }) });
        const textResponse = await res.text();
        const data = JSON.parse(textResponse);
        
        if(data.status === "success") {
            resettingPhoneEmail = id; resettingDocId = data.docId; 
            document.getElementById('fpStep1').style.display = 'none'; document.getElementById('fpStep2').style.display = 'block';
            let sMsg = data.email ? `OTP sent to ${data.email}` : "OTP Sent Successfully!";
            document.getElementById('fpMsg').innerHTML = `<span style="color:#059669;"><b>${sanitizeHTML(sMsg)}</b></span>`;
        } else {
            let eMsg = data.message || "Error finding records.";
            document.getElementById('fpMsg').innerHTML = `<span style="color:var(--danger);">${sanitizeHTML(eMsg)}</span>`;
        }
    } catch(e) { document.getElementById('fpMsg').innerHTML = `<span style="color:var(--danger);">Network Error! Try again.</span>`; }
    btn.innerHTML = "SEND OTP"; btn.disabled = false;
  }

  async function verifyOTP() {
    const entered = sanitizeHTML(document.getElementById('fpOTP').value.trim());
    if(!entered) return;
    
    const btns = document.getElementById('fpStep2').getElementsByTagName('button');
    const verifyBtn = btns[0];
    verifyBtn.innerHTML = "<span class='loader-spinner' style='border-top-color:#fff;'></span> VERIFYING..."; verifyBtn.disabled = true;

    try {
        const res = await fetch(SCRIPT_URL, { method: "POST", headers: { "Content-Type": "text/plain;charset=utf-8" }, body: JSON.stringify({ action: "verifyOTP", id: resettingPhoneEmail, otp: entered }) });
        const data = await res.json();

        if(data.status === "success") {
            document.getElementById('fpStep2').style.display = 'none'; document.getElementById('fpStep3').style.display = 'block';
            document.getElementById('fpMsg').innerHTML = `<span style="color:#059669;">OTP Verified! You can now set a new password.</span>`;
        } else {
            document.getElementById('fpMsg').innerHTML = `<span style="color:var(--danger);">${sanitizeHTML(data.message || "Invalid OTP Code!")}</span>`;
        }
    } catch (e) { document.getElementById('fpMsg').innerHTML = `<span style="color:var(--danger);">Network Error! Try again.</span>`; }
    verifyBtn.innerHTML = "VERIFY OTP"; verifyBtn.disabled = false;
  }

  async function saveResetPassword() {
    const newPass = document.getElementById('fpNewPass').value.trim();
    if(newPass.length < 6) { document.getElementById('fpMsg').innerHTML = `<span style="color:var(--danger);">Password must be at least 6 characters.</span>`; return; }
    
    const btn = document.getElementById('btnSaveReset');
    btn.innerHTML = "<span class='loader-spinner' style='border-top-color:#fff;'></span> SAVING..."; btn.disabled = true;

    try {
        const res = await fetch(SCRIPT_URL, { method: "POST", headers: { "Content-Type": "text/plain;charset=utf-8" }, body: JSON.stringify({ action: "updatePassword", docId: resettingDocId, newPass: newPass }) });
        const data = await res.json();
        
        if(data.status === "success") {
            document.getElementById('fpStep3').innerHTML = `<div style="text-align:center; color:#059669; font-weight:bold; font-size:18px; margin-bottom:15px;">✅ ${sanitizeHTML(data.message || "Password Reset Successful!")}</div><button class="login-btn" onclick="closeModal('forgotPassModal')">LOGIN NOW</button>`;
            document.getElementById('fpMsg').innerText = '';
        } else {
            document.getElementById('fpMsg').innerHTML = `<span style="color:var(--danger);">${sanitizeHTML(data.message || "Failed to update password")}</span>`;
            btn.innerHTML = "SAVE NEW PASSWORD"; btn.disabled = false;
        }
    } catch(e) { document.getElementById('fpMsg').innerHTML = `<span style="color:var(--danger);">Network Error!</span>`; btn.innerHTML = "SAVE NEW PASSWORD"; btn.disabled = false; }
  }

  // =====================================================================
  // DASHBOARD INITIALIZATION & ADVANCED RESULT PARSER
  // =====================================================================
  async function initDash() { 
    if (!std) return;
    document.getElementById('uName').innerText = "Assalamu Alaikum, Guardian of " + std.name;
    document.getElementById('uMeta').innerText = `ID: ${std.id} | Class: ${std.class}${std.group ? ` (${std.group})` : ''} | Roll: ${std.roll}`;
    
    try {
        if (!auth.currentUser) return;
        
        const warnSnap = await db.collection("Warnings").where("studentID", "==", std.id).get();
        if (!warnSnap.empty) {
            let warn = warnSnap.docs[0].data();
            document.getElementById('noticeBox').style.display="block";
            document.getElementById('noticeText').innerText = sanitizeHTML(warn.message);
        }

        loadCurrentMonthAttendanceSummary();

        if(std.resultStatus === "Published" && std.resultMarks && Array.isArray(std.resultMarks) && std.resultMarks.length > 0) {
            let rawCls = String(std.class).trim();
            let headerClsName = (rawCls === "Play" || rawCls === "Nursery" || rawCls === "KG" || rawCls.toLowerCase().startsWith("class")) ? rawCls : "Class " + rawCls;
            if(std.group && std.group !== "None" && std.group !== "N/A") headerClsName += " " + std.group;
            let hDocName = headerClsName.replace(/\s+/g, '_');

            const headerDoc = await db.collection("ClassHeaders").doc(hDocName).get();
            if(headerDoc.exists && headerDoc.data().headers) {
                let parsedHeaders = safeJSONParse(headerDoc.data().headers, []);
                if (parsedHeaders.length > 0) renderResults(parsedHeaders, std.resultMarks);
            }
        } else if (std.resultStatus === "Calculated") {
            markSheetHTML = `<div style="text-align:center; padding:40px;"><h2 style="color:#d97706;">Result Pending</h2><p style="color:#64748b;">Your result has been processed but is not published yet. Please wait for the official announcement.</p></div>`;
        } else {
            markSheetHTML = `<div style="text-align:center; padding:40px;"><h2 style="color:#d97706;">No Result Found</h2><p style="color:#64748b;">There are no academic results available for the current term.</p></div>`;
        }

        fetchMat();
        checkGuardianMeetStatus();
    } catch(err) { console.log("Dashboard Sync Error:", err); }
  }

  async function loadCurrentMonthAttendanceSummary() {
      let bdTime = new Date().toLocaleString("en-US", {timeZone: "Asia/Dhaka"});
      let now = new Date(bdTime);
      let mStr = now.getFullYear() + "-" + String(now.getMonth()+1).padStart(2, '0');
      let monthName = now.toLocaleString('default', { month: 'long', year: 'numeric' });
      
      try {
          const snap = await db.collection("AttendanceHistory")
              .where("studentID", "==", std.id)
              .where("pureDate", ">=", mStr + "-01")
              .where("pureDate", "<=", mStr + "-31")
              .get();
              
          let p = 0;
          snap.forEach(doc => { if (doc.data().type === "IN") p++; });
          
          document.getElementById('attTable').innerHTML = `
            <tr><td style="padding:10px; border-bottom:1px solid #e2e8f0; font-weight:700;">Current Month (${monthName})</td>
            <td style="padding:10px; text-align:right; border-bottom:1px solid #e2e8f0;"><b style="color:var(--success); font-size:15px;">${p} Days Present</b></td></tr>
          `;
          document.getElementById('attSummary').innerText = `Click 'VIEW DETAILED LOGS' to see daily punches and holidays.`;
      } catch(e) {}
  }

  async function fetchMat() {
      const box = document.getElementById('matList');
      box.innerHTML = "<div style='padding:15px; color:var(--text-muted); text-align:center;'><span class='loader-spinner' style='border-top-color:var(--primary);'></span> Loading resources...</div>";
      
      try {
          const snap = await db.collection("WebsitePosts").where("targetPage", "==", "Class" + std.class).get();
          box.innerHTML = ""; let count = 0;
          let posts = [];
          snap.forEach(doc => posts.push(doc.data()));

          posts.sort((a,b) => (parseInt(b.timestamp) || 0) - (parseInt(a.timestamp) || 0));

          posts.forEach(f => {
              count++;
              let title = sanitizeHTML(f.title || 'Document');
              let date = sanitizeHTML(f.date || '');
              let link = f.fileUrl || '#';
              if(!link || link === "None") link = "#";
              
              box.innerHTML += `<div style="background:white; padding:15px; border-radius:12px; margin-bottom:12px; display:flex; justify-content:space-between; align-items:center; border:1px solid #e2e8f0; box-shadow:0 4px 6px rgba(0,0,0,0.02);">
                                  <div>
                                    <div style="font-weight:700; color:#1e293b; font-size:14px;">${title}</div>
                                    <div style="font-size:11px; color:#64748b; margin-top:3px;">📅 ${date}</div>
                                  </div>
                                  <a href="${sanitizeHTML(link)}" target="_blank" style="background:var(--accent); color:white; padding:8px 16px; border-radius:8px; font-size:12px; font-weight:700; transition:0.3s; white-space:nowrap; text-decoration:none;">VIEW</a>
                                </div>`;
          });
          
          if(count === 0) box.innerHTML = "<div style='padding:15px; color:var(--text-muted); text-align:center; font-weight:500;'>No class materials available.</div>";
      } catch(e) { box.innerHTML = "<div style='padding:15px; color:var(--danger); text-align:center; font-weight:600;'>Materials sync error.</div>"; }
  }

  function extractPortalSubAndExam(headerText) {
      if(!headerText) return { sub: "Unknown", exam: "Exam", type: "Test" };
      let clean = String(headerText).replace(/\[.*?\]/g, '').replace(/\([^)]+\)/g, '').trim();
      let parts = clean.split(" - ");
      if(parts.length >= 3) {
          return { sub: parts[0].trim(), exam: parts[1].trim(), type: parts[2].includes("Main") ? "Main" : "Test" };
      }
      return { sub: clean, exam: "Exam", type: "Test" };
  }

  function parsePortalHeaders(headers) {
      let firstEmpty = headers.indexOf("");
      if(firstEmpty === -1) firstEmpty = headers.length;
      let subjects = {};
      let testSeq = [];
      let mainSeq = [];
      let c = 3;
      while(c < firstEmpty && c < headers.length) {
          let startC = c;
          let hStr = String(headers[c] || "");
          if (hStr.toLowerCase().includes("opt") && hStr.toLowerCase().includes("name")) {
              let optSubName = hStr.replace(/Opt Name/i, "").trim();
              if(!subjects[optSubName]) subjects[optSubName] = { isOpt: true, nameCol: c, tests: [], mains: [] };
              let j = c + 1;
              while(j < firstEmpty && String(headers[j] || "").startsWith(optSubName + " - ")) {
                  let info = extractPortalSubAndExam(headers[j]);
                  if(String(headers[j]).includes(" - Main")) {
                      subjects[optSubName].mains.push(j);
                      if(info.exam && !mainSeq.includes(info.exam)) mainSeq.push(info.exam);
                  } else {
                      subjects[optSubName].tests.push(j);
                      if(info.exam && !testSeq.includes(info.exam)) testSeq.push(info.exam);
                  }
                  j++;
              }
              c = j;
          } else {
              let subName = hStr.split(" - ")[0].trim();
              if(!subjects[subName]) subjects[subName] = { isOpt: false, tests: [], mains: [] };
              let j = c;
              while(j < firstEmpty && String(headers[j] || "").startsWith(subName + " - ")) {
                  let info = extractPortalSubAndExam(headers[j]);
                  if(String(headers[j]).includes(" - Main")) {
                      subjects[subName].mains.push(j);
                      if(info.exam && !mainSeq.includes(info.exam)) mainSeq.push(info.exam);
                  } else {
                      subjects[subName].tests.push(j);
                      if(info.exam && !testSeq.includes(info.exam)) testSeq.push(info.exam);
                  }
                  j++;
              }
              c = j;
          }
          if (c === startC) c++;
      }
      return { subjects, testSeq, mainSeq, firstEmpty };
  }

