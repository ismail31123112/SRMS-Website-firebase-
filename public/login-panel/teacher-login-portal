  // =========================================================================
  // 📸 TEACHER PROFILE PHOTO CHANGE SYSTEM (IMGBB + FIRESTORE INSTANT SYNC)
  // =========================================================================
  function changeTeacherProfilePhoto(input) {
    if (!input.files || input.files.length === 0) return;
    const file = input.files[0];
    const statusEl = document.getElementById('photoSyncStatus');
    statusEl.innerHTML = `<i class="fas fa-spinner fa-spin"></i> ছবি অপটিমাইজ ও আপলোড হচ্ছে...`;

    const reader = new FileReader();
    reader.onload = function(e) {
      const img = new Image();
      img.onload = async function() {
        const maxDim = 650;
        let w = img.width, h = img.height;
        if (w > maxDim || h > maxDim) {
          if (w > h) { h = Math.round((h * maxDim) / w); w = maxDim; }
          else { w = Math.round((w * maxDim) / h); h = maxDim; }
        }
        const canvas = document.createElement('canvas');
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, w, h);

        const dataUrl = canvas.toDataURL('image/jpeg', 0.86);
        const base64Raw = dataUrl.split(',')[1];

        // সাথে সাথে স্ক্রিনে প্রিভিউ দেখানো
        document.getElementById('teacherProfileAvatar').src = dataUrl;

        try {
          let newPhotoUrl = "";
          try {
            const imgbbRes = await uploadBase64ToImgBB(base64Raw, "Teacher_" + normalizePhone11JS(tPhone));
            newPhotoUrl = imgbbRes.url;
          } catch (directErr) {
            // যদি ব্রাউজার থেকে ব্লক হয়, ব্যাকএন্ড নিজেই আপলোড করবে
          }

          const docId = sessionStorage.getItem("srms_teacher_id") || "";
          const apiRes = await teacherApiCall("updateTeacherPhoto", {
            phone: exactDbPhone || normalizePhone11JS(tPhone),
            docId: docId,
            photoUrl: newPhotoUrl,
            photoData: newPhotoUrl ? "" : base64Raw
          });

          const finalUrl = apiRes.photoUrl || newPhotoUrl;
          applyTeacherPhotoToUI(finalUrl);
          statusEl.style.color = "#a7f3d0";
          statusEl.innerHTML = `✅ প্রোফাইল ছবি সফলভাবে আপডেট হয়েছে!`;
          setTimeout(() => { statusEl.innerHTML = ""; }, 4000);
        } catch (err) {
          statusEl.style.color = "#fecdd3";
          statusEl.innerHTML = `❌ ছবি সেভ করতে সমস্যা হয়েছে: ${err.message}`;
        }
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  }

