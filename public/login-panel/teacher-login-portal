<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Saidpur Residential Model School — Official Teacher Portal</title>
<link rel="icon" href="https://i.postimg.cc/hGQQqrsb/20260117_231551.png" type="image/png">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
  :root {
    --primary: #005f40;
    --primary-dark: #003d29;
    --accent: #bf953f;
    --danger: #e11d48;
    --danger-dark: #be123c;
    --warning: #f59e0b;
    --success: #10b981;
    --bg-color: #f4f7f6;
    --card-bg: #ffffff;
    --text-main: #1e293b;
    --text-muted: #64748b;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 0;
    font-family: 'Poppins', sans-serif;
    background-color: var(--bg-color);
    color: var(--text-main);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }
  a { text-decoration: none; color: inherit; transition: 0.25s; }
  ul { list-style: none; margin: 0; padding: 0; }

  @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes bounce { 0%, 20%, 50%, 80%, 100% { transform: translateY(0); } 40% { transform: translateY(-7px); } 60% { transform: translateY(-4px); } }
  @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  @keyframes livePulseAlert { 0% { box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.45); } 70% { box-shadow: 0 0 0 15px rgba(225, 29, 72, 0); } 100% { box-shadow: 0 0 0 0 rgba(225, 29, 72, 0); } }
  .animate-up { animation: fadeInUp 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards; }

  ::-webkit-scrollbar { width: 8px; }
  ::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 10px; }
  ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
  ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

  /* === Official Navbar === */
  #main-navbar {
    display: none;
    background: var(--card-bg);
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    position: sticky;
    top: 0;
    z-index: 1000;
    border-bottom: 3px solid var(--accent);
  }
  .nav-top-container {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 5%;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }
  .nav-brand {
    font-weight: 800;
    color: var(--primary);
    font-size: 19px;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .nav-link {
    font-weight: 700;
    font-size: 13px;
    color: var(--danger);
    background: #fff1f2;
    padding: 10px 20px;
    border-radius: 10px;
    text-transform: uppercase;
    cursor: pointer;
    transition: 0.25s;
    border: 1px solid #fecdd3;
  }
  .nav-link:hover {
    color: #fff;
    background: var(--danger);
    box-shadow: 0 5px 15px rgba(225, 29, 72, 0.25);
  }

  /* === Official Banner === */
  #main-banner {
    display: none;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white;
    padding: 36px 5%;
    align-items: center;
    justify-content: center;
    gap: 24px;
    text-align: left;
    position: relative;
    overflow: hidden;
  }
  .custom-banner::before {
    content: '';
    position: absolute;
    top: -50%; left: -50%; width: 200%; height: 200%;
    background: radial-gradient(circle, rgba(255,255,255,0.06) 0%, transparent 60%);
    z-index: 0;
  }
  .banner-logo {
    width: 86px;
    height: 86px;
    background: #fff;
    border-radius: 50%;
    padding: 7px;
    border: 3px solid rgba(255,255,255,0.25);
    object-fit: contain;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    z-index: 1;
  }
  .banner-text { z-index: 1; }
  .banner-text h1 {
    margin: 0;
    font-size: 25px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.3px;
  }
  .school-codes {
    background: rgba(255, 255, 255, 0.12);
    display: inline-block;
    padding: 6px 16px;
    border-radius: 20px;
    margin-top: 8px;
    font-size: 13px;
    font-weight: 600;
    color: #fcf6ba;
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(5px);
  }

  /* === Login Section === */
  #login-sec {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 20px;
    position: relative;
    overflow: hidden;
  }
  #login-sec::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(circle at top right, rgba(0,95,64,0.06) 0%, transparent 50%);
    z-index: -1;
  }
  .login-card {
    background: var(--card-bg);
    padding: 46px 38px;
    border-radius: 24px;
    box-shadow: 0 25px 50px -12px rgba(0,0,0,0.1);
    width: 100%;
    max-width: 440px;
    text-align: center;
    border: 1px solid rgba(0,0,0,0.05);
    border-top: 6px solid var(--primary);
  }
  .login-logo { width: 84px; height: 84px; object-fit: contain; margin-bottom: 16px; }
  .login-title { color: var(--primary); font-size: 23px; font-weight: 800; text-transform: uppercase; margin: 0 0 5px 0; }
  .login-subtitle { color: var(--text-muted); font-size: 13.5px; margin-bottom: 26px; font-weight: 500; }

  /* === Form Elements === */
  input, select, textarea {
    width: 100%;
    padding: 14px 16px;
    margin: 9px 0;
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    font-family: inherit;
    font-size: 14.5px;
    transition: 0.2s;
    background: #f8fafc;
    color: var(--text-main);
    font-weight: 500;
  }
  input:focus, select:focus, textarea:focus {
    border-color: var(--primary);
    outline: none;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(0,95,64,0.1);
  }
  .btn-p {
    width: 100%;
    padding: 15px;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    font-weight: 700;
    font-size: 14.5px;
    margin-top: 14px;
    transition: all 0.25s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .btn-p:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 12px 22px -5px rgba(0,95,64,0.3);
  }
  .btn-p:disabled {
    background: #94a3b8;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }
  .btn-success { background: linear-gradient(135deg, #059669, #047857); }

  .forgot-link {
    display: inline-block;
    margin-top: 18px;
    color: var(--accent);
    font-weight: 700;
    font-size: 13.5px;
    cursor: pointer;
    transition: 0.2s;
    border-bottom: 2px solid transparent;
  }
  .forgot-link:hover { border-color: var(--accent); color: var(--primary); }

  .loader-spinner {
    border: 3px solid rgba(255,255,255,0.3);
    border-top: 3px solid #fff;
    border-radius: 50%;
    width: 18px;
    height: 18px;
    animation: spin 0.75s linear infinite;
    display: inline-block;
    vertical-align: middle;
    margin-right: 8px;
  }

  /* === Dashboard Container === */
  .container { max-width: 1000px; margin: 0 auto; padding: 35px 5%; display: none; }

  .scroll-cue-container { width: 100%; margin-bottom: 26px; text-align: center; }
  .scroll-cue {
    display: inline-block;
    color: var(--primary);
    font-size: 14px;
    font-weight: 700;
    padding: 9px 22px;
    background: #ecfdf5;
    border-radius: 20px;
    border: 1px solid #a7f3d0;
    animation: bounce 2.2s infinite;
  }

  /* 📸 Welcome Card & Teacher Avatar */
  .welcome-card {
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white;
    padding: 28px 30px;
    border-radius: 22px;
    margin-bottom: 32px;
    border-left: 8px solid var(--accent);
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 15px 35px rgba(0,95,64,0.2);
    flex-wrap: wrap;
    gap: 20px;
  }
  .teacher-profile-wrap { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .teacher-avatar-box {
    position: relative;
    width: 86px;
    height: 86px;
    border-radius: 50%;
    border: 3.5px solid var(--accent);
    padding: 3px;
    background: rgba(255,255,255,0.15);
    box-shadow: 0 8px 25px rgba(0,0,0,0.22);
    flex-shrink: 0;
  }
  .teacher-avatar-box img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    background: #fff;
    display: block;
  }
  .change-photo-badge {
    position: absolute;
    bottom: -2px;
    right: -2px;
    background: var(--accent);
    color: #fff;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: 2px solid #fff;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    transition: 0.2s;
    font-size: 13px;
  }
  .change-photo-badge:hover { transform: scale(1.1); background: #a67c2e; }
  .welcome-card h2 { margin: 0; font-size: 23px; font-weight: 800; }
  .welcome-card p { margin: 5px 0 0 0; opacity: 0.92; font-weight: 500; font-size: 13.5px; }
  .welcome-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .btn-gold {
    background: var(--accent);
    padding: 11px 20px;
    border: none;
    color: white;
    border-radius: 12px;
    cursor: pointer;
    font-weight: 700;
    transition: 0.2s;
    font-size: 13.5px;
    box-shadow: 0 5px 15px rgba(191, 149, 63, 0.3);
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .btn-gold:hover { background: #a67c2e; transform: translateY(-2px); }
  .btn-outline-light {
    background: rgba(255,255,255,0.14);
    border: 1.5px solid rgba(255,255,255,0.35);
    padding: 11px 18px;
    color: #fff;
    border-radius: 12px;
    cursor: pointer;
    font-weight: 700;
    font-size: 13.5px;
    transition: 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .btn-outline-light:hover { background: rgba(255,255,255,0.25); transform: translateY(-2px); }

  .section-title {
    font-weight: 800;
    color: var(--text-main);
    margin: 36px 0 14px;
    font-size: 17.5px;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 2px solid #e2e8f0;
    padding-bottom: 10px;
  }
  .card {
    background: var(--card-bg);
    border-radius: 20px;
    padding: 30px;
    margin-bottom: 26px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.04);
    border: 1px solid #e2e8f0;
  }

  .action-btn-large {
    width: 100%;
    padding: 18px;
    font-size: 15.5px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: none;
    color: white;
    cursor: pointer;
    font-weight: 700;
    transition: all 0.25s ease;
    text-transform: uppercase;
  }
  .action-btn-large:hover { transform: translateY(-2px); box-shadow: 0 12px 22px -5px rgba(0,0,0,0.2); }

  /* 🎥 Live Classroom & Meeting Styles */
  .admin-live-meeting-banner {
    background: linear-gradient(135deg, #be123c, #e11d48);
    color: white;
    border-radius: 18px;
    padding: 20px 24px;
    margin-bottom: 20px;
    display: none;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    animation: livePulseAlert 2s infinite;
    border: 2px solid #fecdd3;
  }
  .live-class-item {
    background: #f0fdf4;
    border: 2px solid #bbf7d0;
    padding: 16px 20px;
    border-radius: 16px;
    margin-bottom: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }
  .live-class-item p { margin: 3px 0; font-size: 13.5px; color: #065f46; }
  .btn-stop-live {
    background: var(--danger);
    color: white;
    border: none;
    padding: 9px 16px;
    border-radius: 10px;
    font-weight: 700;
    cursor: pointer;
    font-size: 12.5px;
    transition: 0.2s;
  }
  .btn-stop-live:hover { background: var(--danger-dark); }
  .btn-rejoin-live {
    background: var(--primary);
    color: white;
    border: none;
    padding: 9px 16px;
    border-radius: 10px;
    font-weight: 700;
    cursor: pointer;
    font-size: 12.5px;
    transition: 0.2s;
  }

  /* File Upload Preview Box */
  .file-preview-box {
    display: none;
    margin-top: 12px;
    padding: 12px 15px;
    border-radius: 14px;
    background: #f0fdf4;
    border: 1.5px solid #bbf7d0;
    align-items: center;
    gap: 14px;
  }
  .file-preview-box img {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 10px;
    border: 2px solid var(--primary);
    background: #fff;
  }
  .file-preview-meta { flex: 1; font-size: 12.5px; color: #065f46; font-weight: 600; }

  /* Board Items */
  .notice-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 18px 20px;
    border-radius: 16px;
    margin-bottom: 14px;
    border-left: 6px solid var(--accent);
    transition: 0.2s;
  }
  .notice-item:hover { box-shadow: 0 5px 15px rgba(0,0,0,0.04); }
  .item-box {
    background: #fff;
    border: 1px solid #e2e8f0;
    padding: 20px 22px;
    border-radius: 16px;
    margin-bottom: 14px;
    position: relative;
    border-left: 6px solid var(--primary);
    transition: 0.2s;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    flex-wrap: wrap;
  }
  .item-box:hover { box-shadow: 0 8px 20px rgba(0,0,0,0.04); }
  .del-btn {
    color: var(--danger);
    cursor: pointer;
    font-size: 12.5px;
    border: 1.5px solid #fecdd3;
    padding: 8px 15px;
    border-radius: 10px;
    font-weight: 700;
    background: #fff1f2;
    transition: 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .del-btn:hover { background: var(--danger); color: white; border-color: var(--danger); }
  .readonly-badge {
    background: #f1f5f9;
    color: #64748b;
    padding: 7px 13px;
    border-radius: 10px;
    font-size: 11.5px;
    font-weight: 700;
    border: 1px solid #e2e8f0;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .tag {
    background: #ecfdf5;
    color: var(--primary);
    padding: 4px 11px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 800;
    display: inline-block;
    margin-bottom: 5px;
    text-transform: uppercase;
  }

  /* Modals */
  .modal-overlay {
    display: none;
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(15, 23, 42, 0.8);
    z-index: 2000;
    justify-content: center;
    align-items: center;
    backdrop-filter: blur(6px);
    padding: 18px;
  }
  .modal-box {
    background: var(--card-bg);
    padding: 34px 28px;
    border-radius: 24px;
    text-align: center;
    width: 100%;
    max-width: 470px;
    box-shadow: 0 25px 50px rgba(0,0,0,0.22);
    animation: fadeInUp 0.25s ease;
    border-top: 7px solid var(--accent);
    position: relative;
    max-height: 90vh;
    overflow-y: auto;
  }
  .modal-box.danger-modal { border-top-color: var(--danger); }
  .close-modal-btn {
    background: #f1f5f9;
    color: #334155;
    border: none;
    padding: 13px;
    border-radius: 12px;
    cursor: pointer;
    font-weight: 700;
    width: 100%;
    transition: 0.2s;
    margin-top: 10px;
    font-size: 14.5px;
  }
  .close-modal-btn:hover { background: #e2e8f0; }

  .premium-footer {
    display: none;
    background: #0f172a;
    color: #f8fafc;
    padding: 45px 5% 28px;
    margin-top: 55px;
    text-align: center;
    border-top: 5px solid var(--primary);
  }

  @media (max-width: 768px) {
    .nav-brand { font-size: 15px; }
    .custom-banner { flex-direction: column; text-align: center; padding: 28px 18px; }
    .banner-text h1 { font-size: 21px; }
    .login-card { padding: 36px 24px; border-radius: 20px; }
    .container { padding: 25px 16px; }
    .welcome-card { flex-direction: column; text-align: center; padding: 24px 18px; }
    .teacher-profile-wrap { flex-direction: column; justify-content: center; text-align: center; }
    .welcome-card h2 { font-size: 20px; }
    .welcome-actions { width: 100%; justify-content: center; }
    .btn-gold, .btn-outline-light { width: 100%; justify-content: center; }
    .card { padding: 22px 18px; }
    .item-box { flex-direction: column; align-items: flex-start; }
  }
</style>
</head>
<body>

<nav class="navbar" id="main-navbar">
  <div class="nav-top-container">
    <div class="nav-brand">
      <img id="navTeacherThumb" src="https://i.postimg.cc/hGQQqrsb/20260117_231551.png" alt="Avatar" style="width:38px; height:38px; border-radius:50%; object-fit:cover; border:2px solid var(--accent); background:#fff;">
      <span>SRMS Teacher Portal</span>
    </div>
    <a onclick="logout()" class="nav-link"><i class="fas fa-sign-out-alt"></i> লগআউট</a>
  </div>
</nav>

<div class="custom-banner animate-up" id="main-banner">
  <img src="https://i.postimg.cc/hGQQqrsb/20260117_231551.png" class="banner-logo" alt="Logo">
  <div class="banner-text">
    <h1>Saidpur Residential Model School</h1>
    <div class="school-codes">অফিশিয়াল শিক্ষক ড্যাশবোর্ড ও একাডেমিক পোর্টাল</div>
  </div>
</div>

<!-- ================= LOGIN SECTION ================= -->
<div id="login-sec" class="animate-up">
  <div class="login-card">
    <img src="https://i.postimg.cc/hGQQqrsb/20260117_231551.png" alt="Logo" class="login-logo">
    <h2 class="login-title">Teacher Portal</h2>
    <div class="login-subtitle">সৈয়দপুর রেসিডেন্সিয়াল মডেল স্কুল — শিক্ষক লগইন</div>
    <input type="tel" id="lPh" placeholder="মোবাইল নম্বর (যেমন: 017XXXXXXXX)" onkeydown="if(event.key==='Enter') document.getElementById('lPs').focus()">
    <input type="password" id="lPs" placeholder="পাসওয়ার্ড" onkeydown="if(event.key==='Enter') login()">
    <button class="btn-p" id="lBtn" onclick="login()">লগইন করুন ➔</button>
    <div class="forgot-link" onclick="openForgotModal()">পাসওয়ার্ড ভুলে গেছেন?</div>
    <p id="err" style="color:var(--danger); font-size:13px; margin-top:15px; font-weight:700;"></p>
  </div>
</div>

<!-- ================= DASHBOARD SECTION ================= -->
<div id="dash-sec" class="container animate-up">
  <div class="scroll-cue-container">
    <div class="scroll-cue">⬇️ নিচের একাডেমিক অপশনগুলো দেখুন ⬇️</div>
  </div>

  <!-- 📸 Welcome Card with Teacher Profile Photo & Instant Change Option -->
  <div class="welcome-card">
    <div class="teacher-profile-wrap">
      <div class="teacher-avatar-box" title="প্রোফাইল ছবি পরিবর্তন করুন">
        <img id="teacherProfileAvatar" src="https://i.postimg.cc/hGQQqrsb/20260117_231551.png" alt="Teacher Photo" onerror="this.src='https://i.postimg.cc/hGQQqrsb/20260117_231551.png'">
        <label for="teacherPhotoInput" class="change-photo-badge" title="ছবি পরিবর্তন করুন">
          <i class="fas fa-camera"></i>
        </label>
        <input type="file" id="teacherPhotoInput" accept="image/*" style="display:none;" onchange="changeTeacherProfilePhoto(this)">
      </div>
      <div>
        <h2 id="tGreet" style="margin:0;">আসসালামু আলাইকুম</h2>
