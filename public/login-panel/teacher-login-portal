  async function sendWarning() {
      const selectBox = document.getElementById('wStuId');
      const sid = selectBox ? selectBox.value : null; 
      const sName = selectBox && selectBox.selectedIndex > 0 ? selectBox.options[selectBox.selectedIndex].getAttribute('data-name') : "Student";
