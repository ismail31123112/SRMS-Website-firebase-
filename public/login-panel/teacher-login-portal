  const DEFAULT_AVATAR = "https://i.postimg.cc/hGQQqrsb/20260117_231551.png";

  // শুধুমাত্র ক্লাস ক্যাটাগরি লিস্ট (শিক্ষকদের জন্য অনুমোদিত)
  const ALLOWED_CLASS_TARGETS = [
    "ClassPlay", "ClassNursery", "ClassKG",
    "Class1", "Class2", "Class3", "Class4", "Class5",
    "Class6", "Class7", "Class8", "Class9", "Class10"
  ];

  let tPhone = "";
  let tTeacherName = "Teacher";
  let tTeacherPhoto = DEFAULT_AVATAR;
  let exactDbPhone = "";
  let resetPhone = null;
  
  let globalPostsCache = [];
  let globalWarnsCache = [];
  let preparedAcademicFile = null;
  let isUploadingPost = false;

  let allTeacherAttendance = {};
  let allHolidays = {};

  function sanitizeHTML(str) {
      if (typeof str !== 'string') return str;
      return str.replace(/[&<>'"]/g, tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag]));
  }

  function cleanPhoneCoreJS(p) {
    if (!p) return "";
    let d = p.toString().replace(/[^0-9]/g, "");
    if (d.startsWith("880") && d.length === 13) d = d.substring(3);
    else if (d.startsWith("0") && d.length === 11) d = d.substring(1);
    return d;
  }

  function normalizePhone11JS(p) {
    let core = cleanPhoneCoreJS(p);
    return core.length === 10 ? ("0" + core) : p.toString().trim();
  }

  function closeModal(id) { document.getElementById(id).style.display = 'none'; }

  // 📡 Teacher Backend API Caller
  async function teacherApiCall(actionName, payloadObj = {}) {
    let token = "";
    if (auth.currentUser) {
      try { token = await auth.currentUser.getIdToken(false); } catch (e) {
        try { token = await auth.currentUser.getIdToken(true); } catch (e2) {}
      }
    }
    const res = await fetch(TEACHER_BACKEND_URL, {
      method: "POST",
      headers: { "Content-Type": "text/plain;charset=utf-8" },
      body: JSON.stringify({
        action: actionName,
        token: token,
        ...payloadObj
      })
    });
    const text = await res.text();
    let data = JSON.parse(text);
    if (data.status === "error") throw new Error(data.message || data.msg || "Request failed");
    return data;
  }

  // 🖼️ Direct ImgBB Upload Helper (Turbo 1-Second Upload)
  async function uploadBase64ToImgBB(base64Data, fileName) {
    const formData = new FormData();
    formData.append("key", IMGBB_API_KEY);
    formData.append("image", base64Data);
    if (fileName) {
      formData.append("name", fileName.replace(/\.[^/.]+$/, ""));
    }
    const res = await fetch(IMGBB_UPLOAD_URL, { method: "POST", body: formData });
    const json = await res.json();
    if (json && json.success && json.data) {
      return {
        url: json.data.url || json.data.display_url,
        thumbUrl: (json.data.thumb && json.data.thumb.url) ? json.data.thumb.url : json.data.url,
        deleteUrl: json.data.delete_url || "",
        imgbbId: json.data.id || ""
      };
    }
    throw new Error("ImgBB Upload Failed");
  }

  // 🔒 Non-stop Auto-login & Auth Restoration
  window.onload = function() {
    const savedPhone = sessionStorage.getItem("srms_phone");
    const savedName = sessionStorage.getItem("srms_name");
    const savedExact = sessionStorage.getItem("srms_exact_phone");
    const savedPhoto = sessionStorage.getItem("srms_teacher_photo");
    
    if(savedPhone && savedName) {
      tPhone = savedPhone;
      tTeacherName = savedName;
      exactDbPhone = savedExact || normalizePhone11JS(savedPhone);
      tTeacherPhoto = savedPhoto || DEFAULT_AVATAR;
      showDashboardUI(savedName, tTeacherPhoto);
    } else {
       document.getElementById('dash-sec').style.display = 'none';
       document.getElementById('login-sec').style.display = 'flex';
    }

    auth.onAuthStateChanged(function(user) {
      if (user && tPhone) {
        syncTeacherProfileFromFirestore();
        loadBoard();
        loadTeacherLiveHubSessions();
      }
    });
  };

  function logout() {
    try { if(auth) auth.signOut(); } catch(e) {}
    sessionStorage.clear();
    
    document.getElementById('dash-sec').style.display = 'none';
    document.getElementById('main-navbar').style.display = 'none';
    document.getElementById('main-banner').style.display = 'none';
    document.getElementById('main-footer').style.display = 'none';
    
    document.getElementById('lPh').value = '';
    document.getElementById('lPs').value = '';
    document.getElementById('err').innerText = '';
    document.getElementById('login-sec').style.display = 'flex';
  }

  async function login() {
    let p = sanitizeHTML(document.getElementById('lPh').value.trim());
    let s = document.getElementById('lPs').value.trim();
    const b = document.getElementById('lBtn');
    const err = document.getElementById('err');
    
    err.innerText = "";
    if(!p || !s) { err.innerText = "Please fill in all fields!"; return; }
    
    if (s.length > 0 && s.length < 6) s = s.padEnd(6, '0');
    
    b.innerHTML = '<span class="loader-spinner"></span> Authenticating...'; b.disabled = true;
    
    let ph = cleanPhoneCoreJS(p);

    try {
      let emailToTry = `0${ph}@srms.edu.bd`;
      try {
          await auth.signInWithEmailAndPassword(emailToTry, s);
      } catch(e1) {
          emailToTry = `${ph}@srms.edu.bd`;
          await auth.signInWithEmailAndPassword(emailToTry, s);
      }

      const token = await auth.currentUser.getIdToken(true);
      const res = await fetch(`${FIREBASE_DB_BASE}/Teachers?pageSize=1000`, {
          headers: { "Authorization": "Bearer " + token }
      });
      const data = await res.json();
      
      let foundName = "Teacher", teacherDocId = null, dbPhoneToSave = "0" + ph, foundPhoto = DEFAULT_AVATAR;

      if(data.documents) {
        for(let d of data.documents) {
            let f = d.fields || {};
            let dbPhone = f.phone ? f.phone.stringValue : "";
            if(cleanPhoneCoreJS(dbPhone) === ph) {
                foundName = f.name ? f.name.stringValue : "Teacher";
                teacherDocId = d.name.split('/').pop(); 
                dbPhoneToSave = dbPhone;
                foundPhoto = (f.photoUrl && f.photoUrl.stringValue) ? f.photoUrl.stringValue : ((f.photo && f.photo.stringValue) ? f.photo.stringValue : DEFAULT_AVATAR);
                break;
            }
        }
      }
          
      tPhone = ph;
      tTeacherName = foundName;
      exactDbPhone = dbPhoneToSave;
      tTeacherPhoto = foundPhoto || DEFAULT_AVATAR;
      
      sessionStorage.setItem("srms_phone", ph);
      sessionStorage.setItem("srms_exact_phone", dbPhoneToSave);
      sessionStorage.setItem("srms_name", foundName);
      sessionStorage.setItem("srms_active_pass", s);
      sessionStorage.setItem("srms_teacher_photo", tTeacherPhoto);
      if(teacherDocId) sessionStorage.setItem("srms_teacher_id", teacherDocId); 
      
      const teacherRoles = ["teacher_dashboard", "special_page_access"];
      sessionStorage.setItem("srms_user_roles", JSON.stringify(teacherRoles));
      sessionStorage.setItem("srms_active_session", "true");
      
      document.getElementById('lPs').value = '';
      showDashboardUI(foundName, tTeacherPhoto);
      loadBoard();
      loadTeacherLiveHubSessions();
      
    } catch(e) { 
        err.innerText = "Teacher account not found or invalid password!"; 
        b.innerHTML = "Secure Login ➔"; b.disabled = false; 
    }
