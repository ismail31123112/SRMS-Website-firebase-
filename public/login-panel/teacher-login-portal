  function openDeleteModal(id, type) {
    const modal = document.getElementById('delModal'), link = document.getElementById('modalLink');
    link.onclick = async function() {
      closeDeleteModal();

      if (type === 'warn') {
        globalWarnsCache = globalWarnsCache.filter(w => w.id !== id);
        renderBoardUI();
        try {
          const token = await auth.currentUser.getIdToken();
          await fetch(`${FIREBASE_DB_BASE}/Warnings/${id}`, {
            method: "DELETE",
            headers: { "Authorization": "Bearer " + token }
          });
        } catch (e) {}
        return;
      }

      const targetPost = globalPostsCache.find(p => p.rowId === id);
      if (!targetPost) return;

      const myCorePhone = cleanPhoneCoreJS(tPhone);
      if (cleanPhoneCoreJS(targetPost.uploader) !== myCorePhone) {
        alert("⛔ আপনি শুধুমাত্র আপনার নিজের প্রকাশিত পোস্ট মুছে ফেলতে পারবেন!");
        return;
      }

      globalPostsCache = globalPostsCache.filter(p => p.rowId !== id);
      renderBoardUI();

      try {
        await teacherApiCall("teacherDeletePost", {
          docId: id,
          teacherPhone: exactDbPhone || normalizePhone11JS(tPhone),
          meta: {
            fileUrl: targetPost.fileUrl || "",
            fileType: targetPost.fileType || "",
            driveFileId: targetPost.driveFileId || "",
            imgbbDeleteUrl: targetPost.imgbbDeleteUrl || "",
            imgbbId: targetPost.imgbbId || ""
          }
