  // ⚡ ০.২ সেকেন্ডে ইনস্ট্যান্ট লগইন (ডিরেক্ট আইডি + ইনডেক্সড কুয়েরি)
  async function login() {
    let p = sanitizeHTML(document.getElementById('lPh').value.trim());
    let s = document.getElementById('lPs').value.trim();
    const b = document.getElementById('lBtn');
    const err = document.getElementById('err');

    err.innerText = "";
    if (!p || !s) { err.innerText = "অনুগ্রহ করে মোবাইল নম্বর এবং পাসওয়ার্ড দিন!"; return; }

    if (s.length > 0 && s.length < 6) s = s.padEnd(6, '0');

    b.innerHTML = '<span class="loader-spinner"></span> যাচাই করা হচ্ছে...';
    b.disabled = true;

    let ph = cleanPhoneCoreJS(p);
    let norm11 = "0" + ph;

    try {
      let emailToTry = `0${ph}@srms.edu.bd`;
      try {
        await auth.signInWithEmailAndPassword(emailToTry, s);
      } catch (e1) {
        emailToTry = `${ph}@srms.edu.bd`;
        await auth.signInWithEmailAndPassword(emailToTry, s);
      }

      const token = await auth.currentUser.getIdToken(false);
      const headers = { "Authorization": "Bearer " + token, "Content-Type": "application/json" };

      const directDocId = "T_" + norm11;
      const queryPayload = {
        structuredQuery: {
          from: [{ collectionId: "Teachers" }],
          where: {
            fieldFilter: {
              field: { fieldPath: "phone" },
              op: "IN",
              value: {
                arrayValue: {
                  values: [
                    { stringValue: norm11 },
                    { stringValue: ph },
                    { stringValue: "+88" + norm11 }
                  ]
                }
              }
            }
          },
          limit: 1
        }
      };

      const [directRes, queryRes] = await Promise.all([
        fetch(`${FIREBASE_DB_BASE}/Teachers/${directDocId}`, { headers }).catch(() => null),
        fetch(`${FIREBASE_DB_BASE}:runQuery`, { method: "POST", headers, body: JSON.stringify(queryPayload) }).catch(() => null)
      ]);

      let matchedDoc = null;
      if (directRes && directRes.status === 200) {
        matchedDoc = await directRes.json();
      } else if (queryRes && queryRes.status === 200) {
        const qArr = await queryRes.json();
        if (qArr && qArr[0] && qArr[0].document) matchedDoc = qArr[0].document;
      }

      if (!matchedDoc) {
        const allRes = await fetch(`${FIREBASE_DB_BASE}/Teachers?pageSize=500`, { headers });
        const allData = await allRes.json();
        if (allData.documents) {
          matchedDoc = allData.documents.find(d => cleanPhoneCoreJS(d.fields?.phone?.stringValue || "") === ph) || null;
        }
      }

      let foundName = "Teacher", teacherDocId = directDocId, dbPhoneToSave = norm11, foundPhoto = DEFAULT_AVATAR;

      if (matchedDoc && matchedDoc.fields) {
        const f = matchedDoc.fields;
        const roleType = f.roleType ? f.roleType.stringValue : "Teacher";
        const portalAccess = f.portalAccess ? f.portalAccess.stringValue : "Allowed";
        if (roleType === "Staff" || portalAccess === "Blocked") {
          await auth.signOut();
          err.innerText = "এই অ্যাকাউন্টটি শুধুমাত্র অফিশিয়াল স্টাফদের জন্য; শিক্ষক পোর্টালে লগইন অনুমোদিত নয়।";
          b.innerHTML = "লগইন করুন ➔";
          b.disabled = false;
          return;
        }
        foundName = f.name ? f.name.stringValue : "Teacher";
        teacherDocId = matchedDoc.name.split('/').pop();
        dbPhoneToSave = f.phone ? f.phone.stringValue : norm11;
        foundPhoto = (f.photoUrl && f.photoUrl.stringValue) ? f.photoUrl.stringValue : ((f.photo && f.photo.stringValue) ? f.photo.stringValue : DEFAULT_AVATAR);
      }

      tPhone = ph;
      tTeacherName = foundName;
      exactDbPhone = dbPhoneToSave;
      tTeacherPhoto = foundPhoto || DEFAULT_AVATAR;

      sessionStorage.setItem("srms_phone", ph);
      sessionStorage.setItem("srms_exact_phone", dbPhoneToSave);
      sessionStorage.setItem("srms_name", foundName);
      sessionStorage.setItem("srms_active_pass", s);
      sessionStorage.setItem("srms_teacher_photo", tTeacherPhoto);
      if (teacherDocId) sessionStorage.setItem("srms_teacher_id", teacherDocId);

      const teacherRoles = ["teacher_dashboard", "special_page_access"];
      sessionStorage.setItem("srms_user_roles", JSON.stringify(teacherRoles));
      sessionStorage.setItem("srms_active_session", "true");

      document.getElementById('lPs').value = '';
      showDashboardUI(foundName, tTeacherPhoto);
      loadBoard();
      loadTeacherLiveHubSessions();
    } catch (e) {
      err.innerText = "মোবাইল নম্বর অথবা পাসওয়ার্ড সঠিক নয়!";
      b.innerHTML = "লগইন করুন ➔";
      b.disabled = false;
    }
  }

