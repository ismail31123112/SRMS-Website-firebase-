  // 🔗 আপনার Teacher Login Backend URL (Website Management-এর ব্যাকএন্ড এখানে ব্যবহৃত হচ্ছে না)
  const TEACHER_BACKEND_URL = "https://script.google.com/macros/s/AKfycbwwKLqGbAySUBEUrIyeqJhDw483XSecbxhg43PlJWQDw8hRiXZVD5G3luQDTKOjpWNlpw/exec"; 
