  async function startTeacherStudentLiveClass() {
    const sClass = document.getElementById('tLiveClass').value;
    const name = document.getElementById('tLiveName').value.trim() || tTeacherName || "Teacher";
    const sub = document.getElementById('tLiveSub').value.trim();
    const pic = document.getElementById('tLivePic').value;
    const btn = document.getElementById('tStartLiveBtn');

    if (!name || !sub) {
      alert("⚠️ অনুগ্রহ করে শিক্ষকের নাম এবং পাঠের বিষয় লিখুন!");
      return;
    }

    if (sClass === "Teachers" || sClass === "Guardian" || sClass === "All") {
      alert("শুধুমাত্র কর্তৃপক্ষ এই মিটিং শুরু করতে পারবেন।");
      return;
    }

    btn.disabled = true;
    btn.innerHTML = `<span class="loader-spinner"></span> ক্লাস শুরু হচ্ছে...`;

    const config = `#config.prejoinPageEnabled=false&userInfo.displayName="${encodeURIComponent(name + ' (Teacher)')}"&userInfo.avatarUrl="${encodeURIComponent(pic)}"&interfaceConfig.TOOLBAR_BUTTONS=["microphone","camera","desktop","chat","raisehand","mute-everyone","security","tileview","fullscreen","hangup","settings","recording","livestreaming"]`;
    window.open(`https://meet.jit.si/SRMS-Live-${sClass}${config}`, '_blank');

    const nowTime = new Date().toLocaleTimeString("en-US", { hour: '2-digit', minute: '2-digit' });

    try {
      if (auth.currentUser) {
        const token = await auth.currentUser.getIdToken();
        const payload = {
          fields: {
            status: { stringValue: "TRUE" },
            title: { stringValue: sub },
            host: { stringValue: name },
            hostRole: { stringValue: "Teacher" },
            startTime: { stringValue: nowTime },
            updatedAt: { integerValue: Date.now().toString() }
          }
        };
        const patchUrl = `${FIREBASE_DB_BASE}/LiveSessions/${encodeURIComponent(sClass)}?updateMask.fieldPaths=status&updateMask.fieldPaths=title&updateMask.fieldPaths=host&updateMask.fieldPaths=hostRole&updateMask.fieldPaths=startTime&updateMask.fieldPaths=updatedAt`;
        const pRes = await fetch(patchUrl, {
          method: "PATCH",
          headers: { "Content-Type": "application/json", "Authorization": "Bearer " + token },
          body: JSON.stringify(payload)
        });
        if (pRes.status === 404) {
          await fetch(`${FIREBASE_DB_BASE}/LiveSessions?documentId=${encodeURIComponent(sClass)}`, {
            method: "POST",
            headers: { "Content-Type": "application/json", "Authorization": "Bearer " + token },
            body: JSON.stringify(payload)
