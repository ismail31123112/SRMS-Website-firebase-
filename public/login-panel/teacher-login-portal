  async function loadStudentsForWarn() {
      const cls = document.getElementById('wCls').value; if(!cls) return;
      document.getElementById('wStuBox').innerHTML = "<span class='loader-spinner' style='border-top-color:var(--primary);'></span> Loading Data...";
