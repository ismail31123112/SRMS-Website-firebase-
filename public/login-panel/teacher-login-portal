  function getStudentClassLabel(code) {
    const sel = document.getElementById('tLiveClass');
    const opt = Array.from(sel.options).find(o => o.value === code);
    return opt ? opt.text : ("Class " + code);
  }

  async function loadTeacherLiveHubSessions() {
    const container = document.getElementById('teacherActiveClassesContainer');
    const meetingBanner = document.getElementById('teacherMeetingAlertBox');

    try {
      const res = await fetch(`${FIREBASE_DB_BASE}/LiveSessions?pageSize=100`);
      const data = await res.json();
      const docs = data.documents || [];

      let studentClassesHtml = "";
      let activeAdminMeeting = null;

      docs.forEach(d => {
        const f = d.fields || {};
        const docName = d.name.split("/").pop();
        const status = f.status ? f.status.stringValue : "FALSE";

        if (status === "TRUE") {
          const title = f.title ? f.title.stringValue : "Live Session";
          const host = f.host ? f.host.stringValue : "Educator";
          const startTime = f.startTime ? f.startTime.stringValue : "চলমান";

          if (docName === "Teachers" || docName === "All") {
            activeAdminMeeting = { room: docName, title: title, host: host, startTime: startTime };
          } else if (docName !== "Guardian") {
            const clsLabel = getStudentClassLabel(docName);
            studentClassesHtml += `
              <div class="live-class-item">
                <div>
                  <p style="font-size:15px; font-weight:800; color:var(--primary);">🔴 ${sanitizeHTML(clsLabel)} <span style="font-size:11px; background:#dcfce7; padding:2px 8px; border-radius:10px; margin-left:6px;">${sanitizeHTML(startTime)}</span></p>
                  <p><b>বিষয়:</b> ${sanitizeHTML(title)}</p>
                  <p style="font-size:12px; color:#475569;"><b>শিক্ষক:</b> ${sanitizeHTML(host)}</p>
                </div>
                <div style="display:flex; gap:8px;">
                  <button class="btn-rejoin-live" onclick="joinStudentLiveClassAsTeacher('${docName}')"><i class="fas fa-video"></i> যুক্ত হোন</button>
                  <button class="btn-stop-live" onclick="endStudentLiveClassByTeacher('${docName}', '${sanitizeHTML(title).replace(/'/g, "")}', this)">🔴 ক্লাস শেষ করুন</button>
                </div>
              </div>`;
          }
        }
      });

      if (activeAdminMeeting) {
        meetingBanner.style.display = "flex";
        document.getElementById('teacherMeetingTitle').innerText = `📢 ${activeAdminMeeting.title}`;
        document.getElementById('teacherMeetingHost').innerText = `পরিচালনায়: ${activeAdminMeeting.host} • শুরু: ${activeAdminMeeting.startTime}`;
        document.getElementById('joinAdminMeetingBtn').onclick = function() {
          joinAdminTeachersMeeting(activeAdminMeeting.room);
        };
      } else {
        meetingBanner.style.display = "none";
      }

      container.innerHTML = studentClassesHtml || `<p style="font-size:13px; color:#64748b; background:#f8fafc; padding:14px; border-radius:12px; border:1px dashed #cbd5e1; margin:0;">বর্তমানে কোনো শ্রেণির লাইভ ক্লাস চলছে না।</p>`;
    } catch (e) {
      container.innerHTML = `<p style="color:var(--danger); font-size:13px; font-weight:700;">লাইভ সেশন লোড করা যায়নি।</p>`;
    }
  }

