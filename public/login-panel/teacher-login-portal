          const data = await res.json();
          let students = [];
          if(data.documents) {
             data.documents.forEach(d => {
                let f = d.fields || {};
                if(f.class && f.class.stringValue === cls) { students.push({ id: f.studentID ? f.studentID.stringValue : d.name.split('/').pop(), roll: f.roll ? f.roll.stringValue : "0", name: f.name ? f.name.stringValue : "Unknown" }); }
             });
