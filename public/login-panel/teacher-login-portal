  async function loadBoard() {
    if (!auth.currentUser) return;
    const mBox = document.getElementById('manageBox');
    if (globalPostsCache.length === 0) {
      mBox.innerHTML = "<p style='text-align:center; color:#64748b; font-weight:600;'><span class='loader-spinner' style='border-top-color:var(--primary);'></span> তথ্য লোড হচ্ছে...</p>";
    }
    try {
      const token = await auth.currentUser.getIdToken();
      const headers = { "Authorization": "Bearer " + token };
      const [pRes, wRes] = await Promise.all([
        fetch(`${FIREBASE_DB_BASE}/WebsitePosts?pageSize=500`, { headers }).catch(() => ({ json: () => ({ documents: [] }) })),
        fetch(`${FIREBASE_DB_BASE}/Warnings?pageSize=500`, { headers }).catch(() => ({ json: () => ({ documents: [] }) }))
      ]);
      const postsData = await pRes.json(), warnsData = await wRes.json();

      let posts = (postsData.documents || []).map(d => {
        let f = d.fields || {};
        return {
          rowId: d.name.split('/').pop(),
          target: f.targetPage ? f.targetPage.stringValue : "",
          title: f.title ? f.title.stringValue : "",
          desc: f.desc ? f.desc.stringValue : "",
          date: f.date ? f.date.stringValue : "",
          fileType: f.fileType ? f.fileType.stringValue : "None",
          fileUrl: f.fileUrl ? f.fileUrl.stringValue : "",
          thumbUrl: f.thumbUrl ? f.thumbUrl.stringValue : (f.fileUrl ? f.fileUrl.stringValue : ""),
          imgbbId: f.imgbbId ? f.imgbbId.stringValue : "",
          imgbbDeleteUrl: f.imgbbDeleteUrl ? f.imgbbDeleteUrl.stringValue : "",
          driveFileId: f.driveFileId ? f.driveFileId.stringValue : "",
          uploader: f.uploader ? f.uploader.stringValue : "",
          uploaderName: f.uploaderName ? f.uploaderName.stringValue : "",
          time: parseInt(f.timestamp && f.timestamp.integerValue ? f.timestamp.integerValue : "0", 10)
        };
      });
      posts.sort((a, b) => b.time - a.time);

      let warns = (warnsData.documents || []).map(d => {
        let f = d.fields || {};
        return {
          id: d.name.split('/').pop(),
          name: f.name ? f.name.stringValue : "",
          message: f.message ? f.message.stringValue : "",
          teacherPhone: f.teacherPhone ? f.teacherPhone.stringValue : ""
        };
      });

      globalPostsCache = posts;
      globalWarnsCache = warns;
      renderBoardUI();
    } catch (e) {
      mBox.innerHTML = "<p style='text-align:center; color:var(--danger);'>তথ্য লোড করা যায়নি।</p>";
    }
  }

