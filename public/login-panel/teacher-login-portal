  async function sendWarning() {
    const selectBox = document.getElementById('wStuId');
    const sid = selectBox ? selectBox.value : null;
    const sName = selectBox && selectBox.selectedIndex > 0 ? selectBox.options[selectBox.selectedIndex].getAttribute('data-name') : "Student";
    const msg = document.getElementById('wMsg').value.trim();
    const btn = document.getElementById('wBtn');

    if (!sid || !msg) return alert("অনুগ্রহ করে শিক্ষার্থী নির্বাচন করুন এবং সতর্কবার্তা লিখুন।");
    btn.innerHTML = '<span class="loader-spinner"></span> পাঠানো হচ্ছে...';
    btn.disabled = true;

    const normPhone = normalizePhone11JS(tPhone);
    const payload = {
      fields: {
        studentID: { stringValue: sid },
        name: { stringValue: sName },
        message: { stringValue: msg },
        teacherPhone: { stringValue: normPhone },
        timestamp: { stringValue: Date.now().toString() }
      }
    };
    try {
      const token = await auth.currentUser.getIdToken();
      const res = await fetch(`${FIREBASE_DB_BASE}/Warnings`, {
        method: "POST",
        headers: { "Content-Type": "application/json", "Authorization": "Bearer " + token },
        body: JSON.stringify(payload)
      });
      const saved = await res.json();
      const newId = saved.name ? saved.name.split('/').pop() : ("W_" + Date.now());
      globalWarnsCache.unshift({ id: newId, name: sName, message: msg, teacherPhone: normPhone });
      renderBoardUI();
      document.getElementById('wMsg').value = "";
      alert("✅ সতর্কবার্তা সফলভাবে শিক্ষার্থীর পোর্টালে পাঠানো হয়েছে!");
    } catch (e) {
      alert("সতর্কবার্তা পাঠানো যায়নি।");
    }
    btn.innerHTML = '<i class="fas fa-paper-plane"></i> সতর্কবার্তা পাঠান';
    btn.disabled = false;
  }

  // =========================================================================
  // 🚀 ACADEMIC CONTENT PUBLISHING (BACKGROUND PRE-UPLOAD FOR 0.2s SPEED)
  // =========================================================================
  function clearAcademicFile() {
    document.getElementById('uFileInput').value = "";
    document.getElementById('uFilePreviewBox').style.display = "none";
    preparedAcademicFile = null;
  }

  function handleAcademicFileSelect(input) {
    if (!input.files || input.files.length === 0) {
      clearAcademicFile();
      return;
    }
    const file = input.files[0];
    const box = document.getElementById('uFilePreviewBox');
    const imgEl = document.getElementById('uFilePreviewImg');
    const metaEl = document.getElementById('uFilePreviewMeta');

    if (file.type.startsWith("image/")) {
      metaEl.innerHTML = `<i class="fas fa-spinner fa-spin"></i> ছবিটি প্রস্তুত করা হচ্ছে...`;
      box.style.display = "flex";

      const reader = new FileReader();
      reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
          const maxDim = 1280;
          let w = img.width, h = img.height;
          if (w > maxDim || h > maxDim) {
            if (w > h) { h = Math.round((h * maxDim) / w); w = maxDim; }
            else { w = Math.round((w * maxDim) / h); h = maxDim; }
          }
          const canvas = document.createElement('canvas');
          canvas.width = w;
          canvas.height = h;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, w, h);

          const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
          imgEl.src = dataUrl;
          const kbSize = Math.round((dataUrl.length * 0.75) / 1024);
          const cleanName = file.name.replace(/\.[^/.]+$/, "") + ".jpg";
          const rawB64 = dataUrl.split(',')[1];

          const fileObj = {
            isImage: true,
            fileData: rawB64,
            mimeType: 'image/jpeg',
            fileName: cleanName,
            uploadedResult: null,
            uploadPromise: null
          };

          // ব্যাকগ্রাউন্ডে সাথে সাথে প্রি-আপলোড শুরু
          fileObj.uploadPromise = uploadMediaDirect(rawB64, cleanName).then(res => {
            fileObj.uploadedResult = res;
            metaEl.innerHTML = `<b>${sanitizeHTML(cleanName)}</b><br>✅ প্রকাশের জন্য সম্পূর্ণ প্রস্তুত (~${kbSize} KB)`;
            return res;
          }).catch(() => null);

          preparedAcademicFile = fileObj;
          metaEl.innerHTML = `<b>${sanitizeHTML(cleanName)}</b><br>⏳ ব্যাকগ্রাউন্ডে প্রস্তুত হচ্ছে (~${kbSize} KB)...`;
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    } else {
      imgEl.src = "https://cdn-icons-png.flaticon.com/512/337/337946.png";
      metaEl.innerHTML = `<i class="fas fa-spinner fa-spin"></i> ডকুমেন্ট লোড হচ্ছে...`;
      box.style.display = "flex";

      const reader = new FileReader();
      reader.onload = function(e) {
        const kbSize = Math.round(file.size / 1024);
        preparedAcademicFile = {
          isImage: false,
          fileData: e.target.result.split(',')[1],
          mimeType: file.type || 'application/octet-stream',
          fileName: file.name
        };
        metaEl.innerHTML = `<b>${sanitizeHTML(file.name)}</b><br>✅ ডকুমেন্ট প্রস্তুত (${kbSize} KB)`;
      };
      reader.readAsDataURL(file);
    }
  }

  async function upload() {
    if (isUploadingPost) return;
    const btn = document.getElementById('uBtn');
    const cls = document.getElementById('uCls').value;
    const ttl = document.getElementById('uTtl').value.trim();
    const dsc = document.getElementById('uDsc').value.trim();
    const url = document.getElementById('uUrl').value.trim();

    if (!cls || !ttl) return alert("⚠️ অনুগ্রহ করে শ্রেণি এবং শিরোনাম লিখুন!");
    if (ALLOWED_CLASS_TARGETS.indexOf(cls) === -1) {
      return alert("⛔ শুধুমাত্র নির্ধারিত ক্লাস ড্যাশবোর্ডে (Class Play - Class 10) শিক্ষা উপকরণ প্রকাশ করা যাবে!");
    }

    isUploadingPost = true;
    btn.disabled = true;
    btn.innerHTML = '<span class="loader-spinner"></span> প্রকাশিত হচ্ছে...';

    const uploaderNorm = normalizePhone11JS(tPhone);
    let postData = {
      reqId: "T_REQ_" + Date.now(),
      targetPage: cls,
      title: ttl,
      desc: dsc,
      externalUrl: url,
      uploader: uploaderNorm,
      teacherName: tTeacherName
    };

    try {
      if (preparedAcademicFile) {
        if (preparedAcademicFile.isImage) {
          let upRes = preparedAcademicFile.uploadedResult;
          if (!upRes && preparedAcademicFile.uploadPromise) {
            upRes = await preparedAcademicFile.uploadPromise;
          }
          if (upRes && upRes.url) {
            postData.fileUrl = upRes.url;
            postData.externalUrl = upRes.url;
            postData.thumbUrl = upRes.thumbUrl;
            postData.imgbbId = upRes.imgbbId;
            postData.imgbbDeleteUrl = upRes.deleteUrl;
            postData.fileType = "Image";
          } else {
            postData.fileData = preparedAcademicFile.fileData;
            postData.mimeType = preparedAcademicFile.mimeType;
            postData.fileName = preparedAcademicFile.fileName;
          }
        } else {
          postData.fileData = preparedAcademicFile.fileData;
          postData.mimeType = preparedAcademicFile.mimeType;
          postData.fileName = preparedAcademicFile.fileName;
        }
      }

      const res = await teacherApiCall("teacherUploadPost", { data: postData });

      if (res.docId) {
        globalPostsCache.unshift({
          rowId: res.docId,
          target: cls,
          title: ttl,
          desc: dsc,
          date: res.date || new Date().toLocaleDateString('en-GB').replace(/\//g, '-'),
          fileType: res.fileType || postData.fileType || (url ? "Link" : "None"),
          fileUrl: res.fileUrl || postData.fileUrl || url || "",
          thumbUrl: res.thumbUrl || postData.thumbUrl || res.fileUrl || "",
          imgbbId: res.imgbbId || postData.imgbbId || "",
          imgbbDeleteUrl: res.imgbbDeleteUrl || postData.imgbbDeleteUrl || "",
          driveFileId: res.driveFileId || "",
          uploader: uploaderNorm,
          uploaderName: tTeacherName,
          time: res.timestamp || Date.now()
        });
        renderBoardUI();
      } else {
        loadBoard();
      }

      document.getElementById('uCls').value = "";
      document.getElementById('uTtl').value = "";
      document.getElementById('uDsc').value = "";
      document.getElementById('uUrl').value = "";
      clearAcademicFile();
      alert(res.msg || "✅ শিক্ষা উপকরণটি সফলভাবে প্রকাশিত হয়েছে!");
    } catch (e) {
      alert("❌ প্রকাশ করতে সমস্যা হয়েছে: " + e.message);
    } finally {
      isUploadingPost = false;
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-check-circle"></i> ক্লাস ড্যাশবোর্ডে প্রকাশ করুন';
    }
  }

  // =========================================================================
  // 📅 TEACHER DETAILED ATTENDANCE MODAL (VIEW-ONLY, NO PRINT OPTION)
  // =========================================================================
  function openTeacherAttendanceModal() {
    document.getElementById('attendanceModal').style.display = 'flex';
    fetchTeacherDetailedAttendance();
  }

  async function fetchTeacherDetailedAttendance() {
    document.getElementById('attLoader').style.display = 'block';
    document.getElementById('modalAttTableBody').innerHTML = '';

    try {
      const token = await auth.currentUser.getIdToken();
      const headers = { "Content-Type": "application/json", "Authorization": "Bearer " + token };

      const attReq = {
        structuredQuery: {
          from: [{ collectionId: "AttendanceHistory" }],
          where: { fieldFilter: { field: { fieldPath: "studentID" }, op: "EQUAL", value: { stringValue: exactDbPhone } } },
          limit: 2000
        }
      };

      const [attRes, holRes] = await Promise.all([
        fetch(`${FIREBASE_DB_BASE}:runQuery`, { method: "POST", headers, body: JSON.stringify(attReq) }),
        fetch(`${FIREBASE_DB_BASE}/Holidays?pageSize=1000`, { headers })
      ]);

      const attData = await attRes.json();
      const holData = await holRes.json();

      allTeacherAttendance = {};
      if (attData && attData.length > 0 && attData[0].document) {
        attData.forEach(item => {
          if (item.document && item.document.fields) {
            let f = item.document.fields;
            let pDate = sanitizeHTML(f.pureDate?.stringValue || "");
            let timeStr = sanitizeHTML(f.time?.stringValue || "");
            let type = sanitizeHTML(f.type?.stringValue || "");

            if (pDate) {
              if (!allTeacherAttendance[pDate]) { allTeacherAttendance[pDate] = { in: "-", out: "-", isLeave: false, leaveReason: "" }; }
              if (type === "IN") allTeacherAttendance[pDate].in = timeStr;
              else if (type === "OUT") allTeacherAttendance[pDate].out = timeStr;
              else if (type === "LEAVE") {
                allTeacherAttendance[pDate].isLeave = true;
                allTeacherAttendance[pDate].leaveReason = timeStr || "Approved Leave";
              }
            }
          }
        });
      }

      allHolidays = {};
      if (holData && holData.documents) {
        holData.documents.forEach(doc => {
          let f = doc.fields;
          let pDate = f.date?.stringValue;
          let reason = f.reason?.stringValue || "Holiday";
          if (pDate) allHolidays[pDate] = reason;
        });
      }

      populateTeacherAttendanceMonths();
    } catch (e) {
      document.getElementById('modalAttTableBody').innerHTML = '<tr><td colspan="4" style="text-align:center; padding:15px; color:var(--danger); font-weight:bold;">উপস্থিতির তথ্য লোড করা যায়নি।</td></tr>';
    }
    document.getElementById('attLoader').style.display = 'none';
  }

  function populateTeacherAttendanceMonths() {
    let select = document.getElementById('attMonthFilter');
    select.innerHTML = "";

    const bdTime = new Date().toLocaleString("en-US", { timeZone: "Asia/Dhaka" });
    const now = new Date(bdTime);

    let months = [];
    for (let i = 0; i < 12; i++) {
      let d = new Date(now.getFullYear(), now.getMonth() - i, 1);
      let mStr = d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, '0');
      months.push(mStr);
    }

    months.forEach(m => {
      let dateObj = new Date(m + "-01");
      let monthName = dateObj.toLocaleString('default', { month: 'long', year: 'numeric' });
      select.innerHTML += `<option value='${m}'>${monthName}</option>`;
    });

    renderTeacherAttendanceTable(months[0]);
  }

  function renderTeacherAttendanceTable(selectedMonth = null) {
    if (!selectedMonth) selectedMonth = document.getElementById('attMonthFilter').value;
    let tbody = document.getElementById('modalAttTableBody');
    let summaryBox = document.getElementById('modalAttSummary');
    let yearlySummaryBox = document.getElementById('modalYearlySummary');

    const bdTime = new Date().toLocaleString("en-US", { timeZone: "Asia/Dhaka" });
    const today = new Date(bdTime);

    let dateParts = selectedMonth.split('-');
    let sYear = parseInt(dateParts[0], 10);
    let sMonth = parseInt(dateParts[1], 10);

    let daysInMonth = new Date(sYear, sMonth, 0).getDate();
    let daysToLoop = daysInMonth;

    if (sYear > today.getFullYear() || (sYear === today.getFullYear() && sMonth > today.getMonth() + 1)) {
      tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:30px; color:#64748b; font-weight:600;">ভবিষ্যতের মাসের কোনো রেকর্ড নেই।</td></tr>';
      summaryBox.style.display = 'none';
      yearlySummaryBox.style.display = 'none';
      return;
    }

    if (sYear === today.getFullYear() && sMonth === today.getMonth() + 1) {
      daysToLoop = today.getDate();
    }

    let isYearFinished = (sYear < today.getFullYear());
    if (!isYearFinished) {
      yearlySummaryBox.style.display = 'none';
      yearlySummaryBox.innerHTML = '';
    } else {
      let yearlyPresentCount = 0;
      let yearlyAbsentCount = 0;

      for (let m = 1; m <= 12; m++) {
        let mStr = sYear + "-" + String(m).padStart(2, '0');
        let mPresent = 0;
        let mHoliday = 0;
        let daysInM = new Date(sYear, m, 0).getDate();

        for (let d = 1; d <= daysInM; d++) {
          let dStr = String(d).padStart(2, '0');
          let fDate = `${mStr}-${dStr}`;
          if (allTeacherAttendance[fDate]) mPresent++;
          else if (allHolidays[fDate]) mHoliday++;
        }

        yearlyPresentCount += mPresent;
        let workingDaysInM = Math.max(mPresent, daysInM - mHoliday - 4);
        let mAbsent = Math.max(0, workingDaysInM - mPresent);
        yearlyAbsentCount += mAbsent;
      }

      yearlySummaryBox.style.display = 'block';
      yearlySummaryBox.innerHTML = `বার্ষিক সারসংক্ষেপ (<span style="color:var(--accent);">${sYear}</span>): <span style="font-size: 17px;">${yearlyPresentCount} দিন উপস্থিত</span> <span style="opacity:0.5; margin:0 10px;">|</span> <span style="color:#fecdd3; font-size:17px;">~${yearlyAbsentCount} দিন অনুপস্থিত</span>`;
    }

    let presentCount = 0;
    let absentCount = 0;
    let holidayCount = 0;
    let rowsArr = [];

    for (let d = daysToLoop; d >= 1; d--) {
      let dStr = String(d).padStart(2, '0');
      let fullDate = `${sYear}-${String(sMonth).padStart(2, '0')}-${dStr}`;

      let statusHtml = "";
      let inTime = "-";
      let outTime = "-";
      let bgRow = "";

      if (allHolidays[fullDate]) {
        statusHtml = `<span style="color:var(--warning); font-weight:800; font-size:12px;">⛱️ ${sanitizeHTML(allHolidays[fullDate])}</span>`;
        holidayCount++;
        bgRow = "background: #fffbeb;";
      } else if (allTeacherAttendance[fullDate]) {
        let rec = allTeacherAttendance[fullDate];
        if (rec.isLeave) {
          statusHtml = `<span style="color:#4f46e5; font-weight:800; font-size:12px;">🟣 ছুটি (${sanitizeHTML(rec.leaveReason)})</span>`;
          holidayCount++;
          bgRow = "background: #eef2ff;";
        } else {
          inTime = rec.in;
          outTime = rec.out;
          statusHtml = `<span style="color:var(--success); font-weight:800; font-size:12px;">✅ উপস্থিত</span>`;
          presentCount++;
        }
      } else {
        statusHtml = `<span style="color:var(--danger); font-weight:800; font-size:12px;">❌ অনুপস্থিত</span>`;
        absentCount++;
        bgRow = "background: #fff1f2;";
      }

      rowsArr.push(`
        <tr style="border-bottom: 1px solid #f1f5f9; ${bgRow}">
          <td style="padding: 12px 14px; font-weight:700; color:var(--text-main); font-size:13px;">${fullDate}</td>
          <td style="padding: 12px 14px;">${statusHtml}</td>
          <td style="padding: 12px 14px; color:#059669; font-weight:700; font-size:12px;">${inTime}</td>
          <td style="padding: 12px 14px; color:#e11d48; font-weight:700; font-size:12px;">${outTime}</td>
        </tr>`);
    }

    if (rowsArr.length === 0) {
      tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:30px; color:#64748b; font-weight:600;">উপস্থিতির কোনো রেকর্ড পাওয়া যায়নি।</td></tr>';
      summaryBox.style.display = 'none';
    } else {
      tbody.innerHTML = rowsArr.join('');
      summaryBox.style.display = 'flex';
      summaryBox.innerHTML = `
        <span style="display:flex; flex-direction:column; align-items:center;">
          <small style="color:#64748b; font-size:11px; text-transform:uppercase;">উপস্থিত</small>
          <span style="font-size:18px; color:var(--success); font-weight:900;">${presentCount}</span>
        </span>
        <span style="display:flex; flex-direction:column; align-items:center;">
          <small style="color:#64748b; font-size:11px; text-transform:uppercase;">অনুপস্থিত</small>
          <span style="font-size:18px; color:var(--danger); font-weight:900;">${absentCount}</span>
        </span>
        <span style="display:flex; flex-direction:column; align-items:center;">
          <small style="color:#64748b; font-size:11px; text-transform:uppercase;">ছুটি / বন্ধ</small>
          <span style="font-size:18px; color:var(--warning); font-weight:900;">${holidayCount}</span>
        </span>
      `;
    }
  }
</script>
