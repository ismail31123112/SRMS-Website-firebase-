  function extractPortalSubAndExam(headerText) {
      if(!headerText) return { sub: "Unknown", exam: "Exam", type: "Test" };
      let clean = String(headerText).replace(/\[.*?\]/g, '').replace(/\([^)]+\)/g, '').trim();
      let parts = clean.split(" - ");
      if(parts.length >= 3) { return { sub: parts[0].trim(), exam: parts[1].trim(), type: parts[2].includes("Main") ? "Main" : "Test" }; }
      return { sub: clean, exam: "Exam", type: "Test" };
  }

  function parsePortalHeaders(headers) {
      let firstEmpty = headers.indexOf(""); if(firstEmpty === -1) firstEmpty = headers.length;
      let subjects = {}; let testSeq = []; let mainSeq = []; let c = 3;
      while(c < firstEmpty && c < headers.length) {
          let startC = c; let hStr = String(headers[c] || "");
          if (hStr.toLowerCase().includes("opt") && hStr.toLowerCase().includes("name")) {
              let optSubName = hStr.replace(/Opt Name/i, "").trim();
              if(!subjects[optSubName]) subjects[optSubName] = { isOpt: true, nameCol: c, tests: [], mains: [] };
              let j = c + 1;
              while(j < firstEmpty && String(headers[j] || "").startsWith(optSubName + " - ")) {
                  let info = extractPortalSubAndExam(headers[j]);
                  if(String(headers[j]).includes(" - Main")) { subjects[optSubName].mains.push(j); if(info.exam && !mainSeq.includes(info.exam)) mainSeq.push(info.exam); } 
                  else { subjects[optSubName].tests.push(j); if(info.exam && !testSeq.includes(info.exam)) testSeq.push(info.exam); } j++;
              }
              c = j;
          } else {
              let subName = hStr.split(" - ")[0].trim();
              if(!subjects[subName]) subjects[subName] = { isOpt: false, tests: [], mains: [] };
              let j = c;
              while(j < firstEmpty && String(headers[j] || "").startsWith(subName + " - ")) {
                  let info = extractPortalSubAndExam(headers[j]);
                  if(String(headers[j]).includes(" - Main")) { subjects[subName].mains.push(j); if(info.exam && !mainSeq.includes(info.exam)) mainSeq.push(info.exam); } 
                  else { subjects[subName].tests.push(j); if(info.exam && !testSeq.includes(info.exam)) testSeq.push(info.exam); } j++;
              }
              c = j;
          }
          if (c === startC) c++;
      }
      return { subjects, testSeq, mainSeq, firstEmpty };
  }

  function renderResults(h, d) {
      let parsed = parsePortalHeaders(h); let firstEmpty = parsed.firstEmpty;
      if (firstEmpty !== -1 && d[firstEmpty + 2]) {
          let totalAvg = sanitizeHTML(d[firstEmpty+1] || "0.00"); let gpa = sanitizeHTML(d[firstEmpty+2] || "0.00");
          let grade = sanitizeHTML(d[firstEmpty+3] || "F"); let pos = sanitizeHTML(d[firstEmpty+4] || "-");
          let failReason = sanitizeHTML(d[firstEmpty+5] || "None"); let year = sanitizeHTML(d[firstEmpty+6] || d[firstEmpty+5] || new Date().getFullYear().toString());
          if (year === failReason) year = new Date().getFullYear().toString();

          let subHtml = "";

          Object.keys(parsed.subjects).forEach(subName => {
              let sub = parsed.subjects[subName];
              let displaySubName = sub.isOpt ? sanitizeHTML(d[sub.nameCol] || subName) + ` <span style="font-size:11px; color:#94a3b8; font-weight:normal;">(Optional)</span>` : sanitizeHTML(subName);
              
              let testBreakdownHtml = "";
              sub.tests.forEach((col, index) => {
                  let headerText = h[col] || ""; let vStr = String(d[col] || "").trim();
                  if(vStr !== "") {
                      let info = extractPortalSubAndExam(headerText); let examNameStr = info.exam !== "Exam" ? info.exam : `Test ${index+1}`;
                      let match = headerText.match(/\(([^)]+)\)/); let labels = ["Marks"];
                      if (match && match[1].includes(":")) labels = match[1].split('+').map(p => p.split(':')[0].trim());
                      else if (match && !match[1].includes(":")) labels = ["Total"];
                      let vals = vStr.includes("+") ? vStr.split('+').map(p => p.trim()) : [vStr];
                      
                      let boxesHtml = "";
                      labels.forEach((lbl, i) => {
                          let val = vals[i] || "-"; let color = i===0 ? "#e2e8f0" : (i===1 ? "#cbd5e1" : "#94a3b8");
                          boxesHtml += `<div class="mark-group" style="background:rgba(255,255,255,0.05); border-color:rgba(255,255,255,0.1);"><div class="mark-label">${sanitizeHTML(lbl)}</div><div class="mark-val" style="color:${color};">${sanitizeHTML(val)}</div></div>`;
                      });

                      testBreakdownHtml += `
                        <div class="dt-exam-card" style="background:rgba(255,255,255,0.05);">
                          <span style="font-size:9px; color:#cbd5e1; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; border-bottom:1px dashed #475569; padding-bottom:2px; width: 100%; text-align: center;"><i class="fas fa-file-signature"></i> ${sanitizeHTML(examNameStr)}</span>
                          <div style="display:flex; gap:6px; flex-wrap: wrap; justify-content: center;">${boxesHtml}</div>
                        </div>`;
                  }
              });
              if(testBreakdownHtml === "" && sub.tests.length > 0) {
                 testBreakdownHtml = `<div class="dt-exam-card" style="background:rgba(255,255,255,0.05);"><span style="font-size:9.5px; color:#cbd5e1; font-weight:700; text-transform:uppercase; border-bottom:1px dashed #475569; padding-bottom:2px; width:100%; text-align:center;">Pending</span><div class="mark-group" style="background:rgba(255,255,255,0.05); border-color:rgba(255,255,255,0.1);"><div class="mark-label">Total</div><div class="mark-val" style="color:#94a3b8;">-</div></div></div>`;
              } else if (testBreakdownHtml === "") { testBreakdownHtml = `<div class="mark-val" style="color:#e2e8f0; margin-top:2px;">-</div>`; }

              let mainBreakdownHtml = "";
              sub.mains.forEach((col, index) => {
                  let headerText = h[col] || ""; let vStr = String(d[col] || "").trim();
                  if(vStr !== "") {
                      let info = extractPortalSubAndExam(headerText); let examNameStr = info.exam !== "Exam" ? info.exam : `Exam ${index+1}`;
                      let match = headerText.match(/\(([^)]+)\)/); let labels = ["Marks"];
                      if (match && match[1].includes(":")) labels = match[1].split('+').map(p => p.split(':')[0].trim());
                      else if (match && !match[1].includes(":")) labels = ["Total"];
                      let vals = vStr.includes("+") ? vStr.split('+').map(p => p.trim()) : [vStr];
                      
                      let boxesHtml = "";
                      labels.forEach((lbl, i) => {
                          let val = vals[i] || "-"; let color = i===0 ? "#38bdf8" : (i===1 ? "#fbbf24" : (i===2 ? "#34d399" : "#f472b6"));
                          boxesHtml += `<div class="mark-group"><div class="mark-label">${sanitizeHTML(lbl)}</div><div class="mark-val" style="color:${color};">${sanitizeHTML(val)}</div></div>`;
                      });

                      mainBreakdownHtml += `
                        <div class="dt-exam-card">
                          <span style="font-size:9.5px; color:#cbd5e1; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; border-bottom:1px dashed #475569; padding-bottom:2px; width: 100%; text-align: center;"><i class="fas fa-trophy" style="color:#fbbf24;"></i> ${sanitizeHTML(examNameStr)}</span>
                          <div style="display:flex; gap:6px; flex-wrap: wrap; justify-content: center;">${boxesHtml}</div>
                        </div>`;
                  }
              });
              
              if(mainBreakdownHtml === "" && sub.mains.length > 0) {
                 mainBreakdownHtml = `<div class="dt-exam-card"><span style="font-size:9.5px; color:#cbd5e1; font-weight:700; text-transform:uppercase; border-bottom:1px dashed #475569; padding-bottom:2px; width:100%; text-align:center;">Result</span><div class="mark-group"><div class="mark-label">Total</div><div class="mark-val" style="color:#38bdf8;">-</div></div></div>`;
              }

              if(testBreakdownHtml !== `<div class="mark-val" style="color:#e2e8f0; margin-top:2px;">-</div>` || mainBreakdownHtml !== "") {
                  subHtml += `<div class="dt-row">
                                <div class="dt-row-top"><div class="sub-name" style="color:${sub.isOpt ? '#38bdf8' : '#f8fafc'};">${displaySubName}</div></div>
                                <div class="dt-exam-split">
                                    <div class="dt-test-section"><div class="dt-section-title"><i class="fas fa-pen-nib"></i> Test Exam(s) Breakdown</div><div class="dt-test-flex">${testBreakdownHtml}</div></div>
                                    <div class="dt-divider"></div>
                                    <div class="dt-main-section"><div class="dt-section-title"><i class="fas fa-award"></i> Main Exam(s) Breakdown</div><div class="dt-main-flex">${mainBreakdownHtml}</div></div>
                                </div>
                              </div>`;
              }
          });

          let failBanner = (failReason && failReason !== "None") ? `<div style="text-align:center; color:#fecdd3; background:rgba(225,29,72,0.2); border:1px solid rgba(225,29,72,0.4); padding:10px; border-radius:12px; font-size:12px; font-weight:700; margin-bottom:16px;">⚠️ Remarks: Failed in ${failReason}</div>` : "";
          let seqBanner = `<div class="dt-seq-box"><div>📌 <b>Tests Included:</b> [ ${sanitizeHTML(parsed.testSeq.join(" / ") || "None")} ]</div><div style="margin-top:4px;">🏆 <b>Main Exams Included:</b> [ ${sanitizeHTML(parsed.mainSeq.join(" / ") || "None")} ]</div></div>`;

          markSheetHTML = `
            <div class="digital-transcript">
              <div class="scroll-indicator"><i class="fas fa-chevron-down"></i> Scroll down for subject-wise marks <i class="fas fa-chevron-down"></i></div>
              <div class="dt-header">
                  <h2 style="margin:0; color:#38bdf8; font-size:20px; font-weight:800; letter-spacing:1px;"><i class="fas fa-certificate"></i> DIGITAL TRANSCRIPT HUB</h2>
                  <p style="margin:5px 0 0 0; color:#94a3b8; font-size:12px;">Real-time Secure Academic Record • Session: ${year}</p>
              </div>
              
              <div style="padding:12px 15px; background:rgba(255,255,255,0.04); border-radius:12px; margin-bottom:16px; display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px; font-size:13px; border:1px solid #334155;">
                  <span><span style="color:#94a3b8;">ID:</span> <b style="color:#fff;">${std.id}</b></span>
                  <span><span style="color:#94a3b8;">Class:</span> <b style="color:#fff;">${std.class}${std.group ? ' ('+std.group+')' : ''}</b></span>
                  <span><span style="color:#94a3b8;">Roll:</span> <b style="color:#fff;">${std.roll}</b></span>
              </div>

              <div class="dt-summary-box">
                  <div style="text-align:center;"><p style="margin:0 0 4px 0; font-size:10px; color:#cbd5e1; font-weight:700; text-transform:uppercase;">GPA</p><h2 style="margin:0; font-size:24px; color:#fff; font-weight:900;">${gpa}</h2></div>
                  <div style="text-align:center;"><p style="margin:0 0 4px 0; font-size:10px; color:#cbd5e1; font-weight:700; text-transform:uppercase;">Grade</p><h2 style="margin:0; font-size:24px; color:${grade==='F'?'#fda4af':'#4ade80'}; font-weight:900;">${grade}</h2></div>
                  <div style="text-align:center;"><p style="margin:0 0 4px 0; font-size:10px; color:#cbd5e1; font-weight:700; text-transform:uppercase;">Rank</p><h2 style="margin:0; font-size:24px; color:#fbbf24; font-weight:900;">${pos}</h2></div>
                  <div style="text-align:center;"><p style="margin:0 0 4px 0; font-size:10px; color:#cbd5e1; font-weight:700; text-transform:uppercase;">Total Avg</p><h2 style="margin:0; font-size:22px; color:#38bdf8; font-weight:900;">${totalAvg}</h2></div>
              </div>
              ${failBanner}
              ${seqBanner}
              <div style="margin-bottom:20px;">${subHtml}</div>
              <div class="dt-warning-text"><i class="fas fa-info-circle"></i> THIS IS A DIGITAL PREVIEW • NOT FOR OFFICIAL USE</div>
            </div>`;
      }
  }

  function viewResultModal() {
    if(!markSheetHTML) return alert("Result data is not available or not calculated yet.");
    document.getElementById('resultModal').style.display = 'flex';
    document.getElementById('resultModalBody').innerHTML = markSheetHTML; 
  }

  function openAttendanceModal() { document.getElementById('attendanceModal').style.display = 'flex'; fetchDetailedAttendance(); }

  async function fetchDetailedAttendance() {
      document.getElementById('attLoader').style.display = 'block'; document.getElementById('modalAttTableBody').innerHTML = '';
      try {
          const [attSnap, holSnap] = await Promise.all([ db.collection("AttendanceHistory").where("studentID", "==", std.id).limit(2000).get(), db.collection("Holidays").get() ]);
          allStudentAttendance = {}; 
          attSnap.forEach(doc => { let f = doc.data(); let pDate = sanitizeHTML(f.pureDate || ""); let timeStr = sanitizeHTML(f.time || ""); let type = sanitizeHTML(f.type || ""); if(pDate) { if(!allStudentAttendance[pDate]) { allStudentAttendance[pDate] = { in: "-", out: "-" }; } if(type === "IN") allStudentAttendance[pDate].in = timeStr; if(type === "OUT") allStudentAttendance[pDate].out = timeStr; } });
          allHolidays = {};
          holSnap.forEach(doc => { let f = doc.data(); let pDate = f.date || doc.id; let reason = f.reason || "Holiday"; if(pDate) allHolidays[pDate] = reason; });
          populateAttendanceMonths();
      } catch(e) { document.getElementById('modalAttTableBody').innerHTML = '<tr><td colspan="4" style="text-align:center; padding:15px; color:var(--danger); font-weight:bold;">Failed to synchronize attendance data.</td></tr>'; }
      document.getElementById('attLoader').style.display = 'none';
  }

  function populateAttendanceMonths() {
      let select = document.getElementById('attMonthFilter'); select.innerHTML = "";
      const now = new Date(new Date().toLocaleString("en-US", {timeZone: "Asia/Dhaka"}));
      let months = []; for(let i=0; i<12; i++) { let d = new Date(now.getFullYear(), now.getMonth() - i, 1); months.push(d.getFullYear() + "-" + String(d.getMonth()+1).padStart(2, '0')); }
      months.forEach(m => { let monthName = new Date(m + "-01").toLocaleString('default', { month: 'long', year: 'numeric' }); select.innerHTML += `<option value='${m}'>${monthName}</option>`; });
      renderAttendanceTable(months[0]);
  }

  function renderAttendanceTable(selectedMonth = null) {
      if(!selectedMonth) selectedMonth = document.getElementById('attMonthFilter').value;
      let tbody = document.getElementById('modalAttTableBody'); let summaryBox = document.getElementById('modalAttSummary');
      const today = new Date(new Date().toLocaleString("en-US", {timeZone: "Asia/Dhaka"}));
      let dateParts = selectedMonth.split('-'); let sYear = parseInt(dateParts[0]); let sMonth = parseInt(dateParts[1]);
      let daysInMonth = new Date(sYear, sMonth, 0).getDate(); let daysToLoop = daysInMonth;
      if(sYear > today.getFullYear() || (sYear === today.getFullYear() && sMonth > today.getMonth() + 1)) { tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:30px; color:#64748b; font-weight:600;">No attendance records for future months.</td></tr>'; summaryBox.style.display = 'none'; return; }
      if(sYear === today.getFullYear() && sMonth === today.getMonth() + 1) { daysToLoop = today.getDate(); }

      let presentCount = 0; let absentCount = 0; let holidayCount = 0; let html = "";
      for(let d = daysToLoop; d >= 1; d--) {
           let fullDate = `${sYear}-${String(sMonth).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
           let statusHtml = ""; let inTime = "-"; let outTime = "-"; let bgRow = "";
           if(allHolidays[fullDate]) { statusHtml = `<span style="color:var(--warning); font-weight:800; font-size:12px;"><i class="fas fa-umbrella-beach"></i> ${sanitizeHTML(allHolidays[fullDate])}</span>`; holidayCount++; bgRow = "background: #fffbeb;"; } 
           else if (allStudentAttendance[fullDate]) { let rec = allStudentAttendance[fullDate]; inTime = rec.in; outTime = rec.out; statusHtml = `<span style="color:var(--success); font-weight:800; font-size:12px;"><i class="fas fa-check-circle"></i> PRESENT</span>`; presentCount++; } 
           else { statusHtml = `<span style="color:var(--danger); font-weight:800; font-size:12px;"><i class="fas fa-times-circle"></i> ABSENT</span>`; absentCount++; bgRow = "background: #fff1f2;"; }
           html += `<tr style="border-bottom: 1px solid #f1f5f9; transition: 0.2s; ${bgRow}"><td style="padding: 12px 15px; font-weight:700; color:var(--text-main); font-size:13px;">${fullDate}</td><td style="padding: 12px 15px;">${statusHtml}</td><td style="padding: 12px 15px; color:#059669; font-weight:700; font-size:12px;">${inTime}</td><td style="padding: 12px 15px; color:#e11d48; font-weight:700; font-size:12px;">${outTime}</td></tr>`;
      }
      if(html === "") { tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:30px; color:#64748b; font-weight:600;">No attendance records available.</td></tr>'; summaryBox.style.display = 'none'; } 
      else { tbody.innerHTML = html; summaryBox.style.display = 'flex'; summaryBox.innerHTML = `<span style="display:flex; flex-direction:column; align-items:center;"><small style="color:#64748b; font-size:11px; text-transform:uppercase;">Present</small><span style="font-size:18px; color:var(--success); font-weight:900;">${presentCount}</span></span><span style="display:flex; flex-direction:column; align-items:center;"><small style="color:#64748b; font-size:11px; text-transform:uppercase;">Absent</small><span style="font-size:18px; color:var(--danger); font-weight:900;">${absentCount}</span></span><span style="display:flex; flex-direction:column; align-items:center;"><small style="color:#64748b; font-size:11px; text-transform:uppercase;">Holidays</small><span style="font-size:18px; color:var(--warning); font-weight:900;">${holidayCount}</span></span>`; }
  }

  function openSecurityModal() { document.getElementById('newPass').value = ""; document.getElementById('passMsg').innerText = ""; document.getElementById('securityModal').style.display = 'flex'; }

  async function updatePassword() {
    const p = document.getElementById('newPass').value.trim(); const msgBox = document.getElementById('passMsg'); const btn = document.getElementById('btnUpdatePass');
    if(!p || p.length < 6) { msgBox.style.color = "var(--danger)"; msgBox.innerText = "Password must be at least 6 characters."; return; }
    let docId = sessionStorage.getItem('srms_student_docId'); if(!docId) { msgBox.style.color = "var(--danger)"; msgBox.innerText = "Session error! Please logout and login again."; return; }
    btn.disabled = true; btn.innerHTML = "<span class='loader-spinner' style='border-top-color:#fff;'></span> UPDATING..."; msgBox.style.color = "var(--primary)"; msgBox.innerText = "Updating password directly...";
    let directSuccess = false;
    try {
        if (auth.currentUser) {
            try { await auth.currentUser.updatePassword(p); directSuccess = true; } 
            catch (authErr) {
                if (authErr.code === 'auth/requires-recent-login') {
                    let oldPass = sessionStorage.getItem('srms_active_pass');
                    if (!oldPass) { const sDoc = await db.collection("Students").doc(docId).get(); oldPass = sDoc.data()?.pass || "123456"; }
                    await auth.currentUser.reauthenticateWithCredential(firebase.auth.EmailAuthProvider.credential(auth.currentUser.email, oldPass));
                    await auth.currentUser.updatePassword(p); directSuccess = true;
                }
            }
            await db.collection("Students").doc(docId).update({ pass: p }); directSuccess = true;
        }
        try { await fetch(SCRIPT_URL, { method: "POST", headers: { "Content-Type": "text/plain;charset=utf-8" }, body: JSON.stringify({ action: "updatePassword", docId: docId, id: std ? std.id : "", newPass: p }) }); } catch (scriptErr) {}
        if (directSuccess) { sessionStorage.setItem('srms_active_pass', p); msgBox.style.color = "#059669"; msgBox.innerText = "✅ Password Changed Successfully!"; document.getElementById('newPass').value = ""; } 
        else { msgBox.style.color = "var(--danger)"; msgBox.innerText = "Could not update password. Please logout and login again."; }
    } catch(e) { msgBox.style.color = "var(--danger)"; msgBox.innerText = "Error updating password! Please try again."; }
    btn.disabled = false; btn.innerHTML = "SAVE NEW PASSWORD";
  }

  async function checkLiveClassForButton() {
    let sClass = std.class; if (sClass == "9" || sClass == "10") { if(std.group) sClass = sClass + "-" + std.group; }
    try { let doc = await db.collection("LiveSessions").doc(sClass).get(); if(doc.exists && doc.data().status === "TRUE") { document.getElementById('liveClassMainBtn').classList.add('live-active-btn'); document.getElementById('liveClassMainBtn').innerHTML = "<i class='fas fa-video'></i><span>LIVE NOW</span>"; } } catch (e) {}
  }

  async function openLiveClassModal() {
    document.getElementById('liveClassModal').style.display = 'flex'; const body = document.getElementById('liveClassModalBody'); body.innerHTML = `<div style="text-align:center; font-weight:bold; color:var(--primary);">⏳ Checking Live Session...</div>`;
    let sClass = std.class; if (sClass == "9" || sClass == "10") { if(std.group) sClass = sClass + "-" + std.group; }
    try {
        let doc = await db.collection("LiveSessions").doc(sClass).get();
        if(doc.exists && doc.data().status === "TRUE") {
            let title = sanitizeHTML(doc.data().title || "Class Running");
            body.innerHTML = `<div style="text-align:center;"><div style="color:var(--danger); font-weight:800; font-size:12px; margin-bottom:15px; background:#fff1f2; display:inline-block; padding:5px 15px; border-radius:20px;"><i class="fas fa-broadcast-tower"></i> LIVE BROADCAST</div><h3 style="margin:0 0 15px 0; color:var(--text-main); font-size:20px;">${title}</h3><p style="color:var(--text-muted); font-size:13px; margin-bottom:20px;">Secure ID: ${std.id}</p><button class="login-btn" onclick="joinLiveClass('${sClass}', '${std.name}', '${std.roll}')"><i class="fas fa-sign-in-alt"></i> JOIN SESSION NOW</button></div>`;
            return;
        }
        body.innerHTML = `<div style="text-align:center; padding:20px;"><p style="color:var(--text-muted); font-weight:600; font-size:15px;"><i class="fas fa-bed"></i> No active live sessions for your class.</p></div>`;
    } catch (e) { body.innerHTML = `<p style="color:red; text-align:center;">API Sync Failed.</p>`; }
  }

  function joinLiveClass(room, name, roll) { window.open(`https://meet.jit.si/SRMS-Live-${room}#config.startWithAudioMuted=true&config.startWithVideoMuted=true&config.prejoinPageEnabled=false&userInfo.displayName="${name} (${roll})"`, '_blank'); closeModal('liveClassModal'); }

  function openFeesModal() {
    document.getElementById('feesModal').style.display = 'flex';
    let total = 0; let pendingCount = 0; let html = `<h3 style="margin:0 0 20px 0; color:var(--primary); font-size:20px; border-bottom:2px solid #f1f5f9; padding-bottom:15px;"><i class="fas fa-file-invoice-dollar"></i> Billing Hub</h3><div style="background:#f8fafc; padding:20px; border-radius:16px; border:1px solid #e2e8f0;">`;
    
    let genAmt = parseFloat(std.schoolFeeDue) || 0; let genSts = (std.schoolFeeStatus || "").toLowerCase();
    if(genAmt > 0 && genSts !== "paid") { if(genSts === "pending") { pendingCount++; html += `<div style="display:flex; justify-content:space-between; margin-bottom:12px; font-size:15px; color:var(--text-main);"><span>School Fee</span><b style="color:#d97706;"><i class="fas fa-clock"></i> Pending Review</b></div>`; } else { total += genAmt; html += `<div style="display:flex; justify-content:space-between; margin-bottom:12px; font-size:15px; color:var(--text-main);"><span>School Fee</span><b style="color:var(--primary);">${genAmt} Tk</b></div>`; } }
    if(std.customFees && std.customFees.length > 0) {
        std.customFees.forEach(cf => { 
            let cAmt = parseFloat(cf.amount) || 0; let cSts = (cf.status || "").toLowerCase();
            if(cAmt > 0 && cSts !== "paid") { if(cSts === "pending") { pendingCount++; html += `<div style="display:flex; justify-content:space-between; margin-bottom:12px; font-size:15px; color:var(--text-main);"><span>${sanitizeHTML(cf.name)}</span><b style="color:#d97706;"><i class="fas fa-clock"></i> Pending Review</b></div>`; } else { total += cAmt; html += `<div style="display:flex; justify-content:space-between; margin-bottom:12px; font-size:15px; color:var(--text-main);"><span>${sanitizeHTML(cf.name)}</span><b style="color:var(--primary);">${cAmt} Tk</b></div>`; } }
        });
    }
    html += `</div>`;
    
    if(total > 0) { html += `<div style="margin-top:25px; text-align:center; background:#fff1f2; padding:20px; border-radius:16px;"><p style="margin:0 0 5px 0; color:var(--text-muted); font-size:13px; font-weight:600;">Total Payable Amount</p><h2 style="margin:0; color:var(--danger); font-size:32px;">${total} Tk</h2></div><div style="margin-top:20px;"><label style="font-size:12px; font-weight:700; color:var(--text-muted);">Mobile Number (For Payment)</label><input type="text" id="feesPhone" value="${sanitizeHTML(std.phone) || ''}" placeholder="Enter Bkash/Nagad Number"></div><p style="font-size:12px; color:var(--danger); font-weight:700; text-align:center; margin-top:12px; line-height:1.4;"><i class="fas fa-exclamation-triangle"></i> Note: If your transaction shows "Pending" in gateway, please do NOT pay again. We will verify manually.</p><button id="btnPayNow" class="login-btn" style="background:var(--danger); font-size:15px;" onclick="generatePaymentLink()"><i class="fas fa-lock"></i> PROCEED TO SECURE PAYMENT</button><a id="feesPayLink" href="#" target="_blank" class="login-btn" style="display:none; background:#059669; font-size:15px; text-align:center;"><i class="fas fa-check-circle"></i> CLICK HERE TO PAY</a><div id="feesMsg" style="margin-top:15px; font-size:13px; font-weight:bold; text-align:center;"></div>`; } 
    else if (pendingCount > 0) { html += `<div style="text-align:center; color:#d97706; font-weight:700; padding:30px; background:#fef3c7; border-radius:16px; margin-top:20px; border:1px solid #fde68a;"><i class="fas fa-hourglass-half fa-2x"></i><br><br>Your payment is currently under Pending Review. We will update it soon.</div>`; } 
    else { html += `<div style="text-align:center; color:#059669; font-weight:700; padding:30px; background:#f0fdf4; border-radius:16px; margin-top:20px; border:1px solid #a7f3d0;"><i class="fas fa-check-double fa-2x"></i><br><br>All Fees Already Paid. Thank You!</div>`; }
    document.getElementById('feesModalBody').innerHTML = html; 
  }

  function generatePaymentLink() {
    const phone = sanitizeHTML(document.getElementById("feesPhone").value.trim()); if (phone.length < 11) { document.getElementById("feesMsg").innerHTML = "<span style='color:var(--danger);'>⚠️ সঠিক মোবাইল নম্বর দিন।</span>"; return; }
    const btn = document.getElementById("btnPayNow"); btn.innerHTML = "<span class='loader-spinner'></span> Connecting Server..."; btn.disabled = true;
    fetch(FEE_PAY_SCRIPT + "?action=create_payment&student_id=" + encodeURIComponent(std.id) + "&phone=" + encodeURIComponent(phone) + "&email=" + encodeURIComponent(std.email || '')).then(r => r.json()).then(data => {
        if (data.payment_url) { btn.style.display = "none"; const linkBtn = document.getElementById("feesPayLink"); linkBtn.style.display = "block"; linkBtn.href = sanitizeHTML(data.payment_url); document.getElementById("feesMsg").innerHTML = ""; } 
        else { btn.innerHTML = "Retry Payment"; btn.disabled = false; document.getElementById("feesMsg").innerHTML = "<span style='color:var(--danger);'>Payment generation failed.</span>"; }
    }).catch(e => { btn.innerHTML = "Retry Payment"; btn.disabled = false; document.getElementById("feesMsg").innerHTML = "<span style='color:var(--danger);'>Network Error.</span>"; });
  }
</script>
