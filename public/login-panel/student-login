  let std = null; let markSheetHTML = ""; let resettingDocId = null; let resettingStudentID = null; let allStudentAttendance = {}; let allHolidays = {};

  function sanitizeHTML(str) { return typeof str !== 'string' ? str : str.replace(/[&<>'"]/g, tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag])); }
