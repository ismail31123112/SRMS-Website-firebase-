            sessionStorage.setItem('srms_student_session', JSON.stringify(std)); sessionStorage.setItem('srms_student_docId', stdDocId); sessionStorage.setItem('srms_active_pass', pass);
            document.getElementById('stuPass').value = ''; showDashboardUI(); initDash();
