<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Official Student Premium Portal of Saidpur Residential Model School. Securely access academic results, live classes, attendance logs, and fee payments.">
<meta name="keywords" content="SRMS, Saidpur Residential Model School, Student Portal, Result Portal, Bangladesh, Education, SAM Digital Hub">
<meta name="author" content="SAM Digital Hub">
<meta property="og:title" content="Student Premium Portal - SRMS">
<meta property="og:description" content="Smart Student Dashboard for Saidpur Residential Model School.">
<meta property="og:image" content="https://i.postimg.cc/9FxBsqsj/IMG-20251220-WA0006.jpg">
<title>Student Premium Portal - SRMS</title>

<!-- Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
  :root {
    --primary: #005f40;
    --primary-dark: #003d29;
    --accent: #bf953f;
    --success: #059669;
    --warning: #d97706;
    --danger: #e11d48;
    --danger-dark: #be123c;
    --bg-color: #f4f7f6;
    --card-bg: #ffffff;
    --text-main: #1e293b;
    --text-muted: #64748b;
  }
  body { margin: 0; padding: 0; font-family: 'Poppins', sans-serif; background-color: var(--bg-color); color: var(--text-main); overflow-x: hidden; }
  a { text-decoration: none; color: inherit; transition: 0.3s; }
  ul { list-style: none; margin: 0; padding: 0; }
  
  @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes pulseLoader { 0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 95, 64, 0.7); } 70% { transform: scale(1.05); box-shadow: 0 0 0 20px rgba(0, 95, 64, 0); } 100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 95, 64, 0); } }
  @keyframes bounce { 0%, 20%, 50%, 80%, 100% { transform: translateY(0); } 40% { transform: translateY(-10px); } 60% { transform: translateY(-5px); } }
  @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  
  .animate-up { animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; opacity: 0; }
  .delay-1 { animation-delay: 0.1s; } .delay-2 { animation-delay: 0.2s; } .delay-3 { animation-delay: 0.3s; }

  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 10px; }
  ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
  ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

  #main-navbar { display: none; }
  .navbar { background: var(--card-bg); box-shadow: 0 10px 30px rgba(0,0,0,0.04); position: sticky; top: 0; z-index: 1000; border-bottom: 3px solid var(--accent); }
  .nav-top-container { height: 75px; display: flex; align-items: center; justify-content: space-between; padding: 0 5%; box-sizing: border-box; max-width: 1400px; margin: 0 auto; gap: 15px; }
  .nav-brand { font-weight: 800; color: var(--primary); font-size: 18px; letter-spacing: 0.5px; text-transform: uppercase; flex: 1; }
  .nav-menu { display: flex; gap: 10px; align-items: center; flex-shrink: 0; }
  .nav-link { font-weight: 600; font-size: 13px; color: var(--text-main); padding: 10px 20px; border-radius: 8px; text-transform: uppercase; cursor: pointer; transition: 0.3s; }
  .nav-link.logout-btn { color: var(--danger); background: #fff1f2; border: 1px solid #fecdd3; }
  .nav-link.logout-btn:hover { color: #fff; background: var(--danger); }

  #main-banner { display: none; }
  .custom-banner { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: white; padding: 40px 5%; display: flex; align-items: center; justify-content: center; gap: 25px; text-align: left; position: relative; overflow: hidden; }
  .custom-banner::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 60%); z-index: 0; }
  .banner-logo { width: 90px; height: 90px; background: #fff; border-radius: 50%; padding: 8px; border: 3px solid rgba(255,255,255,0.2); object-fit: contain; box-shadow: 0 10px 25px rgba(0,0,0,0.2); z-index: 1; }
  .banner-text { z-index: 1; }
  .banner-text h1 { margin: 0; font-size: 26px; font-weight: 800; text-transform: uppercase; letter-spacing: -0.5px; }
  .school-codes { background: rgba(255, 255, 255, 0.1); display: inline-block; padding: 6px 15px; border-radius: 20px; margin-top: 10px; font-size: 13px; font-weight: 500; color: #e2e8f0; border: 1px solid rgba(255, 255, 255, 0.15); backdrop-filter: blur(5px); }

  #login-container { display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 20px; position: relative; overflow: hidden; }
  #login-container::after { content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(circle at top right, rgba(0,95,64,0.05) 0%, transparent 50%); z-index: -1; }
  .login-card { background: var(--card-bg); padding: 45px 35px; border-radius: 24px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.1); width: 100%; max-width: 450px; text-align: center; border: 1px solid rgba(0,0,0,0.05); box-sizing: border-box; }
  .login-logo { width: 85px; margin-bottom: 20px; }
  .login-title { color: var(--primary); font-size: 24px; font-weight: 800; text-transform: uppercase; margin: 0 0 5px 0; }
  .login-subtitle { color: var(--text-muted); font-size: 14px; margin-bottom: 10px; font-weight: 500; }
  .default-pass-note { font-size: 12px; color: var(--accent); font-weight: 600; margin-bottom: 25px; }
  
  input { width: 100%; padding: 15px 18px; margin: 10px 0; border: 2px solid #e2e8f0; border-radius: 12px; font-family: inherit; font-size: 15px; transition: 0.3s; box-sizing: border-box; background: #f8fafc; color: var(--text-main); font-weight: 500; }
  input:focus { border-color: var(--primary); outline: none; background: #fff; box-shadow: 0 0 0 4px rgba(0,95,64,0.1); }
  .login-btn { width: 100%; padding: 16px; background: var(--primary); color: white; border: none; border-radius: 12px; cursor: pointer; font-weight: 700; font-size: 16px; margin-top: 15px; transition: all 0.3s ease; letter-spacing: 0.5px; }
  .login-btn:hover { background: var(--primary-dark); transform: translateY(-3px); box-shadow: 0 15px 25px -5px rgba(0,95,64,0.3); }
  .login-btn:active { transform: translateY(-1px); }
  .login-btn:disabled { background: #94a3b8; cursor: not-allowed; transform: none; box-shadow: none; }
  
  .forgot-pass-btn { display: inline-block; margin-top: 20px; color: var(--accent); font-weight: 600; font-size: 14px; cursor: pointer; transition: 0.3s; border-bottom: 2px solid transparent; }
  .forgot-pass-btn:hover { border-color: var(--accent); color: var(--primary); }

  #loader { display: none; position: fixed; top:0; left:0; width:100%; height:100%; background:rgba(255,255,255,0.95); z-index: 10000; justify-content:center; align-items:center; flex-direction:column; backdrop-filter: blur(10px); }
  .loader-img { width: 80px; height: 80px; border-radius: 50%; margin-bottom: 20px; animation: pulseLoader 2s infinite; border: 3px solid var(--primary); padding: 5px; background: #fff; }
  .loader-text { font-size: 16px; font-weight: 700; color: var(--primary); letter-spacing: 1px; text-transform: uppercase; }
  .loader-spinner { border: 3px solid rgba(255,255,255,0.3); border-top: 3px solid #005f40; border-radius: 50%; width: 18px; height: 18px; animation: spin 1s linear infinite; display: inline-block; vertical-align: middle; margin-right: 8px; }

  #dashboard-section { display: none; padding: 30px 5%; max-width: 1200px; margin: 0 auto; }
  
  .header-card { background: var(--card-bg); padding: 18px 25px; border-radius: 16px; box-shadow: 0 5px 15px rgba(0,0,0,0.03); display: flex; justify-content: space-between; align-items: center; border-left: 5px solid var(--primary); margin-bottom: 20px; }
  
  .scroll-cue-container { width: 100%; margin-bottom: 20px; text-align: center; }
  .scroll-cue { display: inline-block; color: var(--danger); font-size: 14px; font-weight: 700; padding: 8px 20px; background: #fff1f2; border-radius: 20px; border: 1px solid #fecdd3; animation: bounce 2s infinite; box-shadow: 0 5px 15px rgba(225, 29, 72, 0.1); }

  #noticeBox { background: #fff1f2; color: var(--danger-dark); padding: 20px 25px; border-radius: 16px; border-left: 6px solid var(--danger); margin-bottom: 30px; display: none; box-shadow: 0 10px 25px rgba(225, 29, 72, 0.08); }
  
  .card { background: var(--card-bg); padding: 30px; border-radius: 24px; box-shadow: 0 15px 35px rgba(0,0,0,0.04); border: 1px solid rgba(0,0,0,0.02); }

  .resource-section { background: var(--card-bg); padding: 35px; border-radius: 24px; box-shadow: 0 15px 35px rgba(0,0,0,0.04); margin-bottom: 40px; }
  .link-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 15px; margin-top: 25px; }
  .l-btn { background: #f8fafc; border: 1px solid #e2e8f0; padding: 20px 10px; border-radius: 16px; text-align: center; transition: all 0.3s ease; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 12px; color: var(--primary); }
  .l-btn i { font-size: 26px; }
  .l-btn span { font-size: 12px; font-weight: 700; color: var(--text-main); text-transform: uppercase; letter-spacing: 0.5px; }
  .l-btn:hover { background: var(--primary); border-color: var(--primary); transform: translateY(-5px); box-shadow: 0 15px 25px rgba(0,95,64,0.15); color: white; }
  .l-btn:hover span { color: white; }

  /* Digital Marksheet Premium UI */
  .digital-transcript { background: #0f172a; color: #f8fafc; border-radius: 24px; padding: 25px 20px; position: relative; }
  .scroll-indicator { text-align: center; color: #cbd5e1; font-size: 12px; font-weight: 600; margin-bottom: 18px; animation: bounce 2s infinite; background: rgba(255,255,255,0.05); padding: 8px; border-radius: 20px; display: inline-block; width: 100%; box-sizing: border-box; }
  .dt-header { border-bottom: 1px solid #334155; padding-bottom: 15px; margin-bottom: 16px; text-align: center; }
  
  .dt-summary-box { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); padding: 18px 15px; border-radius: 18px; margin-bottom: 16px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; align-items: center; box-shadow: 0 10px 30px rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.12); }
  
  .dt-seq-box { background: rgba(30, 41, 59, 0.85); border: 1px dashed #475569; border-radius: 12px; padding: 10px 14px; margin-bottom: 18px; font-size: 11.5px; line-height: 1.6; color: #cbd5e1; }
  .dt-seq-box b { color: #38bdf8; }

  .dt-row { background: #1e293b; border-radius: 16px; padding: 14px 16px; margin-bottom: 12px; display: flex; flex-direction: column; gap: 12px; border: 1px solid #334155; transition: 0.3s; }
  .dt-row:hover { border-color: #38bdf8; box-shadow: 0 4px 15px rgba(56, 189, 248, 0.12); }
  
  .dt-row-top { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 8px; }
  .sub-name { font-weight: 700; font-size: 15px; color: #38bdf8; }

  /* Flex Layout for Exams (No Scroll) */
  .dt-exam-split { display: flex; align-items: stretch; gap: 12px; width: 100%; flex-wrap: wrap; }
  .dt-test-section { flex: 1; background: rgba(15, 23, 42, 0.55); border: 1px solid rgba(148, 163, 184, 0.2); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; align-items: center; min-width: 250px; }
  .dt-divider { width: 2px; background: linear-gradient(to bottom, transparent, #475569, transparent); flex-shrink: 0; }
  .dt-main-section { flex: 2.6; background: rgba(15, 23, 42, 0.75); border: 1px solid rgba(56, 189, 248, 0.25); border-radius: 12px; padding: 12px; display: flex; flex-direction: column; align-items: center; min-width: 250px; }
  
  .dt-section-title { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.8px; color: #94a3b8; text-align: center; margin-bottom: 10px; border-bottom: 1px dashed rgba(255,255,255,0.08); padding-bottom: 6px; width: 100%; }
  .dt-main-section .dt-section-title { color: #38bdf8; }
  
  /* Flex wrap containers */
  .dt-main-flex, .dt-test-flex { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; align-items: stretch; width: 100%; }
  .dt-exam-card { background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.08); padding: 10px; border-radius: 12px; display: flex; flex-direction: column; align-items: center; gap: 8px; flex: 1 1 120px; }

  .mark-group { background: rgba(30, 41, 59, 0.8); padding: 8px; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,0.05); flex: 1; min-width: 45px; }
  .mark-label { font-size: 9px; color: #94a3b8; text-transform: uppercase; font-weight: 800; margin-bottom: 3px; letter-spacing: 0.5px; text-align:center; }
  .mark-val { font-size: 15px; font-weight: 800; color: #f8fafc; text-align: center; word-break: break-word; }
  
  .dt-warning-text { font-size: 10px; color: #64748b; text-align: center; margin-top: 20px; text-transform: uppercase; letter-spacing: 2px; font-weight: 700; }

  @keyframes livePulseBtn { 0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.4); } 50% { transform: scale(1.03); box-shadow: 0 0 0 15px rgba(225, 29, 72, 0); } 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(225, 29, 72, 0); } }
  .live-active-btn { animation: livePulseBtn 2s infinite !important; background: var(--danger) !important; border-color: var(--danger-dark) !important; color: white !important; }
  .live-active-btn span, .live-active-btn i { color: white !important; }

  .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.85); z-index: 2000; justify-content: center; align-items: center; backdrop-filter: blur(8px); padding: 20px; box-sizing: border-box; }
  .modal-content { background: var(--card-bg); width: 100%; max-width: 550px; border-radius: 28px; padding: 40px; position: relative; animation: fadeInUp 0.4s ease; overflow-y: auto; max-height: 85vh; box-shadow: 0 25px 50px rgba(0,0,0,0.2); }
  .close-btn { position: absolute; top: 20px; right: 25px; font-size: 32px; cursor: pointer; color: #94a3b8; line-height: 1; transition: 0.3s; }
  .close-btn:hover { color: var(--danger); transform: rotate(90deg); }

  @media (max-width: 768px) {
    .nav-brand { font-size: 13px; line-height: 1.4; word-wrap: break-word; }
    .nav-link.logout-btn { padding: 8px 12px; font-size: 11px; white-space: nowrap; }
    .custom-banner { flex-direction: column; text-align: center; padding: 30px 20px; }
    .banner-text h1 { font-size: 22px; }
    .login-card { padding: 40px 25px; width: 95%; }
    .header-card { flex-direction: column; text-align: center; gap: 10px; padding: 15px; }
    .dt-summary-box { grid-template-columns: repeat(2, 1fr); gap: 10px; padding: 15px; }
    .dt-row { padding: 12px; }
    .dt-divider { display: none; }
    .resource-section { padding: 25px 15px; }
    .link-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 15px; }
    .l-btn { padding: 15px 5px; gap: 8px; }
    .l-btn i { font-size: 22px; }
    .l-btn span { font-size: 10px; }
  }
</style>
</head>
<body>

<div id="loader">
    <img src="https://i.postimg.cc/9FxBsqsj/IMG-20251220-WA0006.jpg" class="loader-img" alt="Loading">
    <div class="loader-text">Loading Secure Data...</div>
</div>

<div id="login-container" class="animate-up">
    <div class="login-card">
        <img src="https://i.postimg.cc/9FxBsqsj/IMG-20251220-WA0006.jpg" alt="Logo" class="login-logo">
        <h2 class="login-title">Student Portal</h2>
        <div class="login-subtitle">Enter credentials to access your dashboard</div>
        <div class="default-pass-note"><i class="fas fa-key"></i> Default Password is: 123456</div>
        
        <input type="text" id="stuID" placeholder="Enter Student ID" autocomplete="off">
        <input type="password" id="stuPass" placeholder="Enter Password">
        <button id="lBtn" class="login-btn" onclick="handleLogin()"><i class="fas fa-sign-in-alt"></i> SECURE LOGIN</button>
        <div class="forgot-pass-btn" onclick="openForgotPassModal()"><i class="fas fa-unlock-alt"></i> Forgot Password?</div>
        <p id="err" style="color:var(--danger); font-size:13px; margin-top:15px; font-weight:700;"></p>
    </div>
</div>

<nav class="navbar" id="main-navbar">
  <div class="nav-top-container">
    <div class="nav-brand"><i class="fas fa-graduation-cap"></i> Saidpur Residential Model School</div>
    <ul class="nav-menu">
      <li><a class="nav-link logout-btn" onclick="logout()"><i class="fas fa-power-off"></i> LOGOUT</a></li>
    </ul>
  </div>
</nav>

<div class="custom-banner" id="main-banner">
  <img src="https://i.postimg.cc/9FxBsqsj/IMG-20251220-WA0006.jpg" class="banner-logo" alt="Logo">
  <div class="banner-text">
    <h1>Saidpur Residential Model School</h1>
    <div class="school-codes"><i class="fas fa-laptop-code"></i> Smart Student Dashboard</div>
  </div>
</div>

<div id="dashboard-section">
    <div class="scroll-cue-container animate-up delay-1">
        <div class="scroll-cue"><i class="fas fa-arrow-down"></i> Scroll down for more options <i class="fas fa-arrow-down"></i></div>
    </div>

    <div class="header-card animate-up delay-1">
        <div>
          <h3 id="uName" style="margin:0; color:var(--primary); font-size:20px; font-weight:800;">Assalamu Alaikum</h3>
          <p id="uMeta" style="margin:4px 0 0 0; font-size:13px; color:var(--text-muted); font-weight:600;"></p>
        </div>
    </div>

    <div id="noticeBox" class="animate-up delay-1">
        <h4 style="margin:0; font-size:16px; display:flex; align-items:center; gap:8px;"><i class="fas fa-exclamation-triangle"></i> IMPORTANT NOTICE</h4>
        <p id="noticeText" style="margin:8px 0 0 0; font-size:14.5px; font-weight:600; line-height:1.5;"></p>
    </div>

    <div class="card animate-up delay-2" style="margin-bottom: 30px; border-left: 6px solid var(--accent);">
        <h3 style="margin:0 0 15px 0; color:var(--primary); font-size:18px;"><i class="fas fa-book-reader"></i> Class Materials & Content</h3>
        <div id="matList" style="font-size:14.5px; color:#475569; max-height: 350px; overflow-y: auto; padding-right: 5px;"></div>
    </div>

    <div class="resource-section animate-up delay-3">
        <h3 style="margin:0; color:var(--text-main); font-size:22px; border-bottom:2px solid #f1f5f9; padding-bottom:15px;"><i class="fas fa-th-large"></i> Quick Resources</h3>
        
        <div class="link-grid">
            <a onclick="viewResultModal();" class="l-btn"><i class="fas fa-award"></i><span>Results</span></a>
            <a onclick="openAttendanceModal();" class="l-btn"><i class="fas fa-calendar-check"></i><span>Attendance</span></a>
            <a id="liveClassMainBtn" onclick="openLiveClassModal();" class="l-btn"><i class="fas fa-video"></i><span>Live Class</span></a>
            <a onclick="openFeesModal();" class="l-btn"><i class="fas fa-wallet"></i><span>Pay Fees</span></a>
            <a href="/menu/academic/syllabus" target="_blank" class="l-btn"><i class="fas fa-book-open"></i><span>Syllabus</span></a>
            <a href="/menu/academic/class-routine" target="_blank" class="l-btn"><i class="fas fa-clock"></i><span>Routine</span></a>
            <a href="/menu/academic/exam-routine" target="_blank" class="l-btn"><i class="fas fa-calendar-alt"></i><span>Exams</span></a>
            <a href="/notice-board" target="_blank" class="l-btn"><i class="fas fa-bullhorn"></i><span>Notice</span></a>
            <a href="/menu/gallery" target="_blank" class="l-btn"><i class="fas fa-images"></i><span>Gallery</span></a>
            <a onclick="openSecurityModal();" class="l-btn"><i class="fas fa-user-shield"></i><span>Security</span></a>
            <a href="/menu/contact-us" target="_blank" class="l-btn"><i class="fas fa-headset"></i><span>Support</span></a>
        </div>
    </div>
</div>

<div id="forgotPassModal" class="modal-overlay">
    <div class="modal-content" style="text-align: center;">
        <span class="close-btn" onclick="closeModal('forgotPassModal')">×</span>
        <h3 style="color:var(--primary); margin:0 0 5px 0; font-size:22px;"><i class="fas fa-key"></i> Reset Password</h3>
        <p style="color:var(--text-muted); font-size:13px; margin-bottom:20px;">Verify your email to reset security key</p>
        
        <div id="fpStep1">
            <input type="text" id="fpID" placeholder="Enter your Student ID">
            <button id="btnRequestOTP" class="login-btn" onclick="requestOTP()">SEND OTP TO EMAIL</button>
        </div>
        <div id="fpStep2" style="display:none;">
            <input type="text" id="fpOTP" placeholder="Enter 6-digit OTP">
            <button class="login-btn" onclick="verifyOTP()">VERIFY OTP</button>
        </div>
        <div id="fpStep3" style="display:none;">
            <input type="password" id="fpNewPass" placeholder="Enter New Password (Min. 6 chars)">
            <button id="btnSaveReset" class="login-btn" onclick="saveResetPassword()">SAVE NEW PASSWORD</button>
        </div>
        <p id="fpMsg" style="font-size:13px; font-weight:700; margin-top:15px;"></p>
    </div>
</div>

<div id="feesModal" class="modal-overlay"><div class="modal-content"><span class="close-btn" onclick="closeModal('feesModal')">×</span><div id="feesModalBody"></div></div></div>
<div id="liveClassModal" class="modal-overlay"><div class="modal-content"><span class="close-btn" onclick="closeModal('liveClassModal')">×</span><div id="liveClassModalBody"></div></div></div>

<div id="resultModal" class="modal-overlay">
    <div class="modal-content" style="max-width:850px; width:95%; background: #0f172a; padding: 0;">
        <span class="close-btn" onclick="closeModal('resultModal')" style="color:#fff; top:15px; right:20px; z-index:100;">×</span>
        <div id="resultModalBody" style="padding:0;"></div>
