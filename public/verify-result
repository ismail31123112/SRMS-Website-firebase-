<script>
    document.getElementById('auto-year').innerText = new Date().getFullYear();

    function toggleMenu() { document.getElementById('navMenu').classList.toggle('active'); }

    function handleDropdown(el) {
        if (window.innerWidth <= 950) {
            const parent = el.parentElement;
            const isActive = parent.classList.contains('active');
            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
            if (!isActive) parent.classList.add('active');
        }
    }

    // Cryptographic Integrity Check (For Offline QR Mode)
    function verifyHash(id, cls, yr, gpa, grade, totalMarks, providedHash) {
        let raw = `SRMS|${id}|${cls}|${yr}|${gpa}|${grade}|${totalMarks}|2012`;
        let h1 = 0x811c9dc5;
        for (let i = 0; i < raw.length; i++) {
            h1 ^= raw.charCodeAt(i);
            h1 = Math.imul(h1, 0x01000193);
        }
        let calcHash = ("00000000" + (h1 >>> 0).toString(16)).slice(-8).toUpperCase();
        return calcHash === providedHash;
    }

    // ==========================================
    // 🔗 API ENDPOINT (GOOGLE APPS SCRIPT WEB APP)
    // ==========================================
    const WEB_APP_URL = "https://script.google.com/macros/s/AKfycbzn4QO3pRDjv6wxNnVFcdzaLrZVqZxEOSbafafPQFWgDYbGVVbxPk5riyZLkx45D_YW/exec";

    window.onload = function() {
        const params = new URLSearchParams(window.location.search);

        const pId = params.get('id');
        const pName = params.get('name');
        const pCls = params.get('cls');
        const pRoll = params.get('roll');
        const pYr = params.get('yr');
        const pExam = params.get('exam');
        const pMarks = params.get('marks');
        const pGpa = params.get('gpa');
        const pGrade = params.get('grade');
        const pMerit = params.get('merit');
        const pHash = params.get('v');
        const pSubStr = params.get('sub');

        // 1. Smart Redirect (If no ID provided)
        if (!pId) {
            window.location.replace("https://srms2012.edu.bd/");
            return;
        }

        // 2. Check Verification Mode
        // If the URL has 'marks' and 'hash', use the quick offline local check
        if (pHash && pMarks) {
            setTimeout(() => {
                const isValid = verifyHash(pId, pCls, pYr, pGpa, pGrade, pMarks, pHash);
                if (isValid) {
                    renderResultUI(pId, pName, pCls, pRoll, pYr, pExam, pMarks, pGpa, pGrade, pMerit, pHash, pSubStr);
                } else {
                    showErrorUI();
                }
            }, 900);
        } 
        // 3. LIVE DATABASE FETCH (If only ID is provided)
        else {
            fetch(`${WEB_APP_URL}?action=verify&id=${pId}`)
                .then(response => response.json())
                .then(data => {
                    // Assuming your Apps Script returns a JSON object on success
                    if (data && data.success) {
                        renderResultUI(data.id, data.name, data.cls, data.roll, data.yr, data.exam, data.marks, data.gpa, data.grade, data.merit, data.hash, data.sub);
                    } else {
                        showErrorUI();
                    }
                })
                .catch(error => {
                    console.error("Error fetching data from Google Sheets:", error);
                    showErrorUI();
                });
        }
    };

    // UI Rendering Logic
    function renderResultUI(id, name, cls, roll, yr, exam, marks, gpa, grade, merit, hash, subStr) {
        document.getElementById('initLoader').style.display = 'none';
        document.getElementById('topNav').style.display = 'flex';
        document.getElementById('headerBanner').style.display = 'flex';
        document.getElementById('footerArea').style.display = 'block';
        document.getElementById('successCard').style.display = 'block';

        // *** CLEAN URL FEATURE (Hide parameters) ***
        window.history.replaceState({}, document.title, window.location.pathname);

        // Auto-generate avatar based on name
        let safeName = encodeURIComponent(name || "Student");
        document.getElementById('vPhoto').src = `https://ui-avatars.com/api/?name=${safeName}&background=e2e8f0&color=005f40&size=200&bold=true`;

        // Fill Basic Data
        document.getElementById('vId').innerText = id || 'N/A';
        document.getElementById('vName').innerText = name || 'N/A';
        document.getElementById('vClass').innerText = cls || 'N/A';
        document.getElementById('vRoll').innerText = roll || 'N/A';
        document.getElementById('vYear').innerText = yr || 'N/A';
        document.getElementById('vExam').innerText = exam || 'Final Result';
        document.getElementById('vMarks').innerText = marks || 'N/A';
        document.getElementById('vGPA').innerText = gpa || 'N/A';
        document.getElementById('vGrade').innerText = grade || 'N/A';
        document.getElementById('vMerit').innerText = merit || 'N/A';
        document.getElementById('vHashCode').innerText = hash || 'VERIFIED-BY-DB';

        // If Failed
        if (grade === "F") {
            let boxes = ['boxMarks', 'boxGPA', 'boxGrade', 'boxMerit'];
            boxes.forEach(boxId => document.getElementById(boxId).classList.add('fail'));

            let head = document.getElementById('cardHeader');
            head.classList.add('invalid');
            head.innerHTML = `<div class="v-icon-wrap"><i class="fas fa-exclamation-triangle"></i></div><h2>VERIFIED (FAILED)</h2><p>Document is authentic but the student did not pass.</p><div class="official-domain-tag"><i class="fas fa-lock"></i> Secured by srms2012.edu.bd</div>`;
        }

        // Detailed Subject Marks
        if (subStr) {
            document.getElementById('scrollIndicator').style.display = 'block';
            document.getElementById('marksSection').style.display = 'block';

            const tbody = document.getElementById('marksTableBody');
            tbody.innerHTML = ""; // Clear existing rows
            const subjects = subStr.split(',');

            subjects.forEach(item => {
                const parts = item.split('_');
                if(parts.length >= 3) {
                    const sName = parts[0];
                    const sMark = parts[1];
                    const sGrade = parts[2];
                    const gColor = sGrade === 'F' ? '#dc2626' : '#0f172a';
                    tbody.innerHTML += `<tr> <td>${sName}</td> <td>${sMark}</td> <td style="color:${gColor};">${sGrade}</td> </tr>`;
                }
            });
        }
    }

    // Error Handling
    function showErrorUI() {
        document.getElementById('initLoader').style.display = 'none';
        document.getElementById('topNav').style.display = 'flex';
        document.getElementById('headerBanner').style.display = 'flex';
        document.getElementById('footerArea').style.display = 'block';
        document.getElementById('errorCard').style.display = 'block';
    }
</script>

