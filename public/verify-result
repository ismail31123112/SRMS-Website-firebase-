<script>
  // Setup year
  document.getElementById('auto-year').innerText = new Date().getFullYear();

  // Mobile Menu Toggle
  function toggleMenu() { document.getElementById('navMenu').classList.toggle('active'); }
  function handleDropdown(el) {
    if (window.innerWidth <= 950) {
      const parent = el.parentElement;
      const isActive = parent.classList.contains('active');
      document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
      if (!isActive) parent.classList.add('active');
    }
  }

  // 👑 Backend API URL for fetching strictly the student photo
  const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxxo0od8ZzHy7WaNDUJybjjqcISZf5fJLIN2CG2KiTN3r5f5uyWLclcw-nj4ugrK7_t/exec";

  // Security Hash Logic (MUST match generator exactly)
  function verifyHash(id, cls, yr, gpa, grade, totalMarks, providedHash) {
    let raw = `SRMS|${id}|${cls}|${yr}|${gpa}|${grade}|${totalMarks}|2012`;
    let h1 = 0x811c9dc5;
    for (let i = 0; i < raw.length; i++) {
      h1 ^= raw.charCodeAt(i);
      h1 = Math.imul(h1, 0x01000193);
    }
    let calcHash = ("00000000" + (h1 >>> 0).toString(16)).slice(-8).toUpperCase();
    return calcHash === providedHash;
  }

  window.onload = function() {
    const params = new URLSearchParams(window.location.search);
    
    // Extract parameters
    const pId = params.get('id');
    const pName = params.get('name');
    const pCls = params.get('cls');
    const pRoll = params.get('roll');
    const pYr = params.get('yr');
    const pExam = params.get('exam');
    const pMarks = params.get('marks');
    const pGpa = params.get('gpa');
    const pGrade = params.get('grade');
    const pMerit = params.get('merit');
    const pHash = params.get('v');

    // 1. Mandatory Parameter Check (Smart Redirect)
    if (!pId || !pHash || !pCls || !pYr || !pMarks) {
      window.location.replace("https://srms2012.edu.bd/");
      return;
    }

    setTimeout(() => {
      document.getElementById('initLoader').style.display = 'none';
      document.getElementById('headerBanner').style.display = 'flex';
      document.getElementById('footerArea').style.display = 'block';
      
      // 2. Cryptographic Integrity Check
      const isValid = verifyHash(pId, pCls, pYr, pGpa, pGrade, pMarks, pHash);

      if (isValid) {
        // Show Success UI
        document.getElementById('successCard').style.display = 'block';
        
        document.getElementById('vId').innerText = pId;
        document.getElementById('vName').innerText = pName || 'N/A';
        document.getElementById('vClass').innerText = pCls;
        document.getElementById('vRoll').innerText = pRoll || 'N/A';
        document.getElementById('vYear').innerText = pYr;
        document.getElementById('vExam').innerText = pExam || 'Final Result';
        
        document.getElementById('vMarks').innerText = pMarks;
        document.getElementById('vGPA').innerText = pGpa;
        document.getElementById('vGrade').innerText = pGrade;
        document.getElementById('vMerit').innerText = pMerit || 'N/A';
        document.getElementById('vHashCode').innerText = pHash;

        // Apply visual cues for Failed students
        if (pGrade === "F") {
          let boxes = ['boxMarks', 'boxGPA', 'boxGrade', 'boxMerit'];
          boxes.forEach(id => document.getElementById(id).classList.add('fail'));
          document.getElementById('vStamp').innerText = "FAILED";
          document.getElementById('vStamp').style.background = "#ef4444";
          
          let head = document.getElementById('cardHeader');
          head.classList.add('invalid');
          head.innerHTML = `<div class="v-icon-wrap"><i class="fas fa-exclamation-triangle"></i></div><h2>VERIFIED (FAILED)</h2><p>Document is authentic but student did not pass.</p>`;
        }

        // 3. Fetch Student Photo Securely from Backend
        fetchPhoto(pId, pName);

      } else {
        // Show Error UI
        document.getElementById('errorCard').style.display = 'block';
      }
    }, 800); // Slight intentional delay to show "Authenticating..."
  };

  async function fetchPhoto(studentID, studentName) {
    let safeName = encodeURIComponent(studentName || "Student");
    let defaultAvatar = `https://ui-avatars.com/api/?name=${safeName}&background=e2e8f0&color=005f40&size=200&bold=true`;
    
    try {
      let payload = { action: "getStudentPhoto", studentID: studentID };
      let res = await fetch(SCRIPT_URL, {
        method: 'POST',
        body: JSON.stringify(payload),
        headers: { 'Content-Type': 'text/plain;charset=utf-8' }
      });
      let data = await res.json();
      
      if (data.status === "success" && data.photoUrl && data.photoUrl.trim() !== "") {
        document.getElementById('vPhoto').src = data.photoUrl;
      } else {
        document.getElementById('vPhoto').src = defaultAvatar;
      }
    } catch (e) {
      console.error("Photo fetch failed:", e);
      document.getElementById('vPhoto').src = defaultAvatar;
    }
  }
</script>
