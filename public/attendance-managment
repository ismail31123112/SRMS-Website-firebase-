function normalizeClass(clsName) {
if (!clsName) return "";
return String(clsName).toLowerCase().replace(/class\s*/g, "").trim();
}

function parseTimeToMinutes(timeStr) {
if(!timeStr) return 0;
let cleanTime = timeStr.replace(" (M)", "");
if (cleanTime.includes("AM") || cleanTime.includes("PM")) {
let parts = cleanTime.split(' ');
let hm = parts[0].split(':');
let hours = parseInt(hm[0], 10);
if (hours === 12) hours = 0;
if (parts[1].toUpperCase().includes('PM')) hours += 12;
return (hours * 60) + parseInt(hm[1], 10);
} else {
let hm = cleanTime.split(':');
return (parseInt(hm[0], 10) * 60) + parseInt(hm[1], 10);
}
}

function exportTableToCSV(filename) {
var csv = [];
var rows = document.querySelectorAll("table tr");
for (var i = 0; i < rows.length; i++) {
var row = [], cols = rows[i].querySelectorAll("td, th");
for (var j = 0; j < cols.length; j++) {
if(cols[j].classList.contains('no-print')) continue;
var data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, " ").replace(/"/g, '""');
row.push('"' + data + '"');
}
if(row.length > 0) csv.push(row.join(","));
}
var csvFile = new Blob([csv.join("\n")], {type: "text/csv"});
var downloadLink = document.createElement("a");
downloadLink.download = filename;
downloadLink.href = window.URL.createObjectURL(csvFile);
downloadLink.style.display = "none";
document.body.appendChild(downloadLink);
downloadLink.click();
document.body.removeChild(downloadLink);
}

