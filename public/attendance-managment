async function fetchBunkedDataFromFirebase(dateStr, classFilter) {
    let snap = await db.collection('AttendanceHistory').where('pureDate', '==', dateStr).get();
    let records = {};
    snap.forEach(doc => {
        let f = doc.data();
        let sid = String(f.studentID).trim();
        if(!records[sid]) records[sid] = { in: false, out: false, data: f };
        if(f.type === "IN") records[sid].in = true;
        if(f.type === "OUT") records[sid].out = true;
    });

    let bunkedList = [];
    for (let sid in records) {
        if (records[sid].in && !records[sid].out) {
            let f = records[sid].data;
            let dbClass = f.class || "";
            let matchClass = false;
            if (classFilter === "All") matchClass = true;
            else if (classFilter === "AllStudents") matchClass = (dbClass !== "Teacher");
            else if (classFilter === "Teacher") matchClass = (dbClass === "Teacher");
            else matchClass = (normalizeClass(dbClass) === normalizeClass(classFilter));
            
            if (matchClass) {
                bunkedList.push({
                    id: f.studentID || "", name: f.name || "", cls: f.class || "",
                    roll: f.roll || "", date: f.pureDate || "", inTime: f.time || ""
                });
            }
        }
    }
    return bunkedList;
}

async function fetchAbsentDataFromFirebase(dateStr, classFilter) {
let holDoc = await db.collection('Holidays').doc(dateStr).get();
if (holDoc.exists && holDoc.data().reason) return { isHoliday: true, reason: holDoc.data().reason };

let allMembers = [];
let fetchTeachers = (classFilter === "All" || classFilter === "Teacher");
let fetchStudents = (classFilter === "All" || classFilter === "AllStudents" || (classFilter !== "Teacher" && classFilter !== "All"));

if(fetchTeachers) {
let tSnap = await db.collection('Teachers').get();
tSnap.forEach(t => {
let d = t.data();
allMembers.push({ id: d.phone || t.id, name: d.name || "Unknown", roll: d.designation || "Staff", cls: "Teacher" });
});
}
if(fetchStudents) {
let sSnap = await db.collection('Students').get();
sSnap.forEach(s => {
let d = s.data(); let dbClass = d.class || "";
if (classFilter === "All" || classFilter === "AllStudents" || normalizeClass(dbClass) === normalizeClass(classFilter)) {
allMembers.push({ id: d.studentID || s.id, name: d.name || "Unknown", roll: d.roll || "0", cls: dbClass || "Student" });
}
});
}
if (allMembers.length === 0) return { error: "NO_STUDENTS" };

let aSnap = await db.collection('AttendanceHistory').where('pureDate', '==', dateStr).get();
let presentIds = []; let leaveIds = {};
aSnap.forEach(doc => {
let p = doc.data(); let cleanId = String(p.studentID).trim();
if (p.type === "LEAVE") { leaveIds[cleanId] = p.time; presentIds.push(cleanId); }
else { presentIds.push(cleanId); }
});

let absentList = [];
allMembers.forEach(m => {
if (presentIds.indexOf(m.id) === -1) absentList.push(m);
else if (leaveIds[m.id]) absentList.push({...m, isLeave: true, reason: leaveIds[m.id]});
});
return absentList;
}

async function fetchMonthlySummaryFromFirebase(monthStr, classFilter) {
let allMembers = [];
let fetchTeachers = (classFilter === "All" || classFilter === "Teacher");
let fetchStudents = (classFilter === "All" || classFilter === "AllStudents" || (classFilter !== "Teacher" && classFilter !== "All"));

if(fetchTeachers) {
let tSnap = await db.collection('Teachers').get();
tSnap.forEach(t => { let d = t.data(); allMembers.push({ id: d.phone || t.id, name: d.name || "Unknown", roll: d.designation || "Staff", cls: "Teacher" }); });
}
if(fetchStudents) {
let sSnap = await db.collection('Students').get();
sSnap.forEach(s => {
let d = s.data(); let dbClass = d.class || "";
if (classFilter === "All" || classFilter === "AllStudents" || normalizeClass(dbClass) === normalizeClass(classFilter)) {
allMembers.push({ id: d.studentID || s.id, name: d.name || "Unknown", roll: d.roll || "0", cls: dbClass || "Student" });
}
});
}

let monthStart = monthStr + "-01";
let monthEnd = monthStr + "-31";
let aSnap = await db.collection('AttendanceHistory').where('pureDate', '>=', monthStart).where('pureDate', '<=', monthEnd).get();

let workingDaysSet = new Set();
let userStats = {};
allMembers.forEach(m => { userStats[m.id] = { ...m, presentDays: new Set(), leaveDays: new Set(), totalLate: 0, totalEarly: 0, dailyPunches: {} }; });

aSnap.forEach(doc => {
let f = doc.data(); let sid = f.studentID || ""; let pDate = f.pureDate; let type = f.type || "";
if(pDate && pDate.startsWith(monthStr)) {
workingDaysSet.add(pDate);
if (userStats[sid]) {
let time = f.time || "";
if (!userStats[sid].dailyPunches[pDate]) userStats[sid].dailyPunches[pDate] = {};
userStats[sid].dailyPunches[pDate][type] = time;

if(type === "IN") userStats[sid].presentDays.add(pDate);
else if(type === "LEAVE") userStats[sid].leaveDays.add(pDate);

let pStatus = f.punctuality || "On Time";
if (pStatus === "Late") userStats[sid].totalLate++;
if (pStatus === "Early Exit") userStats[sid].totalEarly++;
}
}
});

let totalWorkingDays = workingDaysSet.size;
let finalReport = [];

Object.keys(userStats).forEach(id => {
let u = userStats[id];
u.totalPresent = u.presentDays.size;
u.totalLeave = u.leaveDays.size;
u.totalAbsent = totalWorkingDays - (u.totalPresent + u.totalLeave);
if (u.totalAbsent < 0) u.totalAbsent = 0;
u.totalWorkingDays = totalWorkingDays;

let totalMins = 0;
Object.values(u.dailyPunches).forEach(day => {
if(day["IN"] && day["OUT"]) {
let inM = parseTimeToMinutes(day["IN"]);
let outM = parseTimeToMinutes(day["OUT"]);
if(outM > inM) totalMins += (outM - inM);
}
});
let hrs = Math.floor(totalMins / 60);
let mins = totalMins % 60;
u.totalHoursStr = `${hrs}h ${mins}m`;
finalReport.push(u);
});

finalReport.sort((a,b) => a.totalPresent > b.totalPresent ? -1 : 1);
return finalReport;
}

function displayMonthly(data) {
hideLoader();
var tbody = document.getElementById('tableBody');
if(data.length === 0) { 
tbody.innerHTML = '<tr><td colspan="10" style="text-align:center; padding: 40px; color: var(--text-muted); font-weight: 500;">No data available for this month.</td></tr>'; 
updateAnalytics(0, 0, 0, 0); 
document.getElementById('chartContainer').style.display = 'none';
return; 
}
var tW = 0, tP = 0, tA = 0, tL = 0, tLeave = 0;
data.forEach(r => {
tW += r.totalWorkingDays; tP += r.totalPresent; tA += r.totalAbsent; tL += (r.totalLate + r.totalEarly); tLeave += r.totalLeave;
var lateEarlyBadge = (r.totalLate > 0 || r.totalEarly > 0) ? `<span style="color:var(--danger); font-weight:bold;">${r.totalLate} L, ${r.totalEarly} E</span>` : `0`;
var leaveBadge = r.totalLeave > 0 ? `<span style="color:var(--leave); font-weight:bold;">${r.totalLeave} Days</span>` : `0`;

var tr = `<tr>
<td style="font-weight:800; color: var(--primary-dark);">${r.id}</td>
<td style="font-weight:600;">${r.name}</td>
<td>${r.cls}</td>
<td style="font-weight:600; color: var(--accent);">${r.roll}</td>
<td style="font-weight:bold; color:var(--info);">${r.totalWorkingDays} Days</td>
<td style="font-weight:bold; color:var(--success);">${r.totalPresent} Days</td>
<td style="font-weight:bold; color:var(--danger);">${r.totalAbsent} Days</td>
<td>${leaveBadge}</td>
<td>${lateEarlyBadge}</td>
<td style="font-weight:bold; color:var(--primary); background:#e8f5e9;">${r.totalHoursStr}</td>
</tr>`;
tbody.innerHTML += tr;
});
document.getElementById('statTotal').innerText = data.length;
document.getElementById('statTotal').parentElement.querySelector('span').innerText = "Total Students/Staff";
document.getElementById('statIn').innerText = tP;
document.getElementById('statIn').parentElement.querySelector('span').innerText = "Total Monthly Present";
document.getElementById('statOut').innerText = tA;
document.getElementById('statOut').parentElement.querySelector('span').innerText = "Total Monthly Absent";
document.getElementById('statSms').innerText = tL;
document.getElementById('statSms').parentElement.querySelector('span').innerText = "Total Late/Early Exits";

updateChartData(tP, tA, tLeave, tL);
}

function displayPresent(data) {
hideLoader();
var tbody = document.getElementById('tableBody');
var totalIn = 0; var totalOut = 0; var totalSms = 0; var totalLate = 0; var totalLeave = 0;

if(data.length === 0) { 
tbody.innerHTML = '<tr><td colspan="8" style="text-align:center; padding: 40px; color: var(--text-muted); font-weight: 500;">No records found for this selection.</td></tr>'; 
updateAnalytics(0, 0, 0, 0); 
document.getElementById('chartContainer').style.display = 'none';
return; 
}

data.forEach(r => {
var badgeClass = r.type === 'IN' ? 'badge-in' : (r.type === 'OUT' ? 'badge-out' : 'badge-leave');
var isManual = r.time.includes("(M)") ? '<span class="badge-manual">Manual</span>' : '';
var cleanTime = r.time.replace(" (M)", "");

var punctualityHtml = "";
var actionHtml = "";
if(r.type === 'LEAVE') {
punctualityHtml = `<span style="font-size:10px; color:var(--leave); margin-left:5px; font-weight:bold;">${r.punctuality}</span>`; 
actionHtml = `-`;
totalLeave++;
}
else if(r.punctuality === "Late") { punctualityHtml = `<span class="badge-late">LATE</span>`; actionHtml = `<button class="btn-warn btn-small" onclick="exemptUser('${r.docId}')">Exempt</button>`; totalLate++;}
else if(r.punctuality === "Early Exit") { punctualityHtml = `<span class="badge-early">EARLY EXIT</span>`; actionHtml = `<button class="btn-warn btn-small" onclick="exemptUser('${r.docId}')">Exempt</button>`; totalLate++;}
else if(r.punctuality === "Exempt") { punctualityHtml = `<span class="badge-exempt">EXEMPT (Permission)</span>`; actionHtml = `-`; }
else { punctualityHtml = `<span style="font-size:10px; color:var(--success); margin-left:5px; font-weight:bold;">ON TIME</span>`; actionHtml = `-`; }

var smsHtml = `<span class="sms-na">N/A</span>`;
if(r.smsStatus === "Sent") { smsHtml = `<span class="sms-sent"><i class="fas fa-check"></i> Sent</span>`; totalSms++; }
else if(r.smsStatus === "Failed" || r.smsStatus === "Error") { smsHtml = `<span class="sms-failed"><i class="fas fa-times"></i> Failed</span>`; }

if(r.type === 'IN') totalIn++; if(r.type === 'OUT') totalOut++;

var tr = `<tr>
<td style="font-weight:800; color: var(--primary-dark);">${r.id}</td>
<td style="font-weight:600;">${r.name}</td>
<td>${r.cls}</td>
<td style="font-weight:600; color: var(--accent);">${r.roll}</td>
<td>${r.date}</td>
<td style="font-weight:600;">${cleanTime}</td>
<td><span class="${badgeClass}">${r.type}</span> ${isManual} ${punctualityHtml}</td>
<td class="no-print" style="display:flex; gap:5px; align-items:center;">${actionHtml} <span style="margin-left:5px;">${smsHtml}</span></td>
</tr>`;
tbody.innerHTML += tr;
});
updateAnalytics(data.length, totalIn, totalOut, totalSms);
updateChartData(totalIn, totalOut, totalLeave, totalLate);
}

