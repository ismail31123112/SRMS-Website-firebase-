<style>
:root { --primary: #005f40; --primary-dark: #003d29; --accent: #f59e0b; --danger: #e11d48; --success: #10b981; --warning: #f59e0b; --info: #3b82f6; --leave: #6366f1; --bg-color: #f4f7f6; --card-bg: #ffffff; --text-main: #1e293b; --text-muted: #64748b; }
body { font-family: 'Poppins', sans-serif; background: var(--bg-color); margin: 0; padding: 20px; color: var(--text-main); }
.container { max-width: 1250px; margin: auto; animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; display: none; }
.container.active { display: block; }
@keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

.brand-header { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: white; padding: 30px; border-radius: 20px; margin-bottom: 25px; box-shadow: 0 15px 35px rgba(0, 95, 64, 0.2); position: relative; overflow: hidden; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; border-bottom: 5px solid var(--accent); }
.brand-header::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 60%); z-index: 0; }
.header-left { display: flex; align-items: center; gap: 20px; z-index: 1; }
.brand-logo { width: 85px; height: 85px; background: #fff; border-radius: 50%; padding: 6px; border: 3px solid rgba(255,255,255,0.2); object-fit: contain; box-shadow: 0 10px 25px rgba(0,0,0,0.2); }
.brand-text h1 { margin: 0; font-size: 26px; font-weight: 800; letter-spacing: -0.5px; text-transform: uppercase; }
.brand-text p { margin: 5px 0 0 0; color: #e2e8f0; font-weight: 500; font-size: 14px; letter-spacing: 0.5px; }
.live-clock-box { background: rgba(0,0,0,0.3); padding: 12px 20px; border-radius: 12px; z-index: 1; text-align: center; border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(5px); }
.live-clock-time { font-size: 22px; font-weight: 800; color: var(--accent); margin-bottom: 2px; }
.live-clock-date { font-size: 12px; font-weight: 500; color: #cbd5e1; text-transform: uppercase; }

.summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 25px; }
.summary-card { background: var(--card-bg); padding: 20px; border-radius: 16px; box-shadow: 0 5px 15px rgba(0,0,0,0.03); border-left: 5px solid; display: flex; flex-direction: column; transition: transform 0.3s;}
.summary-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.06); }
.summary-card.total { border-color: var(--info); }
.summary-card.in { border-color: var(--success); }
.summary-card.out { border-color: var(--warning); }
.summary-card.sms { border-color: var(--primary); }
.card-title { font-size: 13px; color: var(--text-muted); font-weight: 700; text-transform: uppercase; margin-bottom: 5px; display: flex; align-items: center; justify-content: space-between;}
.card-value { font-size: 28px; font-weight: 800; color: var(--text-main); }

.chart-container { background: var(--card-bg); padding: 20px; border-radius: 16px; box-shadow: 0 5px 15px rgba(0,0,0,0.03); border: 1px solid #e2e8f0; display: flex; justify-content: center; align-items: center; max-height: 250px; margin-bottom: 25px; }

.panel-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(500px, 1fr)); gap: 20px; margin-bottom: 25px; }
.panel { background: var(--card-bg); padding: 25px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); border: 1px solid rgba(0,0,0,0.03); position: relative; overflow: hidden; }
.panel-title { font-weight: 800; font-size: 16px; margin-bottom: 15px; padding-bottom: 12px; border-bottom: 2px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; color: var(--primary-dark); text-transform: uppercase; }
.flex-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }

select, input { padding: 12px 16px; border-radius: 10px; border: 2px solid #e2e8f0; font-size: 13px; outline: none; font-family: inherit; font-weight: 500; transition: all 0.3s; background: #f8fafc; color: var(--text-main); width: 100%; box-sizing: border-box;}
input:focus, select:focus { border-color: var(--primary); background: #fff; box-shadow: 0 0 0 4px rgba(0, 95, 64, 0.1); }
.input-group { flex: 1; display: flex; flex-direction: column; gap: 5px; }
.input-label { font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-left: 2px; }
.search-wrapper { position: relative; flex: 1; }
.search-wrapper i { position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: var(--text-muted); }
.search-wrapper input { padding-left: 40px; }

button { padding: 12px 16px; border-radius: 10px; border: none; font-weight: 700; font-size: 13px; font-family: inherit; cursor: pointer; display: flex; align-items: center; gap: 8px; justify-content: center; transition: all 0.3s ease; text-transform: uppercase; letter-spacing: 0.5px; }
button:hover { transform: translateY(-2px); box-shadow: 0 8px 15px rgba(0,0,0,0.1); }
button:active { transform: translateY(0); box-shadow: none; }
.btn-primary { background: var(--primary); color: white; }
.btn-accent { background: var(--accent); color: white; }
.btn-green { background: var(--success); color: white; }
.btn-red { background: var(--danger); color: white; }
.btn-dark { background: #0f172a; color: white; }
.btn-warn { background: var(--warning); color: #000; } 
.btn-leave { background: var(--leave); color: white; } 
.btn-info { background: var(--info); color: white; } 
.btn-small { padding: 4px 8px; font-size: 10px; border-radius: 6px; }

#loaderOverlay { display: flex; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,255,255,0.95); z-index: 9999; justify-content: center; align-items: center; flex-direction: column; backdrop-filter: blur(8px); }
.loader-box { background: white; padding: 35px 50px; border-radius: 20px; box-shadow: 0 25px 50px rgba(0,0,0,0.1); text-align: center; font-weight: 800; color: var(--primary-dark); font-size: 16px; border-top: 5px solid var(--primary); }
.spinner { border: 4px solid #e2e8f0; border-top: 4px solid var(--primary); border-radius: 50%; width: 55px; height: 55px; animation: spin 1s cubic-bezier(0.55, 0.15, 0.45, 0.85) infinite; margin: 0 auto 15px auto; }
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

.modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(5px); align-items: center; justify-content: center; }
.modal-content { background: #fff; padding: 30px; border-radius: 20px; width: 90%; max-width: 450px; position: relative; animation: zoomIn 0.3s; box-shadow: 0 20px 50px rgba(0,0,0,0.2); max-height: 90vh; overflow-y: auto;}
@keyframes zoomIn { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.close { position: absolute; top: 15px; right: 20px; font-size: 24px; cursor: pointer; color: #94a3b8; transition: 0.3s; z-index: 10;}
.close:hover { color: var(--danger); transform: rotate(90deg); }
.flatpickr-calendar { margin: 0 auto 15px auto; box-shadow: none !important; border: 1px solid #e2e8f0; width: 100%; }

.table-container { overflow-x: auto; border-radius: 16px; border: 1px solid #e2e8f0; margin-top: 15px; }
table { width: 100%; border-collapse: collapse; background: #fff; }
th, td { padding: 14px 18px; text-align: left; border-bottom: 1px solid #f1f5f9; font-size: 13px;}
th { background: #f8fafc; color: var(--text-muted); font-weight: 700; font-size: 12px; text-transform: uppercase; letter-spacing: 1px; white-space: nowrap; }
tbody tr { transition: background 0.2s; }
tbody tr:hover { background-color: #f8fafc; }

.badge-in { background: #dcfce7; color: #166534; padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 800; border: 1px solid #bbf7d0; display: inline-block;}
.badge-out { background: #fef3c7; color: #92400e; padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 800; border: 1px solid #fde68a; display: inline-block;}
.badge-absent { background: #fee2e2; color: #991b1b; padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 800; border: 1px solid #fecaca; display: inline-block;}
.badge-leave { background: #e0e7ff; color: #3730a3; padding: 5px 12px; border-radius: 20px; font-size: 11px; font-weight: 800; border: 1px solid #c7d2fe; display: inline-block;}
.badge-manual { font-size: 10px; color: var(--accent); margin-left: 6px; font-weight: 700; background: #fef3c7; padding: 2px 6px; border-radius: 8px; border: 1px solid #fde68a; }
.badge-late { background: #fca5a5; color: #7f1d1d; padding: 3px 8px; border-radius: 6px; font-size: 10px; font-weight: 800; margin-left: 5px; }
.badge-early { background: #fcd34d; color: #78350f; padding: 3px 8px; border-radius: 6px; font-size: 10px; font-weight: 800; margin-left: 5px; }
.badge-exempt { background: #bfdbfe; color: #1e3a8a; padding: 3px 8px; border-radius: 6px; font-size: 10px; font-weight: 800; margin-left: 5px; }

.sms-sent { color: var(--success); font-weight: 700; }
.sms-failed { color: var(--danger); font-weight: 700; }
.sms-na { color: var(--text-muted); font-style: italic; }

@media print {
@page { size: A4 portrait; margin: 15mm 10mm; }
body { background: white; padding: 0; color: black; font-size: 11pt; font-family: 'Times New Roman', serif; }
.no-print, .summary-grid, .chart-container, .live-clock-box, .btn-group, button { display: none !important; }
.brand-header { background: transparent !important; color: black !important; box-shadow: none; border-bottom: 2px solid #000; border-radius: 0; padding: 0 0 15px 0; margin-bottom: 20px; display: flex !important; justify-content: center !important; align-items: center !important; flex-direction: column;}
.header-left { display: flex; align-items: center; justify-content: center; gap: 15px; width: 100%; text-align: center; }
.brand-logo { border: none; box-shadow: none; width: 65px; height: 65px; padding: 0; }
.brand-text h1 { font-size: 20pt; margin: 0; color: black !important; text-transform: uppercase; font-family: 'Times New Roman', serif; font-weight: bold;}
.brand-text p { font-size: 12pt; margin: 4px 0 0 0; color: #333 !important; }
.panel { box-shadow: none; border: none; padding: 0; margin: 0; }
#printableArea { border-top: none !important; }
#reportTitle { font-size: 14pt; margin-bottom: 15px; color: black !important; text-align: center; border-bottom: 1px dashed #ccc; padding-bottom: 8px; width: 100%; display: block; font-weight: bold;}
.table-container { border: none; border-radius: 0; margin-top: 0; overflow: visible; }
table { width: 100%; border-collapse: collapse; border: 1px solid #000; table-layout: auto; }
th, td { border: 1px solid #000; padding: 6px 5px; text-align: center; font-size: 10.5pt; word-break: break-word; color: black !important;}
td:nth-child(2) { text-align: left; font-weight: bold; } 
th { background-color: #f0f0f0 !important; font-weight: bold; -webkit-print-color-adjust: exact; print-color-adjust: exact; text-transform: uppercase;}
.badge-in, .badge-out, .badge-absent, .badge-leave, .badge-manual, .badge-late, .badge-early, .badge-exempt, .sms-sent, .sms-failed, .sms-na { border: none; background: transparent !important; color: black !important; padding: 0; font-weight: bold; font-size: 10pt; display: inline; }
tr { page-break-inside: avoid; }
}

@media (max-width: 768px) {
.brand-header { flex-direction: column; text-align: center; justify-content: center; gap: 15px;}
.header-left { flex-direction: column; }
.panel-grid { grid-template-columns: 1fr; }
.summary-grid { grid-template-columns: 1fr 1fr; }
}
</style>
</head>

<body>

<div id="loaderOverlay">
<div class="loader-box">
<div class="spinner"></div>
<div id="loaderMsg">SECURITY CHECK...<br><span style="font-size:11px; color:#64748b; font-weight: 500;">Verifying Admin Session</span></div>
</div>
</div>

<div class="container" id="appContainer">

<div class="brand-header">
<div class="header-left">
<img src="https://i.postimg.cc/9FxBsqsj/IMG-20251220-WA0006.jpg" alt="SRMS Logo" class="brand-logo">
<div class="brand-text">
<h1>Saidpur Residential Model School</h1>
<p>Premium Smart Attendance & Web Management System</p>
</div>
</div>
<div class="live-clock-box">
<div class="live-clock-time" id="clockTime">00:00:00 AM</div>
<div class="live-clock-date" id="clockDate">Loading...</div>
</div>
</div>

<div class="summary-grid no-print" id="analyticsGrid">
<div class="summary-card total">
<div class="card-title"><span>Total Records</span> <i class="fas fa-database"></i></div>
<div class="card-value" id="statTotal">0</div>
</div>
<div class="summary-card in">
<div class="card-title"><span>Total IN / Present</span> <i class="fas fa-sign-in-alt"></i></div>
<div class="card-value" id="statIn">0</div>
</div>
<div class="summary-card out">
<div class="card-title"><span>Total OUT / Absent</span> <i class="fas fa-sign-out-alt"></i></div>
<div class="card-value" id="statOut">0</div>
</div>
<div class="summary-card sms">
<div class="card-title"><span>Late / Leave / SMS</span> <i class="fas fa-envelope-open-text"></i></div>
<div class="card-value" id="statSms">0</div>
</div>
</div>

<!-- Interactive Chart Section -->
<div class="chart-container no-print" id="chartContainer" style="display:none;">
<canvas id="attendanceChart"></canvas>
</div>

<div class="panel-grid no-print">
<div class="panel" style="border-left: 4px solid var(--accent);">
<div class="panel-title">
<span><i class="fas fa-edit"></i> Manual Override & Leaves</span>
<div style="display:flex; gap:8px;">
<button class="btn-warn btn-small" onclick="openTimeModal()"><i class="fas fa-clock"></i> Timings</button>
<button class="btn-leave btn-small" onclick="openLeaveModal()"><i class="fas fa-user-shield"></i> Grant Leave</button>
</div>
</div>
<div class="flex-row">
<div class="input-group" style="flex: 2;">
<input type="text" id="manualId" placeholder="Student/Teacher ID or Machine ID">
</div>
<div class="input-group" style="flex: 1;">
<select id="manualType">
<option value="IN">Only IN</option>
<option value="OUT">Only OUT</option>
<option value="BOTH">Both (IN & OUT)</option>
</select>
</div>
</div>
<div class="flex-row" style="margin-top: 10px;">
<div class="input-group" style="flex: 2;">
<input type="password" id="manualPwd" placeholder="Admin Password">
</div>
<div class="input-group" style="flex: 1;">
<button class="btn-accent" onclick="submitManual()" style="width: 100%;"><i class="fas fa-check-circle"></i> Submit</button>
</div>
</div>
</div>

<div class="panel" style="border-left: 4px solid var(--primary);">
<div class="panel-title">
<span><i class="fas fa-filter"></i> Reports & Data Filters</span>
<div style="display:flex; gap:8px;">
<button class="btn-warn" onclick="openHolidayModal()" style="font-size: 11px; padding: 6px 10px;"><i class="fas fa-umbrella-beach"></i> Holidays</button>
<button class="btn-accent" onclick="syncMachineManually()" style="font-size: 11px; padding: 6px 10px;"><i class="fas fa-sync"></i> Sync</button>
<button class="btn-red" onclick="resetData()" style="font-size: 11px; padding: 6px 10px;"><i class="fas fa-trash-alt"></i> Reset</button>
</div>
</div>
<div class="flex-row">
<div class="input-group">
<span class="input-label">From Date</span>
<input type="date" id="dateFilterFrom">
</div>
<div class="input-group">
<span class="input-label">To Date</span>
<input type="date" id="dateFilterTo">
</div>
<div class="input-group">
<span class="input-label">Select Month (For Monthly)</span>
<input type="month" id="monthFilter">
</div>
</div>
<div class="flex-row" style="margin-top: 10px;">
<div class="input-group">
<span class="input-label">Select Category/Class</span>
<select id="classFilter">
<option value="All" style="font-weight:bold; color:var(--primary);">All (Teachers + Students)</option>
<option value="AllStudents" style="font-weight:bold; color:var(--accent);">All Students Only</option>
<option value="Teacher" style="font-weight:bold;">All Teachers & Staff</option>
<option disabled>──────────</option>
<option value="Play">Play Group</option>
<option value="Nursery">Nursery</option>
<option value="Class 1">Class 1</option>
<option value="Class 2">Class 2</option>
<option value="Class 3">Class 3</option>
<option value="Class 4">Class 4</option>
<option value="Class 5">Class 5</option>
<option value="Class 6">Class 6</option>
<option value="Class 7">Class 7</option>
<option value="Class 8">Class 8</option>
<option value="Class 9">Class 9</option>
<option value="Class 10">Class 10</option>
<option value="Class 11">Class 11</option>
<option value="Class 12">Class 12</option>
</select>
</div>
</div>
<div class="flex-row" style="margin-top: 15px;">
<button class="btn-primary" onclick="loadData('Present')" style="flex: 1;"><i class="fas fa-user-check"></i> Present</button>
<button class="btn-red" onclick="loadData('Absent')" style="flex: 1;"><i class="fas fa-user-times"></i> Absent</button>
<button class="btn-dark" onclick="loadData('Bunked')" style="flex: 1;"><i class="fas fa-user-ninja"></i> Bunked</button>
<button class="btn-warn" onclick="loadData('LateEarly')" style="flex: 1;"><i class="fas fa-clock"></i> Late/Early</button>
<button class="btn-info" onclick="loadData('Monthly')" style="flex: 1;"><i class="fas fa-calendar-check"></i> Monthly</button>
</div>
</div>
</div>

<div class="panel" id="printableArea" style="border-top: 4px solid var(--primary);">
<div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; margin-bottom: 10px; gap: 10px;">
<h2 id="reportTitle" style="color:var(--primary-dark); margin:0; font-weight: 800; text-transform: uppercase; font-size: 18px;">Attendance Report</h2>

<div class="search-wrapper no-print" style="max-width: 300px; width: 100%; flex: 1;">
<i class="fas fa-search"></i>
<input type="text" id="searchInput" onkeyup="filterTableFast()" placeholder="Search Name, ID or Roll...">
</div>

<div class="no-print" style="display:flex; gap:10px;">
<button class="btn-green" onclick="exportTableToCSV('SRMS_Attendance_Report.csv')"><i class="fas fa-file-excel"></i> Export CSV</button>
<button class="btn-dark" onclick="window.print()"><i class="fas fa-print"></i> Print</button>
</div>

</div>
<div class="table-container">
<table id="reportTable">
<thead id="tableHead">
<tr>
<th>ID Number</th>
<th>Full Name</th>
<th>Class/Role</th>
<th>Roll</th>
<th>Date</th>
<th>Time</th>
<th>Status / Punctuality</th>
<th class="no-print">Action / SMS</th>
</tr>
</thead>
<tbody id="tableBody">
<tr><td colspan="10" style="text-align:center; color:var(--text-muted); padding: 40px; font-weight: 500;"><i class="fas fa-table" style="font-size: 24px; display: block; margin-bottom: 10px; opacity: 0.5;"></i>Select filters, then click View to load data...</td></tr>
</tbody>
</table>
</div>
</div>

</div>

<!-- === MODALS === -->
<div id="timeModal" class="modal">
<div class="modal-content" style="max-width: 400px; text-align: left;">
<span class="close" onclick="closeModal('timeModal')">&times;</span>
<h3 style="color:var(--primary); margin-top:0; text-align:center; font-weight:800;"><i class="fas fa-clock"></i> Set Entry & Exit Time</h3>
<p style="font-size:12px; color:var(--text-muted); text-align:center; margin-bottom:15px;">Configure cut-off timings for Late Entry and Early Exit markings.</p>
<label style="font-size:12px; font-weight:700;">Maximum Allowed Entry Time (After this = Late)</label>
<input type="time" id="setEntryTime" style="margin-bottom: 10px;">
<label style="font-size:12px; font-weight:700;">Minimum Required Exit Time (Before this = Early)</label>
<input type="time" id="setExitTime" style="margin-bottom: 15px;">
<label style="font-size:12px; font-weight:700;">Admin Password</label>
<input type="password" id="timePwd" placeholder="Master Password" style="margin-bottom: 20px;">
<button class="btn-submit btn-primary" style="width:100%; font-size:14px;" onclick="saveTimings()"><i class="fas fa-save"></i> Save Settings</button>
</div>
</div>

<div id="holidayModal" class="modal">
<div class="modal-content" style="max-width: 450px; text-align: left;">
<span class="close" onclick="closeModal('holidayModal')">&times;</span>
<h3 style="color:var(--warning); margin-top:0; text-align:center; font-weight:800;"><i class="fas fa-umbrella-beach"></i> Global Calendar Holidays</h3>
<p style="font-size:12px; color:var(--text-muted); text-align:center; margin-bottom:15px; font-weight:500;">Click on multiple days in the calendar below to select them all at once for Everyone.</p>
<input type="text" id="holDates" style="display:none;">
<div style="margin-top: 15px;">
<label style="font-size:12px; font-weight:700;">Reason (e.g., Eid, Friday, Strike)</label>
<input type="text" id="holReason" placeholder="Holiday Reason" style="margin-bottom: 10px;">
<label style="font-size:12px; font-weight:700;">Admin Password</label>
<input type="password" id="holPwd" placeholder="Master Password" style="margin-bottom: 20px;">
<button class="btn-submit btn-warn" style="width:100%; font-size:14px;" onclick="submitHolidays()"><i class="fas fa-save"></i> Save Global Holidays</button>
</div>
</div>
</div>

<div id="leaveModal" class="modal">
