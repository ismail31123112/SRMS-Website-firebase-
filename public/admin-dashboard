        <!-- 🎥 INTEGRATED LIVE BROADCAST & MEETING HUB (ALL CATEGORIES FOR ADMIN) -->
        <div class="container hidden" id="live-hub-section" style="border-top-color: var(--danger-color);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
                <h2 style="margin:0; color:var(--danger-color); font-size:20px;"><i class="fas fa-satellite-dish"></i> Master Live Control Hub</h2>
                <button onclick="showSection('dashboard-section')" style="background:#f1f5f9; border:none; padding:8px 14px; border-radius:8px; font-weight:700; cursor:pointer; color:#334155;">⬅ Back</button>
            </div>

            <div style="background:#fffbeb; border:1px solid #fde68a; color:#b45309; padding:12px; border-radius:10px; font-size:12.5px; text-align:left; margin-bottom:15px; line-height:1.5;">
                <b>💡 অ্যাডমিন কন্ট্রোল:</b> আপনি এখান থেকে শিক্ষক, অভিভাবক, সম্পূর্ণ স্কুল কিংবা যেকোনো শ্রেণির লাইভ সেশন শুরু বা বন্ধ করতে পারবেন। একসাথে একাধিক ক্লাস/মিটিং সমান্তরালে চলতে পারবে এবং লাইভ শুরু করলেই সবার কাছে অফিশিয়াল <b>Push Notification</b> চলে যাবে।
            </div>

            <input type="text" id="adminLiveHost" value="Principal / Admin" placeholder="পরিচালকের নাম (যেমন: Principal / Admin)">
            <input type="text" id="adminLiveTopic" placeholder="মিটিং বা ক্লাসের বিষয় (যেমন: জরুরি স্টাফ মিটিং / গণিত)">

            <select id="adminLiveTarget" class="input-field" style="font-weight:700; color:var(--primary-color); border-color:#cbd5e1;">
                <optgroup label="👑 Special Official Meetings (Admin Exclusive)">
                    <option value="Teachers">👨‍🏫 Teachers' Live Meeting (সকল শিক্ষক)</option>
                    <option value="Guardian">👪 Guardian Live Meeting (সকল অভিভাবক)</option>
                    <option value="All">🏫 All School Live Meeting (সবার জন্য)</option>
                </optgroup>
                <optgroup label="📚 Primary & Junior Classes">
                    <option value="Play">Class Play</option><option value="Nursery">Class Nursery</option><option value="KG">Class KG</option>
                    <option value="1">Class 1</option><option value="2">Class 2</option><option value="3">Class 3</option><option value="4">Class 4</option>
                    <option value="5">Class 5</option><option value="6">Class 6</option><option value="7">Class 7</option><option value="8">Class 8</option>
                </optgroup>
                <optgroup label="🎓 Secondary Classes">
                    <option value="9-Science">Class 9 (Science)</option><option value="9-Arts">Class 9 (Arts)</option><option value="9-Commerce">Class 9 (Commerce)</option>
                    <option value="10-Science">Class 10 (Science)</option><option value="10-Arts">Class 10 (Arts)</option><option value="10-Commerce">Class 10 (Commerce)</option>
                </optgroup>
            </select>

            <!-- Optional Image / Banner Upload via ImgBB -->
            <div style="text-align:left; background:#f8fafc; padding:10px 14px; border-radius:10px; border:1px dashed #cbd5e1; margin-bottom:12px;">
                <label style="font-size:11.5px; font-weight:700; color:#475569; display:block; margin-bottom:5px;">🖼️ লোগো বা ছবি পরিবর্তন (ঐচ্ছিক - ImgBB Auto Upload):</label>
                <input type="file" id="adminAvatarFile" accept="image/*" onchange="uploadAvatarToImgBB(this, 'adminLivePic', 'adminImgStatus')" style="padding:6px; margin:0; font-size:12px; background:#fff;">
                <input type="hidden" id="adminLivePic" value="https://i.postimg.cc/hGQQqrsb/20260117_231551.png">
                <small id="adminImgStatus" style="font-size:11px; color:var(--primary-color); font-weight:600;"></small>
            </div>

            <button class="btn btn-danger" id="adminStartLiveBtn" onclick="startAdminLiveSession()" style="padding:15px; font-size:15px; letter-spacing:0.5px;">
                <i class="fas fa-broadcast-tower"></i> START LIVE &amp; SEND PUSH NOTIFICATION 🚀
            </button>

            <hr>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                <h3 style="margin:0; font-size:15px; color:var(--primary-color); font-weight:800;">🟢 বর্তমানে চলমান সকল লাইভ সেশন</h3>
                <button onclick="loadAllActiveLiveSessions()" style="background:#e2e8f0; border:none; padding:5px 12px; border-radius:6px; font-size:12px; font-weight:700; cursor:pointer;"><i class="fas fa-sync-alt"></i> Refresh</button>
            </div>
            <div id="adminActiveSessionsList">
                <p style="font-size:13px; color:#64748b;">লোড হচ্ছে...</p>
            </div>
        </div>

        <!-- 📩 Messaging Section -->
        <div class="container hidden" id="messaging-section">
            <h2>Broadcast Message</h2>
            <select id="audienceType" class="input-field" onchange="handleAudienceChange()" style="font-weight: 600; color: var(--primary-color);">
                <option value="Students">Send to Students</option>
                <option value="Teachers">Send to Teachers</option>
            </select>

            <select id="recipientClass" class="input-field" onchange="loadSpecificUsers()" style="font-weight: 600;">
                <option value="All">All Students (Entire School)</option>
                <option value="Play">Play</option><option value="Nursery">Nursery</option><option value="KG">KG</option>
                <option value="1">Class 1</option><option value="2">Class 2</option><option value="3">Class 3</option>
                <option value="4">Class 4</option><option value="5">Class 5</option><option value="6">Class 6</option>
                <option value="7">Class 7</option><option value="8">Class 8</option><option value="9">Class 9</option>
                <option value="10">Class 10</option>
            </select>

            <select id="specificUser" class="input-field" style="border-color: #cbd5e1; background: #f8fafc;">
                <option value="All">Loading list...</option>
            </select>
            <select id="msgType" class="input-field">
                <option value="Both">Send Both (Email &amp; SMS)</option>
                <option value="SMS">Send SMS Only</option>
                <option value="Email">Send Email Only</option>
            </select>
            <textarea id="msgBody" class="input-field" placeholder="Type your formal notice/message here..." rows="4"></textarea>
            <button class="btn" onclick="sendBroadcast()" id="sendBtn" style="margin-top: 15px;">
                <i class="fas fa-spinner spinner" id="sendSpinner"></i><span id="sendText">Start Broadcast</span>
            </button>

            <button class="btn btn-danger" onclick="showSection('dashboard-section')" style="background: #64748b; margin-top: 10px;">Back to Dashboard</button>
            <p id="send-msg" class="msg-text"></p>
        </div>

        <!-- 🔑 Change Password Section -->
        <div class="container hidden" id="change-pass-section">
            <h2>Change Password</h2>
            <div class="password-container">
                <input type="password" id="new-password" placeholder="Enter New Password (Min. 6 chars)">
                <i class="fas fa-eye toggle-password" onclick="togglePasswordVisibility('new-password', this)"></i>
            </div>
            <button class="btn btn-warning" onclick="updatePassword()" id="updateBtn">
                <i class="fas fa-spinner spinner" id="updateSpinner"></i><span id="updateText">Update Password</span>
            </button>
            <button class="btn btn-danger" onclick="showSection('dashboard-section')">Cancel</button>
            <p id="success-msg" class="msg-text"></p>
        </div>

    </div>

    <!-- 🌐 Firebase Client SDKs -->
    <script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-firestore-compat.js"></script>

    <script>
        // 🚀 Firebase Configuration
        const firebaseConfig = {
            apiKey: "AIzaSyBhzidG1s5CsOaiY0RsBG6GJcrE12LLEuU",
            authDomain: "srms-website-management.firebaseapp.com",
            projectId: "srms-website-management",
            storageBucket: "srms-website-management.firebasestorage.app",
            messagingSenderId: "960037316778",
            appId: "1:960037316778:web:d6f9b1f434572d9374c8d3"
        };
        if (!firebase.apps.length) { firebase.initializeApp(firebaseConfig); }
        const auth = firebase.auth();
        const db = firebase.firestore();

        auth.setPersistence(firebase.auth.Auth.Persistence.LOCAL).catch((error) => {
            console.error("Session persistence error:", error);
        });

        // 🌐 Backend URLs
        const scriptURL = 'https://api.srms2012.edu.bd/api/admin'; 
        const LIVE_SCRIPT_URL = 'https://api.srms2012.edu.bd/api/live';
        const IMGBB_API_KEY = ''; // Optional: এখানে আপনার ImgBB API Key দিতে পারেন

        let cachedTeachers = [];
        let cachedStudents = [];

        function sanitizeHTML(str) {
            if (typeof str !== 'string') return str;
            return str.replace(/[&<>'"]/g, tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag]));
        }

        // --- 🚀 SECURITY GATE: AUTO VERIFY OR KICK OUT ---
        window.onload = function() {
            auth.onAuthStateChanged((user) => {
                if(user && (user.email === "admin@srms.edu.bd" || user.email === "srms2012.edu@gmail.com")) {
                    document.getElementById('loader').style.display = 'none';
                    document.getElementById('appBody').style.display = 'flex';
                    
                    user.getIdToken().then(token => sessionStorage.setItem('portal_token', token));
                    
                    prefetchDataDirectly(); 
                    loadAllActiveLiveSessions();
                } else {
                    document.getElementById('loaderText').innerHTML = "UNAUTHORIZED ACCESS!<br><span style='font-size:11px; color:#ef4444;'>Redirecting to Login...</span>";
                    let baseUrl = window.location.origin || (window.location.protocol + "//" + window.location.host);
                    window.location.replace(baseUrl + "/login-panel/accounting-and-management-department");
                }
            });
        };

        function showSection(sectionId) {
            document.querySelectorAll('.container').forEach(c => { c.classList.add('hidden'); c.classList.remove('show-section'); });
            const target = document.getElementById(sectionId);
            if(target) { target.classList.remove('hidden'); target.classList.add('show-section'); }
        }

        function openLiveHubSection() {
            showSection('live-hub-section');
            loadAllActiveLiveSessions();
        }

        // 🖼️ ImgBB API v1 Direct Upload Helper
        async function uploadAvatarToImgBB(fileInput, targetHiddenId, statusId) {
            const file = fileInput.files[0];
            if (!file) return;
            const statusEl = document.getElementById(statusId);

            if (!IMGBB_API_KEY) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById(targetHiddenId).value = e.target.result;
                    statusEl.innerText = "✅ ছবি যুক্ত হয়েছে!";
                };
                reader.readAsDataURL(file);
                return;
            }

            statusEl.innerText = "⏳ ImgBB-তে ছবি আপলোড হচ্ছে...";
            const formData = new FormData();
            formData.append("image", file);

            try {
                const res = await fetch(`https://api.imgbb.com/1/upload?key=${IMGBB_API_KEY}`, {
                    method: "POST",
                    body: formData
                });
                const json = await res.json();
                if (json && json.success && json.data && json.data.display_url) {
                    document.getElementById(targetHiddenId).value = json.data.display_url;
                    statusEl.innerText = "✅ ছবি সফলভাবে আপলোড হয়েছে!";
                } else {
                    statusEl.innerText = "⚠️ আপলোড ব্যর্থ, ডিফল্ট লোগো ব্যবহৃত হবে।";
                }
            } catch (err) {
                statusEl.innerText = "⚠️ নেটওয়ার্ক এরর, ডিফল্ট লোগো ব্যবহৃত হবে।";
            }
        }

        // =========================================================================
        // 🎥 ADMIN MASTER LIVE CONTROL (Multiple Simultaneous Sessions Supported)
        // =========================================================================
        function getTargetReadableName(code) {
            const select = document.getElementById('adminLiveTarget');
            const opt = Array.from(select.options).find(o => o.value === code);
            return opt ? opt.text : ("Class " + code);
        }

        async function loadAllActiveLiveSessions() {
            const listContainer = document.getElementById('adminActiveSessionsList');
            const counterBadge = document.getElementById('dashLiveCounter');
            listContainer.innerHTML = `<p style="font-size:13px; color:#b45309; font-weight:600;">⏳ চলমান সেশন চেক করা হচ্ছে...</p>`;

            try {
                const snap = await db.collection('LiveSessions').get();
                let activeHtml = '';
                let count = 0;

                snap.forEach(doc => {
                    const data = doc.data() || {};
                    const docId = doc.id;
                    if (String(data.status).toUpperCase() === "TRUE") {
                        count++;
                        const title = sanitizeHTML(data.title || "Live Session");
                        const host = sanitizeHTML(data.host || "Admin / Teacher");
                        const startTime = sanitizeHTML(data.startTime || "Running");
                        const label = sanitizeHTML(getTargetReadableName(docId));

                        activeHtml += `
                        <div class="live-session-card">
                            <h4>
                                <span>🔴 ${label}</span>
                                <span style="font-size:11px; background:#dcfce7; color:#166534; padding:3px 8px; border-radius:10px;">${startTime}</span>
                            </h4>
                            <p><b>বিষয়:</b> ${title}</p>
                            <p><b>পরিচালনায়:</b> ${host}</p>
                            <div class="live-card-actions">
                                <button class="btn-join-live" onclick="joinLiveRoomAsAdmin('${docId}')"><i class="fas fa-sign-in-alt"></i> Join Room</button>
                                <button class="btn-end-live" onclick="stopSpecificLiveSession('${docId}', '${title.replace(/'/g, "")}', this)"><i class="fas fa-stop-circle"></i> End Session</button>
                            </div>
                        </div>`;
                    }
                });

                if (count > 0) {
                    listContainer.innerHTML = activeHtml;
                    counterBadge.style.display = 'inline-block';
                    counterBadge.innerText = count + " LIVE";
                } else {
                    listContainer.innerHTML = `<p style="font-size:13px; color:#64748b; background:#f8fafc; padding:15px; border-radius:10px; border:1px dashed #cbd5e1;">বর্তমানে কোনো লাইভ ক্লাস বা মিটিং চলছে না।</p>`;
                    counterBadge.style.display = 'none';
                }
            } catch (e) {
                listContainer.innerHTML = `<p style="color:var(--danger-color); font-size:13px; font-weight:700;">সেশন লোড করতে সমস্যা হয়েছে!</p>`;
            }
        }

        async function startAdminLiveSession() {
            const target = document.getElementById('adminLiveTarget').value;
            const hostName = document.getElementById('adminLiveHost').value.trim() || "Admin";
            const topic = document.getElementById('adminLiveTopic').value.trim();
            const pic = document.getElementById('adminLivePic').value;
            const btn = document.getElementById('adminStartLiveBtn');

            if (!topic) {
                alert("⚠️ অনুগ্রহ করে মিটিং বা ক্লাসের বিষয় (Topic) লিখুন!");
                return;
            }

            btn.disabled = true;
            btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> ব্রডকাস্ট শুরু হচ্ছে...`;

            // 1. Open Jitsi Live Room in New Tab
            const config = `#config.prejoinPageEnabled=false&userInfo.displayName="${encodeURIComponent(hostName + ' (Admin)')}"&userInfo.avatarUrl="${encodeURIComponent(pic)}"&interfaceConfig.TOOLBAR_BUTTONS=["microphone","camera","desktop","chat","raisehand","mute-everyone","security","tileview","fullscreen","hangup","settings","recording","livestreaming"]`;
            window.open(`https://meet.jit.si/SRMS-Live-${target}${config}`, '_blank');

            const nowTime = new Date().toLocaleTimeString("en-US", { hour: '2-digit', minute: '2-digit' });

            try {
                // 2. Direct Instant Firestore Update (Multi-session safe)
                await db.collection('LiveSessions').doc(target).set({
                    status: "TRUE",
                    title: topic,
                    host: hostName,
                    hostRole: "Admin",
                    startTime: nowTime,
                    updatedAt: Date.now()
                }, { merge: true });

                // 3. Trigger Backend for Official OneSignal Push Notification
                fetch(LIVE_SCRIPT_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    body: JSON.stringify({
                        action: "update",
                        className: target,
                        status: "TRUE",
                        title: topic,
                        host: hostName,
                        hostRole: "Admin"
                    })
                }).catch(e => {});

                document.getElementById('adminLiveTopic').value = '';
                await loadAllActiveLiveSessions();
            } catch (err) {
                alert("ডাটাবেস আপডেটে সমস্যা হয়েছে: " + err.message);
            }

            btn.disabled = false;
            btn.innerHTML = `<i class="fas fa-broadcast-tower"></i> START LIVE & SEND PUSH NOTIFICATION 🚀`;
        }

        function joinLiveRoomAsAdmin(target) {
            const hostName = document.getElementById('adminLiveHost').value.trim() || "Admin";
            const pic = document.getElementById('adminLivePic').value;
            const config = `#config.prejoinPageEnabled=false&userInfo.displayName="${encodeURIComponent(hostName + ' (Admin)')}"&userInfo.avatarUrl="${encodeURIComponent(pic)}"`;
            window.open(`https://meet.jit.si/SRMS-Live-${target}${config}`, '_blank');
        }

        async function stopSpecificLiveSession(target, title, btnEl) {
            btnEl.disabled = true;
            btnEl.innerText = "Ending...";
            try {
                await db.collection('LiveSessions').doc(target).set({
                    status: "FALSE",
                    title: title,
                    updatedAt: Date.now()
                }, { merge: true });

                fetch(LIVE_SCRIPT_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    body: JSON.stringify({ action: "update", className: target, status: "FALSE", title: title })
                }).catch(e => {});

                await loadAllActiveLiveSessions();
            } catch (e) {
                btnEl.disabled = false;
                btnEl.innerText = "End Session";
            }
        }

        function togglePasswordVisibility(inputId, icon) {
            const input = document.getElementById(inputId);
            if (input.type === "password") { input.type = "text"; icon.classList.replace('fa-eye', 'fa-eye-slash'); } 
            else { input.type = "password"; icon.classList.replace('fa-eye-slash', 'fa-eye'); }
        }
        
        function logout() { 
            auth.signOut().then(() => {
                sessionStorage.clear();
                let baseUrl = window.location.origin || (window.location.protocol + "//" + window.location.host);
                window.location.replace(baseUrl + "/login-panel/accounting-and-management-department");
            }).catch((error) => {
                sessionStorage.clear();
                let baseUrl = window.location.origin || (window.location.protocol + "//" + window.location.host);
                window.location.replace(baseUrl + "/login-panel/accounting-and-management-department");
            });
        }
        
        function showChangePassword() { showSection('change-pass-section'); document.getElementById('success-msg').innerText = ""; }
        
        async function updatePassword() {
            const newPass = document.getElementById('new-password').value.trim();
            const msg = document.getElementById('success-msg');
            const btn = document.getElementById('updateBtn');
            
            if(!newPass || newPass.length < 6) { msg.style.color = "var(--danger-color)"; msg.innerText = "⚠ Minimum 6 characters required!"; return; }
            
            btn.disabled = true;
            document.getElementById('updateSpinner').style.display = "inline-block";
            document.getElementById('updateText').innerText = "Updating...";
            
            try {
                const user = auth.currentUser;
                if(!user) throw new Error("Not authenticated");

                await user.updatePassword(newPass);
                await db.collection('Admin').doc('Settings').set({ password: newPass }, { merge: true });
                
                msg.style.color = "var(--success-color)"; 
                msg.innerText = "✅ Changed successfully!"; 
                setTimeout(() => { showSection('dashboard-section'); document.getElementById('new-password').value = ''; }, 1500);
            } catch(e) {
                msg.style.color = "var(--danger-color)"; 
                msg.innerText = "❌ Error! Try re-logging in.";
            }
            btn.disabled = false;
            document.getElementById('updateSpinner').style.display = "none"; 
            document.getElementById('updateText').innerText = "Update Password";
        }

        async function prefetchDataDirectly() {
            try {
                const [tSnap, sSnap] = await Promise.all([
                    db.collection('Teachers').get(),
                    db.collection('Students').get()
                ]);
                
                cachedTeachers = [];
                tSnap.forEach(doc => {
                    let d = doc.data();
                    cachedTeachers.push({ name: d.name || "Teacher", phone: d.phone || "" });
                });

                cachedStudents = [];
                sSnap.forEach(doc => {
                    let d = doc.data();
                    cachedStudents.push({ 
                        id: d.studentID || "", name: d.name || "Unknown", roll: d.roll ? parseInt(d.roll, 10) : 9999, cls: d.class || "" 
                    });
                });
                cachedStudents.sort((a,b) => a.roll - b.roll);
                
            } catch(e) { console.log("Prefetch error:", e); }
        }

        window.handleAudienceChange = function() {
            const aud = document.getElementById('audienceType').value;
            if(aud === "Teachers") {
                document.getElementById('recipientClass').style.display = 'none';
            } else {
                document.getElementById('recipientClass').style.display = 'block';
            }
            loadSpecificUsers();
        };

        window.loadSpecificUsers = function() {
             const aud = document.getElementById('audienceType').value;
             const cls = document.getElementById('recipientClass').value;
             const select = document.getElementById('specificUser');
             
             if (aud === "Teachers") {
                 let opts = `<option value="All">All Teachers</option>`;
                 cachedTeachers.forEach(t => {
                     if(t.phone) opts += `<option value="${t.phone}">${t.name} (${t.phone})</option>`;
                 });
                 select.innerHTML = opts;
             } else {
                 if (cls === "All") {
                     select.innerHTML = `<option value="All">All Students (Entire School)</option>`;
                     return;
                 }
                 let opts = `<option value="All">All Students of Class ${cls}</option>`;
                 cachedStudents.filter(s => s.cls === cls).forEach(s => {
                     opts += `<option value="${s.id}">Roll ${s.roll} - ${s.name} (${s.id})</option>`;
                 });
                 select.innerHTML = opts;
             }
        };

        window.sendBroadcast = async function() {
            const audienceType = document.getElementById('audienceType').value;
            const targetClass = document.getElementById('recipientClass').value;
            const specificUser = document.getElementById('specificUser').value;
            const msgType = document.getElementById('msgType').value;
            const msgBody = document.getElementById('msgBody').value;
            const msgStatus = document.getElementById('send-msg');
            const btn = document.getElementById('sendBtn');
            
            if (!msgBody) { msgStatus.style.color = "var(--danger-color)"; msgStatus.innerText = "⚠️ Message body is empty!"; return; }

            btn.disabled = true;
            document.getElementById('sendSpinner').style.display = "inline-block";
            document.getElementById('sendText').innerText = "Transmitting...";
            msgStatus.style.color = "#333"; msgStatus.innerText = "Connecting to Broadcast Server...";

            let payload = {
                action: 'sendMessage',
                audienceType: audienceType, targetClass: targetClass, specificUser: specificUser, msgType: msgType, msgBody: msgBody,
                token: sessionStorage.getItem('portal_token')
            };

            fetch(scriptURL, {
                method: 'POST',
                headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                body: JSON.stringify(payload)
            })
            .then(response => response.json())
            .then(data => {
                document.getElementById('sendSpinner').style.display = "none"; 
                document.getElementById('sendText').innerText = "Start Broadcast";
                btn.disabled = false;
                
                if(data.status === "error") {
                    msgStatus.style.color = "var(--danger-color)"; 
                    msgStatus.innerText = "❌ " + data.message;
                } else {
                    msgStatus.style.color = "var(--success-color)"; 
                    msgStatus.innerText = data.message;
                    document.getElementById('msgBody').value = ''; 
                }
            })
            .catch(error => {
                msgStatus.style.color = "var(--danger-color)"; 
                msgStatus.innerText = "🌐 Connection Error! Message may not be sent."; 
                document.getElementById('sendSpinner').style.display = "none"; 
                document.getElementById('sendText').innerText = "Start Broadcast";
                btn.disabled = false;
            });
        };
    </script>
