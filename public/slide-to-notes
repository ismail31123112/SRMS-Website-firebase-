    function downloadOptimizedPDF() {
      const selected = pages.filter(p => p.selected);
      if (selected.length === 0) {
        alert(currentLanguage === 'en' ? 'Please select at least one page to export!' : 'कृपया निर्यात करने के लिए कम से कम एक पृष्ठ चुनें!');
        return;
      }

      try {
        const { jsPDF } = window.jspdf;
        const isPortrait = appSettings.orientation === 'portrait';
        const pdf = new jsPDF({
          orientation: isPortrait ? 'portrait' : 'landscape',
          unit: 'mm',
          format: appSettings.pageSize
        });

        const paperW = appSettings.pageSize === 'a4' ? 210 : 216;
        const paperH = appSettings.pageSize === 'a4' ? 297 : 279;

        let margin = 0;
        if (appSettings.marginSize === 'thin') margin = 5;
        if (appSettings.marginSize === 'standard') margin = 12;

        const printableW = paperW - (margin * 2);
        const printableH = paperH - (margin * 2);

        const chunks = [];
        const chunkSize = appSettings.imagesPerSheet;
        for (let i = 0; i < selected.length; i += chunkSize) {
          chunks.push(selected.slice(i, i + chunkSize));
        }

        chunks.forEach((chunk, chunkIndex) => {
          if (chunkIndex > 0) {
            pdf.addPage();
          }

          chunk.forEach((page, itemIndex) => {
            let x = margin;
            let y = margin;
            let itemW = printableW;
            let itemH = printableH;

            if (chunkSize === 2) {
              const gap = 6;
              if (!isPortrait) {
                itemW = (printableW - gap) / 2;
                itemH = printableH;
                x = margin + itemIndex * (itemW + gap);
                y = margin;
              } else {
                itemW = printableW;
                itemH = (printableH - gap) / 2;
                x = margin;
                y = margin + itemIndex * (itemH + gap);
              }
            } else if (chunkSize === 3) {
              const gap = 5;
              itemW = printableW;
              itemH = (printableH - 2 * gap) / 3;
              x = margin;
              y = margin + itemIndex * (itemH + gap);
            } else if (chunkSize === 4) {
              const gap = 6;
              itemW = (printableW - gap) / 2;
              itemH = (printableH - gap) / 2;
              const row = Math.floor(itemIndex / 2);
              const col = itemIndex % 2;
              x = margin + col * (itemW + gap);
              y = margin + row * (itemH + gap);
            }

            const pageRatio = page.width / page.height;
            let fitW = itemW;
            let fitH = itemH;
            if (itemW / itemH > pageRatio) {
              fitH = itemH;
              fitW = itemH * pageRatio;
            } else {
              fitW = itemW;
              fitH = itemW / pageRatio;
            }
            const dx = x + (itemW - fitW) / 2;
            const dy = y + (itemH - fitH) / 2;

            pdf.addImage(
              page.processedUrl,
              'JPEG',
              dx,
              dy,
              fitW,
              fitH,
              undefined,
              'FAST'
            );
          });
        });

        const safeName = fileMeta.name.replace('.pdf', '');
        pdf.save(`optimized-${safeName}.pdf`);

        const savedHistory = JSON.parse(localStorage.getItem('standalone_ink_save_history') || '[]');
        const newItem = {
          id: Math.random().toString(36).substr(2, 9),
          fileName: fileMeta.name,
          pages: selected.length,
          timestamp: new Date().toLocaleTimeString(),
          savings: '≈ ' + Math.floor(selected.length * 90) + '%'
        };
        savedHistory.unshift(newItem);
        localStorage.setItem('standalone_ink_save_history', JSON.stringify(savedHistory.slice(0, 10)));
        renderHistory();

      } catch (err) {
        console.error(err);
        alert(currentLanguage === 'en' ? 'PDF Generation failed.' : 'पीडीएफ संकलन विफल रहा।');
      }
    }

    function triggerDirectPrint() {
      const selected = pages.filter(p => p.selected);
      if (selected.length === 0) {
        alert(currentLanguage === 'en' ? 'Please select at least one page to print!' : 'कृपया प्रिंट करने के लिए कम से कम एक पृष्ठ चुनें!');
        return;
      }

      const printContainer = document.getElementById('print-container');
      printContainer.innerHTML = '';

      const chunks = [];
      const chunkSize = appSettings.imagesPerSheet;
      for (let i = 0; i < selected.length; i += chunkSize) {
        chunks.push(selected.slice(i, i + chunkSize));
      }

      chunks.forEach((chunk) => {
        const sheet = document.createElement('div');
        
        let marginClass = 'print-sheet-margin-none';
        if (appSettings.marginSize === 'thin') marginClass = 'print-sheet-margin-thin';
        if (appSettings.marginSize === 'standard') marginClass = 'print-sheet-margin-standard';

        let gridClass = 'print-grid-1';
        if (chunkSize === 2) {
          gridClass = appSettings.orientation === 'landscape' ? 'print-grid-2-landscape' : 'print-grid-2-portrait';
        } else if (chunkSize === 3) {
          gridClass = 'print-grid-3';
        } else if (chunkSize === 4) {
          gridClass = 'print-grid-4';
        }

        const sizeClass = appSettings.pageSize === 'a4' ? 'print-size-a4' : 'print-size-letter';
        const orientationClass = appSettings.orientation === 'landscape' ? 'print-orientation-landscape' : 'print-orientation-portrait';

        sheet.className = `print-sheet ${sizeClass} ${orientationClass} ${marginClass} ${gridClass}`;

        chunk.forEach((page) => {
          const frame = document.createElement('div');
          frame.className = 'print-img-frame';

          const img = document.createElement('img');
          img.src = page.processedUrl;
          img.className = 'print-image';

          frame.appendChild(img);
          sheet.appendChild(frame);
        });

        printContainer.appendChild(sheet);
      });

      window.print();
    }

    function resetWorkspace() {
      fileMeta = { name: '', size: 0, totalPages: 0 };
      pages = [];
      activeMode = 'ink-saver';
      customFilters = { invert: true, grayscale: false, brightness: 0, contrast: 0, threshold: 0 };
      appSettings = { pageSize: 'a4', orientation: 'portrait', marginSize: 'none', imagesPerSheet: 1 };

      document.getElementById('setting-pageSize').value = 'a4';
      document.getElementById('setting-orientation').value = 'portrait';
      document.getElementById('setting-marginSize').value = 'none';
      document.getElementById('setting-imagesPerSheet').value = '1';
      document.getElementById('file-input').value = '';

      setConversionMode('ink-saver');
      renderPreviewGrid();
      updateActionButtonsState();
    }

    function renderHistory() {
      const container = document.getElementById('history-container');
      const emptyMsg = document.getElementById('history-empty-message');
      const saved = JSON.parse(localStorage.getItem('standalone_ink_save_history') || '[]');

      if (saved.length === 0) {
        container.classList.add('hidden');
        emptyMsg.classList.remove('hidden');
        return;
      }

      emptyMsg.classList.add('hidden');
      container.classList.remove('hidden');
      container.innerHTML = '';

      saved.forEach((item) => {
        const log = document.createElement('div');
        log.className = "flex items-center justify-between p-3 rounded-xl bg-gray-950/40 border border-gray-900/60 text-xs";

        log.innerHTML = `
          <div class="flex items-center gap-2.5">
            <div class="p-1.5 rounded-lg bg-amber-500/10 text-amber-500">
              <i data-lucide="file-check" class="w-3.5 h-3.5"></i>
            </div>
            <div class="space-y-0.5">
              <span class="font-sans font-bold text-white block truncate max-w-[200px]">${item.fileName}</span>
              <span class="text-[10px] text-gray-500 font-mono">${item.timestamp} • ${item.pages} ${currentLanguage === 'en' ? 'Pages' : 'पृष्ठ'}</span>
            </div>
          </div>
          <div class="text-right">
            <span class="px-2 py-0.5 rounded-full border border-emerald-500/20 bg-emerald-500/5 text-[10px] font-mono font-bold text-emerald-400">
              ${currentLanguage === 'en' ? 'Saved' : 'बचत'}: ${item.savings}
            </span>
          </div>
        `;

        container.appendChild(log);
      });

      lucide.createIcons();
    }

    function clearHistory() {
      localStorage.removeItem('standalone_ink_save_history');
      renderHistory();
    }

    function clearCacheAndStorage() {
      const text = currentLanguage === 'en' 
        ? 'Are you sure you want to clear all stored history logs and cache settings?' 
        : 'क्या आप वाकई सभी सहेजे गए इतिहास लॉग और कैश सेटिंग्स को मिटाना चाहते हैं?';
      
      if (confirm(text)) {
        localStorage.clear();
        resetWorkspace();
        renderHistory();
        alert(currentLanguage === 'en' ? 'Storage successfully cleared!' : 'कैश सफलतापूर्वक साफ किया गया!');
      }
    }

    function generateDemoPagesData() {
      const mockCanvas = (title, subtitle, extraFunc) => {
        const canvas = document.createElement('canvas');
        canvas.width = 1200;
        canvas.height = 800;
        const ctx = canvas.getContext('2d');

        ctx.fillStyle = '#0b1120';
        ctx.fillRect(0, 0, 1200, 800);

        ctx.strokeStyle = '#1e293b';
        ctx.lineWidth = 1;
        for (let x = 0; x < 1200; x += 40) {
          ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, 800); ctx.stroke();
        }
        for (let y = 0; y < 800; y += 40) {
          ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(1200, y); ctx.stroke();
        }

        ctx.fillStyle = '#f59e0b';
        ctx.font = 'bold 36px "Inter", sans-serif';
        ctx.fillText(title, 80, 100);

        ctx.fillStyle = '#94a3b8';
        ctx.font = '18px "JetBrains Mono", monospace';
        ctx.fillText(subtitle, 80, 140);

        ctx.strokeStyle = '#334155';
        ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(80, 160); ctx.lineTo(1120, 160); ctx.stroke();

        extraFunc(ctx);

        return { originalUrl: canvas.toDataURL('image/jpeg', 0.85), width: 1200, height: 800 };
      };

      return [
        mockCanvas('Coaching Notes - Electrostatics', 'Topic: Coulomb\'s Law & Field Lines (Class XII Physics)', (ctx) => {
          ctx.fillStyle = '#f8fafc';
          ctx.font = '500 24px "Inter", sans-serif';
          ctx.fillText('1. Coulomb\'s Force Law:', 80, 220);
          ctx.fillStyle = '#e2e8f0';
          ctx.font = '20px "JetBrains Mono", monospace';
          ctx.fillText('F = k * ( |q₁ • q₂| ) / r²', 120, 260);

          ctx.lineWidth = 3;
          ctx.strokeStyle = '#ec4899'; 
          ctx.beginPath(); ctx.moveTo(400, 500); ctx.bezierCurveTo(450, 400, 750, 400, 800, 500); ctx.stroke();

          ctx.fillStyle = '#ef4444'; ctx.beginPath(); ctx.arc(400, 500, 25, 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = '#3b82f6'; ctx.beginPath(); ctx.arc(800, 500, 25, 0, Math.PI * 2); ctx.fill();
        }),
        mockCanvas('Blackboard Mathematics: Integration', 'Integration by Parts & Blackboard Chalk Styles', (ctx) => {
          ctx.fillStyle = '#ffffff';
          ctx.font = 'italic 28px "Times New Roman", serif';
          ctx.fillText('Let u and v be differentiable functions of x.', 100, 220);
          ctx.fillStyle = '#a7f3d0';
          ctx.font = 'italic bold 38px "Times New Roman", serif';
          ctx.fillText('∫ u dv  =  u • v  -  ∫ v du', 380, 320);
        }),
        mockCanvas('📝 iPad Notes: Full-Stack Flow', 'iPad GoodNotes / Notability Dark Template Flow', (ctx) => {
          ctx.lineWidth = 4;
          ctx.strokeStyle = '#f43f5e';
          ctx.strokeRect(150, 220, 220, 120);
          ctx.fillStyle = '#f43f5e';
          ctx.font = 'bold 22px "Inter", sans-serif';
          ctx.fillText('Client Browser', 180, 270);

          ctx.strokeStyle = '#10b981';
          ctx.strokeRect(750, 220, 240, 120);
          ctx.fillStyle = '#10b981';
          ctx.fillText('Express Backend', 780, 270);
        })
      ];
    }
  </script>
