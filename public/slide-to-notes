    async function handleFiles(files) {
      document.getElementById('error-panel').classList.add('hidden');
      if (files.length === 0) return;

      const pdfFile = files.find(f => f.type === 'application/pdf' || f.name.endsWith('.pdf'));

      if (pdfFile) {
        await processSinglePdf(pdfFile);
      } else {
        const imageFiles = files.filter(f => f.type.startsWith('image/'));
        if (imageFiles.length === 0) {
          showError(currentLanguage === 'en' 
            ? 'Unsupported format! Please upload PDF files or notes images (PNG/JPEG).'
            : 'असमर्थित प्रारूप! कृपया पीडीएफ या नोट्स इमेज (PNG/JPEG) अपलोड करें।'
          );
          return;
        }
        await processMultipleImages(imageFiles);
      }
    }

    function showError(msg) {
      const errorPanel = document.getElementById('error-panel');
      const errorText = document.getElementById('error-message-text');
      errorText.textContent = msg;
      errorPanel.classList.remove('hidden');
    }

    async function processSinglePdf(file) {
      setProcessing(true, 
        currentLanguage === 'en' ? 'Reading PDF file...' : 'पीडीएफ फाइल पढ़ी जा रही है...',
        currentLanguage === 'en' ? 'Parsing PDF contents...' : 'पीडीएफ पार्स किया जा रहा है...'
      );

      fileMeta = { name: file.name, size: file.size, totalPages: 0 };

      try {
        const arrayBuffer = await file.arrayBuffer();
        const loadingTask = pdfjsLib.getDocument({ data: arrayBuffer });
        const pdf = await loadingTask.promise;
        const pageCount = pdf.numPages;
        fileMeta.totalPages = pageCount;

        if (pageCount === 0) {
          throw new Error(currentLanguage === 'en' ? 'The selected PDF contains zero pages.' : 'चुनी गई पीडीएफ में कोई पृष्ठ नहीं है.');
        }

        pages = [];

        for (let i = 1; i <= pageCount; i++) {
          setProcessing(true, 
            currentLanguage === 'en' ? 'Extracting pages...' : 'पृष्ठ निकाले जा रहे हैं...',
            currentLanguage === 'en' ? `Page ${i} of ${pageCount}...` : `पेज ${i} / ${pageCount}...`
          );

          const page = await pdf.getPage(i);
          const viewport = page.getViewport({ scale: 1.5 });
          const canvas = document.createElement('canvas');
          const context = canvas.getContext('2d');

          if (!context) throw new Error('Canvas context initialization failed.');

          canvas.width = viewport.width;
          canvas.height = viewport.height;

          await page.render({
            canvasContext: context,
            viewport: viewport,
            canvas: canvas
          }).promise;

          const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
          pages.push({
            pageNumber: i,
            originalUrl: dataUrl,
            processedUrl: dataUrl, 
            width: viewport.width,
            height: viewport.height,
            selected: true
          });
        }

        await runFiltersOnAllPages();

      } catch (err) {
        console.error(err);
        showError(err.message || 'Error occurred during PDF loading.');
        setProcessing(false);
      }
    }

    async function processMultipleImages(files) {
      setProcessing(true, currentLanguage === 'en' ? 'Preparing images...' : 'इमेज तैयार की जा रही हैं...');
      
      const count = files.length;
      const combinedName = count === 1 
        ? files[0].name 
        : `${files[0].name.split('.')[0]} + ${count - 1} other${count > 2 ? 's' : ''}`;

      let totalSize = 0;
      pages = [];
      fileMeta = { name: combinedName, size: 0, totalPages: count };

      for (let i = 0; i < count; i++) {
        const file = files[i];
        totalSize += file.size;

        setProcessing(true, 
          currentLanguage === 'en' ? 'Loading image files...' : 'इमेज फाइलें लोड हो रही हैं...',
          currentLanguage === 'en' ? `Processing image ${i + 1} of ${count}...` : `इमेज ${i + 1} / ${count} लोड की जा रही है...`
        );

        try {
          const dataUrl = await new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = (e) => resolve(e.target.result);
            reader.onerror = reject;
            reader.readAsDataURL(file);
          });

          const imgInfo = await new Promise((resolve, reject) => {
            const img = new Image();
            img.onload = () => {
              let width = img.naturalWidth || img.width;
              let height = img.naturalHeight || img.height;

              const maxRes = 2048;
              if (width > maxRes || height > maxRes) {
                const ratio = Math.min(maxRes / width, maxRes / height);
                width = Math.floor(width * ratio);
                height = Math.floor(height * ratio);
              }

              const canvas = document.createElement('canvas');
              canvas.width = width;
              canvas.height = height;
              const context = canvas.getContext('2d');
              if (context) {
                context.drawImage(img, 0, 0, width, height);
                resolve({
                  originalUrl: canvas.toDataURL('image/jpeg', 0.85),
                  width,
                  height
                });
              } else {
                reject(new Error('Canvas creation failed'));
              }
            };
            img.onerror = reject;
            img.src = dataUrl;
          });

          pages.push({
            pageNumber: i + 1,
            originalUrl: imgInfo.originalUrl,
            processedUrl: imgInfo.originalUrl,
            width: imgInfo.width,
            height: imgInfo.height,
            selected: true
          });

        } catch (err) {
          console.error('Failed to load image index: ', i, err);
        }
      }

      fileMeta.size = totalSize;

      if (pages.length === 0) {
        showError(currentLanguage === 'en' ? 'Failed to process any uploaded images.' : 'अपलोड की गई किसी भी इमेज को प्रोसेस नहीं किया जा सका.');
        setProcessing(false);
        return;
      }

      await runFiltersOnAllPages();
    }

