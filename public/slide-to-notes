      .print-sheet-margin-none { padding: 0 !important; }
      .print-sheet-margin-thin { padding: 5mm !important; }
      .print-sheet-margin-standard { padding: 12mm !important; }

      .print-grid-1 { grid-template-columns: 1fr !important; grid-template-rows: 1fr !important; gap: 0 !important; }
