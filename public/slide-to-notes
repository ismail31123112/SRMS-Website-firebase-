    function runFilterOnPage(originalUrl, mode, filters) {
      return new Promise((resolve) => {
        const img = new Image();
        img.crossOrigin = "anonymous";
        img.onload = () => {
          const canvas = document.createElement('canvas');
          canvas.width = img.naturalWidth || img.width;
          canvas.height = img.naturalHeight || img.height;
          
          const ctx = canvas.getContext('2d');
          if (!ctx) {
            resolve(originalUrl);
            return;
          }
          
          ctx.drawImage(img, 0, 0);
          try {
            const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
            const data = imgData.data;
            const len = data.length;

            for (let i = 0; i < len; i += 4) {
              let r = data[i];
              let g = data[i+1];
              let b = data[i+2];

              if (mode === 'ink-saver') {
                let v = (0.2126 * r + 0.7152 * g + 0.0722 * b);
                let inv = 255 - v;
                
                if (inv > 200) {
                  r = g = b = 255; 
                } else if (inv < 100) {
                  r = g = b = 0;   
                } else {
                  let factor = (inv - 100) / 100;
                  let val = Math.floor(factor * 255);
                  r = g = b = val;
                }
              } 
              else if (mode === 'color-preserve') {
                let maxChannel = Math.max(r, g, b);
                let minChannel = Math.min(r, g, b);
                let diff = maxChannel - minChannel; 
                let v = (0.2126 * r + 0.7152 * g + 0.0722 * b);

                if (maxChannel < 80) {
                  r = g = b = 255; 
                } else if (diff > 30) {
                  r = Math.min(255, Math.floor((255 - r) * 1.3));
                  g = Math.min(255, Math.floor((255 - g) * 1.3));
                  b = Math.min(255, Math.floor((255 - b) * 1.3));
                } else {
                  let inv = 255 - v;
                  if (inv > 220) {
                    r = g = b = 255;
                  } else if (inv < 50) {
                    r = g = b = 0;
                  } else {
                    r = g = b = Math.floor(inv);
                  }
                }
              } 
              else if (mode === 'grayscale') {
                let v = Math.floor(0.2126 * r + 0.7152 * g + 0.0722 * b);
                r = g = b = v;
              } 
              else if (mode === 'custom') {
                if (filters.invert) {
                  r = 255 - r;
                  g = 255 - g;
                  b = 255 - b;
                }

                if (filters.grayscale) {
                  let v = Math.floor(0.2126 * r + 0.7152 * g + 0.0722 * b);
                  r = g = b = v;
                }

                let bOffset = filters.brightness;
                r = Math.max(0, Math.min(255, r + bOffset));
                g = Math.max(0, Math.min(255, g + bOffset));
                b = Math.max(0, Math.min(255, b + bOffset));

                let contrastFactor = (259 * (filters.contrast + 255)) / (255 * (259 - filters.contrast));
                r = Math.max(0, Math.min(255, contrastFactor * (r - 128) + 128));
                g = Math.max(0, Math.min(255, contrastFactor * (g - 128) + 128));
                b = Math.max(0, Math.min(255, contrastFactor * (b - 128) + 128));

                if (filters.threshold > 0) {
                  let v = (0.2126 * r + 0.7152 * g + 0.0722 * b);
                  let val = v > filters.threshold ? 255 : 0;
                  r = g = b = val;
                }
              }

              data[i] = r;
              data[i+1] = g;
              data[i+2] = b;
            }

            ctx.putImageData(imgData, 0, 0);
            resolve(canvas.toDataURL('image/jpeg', 0.85));
          } catch (err) {
            console.error('Filter processing error: ', err);
            resolve(originalUrl);
          }
        };
        img.onerror = () => resolve(originalUrl);
        img.src = originalUrl;
      });
    }

    async function runFiltersOnAllPages() {
      if (pages.length === 0) return;
      setProcessing(true, currentLanguage === 'en' ? 'Optimizing layouts...' : 'इमेज ऑप्टिमाइज़ की जा रही है...', currentLanguage === 'en' ? 'Running pixel shaders...' : 'फिल्टर चलाए जा रहे हैं...');

      for (let i = 0; i < pages.length; i++) {
        pages[i].processedUrl = await runFilterOnPage(pages[i].originalUrl, activeMode, customFilters);
      }

      setProcessing(false);
      renderPreviewGrid();
      updateActionButtonsState();
    }

