      <button type="button" class="close-form-btn" onclick="closeAdmissionForm()">✕ Close</button>
      <h2>📝 Online Admission Application Form</h2>
      <p>Fill out the form below to apply directly for admission at Saidpur Residential Model School (SRMS)</p>
    </div>

    <form id="admission-form">
      <!-- Hidden compatibility fields so the existing Complain/Contact Web App sends the full formatted email -->
      <input type="hidden" name="form_type" value="contact">
      <input type="hidden" name="Sender_Name" id="hidden_sender_name">
      <input type="hidden" name="Mobile_Number" id="hidden_mobile_number">
      <input type="hidden" name="Message_Body" id="hidden_message_body">

      <div class="form-grid">
        <div class="form-group">
          <label>Student's Full Name (শিক্ষার্থীর নাম) *</label>
          <input type="text" id="stu_name" name="student_name" placeholder="Enter student's full name" required class="adm-input">
        </div>

        <div class="form-group">
          <label>Applying for Class (কোন শ্রেণিতে ভর্তি হতে ইচ্ছুক) *</label>
          <select id="stu_class" name="applying_class" required class="adm-input" onchange="handleClassChange()">
            <option value="">-- Select Class --</option>
            <option value="Play">Play</option>
            <option value="Nursery">Nursery</option>
            <option value="KG">KG</option>
            <option value="Class 1">Class 1</option>
            <option value="Class 2">Class 2</option>
            <option value="Class 3">Class 3</option>
            <option value="Class 4">Class 4</option>
            <option value="Class 5">Class 5</option>
            <option value="Class 6">Class 6</option>
            <option value="Class 7">Class 7</option>
            <option value="Class 8">Class 8</option>
            <option value="Class 9">Class 9</option>
            <option value="Class 10">Class 10</option>
          </select>
        </div>

