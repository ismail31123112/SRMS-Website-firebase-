          <select id="stu_group" name="student_group" class="adm-input group-highlight">
            <option value="">-- Select Group (বিভাগ নির্বাচন করুন) --</option>
            <option value="Science (বিজ্ঞান)">Science (বিজ্ঞান)</option>
            <option value="Humanities / Arts (মানবিক)">Humanities / Arts (মানবিক)</option>
            <option value="Business Studies / Commerce (ব্যবসায় শিক্ষা)">Business Studies / Commerce (ব্যবসায় শিক্ষা)</option>
          </select>
        </div>

        <div class="form-group">
          <label>Student Category (ধরন) *</label>
          <select id="stu_category" name="residential_type" required class="adm-input">
            <option value="Residential (আবাসিক)">Residential (আবাসিক)</option>
            <option value="Non-Residential (অনাবাসিক)">Non-Residential (অনাবাসিক)</option>
            <option value="Day-Care (ডে-কেয়ার)">Day-Care (ডে-কেয়ার)</option>
            <option value="Night-Care (নাইট-কেয়ার)">Night-Care (নাইট-কেয়ার)</option>
          </select>
        </div>

        <div class="form-group">
          <label>Date of Birth (জন্ম তারিখ) *</label>
          <input type="date" id="stu_dob" name="date_of_birth" required class="adm-input">
        </div>

        <div class="form-group">
          <label>Father's Name (পিতার নাম) *</label>
          <input type="text" id="stu_father" name="father_name" placeholder="Enter father's name" required class="adm-input">
        </div>

        <div class="form-group">
          <label>Mother's Name (মাতার নাম) *</label>
