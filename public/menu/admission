<script>
  document.getElementById('auto-year').innerText = new Date().getFullYear();

  function toggleMenu() { document.getElementById('navMenu').classList.toggle('active'); }
  
  function handleDropdown(el) {
    if (window.innerWidth <= 950) {
      const parent = el.parentElement;
      const isActive = parent.classList.contains('active');
      document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
      if (!isActive) parent.classList.add('active');
    }
  }

  window.addEventListener('click', function(e) {
    if (!e.target.closest('.nav-item')) {
      document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
    }
  });

  // Open Online Admission Form on Button Click
  function openAdmissionForm() {
    const formSection = document.getElementById('online-admission-section');
    if (formSection) {
      formSection.style.display = 'block';
      formSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(() => {
        const nameInput = document.getElementById('stu_name');
        if (nameInput && formSection.style.display !== 'none') nameInput.focus();
      }, 500);
    }
  }

  function closeAdmissionForm() {
    const formSection = document.getElementById('online-admission-section');
    if (formSection) {
      formSection.style.display = 'none';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }

  // Show/Hide Group (Department) when Class 9 or Class 10 is selected
  function handleClassChange() {
    const selectedClass = document.getElementById('stu_class').value;
    const groupWrapper = document.getElementById('group_field_wrapper');
    const groupSelect = document.getElementById('stu_group');

    if (selectedClass === 'Class 9' || selectedClass === 'Class 10') {
      groupWrapper.style.display = 'block';
      groupSelect.required = true;
    } else {
      groupWrapper.style.display = 'none';
      groupSelect.required = false;
      groupSelect.value = '';
    }
  }

  const FIREBASE_PROJECT_ID = "srms-website-management";
  const FIREBASE_DB_BASE = `https://firestore.googleapis.com/v1/projects/${FIREBASE_PROJECT_ID}/databases/(default)/documents`;
  const TARGET_PAGE = "Admission";

  async function loadAdmissionData() {
    const contentArea = document.getElementById('admission-content');
    
    try {
      const response = await fetch(`${FIREBASE_DB_BASE}/WebsitePosts?pageSize=1000`);
      const data = await response.json();
      
      let found = false;
      contentArea.innerHTML = "";

      if (data.documents) {
        data.documents.sort((a, b) => {
          let tA = (a.fields && a.fields.timestamp) ? parseInt(a.fields.timestamp.integerValue || a.fields.timestamp.stringValue || "0", 10) : 0;
          let tB = (b.fields && b.fields.timestamp) ? parseInt(b.fields.timestamp.integerValue || b.fields.timestamp.stringValue || "0", 10) : 0;
          return tB - tA;
        });

        data.documents.forEach(doc => {
          let f = doc.fields || {};
          if (f.targetPage && f.targetPage.stringValue === TARGET_PAGE) {
            found = true;
            let title = f.title ? f.title.stringValue : "";
            let desc = f.desc ? f.desc.stringValue : "";
            let fileType = f.fileType ? f.fileType.stringValue : "None";
            let rawUrl = f.fileUrl ? f.fileUrl.stringValue.trim() : (f.thumbUrl ? f.thumbUrl.stringValue.trim() : "");
            let fileId = (f.driveFileId ? f.driveFileId.stringValue.trim() : "") || (rawUrl.match(/id=([a-zA-Z0-9_-]{15,})/) || rawUrl.match(/\/d\/([a-zA-Z0-9_-]{15,})/) || [])[1];
            let isImg = (fileType === "Image" || rawUrl.includes("ibb.co") || rawUrl.includes("postimg.cc") || /\.(jpg|jpeg|png|webp|gif)$/i.test(rawUrl));

            let mediaHTML = "";
            let downloadBtn = "";

            if (rawUrl && isImg) {
              let imgSrc = (fileId && rawUrl.includes("drive.google.com"))
                ? `https://drive.google.com/thumbnail?id=${fileId}&sz=w1000`
                : rawUrl;
              mediaHTML = `<div class="adm-img-box"><img src="${imgSrc}" class="adm-img" loading="lazy" alt="${title}" onclick="window.open('${rawUrl}', '_blank')"></div>`;
              downloadBtn = `<a href="${rawUrl}" target="_blank" rel="noopener noreferrer" class="btn-apply">🖼️ View Circular Image</a>`;
            } else if (rawUrl) {
              let dlUrl = fileId ? `https://drive.google.com/uc?export=download&id=${fileId}` : rawUrl;
              downloadBtn = `<a href="${dlUrl}" target="_blank" rel="noopener noreferrer" class="btn-apply">⬇ Download Form (PDF)</a>`;
            }

            let onlineBtn = `<button type="button" onclick="openAdmissionForm()" class="btn-apply btn-online">📝 Apply Online</button>`;
            
            contentArea.innerHTML += `
              <div class="info-box">
                <h3>${title}</h3>
                <p>${desc}</p>
                ${mediaHTML}
                <div class="btn-group">${onlineBtn}${downloadBtn}</div>
              </div>`;
          }
        });
      }

      if(!found) {
        contentArea.innerHTML = `
          <div class="info-box" style="text-align:center; color: #555;">
            <p style="font-size: 16px; margin-bottom: 18px;">Currently, no admission circular is published. Click the button below to apply online directly.</p>
            <div class="btn-group" style="justify-content: center; margin-top: 0;">
              <button type="button" onclick="openAdmissionForm()" class="btn-apply btn-online">📝 Apply Online Now</button>
            </div>
          </div>`;
      }

    } catch (error) {
      console.error(error);
      contentArea.innerHTML = `<div style="text-align:center; padding:20px; color: red;">⚠️ Error loading admission info. Please check your internet connection.</div>`;
    }
  }

  loadAdmissionData();

  function resetAdmissionForm() {
    const form = document.getElementById('admission-form');
    form.reset();
    handleClassChange();
    form.style.display = "block";
    document.getElementById('adm-form-header').style.display = "block";
    document.getElementById('adm-success').style.display = "none";
    const btn = document.getElementById('adm-submit-btn');
    btn.innerHTML = "🚀 Submit Online Admission Form";
    btn.disabled = false;
  }

  // Direct Submission to Complain/Contact Web App URL (Email Notification)
  (function(){
    const form = document.getElementById('admission-form');
    const successBox = document.getElementById('adm-success');
    const headerDiv = document.getElementById('adm-form-header');
    const btn = document.getElementById('adm-submit-btn');
    const scriptURL = 'https://script.google.com/macros/s/AKfycbyuDpo-fAqjuGDc3dPSsiK5oln26RYLq_GPumxVpAUg4A8MuHYETbkvWAJEvaR6uINp/exec';

    form.addEventListener('submit', function(e) {
      e.preventDefault();

      const stuName = document.getElementById('stu_name').value.trim();
      const stuClass = document.getElementById('stu_class').value.trim();
      const stuGroup = document.getElementById('stu_group').value.trim();
      const stuCat = document.getElementById('stu_category').value.trim();
      const stuDob = document.getElementById('stu_dob').value.trim();
      const stuFather = document.getElementById('stu_father').value.trim();
      const stuMother = document.getElementById('stu_mother').value.trim();
      const stuPhone = document.getElementById('stu_phone').value.trim();
      const stuPrev = document.getElementById('stu_prev_school').value.trim() || "N/A";
      const stuAddr = document.getElementById('stu_address').value.trim();
      const stuNote = document.getElementById('stu_note').value.trim() || "N/A";

      const isHighSchool = (stuClass === "Class 9" || stuClass === "Class 10");
      if (isHighSchool && !stuGroup) {
        alert("অনুগ্রহ করে ৯ম/১০ম শ্রেণির জন্য বিভাগ (Group/Department) নির্বাচন করুন।");
        return;
      }

      const classWithGroup = (isHighSchool && stuGroup) ? `${stuClass} (${stuGroup})` : stuClass;
      const groupLine = (isHighSchool && stuGroup) ? `📚 Group / Department: ${stuGroup}\n` : "";

      // Populate fields so the Web App sends a complete, structured Admission Email
      document.getElementById('hidden_sender_name').value = `🎓 ADMISSION APPLICATION: ${stuName} - ${classWithGroup}`;
      document.getElementById('hidden_mobile_number').value = stuPhone;
      document.getElementById('hidden_message_body').value =
        `📌 NEW ONLINE ADMISSION APPLICATION (SRMS)\n` +
        `--------------------------------------------\n` +
        `👤 Student Name: ${stuName}\n` +
        `🏫 Applying Class: ${stuClass}\n` +
        groupLine +
        `🏠 Category: ${stuCat}\n` +
        `🎂 Date of Birth: ${stuDob}\n` +
        `👨 Father's Name: ${stuFather}\n` +
        `👩 Mother's Name: ${stuMother}\n` +
        `📞 Guardian Mobile: ${stuPhone}\n` +
        `🏛️ Previous School: ${stuPrev}\n` +
        `📍 Present Address: ${stuAddr}\n` +
        `📝 Additional Note: ${stuNote}`;

      btn.innerHTML = "⏳ Submitting Application...";
      btn.disabled = true;

      fetch(scriptURL, {
        method: "POST",
        body: new FormData(form)
      })
      .then(() => {
        alert("আলহামদুলিল্লাহ! আপনার অনলাইন ভর্তি আবেদনটি সফলভাবে জমা হয়েছে।");
        form.style.display = "none";
        if (headerDiv) headerDiv.style.display = "none";
        successBox.style.display = "block";
      })
      .catch(() => {
        alert("দুঃখিত, সংযোগে সমস্যা হয়েছে। অনুগ্রহ করে আবার চেষ্টা করুন।");
        btn.innerHTML = "🚀 Submit Online Admission Form";
        btn.disabled = false;
      });
    });
  })();
</script>
