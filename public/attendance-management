async function generateMonthlyPayrollSheet() {
  if (!isAuthReady) return;
  let monthStr = document.getElementById('payrollMonth').value;
  let roleFilter = document.getElementById('payrollRoleFilter').value;
  let catFilter = document.getElementById('payrollCatFilter').value;
  if (!monthStr) return;

  showLoader("Calculating Monthly Payroll, Overtime & Deductions...");
  try {
    const [attSnap, holSnap, salSnap] = await Promise.all([
      db.collection('AttendanceHistory')
        .where('pureDate', '>=', monthStr + '-01')
        .where('pureDate', '<=', monthStr + '-31').get(),
      db.collection('Holidays').get(),
      db.collection('SalaryLedger').where('monthStr', '==', monthStr).get()
    ]);

    let holidaySet = new Set();
    holSnap.forEach(h => { if (h.id.startsWith(monthStr)) holidaySet.add(h.id); });

    let paidByEmp = {};
    salSnap.forEach(s => {
      let d = s.data();
      let eid = d.empId || "";
      paidByEmp[eid] = (paidByEmp[eid] || 0) + (parseFloat(d.paidAmount) || 0);
    });

    let workingDaysSet = new Set();
    let empAtt = {};
    allStaffCache.forEach(emp => {
      empAtt[emp.id] = { presentDays: new Set(), leaveDays: new Set(), lateCount: 0, daily: {} };
    });

    attSnap.forEach(doc => {
      let f = doc.data();
      let sid = String(f.studentID || "").trim();
      if (!empAtt[sid]) return;
      let pDate = f.pureDate || "";
      if (!holidaySet.has(pDate)) workingDaysSet.add(pDate);

      if (!empAtt[sid].daily[pDate]) empAtt[sid].daily[pDate] = {};
      empAtt[sid].daily[pDate][f.type] = f;
      if (f.type === 'IN') empAtt[sid].presentDays.add(pDate);
      else if (f.type === 'LEAVE') empAtt[sid].leaveDays.add(pDate);
      if (f.punctuality === 'Late') empAtt[sid].lateCount++;
    });

    let totalWorkingDays = workingDaysSet.size;
    calculatedPayrollMap = {};
    let html = "";
    let sumNet = 0, sumOT = 0, sumDeduct = 0, sumPaid = 0;

    allStaffCache.forEach(emp => {
      if (roleFilter !== 'All' && emp.roleType !== roleFilter) return;
      if (catFilter !== 'All' && emp.staffCategory !== catFilter) return;

      let att = empAtt[emp.id];
      let shift = getEffectiveEmployeeShift(emp);
      let reqExitMins = parseTimeToMinutes(shift.exitTime);
      let otMins = 0;

      Object.values(att.daily).forEach(dObj => {
        if (dObj.IN && dObj.OUT) {
          let outM = parseTimeToMinutes(dObj.OUT.time);
          if (outM > reqExitMins) otMins += (outM - reqExitMins);
        } else if (dObj.OUT && dObj.OUT.overtimeMinutes) {
          otMins += (parseInt(dObj.OUT.overtimeMinutes) || 0);
        }
      });

      let presentDays = att.presentDays.size;
      let leaveDays = att.leaveDays.size;
      let absentDays = totalWorkingDays > 0 ? Math.max(0, totalWorkingDays - (presentDays + leaveDays)) : 0;
      let lateCount = att.lateCount;
      let otHours = +(otMins / 60).toFixed(2);

      let baseSal = emp.baseSalary || 0;
      let perDaySal = Math.round(baseSal / 30);
      let otPay = Math.round(otHours * (emp.overtimeRate || 0));

      // Absent Deduction Calculation (Supports AUTO, OFF, or Fixed Number)
      let absentCut = 0;
      let absRule = String(emp.absentDeductionRate || "AUTO").toUpperCase();
      if (absRule === "OFF" || absRule === "0") {
        absentCut = 0;
      } else if (absRule === "AUTO") {
        absentCut = absentDays * perDaySal;
      } else {
        absentCut = absentDays * (parseFloat(emp.absentDeductionRate) || 0);
      }

      // Late Deduction Calculation
      let lateCut = 0;
      if (emp.lateDeductionRule === "3_LATE_1_DAY") {
        lateCut = Math.floor(lateCount / 3) * perDaySal;
      } else if (emp.lateDeductionRule === "FIXED_PER_LATE") {
        lateCut = lateCount * (emp.lateFixedFine || 0);
      }

      let advBal = emp.advanceBalance || 0;
      let netPayable = Math.max(0, baseSal + otPay - absentCut - lateCut - advBal);
      let alreadyPaid = paidByEmp[emp.id] || 0;

      sumNet += netPayable;
      sumOT += otPay;
      sumDeduct += (absentCut + lateCut);
      sumPaid += alreadyPaid;

      calculatedPayrollMap[emp.id] = {
        emp: emp,
        monthStr: monthStr,
        workingDays: totalWorkingDays,
        presentDays: presentDays,
        absentDays: absentDays,
        leaveDays: leaveDays,
        lateCount: lateCount,
        overtimeHours: otHours,
        baseSalary: baseSal,
        overtimePay: otPay,
        absentDeduction: absentCut,
        lateDeduction: lateCut,
        advanceDeduction: advBal,
        netPayable: netPayable,
        alreadyPaid: alreadyPaid
      };

      let paidBadge = alreadyPaid >= netPayable && netPayable > 0
        ? `<span class="badge-in">PAID (৳${alreadyPaid})</span>`
        : (alreadyPaid > 0 ? `<span class="badge-out">PARTIAL (৳${alreadyPaid})</span>` : `<span class="badge-absent">UNPAID</span>`);

      html += `<tr>
        <td><b>${emp.name}</b><br><small style="color:var(--text-muted);">ID: ${emp.id}</small></td>
        <td><b>${emp.roleType}</b><br><span class="badge-cat">${emp.staffCategory}</span></td>
        <td><b>৳ ${baseSal}</b></td>
        <td><span style="color:var(--success); font-weight:800;">${presentDays}P</span> / <span style="color:var(--danger); font-weight:800;">${absentDays}A</span> / <span style="color:var(--leave); font-weight:800;">${leaveDays}L</span></td>
        <td><b>${lateCount}</b> Late<br><span class="badge-ot">${otHours}h OT</span></td>
        <td style="color:var(--info); font-weight:800;">+ ৳ ${otPay}</td>
        <td style="color:var(--danger); font-weight:800;">- ৳ ${absentCut + lateCut}<br><small>(Abs: ৳${absentCut}, Late: ৳${lateCut})</small></td>
        <td style="color:var(--purple); font-weight:800;">৳ ${advBal}</td>
        <td style="font-size:15px; font-weight:900; color:var(--primary);">৳ ${netPayable}</td>
        <td>${paidBadge}</td>
        <td class="no-print">
          <div style="display:flex; gap:6px;">
            <button class="btn-green btn-small" onclick="openPaySalaryModal('${emp.id}')"><i class="fas fa-hand-holding-usd"></i> Pay</button>
            <button class="btn-purple btn-small" onclick="promptSalaryAdvance('${emp.docId}', '${emp.name.replace(/'/g, "\\'")}', ${advBal})" title="Give Advance"><i class="fas fa-plus"></i> Adv</button>
          </div>
        </td>
      </tr>`;
    });

    document.getElementById('payrollSheetBody').innerHTML = html || `<tr><td colspan="11" style="text-align:center; padding:30px;">No employees found matching filter.</td></tr>`;
    document.getElementById('payStatNet').innerText = "৳ " + sumNet;
    document.getElementById('payStatOT').innerText = "৳ " + sumOT;
    document.getElementById('payStatDeduct').innerText = "৳ " + sumDeduct;
    document.getElementById('payStatPaid').innerText = "৳ " + sumPaid;
    hideLoader();
  } catch (e) { catchError(e); }
}

function openPaySalaryModal(empId) {
  let calc = calculatedPayrollMap[empId];
  if (!calc) return;
  activePayModalEmp = calc;

  document.getElementById('payModalEmpHeader').innerHTML = `
    <b>${calc.emp.name}</b> (${calc.emp.designation} • <span class="badge-cat">${calc.emp.staffCategory}</span>)<br>
    Month: <b>${calc.monthStr}</b> | Working Days: <b>${calc.workingDays}</b> | Present: <b>${calc.presentDays}</b> | Absent: <b>${calc.absentDays}</b> | Late: <b>${calc.lateCount}</b> | Overtime: <b>${calc.overtimeHours} hrs</b>
  `;
  document.getElementById('pmBaseSalary').value = calc.baseSalary;
  document.getElementById('pmOvertimePay').value = calc.overtimePay;
  document.getElementById('pmBonus').value = 0;
  document.getElementById('pmAbsentCut').value = calc.absentDeduction;
  document.getElementById('pmLateCut').value = calc.lateDeduction;
  document.getElementById('pmAdvanceCut').value = calc.advanceDeduction;
  document.getElementById('pmNote').value = "";
  document.getElementById('pmAdminPwd').value = "";

  recalcPayModalNet();
  document.getElementById('paySalaryModal').style.display = 'flex';
}

function recalcPayModalNet() {
  let base = parseFloat(document.getElementById('pmBaseSalary').value) || 0;
  let ot = parseFloat(document.getElementById('pmOvertimePay').value) || 0;
  let bonus = parseFloat(document.getElementById('pmBonus').value) || 0;
  let absCut = parseFloat(document.getElementById('pmAbsentCut').value) || 0;
  let lateCut = parseFloat(document.getElementById('pmLateCut').value) || 0;
  let advCut = parseFloat(document.getElementById('pmAdvanceCut').value) || 0;

  let net = Math.max(0, base + ot + bonus - absCut - lateCut - advCut);
  document.getElementById('pmNetPayableLbl').innerText = net;
  document.getElementById('pmPaidNow').value = net;
}

