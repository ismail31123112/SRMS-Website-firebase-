function switchModuleTab(tabId) {
  document.querySelectorAll('.tab-section').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('.mod-tab-btn').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('.b-nav-item').forEach(el => el.classList.remove('active'));

  document.getElementById(tabId).classList.add('active');
  var topBtn = document.getElementById('topTab_' + tabId);
  var botBtn = document.getElementById('botTab_' + tabId);
  if (topBtn) topBtn.classList.add('active');
  if (botBtn) botBtn.classList.add('active');

  if (tabId === 'payrollTab') {
    generateMonthlyPayrollSheet();
    loadSalaryLedgerHistory();
  } else if (tabId === 'hrSetupTab') {
    loadAllDirectoriesAndSettings(false);
  }
}

async function apiCall(actionName, payloadData = {}) {
  let token = await auth.currentUser.getIdToken(false);
  let payload = { action: actionName, token: token, ...payloadData };
  let res = await fetch(SCRIPT_URL, {
    method: 'POST',
    body: JSON.stringify(payload),
    headers: { 'Content-Type': 'text/plain;charset=utf-8' }
  });
  let data = await res.json();
  if (data.status === "error") throw new Error(data.message || data.msg);
  return data;
}

auth.setPersistence(firebase.auth.Auth.Persistence.LOCAL).then(() => {
  auth.onAuthStateChanged(async function(user) {
    if (user) {
      isAuthReady = true;
      await loadAllDirectoriesAndSettings(true);
      hideLoader();
      document.getElementById('appWrapper').style.display = 'block';
    } else {
      showLoader("UNAUTHORIZED ACCESS!<br><span style='font-size:11px; color:#ef4444;'>Redirecting to Login...</span>");
      setTimeout(() => {
        var currentDomain = window.location.protocol + "//" + window.location.host;
        window.location.replace(currentDomain + "/login-panel/accounting-and-management-department");
      }, 1000);
    }
  });
});

async function loadAllDirectoriesAndSettings(silent = false) {
  if (!silent) showLoader("Syncing HR Directory & Categories...");
  try {
    const [setDoc, stuSnap, stfSnap] = await Promise.all([
      db.collection('Admin').doc('Settings').get(),
      db.collection('Students').get(),
      db.collection('Teachers').get()
    ]);

    if (setDoc.exists) {
      let d = setDoc.data();
      globalSettings.entryTime = d.entryTime || "08:30";
      globalSettings.exitTime = d.exitTime || "15:30";
      globalSettings.staffEntryTime = d.staffEntryTime || "08:00";
      globalSettings.staffExitTime = d.staffExitTime || "16:00";
      if (d.sections) globalSettings.sections = d.sections.split(',').map(s => s.trim()).filter(Boolean);
      if (d.categories) globalSettings.studentCategories = d.categories.split(',').map(s => s.trim()).filter(Boolean);
      if (d.staffCategories) globalSettings.staffCategories = d.staffCategories.split(',').map(s => s.trim()).filter(Boolean);
      if (d.categoryTimingsJSON) {
        try { globalSettings.categoryTimings = JSON.parse(d.categoryTimingsJSON) || {}; } catch (e) {}
      }
    }

    allStudentsCache = [];
    stuSnap.forEach(doc => {
      let f = doc.data();
      let sCat = (f.category || f.resStatus || "").toString().trim();
      if (sCat && !globalSettings.studentCategories.includes(sCat)) globalSettings.studentCategories.push(sCat);
      allStudentsCache.push({
        docId: doc.id,
        id: (f.studentID || doc.id).toString().trim(),
        machineID: (f.machineID || f.studentID || "").toString().trim(),
        name: f.name || "Unknown",
        cls: (f.class || "").toString().trim(),
        section: (f.section || "").toString().trim(),
        roll: (f.roll || "").toString().trim(),
        category: sCat,
        phone: (f.phone || "").toString().trim()
      });
    });

    allStaffCache = [];
    stfSnap.forEach(doc => {
      let f = doc.data();
      let rType = (f.roleType || "Teacher").toString().trim();
      let stCat = (f.staffCategory || (rType === "Staff" ? "Admin Staff" : "Teacher")).toString().trim();
      if (stCat && !globalSettings.staffCategories.includes(stCat)) globalSettings.staffCategories.push(stCat);
      let phoneId = (f.phone || f.staffID || doc.id).toString().trim();
      allStaffCache.push({
        docId: doc.id,
        id: phoneId,
        phone: phoneId,
        machineID: (f.machineID || phoneId).toString().trim(),
        cardNumber: (f.cardNumber || "").toString().trim(),
        name: f.name || "Unknown",
        roleType: rType,
        staffCategory: stCat,
        designation: f.designation || stCat,
        baseSalary: parseFloat(f.baseSalary) || 0,
        overtimeRate: parseFloat(f.overtimeRate) || 0,
        absentDeductionRate: (f.absentDeductionRate !== undefined && f.absentDeductionRate !== "") ? f.absentDeductionRate : "AUTO",
        lateDeductionRule: f.lateDeductionRule || "3_LATE_1_DAY",
        lateFixedFine: parseFloat(f.lateFixedFine) || 0,
        customEntryTime: f.customEntryTime || "",
        customExitTime: f.customExitTime || "",
        advanceBalance: parseFloat(f.advanceBalance) || 0,
        portalAccess: rType === "Teacher" ? "Allowed" : "Blocked",
        photoUrl: f.photoUrl || f.photo || DEFAULT_LOGO,
        pass: f.pass || "123456"
      });
    });

    populateCategoryAndSectionSelects();
    renderHrDirectoryTable();
    if (!silent) hideLoader();
  } catch (e) {
    if (!silent) hideLoader();
    console.error("Init Load Error:", e);
  }
}

