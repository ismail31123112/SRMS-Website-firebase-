async function addNewCustomCategory(target) {
  let inp = document.getElementById(target === 'staff' ? 'newStaffCatInput' : 'newStuCatInput');
  let val = inp.value.trim();
  if (!val) return;
  if (target === 'staff') {
    if (!globalSettings.staffCategories.includes(val)) globalSettings.staffCategories.push(val);
  } else {
    if (!globalSettings.studentCategories.includes(val)) globalSettings.studentCategories.push(val);
  }
  inp.value = "";
  populateCategoryAndSectionSelects();
  showLoader("Saving Category...");
  try {
    await apiCall('saveCustomCategories', {
      studentCategories: globalSettings.studentCategories.join(','),
      staffCategories: globalSettings.staffCategories.join(',')
    });
    hideLoader();
    Swal.fire("Saved!", `Category "${val}" added & synced with database!`, "success");
  } catch (e) { catchError(e); }
}

async function removeCustomCategory(target, val) {
  if (target === 'staff') {
    globalSettings.staffCategories = globalSettings.staffCategories.filter(c => c !== val);
  } else {
    globalSettings.studentCategories = globalSettings.studentCategories.filter(c => c !== val);
  }
  populateCategoryAndSectionSelects();
  try {
    await apiCall('saveCustomCategories', {
      studentCategories: globalSettings.studentCategories.join(','),
      staffCategories: globalSettings.staffCategories.join(',')
    });
  } catch (e) { catchError(e); }
}

function normalizeClass(clsName) {
  if (!clsName) return "";
  return String(clsName).toLowerCase().replace(/class\s*/g, "").trim();
}

function parseTimeToMinutes(timeStr) {
  if (!timeStr) return 0;
  let cleanTime = timeStr.toString().replace(" (M)", "").trim();
  if (cleanTime.toUpperCase().includes("AM") || cleanTime.toUpperCase().includes("PM")) {
    let parts = cleanTime.split(/\s+/);
    let hm = parts[0].split(':');
    let hours = parseInt(hm[0], 10) || 0;
    let mins = parseInt(hm[1], 10) || 0;
    if (hours === 12) hours = 0;
    if (parts[1] && parts[1].toUpperCase().includes('PM')) hours += 12;
    return (hours * 60) + mins;
  } else {
    let hm = cleanTime.split(':');
    return ((parseInt(hm[0], 10) || 0) * 60) + (parseInt(hm[1], 10) || 0);
  }
}

function formatMinsToHrsMins(totalMins) {
  let m = Math.max(0, Math.round(totalMins || 0));
  let hrs = Math.floor(m / 60);
  let rem = m % 60;
  return `${hrs}h ${rem}m`;
}

function getEffectiveEmployeeShift(emp) {
  let cat = emp.staffCategory || "";
  let catShift = globalSettings.categoryTimings[cat] || {};
  return {
    entryTime: emp.customEntryTime || catShift.entryTime || globalSettings.staffEntryTime || "08:00",
    exitTime: emp.customExitTime || catShift.exitTime || globalSettings.staffExitTime || "16:00"
  };
}

async function loadStudentAttendance(reportType) {
  if (!isAuthReady) return;
  let fromDate = document.getElementById('stuFromDate').value;
  let toDate = document.getElementById('stuToDate').value;
  let monthStr = document.getElementById('stuMonthFilter').value;
  let clsFilter = document.getElementById('stuClassFilter').value;
  let secFilter = document.getElementById('stuSectionFilter').value;
  let catFilter = document.getElementById('stuCategoryFilter').value;

  document.getElementById('btnBulkAbsentSms').style.display = 'none';
  let stuMap = {};
  allStudentsCache.forEach(s => { stuMap[s.id] = s; });

  showLoader("Loading Student Attendance...");
  try {
    if (reportType === 'Monthly') {
      document.getElementById('stuReportTitle').innerText = `Student Monthly Summary (${monthStr})`;
      document.getElementById('stuTableHead').innerHTML = `<tr>
        <th>Student ID</th><th>Student Name</th><th>Class (Sec)</th><th>Roll</th><th>Category</th>
        <th>Working Days</th><th>Present</th><th>Absent</th><th>On Leave</th><th>Late / Early</th><th>Total Hours</th>
      </tr>`;

      let snap = await db.collection('AttendanceHistory')
        .where('pureDate', '>=', monthStr + '-01')
        .where('pureDate', '<=', monthStr + '-31').get();

      let workingDays = new Set();
      let stats = {};
      allStudentsCache.forEach(s => {
        let matchCls = (clsFilter === 'All' || normalizeClass(s.cls) === normalizeClass(clsFilter));
        let matchSec = (secFilter === 'All' || s.section === secFilter);
        let matchCat = (catFilter === 'All' || s.category === catFilter);
        if (matchCls && matchSec && matchCat) {
          stats[s.id] = { ...s, presentDays: new Set(), leaveDays: new Set(), lateCount: 0, earlyCount: 0, punches: {} };
        }
      });

      snap.forEach(doc => {
        let f = doc.data();
        if (f.class === 'Teacher') return;
        let sid = String(f.studentID || "").trim();
        let pDate = f.pureDate || "";
        workingDays.add(pDate);
        if (stats[sid]) {
          if (!stats[sid].punches[pDate]) stats[sid].punches[pDate] = {};
          stats[sid].punches[pDate][f.type] = f.time;
          if (f.type === 'IN') stats[sid].presentDays.add(pDate);
          else if (f.type === 'LEAVE') stats[sid].leaveDays.add(pDate);
          if (f.punctuality === 'Late') stats[sid].lateCount++;
          if (f.punctuality === 'Early Exit') stats[sid].earlyCount++;
        }
      });

      let wDaysCount = workingDays.size;
      let rowsHtml = "";
      let sumP = 0, sumA = 0, sumL = 0;

      Object.values(stats).forEach(u => {
        let p = u.presentDays.size;
        let lv = u.leaveDays.size;
        let ab = Math.max(0, wDaysCount - (p + lv));
        sumP += p; sumA += ab; sumL += (u.lateCount + u.earlyCount);
        let mins = 0;
        Object.values(u.punches).forEach(d => {
          if (d.IN && d.OUT) {
            let diff = parseTimeToMinutes(d.OUT) - parseTimeToMinutes(d.IN);
            if (diff > 0) mins += diff;
          }
        });
        rowsHtml += `<tr>
          <td><b>${u.id}</b></td>
          <td><b>${u.name}</b></td>
          <td>Class ${u.cls} ${u.section ? '(' + u.section + ')' : ''}</td>
          <td>${u.roll}</td>
          <td><span class="badge-cat">${u.category || '-'}</span></td>
          <td><b>${wDaysCount}</b></td>
          <td style="color:var(--success); font-weight:800;">${p}</td>
          <td style="color:var(--danger); font-weight:800;">${ab}</td>
          <td style="color:var(--leave); font-weight:800;">${lv}</td>
          <td>${u.lateCount} L / ${u.earlyCount} E</td>
          <td><b>${formatMinsToHrsMins(mins)}</b></td>
        </tr>`;
      });

      document.getElementById('stuTableBody').innerHTML = rowsHtml || `<tr><td colspan="11" style="text-align:center; padding:30px;">No student records found.</td></tr>`;
      updateSummaryCards('stu', Object.keys(stats).length, 'Students', sumP, 'Total Present', sumA, 'Total Absent', sumL, 'Late / Early');
      hideLoader();
      return;
    }

    // Standard Daily / Range Student Headers
    document.getElementById('stuTableHead').innerHTML = `<tr>
      <th>Student ID</th><th>Student Name</th><th>Class (Sec)</th><th>Roll</th>
      <th>Category</th><th>Date</th><th>Punch Time</th><th>Status &amp; Punctuality</th><th class="no-print">Action / SMS</th>
    </tr>`;

    if (reportType === 'Absent') {
      document.getElementById('stuReportTitle').innerText = `Student Daily Absent List (${fromDate})`;
      let holDoc = await db.collection('Holidays').doc(fromDate).get();
      if (holDoc.exists && holDoc.data().reason) {
        document.getElementById('stuTableBody').innerHTML = `<tr><td colspan="9" style="text-align:center; padding:35px; color:var(--warning); font-weight:800;">🏖️ School Holiday (${holDoc.data().reason})</td></tr>`;
        hideLoader();
        return;
      }

      let aSnap = await db.collection('AttendanceHistory').where('pureDate', '==', fromDate).get();
      let presentSet = new Set();
      let leaveMap = {};
      aSnap.forEach(doc => {
        let f = doc.data();
        let sid = String(f.studentID || "").trim();
        presentSet.add(sid);
        if (f.type === 'LEAVE') leaveMap[sid] = f.time || "Approved Leave";
      });

      lastLoadedAbsentStudents = [];
      let rowsHtml = "";
      let leaveCnt = 0;

      allStudentsCache.forEach(s => {
        let matchCls = (clsFilter === 'All' || normalizeClass(s.cls) === normalizeClass(clsFilter));
        let matchSec = (secFilter === 'All' || s.section === secFilter);
        let matchCat = (catFilter === 'All' || s.category === catFilter);
        if (!matchCls || !matchSec || !matchCat) return;

        if (!presentSet.has(s.id)) {
          lastLoadedAbsentStudents.push(s);
          rowsHtml += `<tr>
            <td><b>${s.id}</b></td>
            <td><b>${s.name}</b></td>
            <td>Class ${s.cls} ${s.section ? '(' + s.section + ')' : ''}</td>
            <td>${s.roll}</td>
            <td><span class="badge-cat">${s.category || '-'}</span></td>
            <td>${fromDate}</td>
            <td>Not Punched</td>
            <td><span class="badge-absent">ABSENT</span></td>
            <td class="no-print">${s.phone || '-'}</td>
          </tr>`;
        } else if (leaveMap[s.id]) {
          leaveCnt++;
          rowsHtml += `<tr>
            <td><b>${s.id}</b></td>
            <td><b>${s.name}</b></td>
            <td>Class ${s.cls} ${s.section ? '(' + s.section + ')' : ''}</td>
            <td>${s.roll}</td>
            <td><span class="badge-cat">${s.category || '-'}</span></td>
            <td>${fromDate}</td>
            <td>${leaveMap[s.id]}</td>
            <td><span class="badge-leave">ON LEAVE</span></td>
            <td class="no-print">Approved</td>
          </tr>`;
        }
      });

      if (lastLoadedAbsentStudents.length > 0) {
        document.getElementById('btnBulkAbsentSms').style.display = 'inline-flex';
      }
      document.getElementById('stuTableBody').innerHTML = rowsHtml || `<tr><td colspan="9" style="text-align:center; padding:35px; color:var(--success); font-weight:800;">🎉 Alhamdulillah! All matching students are present on ${fromDate}!</td></tr>`;
      updateSummaryCards('stu', lastLoadedAbsentStudents.length + leaveCnt, 'Total Away', lastLoadedAbsentStudents.length, 'Absent Students', leaveCnt, 'On Leave', lastLoadedAbsentStudents.filter(x => x.phone).length, 'SMS Ready');
      hideLoader();
      return;
    }

    // Present, LateEarly, or Bunked
    let snap = await db.collection('AttendanceHistory')
      .where('pureDate', '>=', fromDate)
      .where('pureDate', '<=', reportType === 'Bunked' ? fromDate : toDate).get();

    if (reportType === 'Bunked') {
      document.getElementById('stuReportTitle').innerText = `Student Bunked / Missing OUT List (${fromDate})`;
      let punchMap = {};
      snap.forEach(doc => {
        let f = doc.data();
        if (f.class === 'Teacher') return;
        let sid = String(f.studentID || "").trim();
        if (!punchMap[sid]) punchMap[sid] = { in: false, out: false, f: f };
        if (f.type === 'IN') punchMap[sid].in = true;
        if (f.type === 'OUT') punchMap[sid].out = true;
      });

      let rowsHtml = "";
      let cnt = 0;
      Object.keys(punchMap).forEach(sid => {
        if (punchMap[sid].in && !punchMap[sid].out) {
          let sObj = stuMap[sid] || {};
          let f = punchMap[sid].f;
          let sCls = f.class || sObj.cls || "";
          let sSec = f.section || sObj.section || "";
          let sCat = f.category || sObj.category || "";
          if (clsFilter !== 'All' && normalizeClass(sCls) !== normalizeClass(clsFilter)) return;
          if (secFilter !== 'All' && sSec !== secFilter) return;
          if (catFilter !== 'All' && sCat !== catFilter) return;
          cnt++;
          rowsHtml += `<tr>
            <td><b>${sid}</b></td>
            <td><b>${f.name || sObj.name || ''}</b></td>
            <td>Class ${sCls} ${sSec ? '(' + sSec + ')' : ''}</td>
            <td>${f.roll || sObj.roll || ''}</td>
            <td><span class="badge-cat">${sCat || '-'}</span></td>
            <td>${fromDate}</td>
            <td>IN: ${f.time}</td>
            <td><span class="badge-absent" style="background:#0f172a; color:#fff;">NO OUT PUNCH</span></td>
            <td class="no-print"><button class="btn-warn btn-small" onclick="sendBunkerAlert('${sid}', '${fromDate}')"><i class="fas fa-sms"></i> Alert Guardian</button></td>
          </tr>`;
        }
      });
      document.getElementById('stuTableBody').innerHTML = rowsHtml || `<tr><td colspan="9" style="text-align:center; padding:35px; color:var(--success); font-weight:800;">✅ No missing OUT punches found!</td></tr>`;
      updateSummaryCards('stu', cnt, 'Missing OUT', cnt, 'Entered (IN)', 0, 'Exited (OUT)', cnt, 'Alert Ready');
      hideLoader();
      return;
    }

    // Present or LateEarly
    document.getElementById('stuReportTitle').innerText = reportType === 'LateEarly'
      ? `Student Late & Early Exit Report (${fromDate} to ${toDate})`
      : `Student Attendance Log (${fromDate} to ${toDate})`;

    let rows = [];
    snap.forEach(doc => {
      let f = doc.data();
      if (f.class === 'Teacher' || f.userRole === 'Teacher' || f.userRole === 'Staff') return;
      let sid = String(f.studentID || "").trim();
      let sObj = stuMap[sid] || {};
      let sCls = f.class || sObj.cls || "";
      let sSec = f.section || sObj.section || "";
      let sCat = f.category || sObj.category || "";

      if (clsFilter !== 'All' && normalizeClass(sCls) !== normalizeClass(clsFilter)) return;
      if (secFilter !== 'All' && sSec !== secFilter) return;
      if (catFilter !== 'All' && sCat !== catFilter) return;
      if (reportType === 'LateEarly' && f.punctuality !== 'Late' && f.punctuality !== 'Early Exit') return;

      rows.push({
        docId: doc.id,
        id: sid,
        name: f.name || sObj.name || "",
        cls: sCls,
        sec: sSec,
        roll: f.roll || sObj.roll || "",
        cat: sCat,
        date: f.pureDate || "",
        time: f.time || "",
        type: f.type || "IN",
        punctuality: f.punctuality || "On Time",
        smsStatus: f.smsStatus || "N/A"
      });
    });

    rows.sort((a, b) => (a.date !== b.date ? (a.date > b.date ? -1 : 1) : (a.time > b.time ? 1 : -1)));
    let inCnt = 0, outCnt = 0, lateCnt = 0;
    let html = "";
    rows.forEach(r => {
      if (r.type === 'IN') inCnt++;
      if (r.type === 'OUT') outCnt++;
      if (r.punctuality === 'Late' || r.punctuality === 'Early Exit') lateCnt++;

      let typeBadge = r.type === 'IN' ? 'badge-in' : (r.type === 'OUT' ? 'badge-out' : 'badge-leave');
      let puncHtml = `<span style="color:var(--success); font-weight:800; font-size:11px; margin-left:5px;">ON TIME</span>`;
      let actBtn = r.smsStatus;
      if (r.punctuality === 'Late') {
        puncHtml = `<span class="badge-late">LATE</span>`;
        actBtn = `<button class="btn-warn btn-small" onclick="exemptUser('${r.docId}', 'student')">Exempt</button>`;
      } else if (r.punctuality === 'Early Exit') {
        puncHtml = `<span class="badge-early">EARLY EXIT</span>`;
        actBtn = `<button class="btn-warn btn-small" onclick="exemptUser('${r.docId}', 'student')">Exempt</button>`;
      } else if (r.punctuality === 'Exempt') {
        puncHtml = `<span class="badge-exempt">EXEMPT</span>`;
      }

      html += `<tr>
        <td><b>${r.id}</b></td>
        <td><b>${r.name}</b></td>
        <td>Class ${r.cls} ${r.sec ? '(' + r.sec + ')' : ''}</td>
        <td>${r.roll}</td>
        <td><span class="badge-cat">${r.cat || '-'}</span></td>
        <td>${r.date}</td>
        <td><b>${r.time}</b></td>
        <td><span class="${typeBadge}">${r.type}</span> ${puncHtml}</td>
        <td class="no-print">${actBtn}</td>
      </tr>`;
    });

    document.getElementById('stuTableBody').innerHTML = html || `<tr><td colspan="9" style="text-align:center; padding:35px;">No student attendance records found for this filter.</td></tr>`;
    updateSummaryCards('stu', rows.length, 'Total Punches', inCnt, 'Total IN', outCnt, 'Total OUT', lateCnt, 'Late / Early');
    hideLoader();
  } catch (e) { catchError(e); }
}

async function loadStaffAttendance(reportType) {
  if (!isAuthReady) return;
  let fromDate = document.getElementById('stfFromDate').value;
  let toDate = document.getElementById('stfToDate').value;
  let monthStr = document.getElementById('stfMonthFilter').value;
  let roleFilter = document.getElementById('stfRoleFilter').value;
  let catFilter = document.getElementById('stfCategoryFilter').value;

  let staffMap = {};
  allStaffCache.forEach(s => { staffMap[s.id] = s; });

  showLoader("Loading Teacher & Staff Attendance...");
  try {
    if (reportType === 'Monthly') {
      document.getElementById('stfReportTitle').innerText = `Teacher & Staff Monthly Duty & Overtime Summary (${monthStr})`;
      document.getElementById('stfTableHead').innerHTML = `<tr>
        <th>ID / Phone</th><th>Name</th><th>Role &amp; Post</th><th>Category</th>
        <th>Working Days</th><th>Present</th><th>Absent</th><th>On Leave</th><th>Late Count</th><th>Worked Hours</th><th>Overtime Hours</th>
      </tr>`;

      let [snap, holSnap] = await Promise.all([
        db.collection('AttendanceHistory')
          .where('pureDate', '>=', monthStr + '-01')
          .where('pureDate', '<=', monthStr + '-31').get(),
        db.collection('Holidays').get()
      ]);

      let holidaySet = new Set();
      holSnap.forEach(h => { if (h.id.startsWith(monthStr)) holidaySet.add(h.id); });

      let workingDays = new Set();
      let stats = {};
      allStaffCache.forEach(emp => {
        if (roleFilter !== 'All' && emp.roleType !== roleFilter) return;
        if (catFilter !== 'All' && emp.staffCategory !== catFilter) return;
        stats[emp.id] = {
          ...emp,
          presentDays: new Set(),
          leaveDays: new Set(),
          lateCount: 0,
          workedMins: 0,
          overtimeMins: 0,
          daily: {}
        };
      });

      snap.forEach(doc => {
        let f = doc.data();
        let sid = String(f.studentID || "").trim();
        let isStf = (f.class === 'Teacher' || f.userRole === 'Teacher' || f.userRole === 'Staff' || staffMap[sid]);
        if (!isStf) return;
        let pDate = f.pureDate || "";
        if (!holidaySet.has(pDate)) workingDays.add(pDate);

        if (stats[sid]) {
          if (!stats[sid].daily[pDate]) stats[sid].daily[pDate] = {};
          stats[sid].daily[pDate][f.type] = f;
          if (f.type === 'IN') stats[sid].presentDays.add(pDate);
          else if (f.type === 'LEAVE') stats[sid].leaveDays.add(pDate);
          if (f.punctuality === 'Late') stats[sid].lateCount++;
        }
      });

      let wDaysCount = workingDays.size;
      let html = "";
      let sumP = 0, sumA = 0, sumOTMins = 0;

      Object.values(stats).forEach(u => {
        let shift = getEffectiveEmployeeShift(u);
        let reqExitMins = parseTimeToMinutes(shift.exitTime);

        Object.values(u.daily).forEach(dObj => {
          if (dObj.IN && dObj.OUT) {
            let inM = parseTimeToMinutes(dObj.IN.time);
            let outM = parseTimeToMinutes(dObj.OUT.time);
            if (outM > inM) u.workedMins += (outM - inM);
            if (outM > reqExitMins) u.overtimeMins += (outM - reqExitMins);
          } else if (dObj.OUT && dObj.OUT.overtimeMinutes) {
            u.overtimeMins += (parseInt(dObj.OUT.overtimeMinutes) || 0);
          }
        });

        let p = u.presentDays.size;
        let lv = u.leaveDays.size;
        let ab = Math.max(0, wDaysCount - (p + lv));
        sumP += p; sumA += ab; sumOTMins += u.overtimeMins;

        html += `<tr>
          <td><b>${u.id}</b></td>
          <td><b>${u.name}</b></td>
          <td><b>${u.roleType}</b> (${u.designation})</td>
          <td><span class="badge-cat">${u.staffCategory}</span></td>
          <td><b>${wDaysCount}</b></td>
          <td style="color:var(--success); font-weight:800;">${p}</td>
          <td style="color:var(--danger); font-weight:800;">${ab}</td>
          <td style="color:var(--leave); font-weight:800;">${lv}</td>
          <td style="color:var(--danger); font-weight:800;">${u.lateCount}</td>
          <td><b>${formatMinsToHrsMins(u.workedMins)}</b></td>
          <td><span class="badge-ot"><i class="fas fa-stopwatch"></i> ${formatMinsToHrsMins(u.overtimeMins)}</span></td>
        </tr>`;
      });

      document.getElementById('stfTableBody').innerHTML = html || `<tr><td colspan="11" style="text-align:center; padding:30px;">No staff records found for this month.</td></tr>`;
      updateSummaryCards('stf', Object.keys(stats).length, 'Total Staff', sumP, 'Monthly Present', sumA, 'Monthly Absent', formatMinsToHrsMins(sumOTMins), 'Total Overtime');
      hideLoader();
      return;
    }

    // Standard Staff Table Head
    document.getElementById('stfTableHead').innerHTML = `<tr>
      <th>ID / Phone</th><th>Name</th><th>Role &amp; Designation</th><th>Category</th>
      <th>Date</th><th>Punch Time</th><th>Worked / Overtime</th><th>Status / Punctuality</th><th class="no-print">Action</th>
    </tr>`;

    if (reportType === 'Absent') {
      document.getElementById('stfReportTitle').innerText = `Teacher & Staff Absent List (${fromDate})`;
      let aSnap = await db.collection('AttendanceHistory').where('pureDate', '==', fromDate).get();
      let presentSet = new Set();
      let leaveMap = {};
      aSnap.forEach(doc => {
        let f = doc.data();
        let sid = String(f.studentID || "").trim();
        presentSet.add(sid);
        if (f.type === 'LEAVE') leaveMap[sid] = f.time || "Approved Leave";
      });

      let html = "";
      let absCnt = 0, lvCnt = 0;
      allStaffCache.forEach(emp => {
        if (roleFilter !== 'All' && emp.roleType !== roleFilter) return;
        if (catFilter !== 'All' && emp.staffCategory !== catFilter) return;
        if (!presentSet.has(emp.id)) {
          absCnt++;
          html += `<tr>
            <td><b>${emp.id}</b></td>
            <td><b>${emp.name}</b></td>
            <td>${emp.roleType} (${emp.designation})</td>
            <td><span class="badge-cat">${emp.staffCategory}</span></td>
            <td>${fromDate}</td>
            <td>Not Punched</td>
            <td>0h 0m</td>
            <td><span class="badge-absent">ABSENT</span></td>
            <td class="no-print">-</td>
          </tr>`;
        } else if (leaveMap[emp.id]) {
          lvCnt++;
          html += `<tr>
            <td><b>${emp.id}</b></td>
            <td><b>${emp.name}</b></td>
            <td>${emp.roleType} (${emp.designation})</td>
            <td><span class="badge-cat">${emp.staffCategory}</span></td>
            <td>${fromDate}</td>
            <td>${leaveMap[emp.id]}</td>
            <td>Leave</td>
            <td><span class="badge-leave">ON LEAVE</span></td>
            <td class="no-print">Approved</td>
          </tr>`;
        }
      });
      document.getElementById('stfTableBody').innerHTML = html || `<tr><td colspan="9" style="text-align:center; padding:35px; color:var(--success); font-weight:800;">🎉 All Teachers &amp; Staff are present on ${fromDate}!</td></tr>`;
      updateSummaryCards('stf', absCnt + lvCnt, 'Total Away', absCnt, 'Absent', lvCnt, 'On Leave', 0, 'Overtime');
      hideLoader();
      return;
    }

    let snap = await db.collection('AttendanceHistory')
      .where('pureDate', '>=', fromDate)
      .where('pureDate', '<=', reportType === 'Bunked' ? fromDate : toDate).get();

    let rows = [];
    snap.forEach(doc => {
      let f = doc.data();
      let sid = String(f.studentID || "").trim();
      let emp = staffMap[sid];
      let isStf = (f.class === 'Teacher' || f.userRole === 'Teacher' || f.userRole === 'Staff' || emp);
      if (!isStf) return;

      let rType = emp ? emp.roleType : (f.userRole || "Teacher");
      let sCat = emp ? emp.staffCategory : (f.category || "Teacher");
      let desig = emp ? emp.designation : (f.roll || "Staff");

      if (roleFilter !== 'All' && rType !== roleFilter) return;
      if (catFilter !== 'All' && sCat !== catFilter) return;
      if (reportType === 'LateEarly' && f.punctuality !== 'Late' && f.punctuality !== 'Early Exit') return;

      rows.push({
        docId: doc.id,
        id: sid,
        name: f.name || (emp ? emp.name : ""),
        roleType: rType,
        designation: desig,
        category: sCat,
        date: f.pureDate || "",
        time: f.time || "",
        type: f.type || "IN",
        punctuality: f.punctuality || "On Time",
        workedMins: parseInt(f.workedMinutes) || 0,
        overtimeMins: parseInt(f.overtimeMinutes) || 0,
        lateMins: parseInt(f.lateMinutes) || 0
      });
    });

    if (reportType === 'Bunked') {
      let byId = {};
      rows.forEach(r => {
        if (!byId[r.id]) byId[r.id] = { in: false, out: false, r: r };
        if (r.type === 'IN') byId[r.id].in = true;
        if (r.type === 'OUT') byId[r.id].out = true;
      });
      rows = Object.values(byId).filter(x => x.in && !x.out).map(x => x.r);
    }

    rows.sort((a, b) => (a.date !== b.date ? (a.date > b.date ? -1 : 1) : (a.time > b.time ? 1 : -1)));
    let html = "";
    let inCnt = 0, outCnt = 0, totalOTMins = 0;

    rows.forEach(r => {
      if (r.type === 'IN') inCnt++;
      if (r.type === 'OUT') outCnt++;
      totalOTMins += r.overtimeMins;

      let typeBadge = r.type === 'IN' ? 'badge-in' : (r.type === 'OUT' ? 'badge-out' : 'badge-leave');
      let otText = "-";
      if (r.type === 'OUT') {
        otText = `Worked: <b>${formatMinsToHrsMins(r.workedMins)}</b>`;
        if (r.overtimeMins > 0) otText += ` <span class="badge-ot">+${formatMinsToHrsMins(r.overtimeMins)} OT</span>`;
      } else if (r.lateMins > 0) {
        otText = `<span style="color:var(--danger); font-weight:700;">Late by ${r.lateMins}m</span>`;
      }

      let puncHtml = `<span style="color:var(--success); font-weight:800; font-size:11px;">ON TIME</span>`;
      let actBtn = "-";
      if (r.punctuality === 'Late') {
        puncHtml = `<span class="badge-late">LATE</span>`;
        actBtn = `<button class="btn-warn btn-small" onclick="exemptUser('${r.docId}', 'staff')">Exempt</button>`;
      } else if (r.punctuality === 'Early Exit') {
        puncHtml = `<span class="badge-early">EARLY EXIT</span>`;
        actBtn = `<button class="btn-warn btn-small" onclick="exemptUser('${r.docId}', 'staff')">Exempt</button>`;
      } else if (r.punctuality === 'Exempt') {
        puncHtml = `<span class="badge-exempt">EXEMPT</span>`;
      }

      html += `<tr>
        <td><b>${r.id}</b></td>
        <td><b>${r.name}</b></td>
        <td><b>${r.roleType}</b> (${r.designation})</td>
        <td><span class="badge-cat">${r.category}</span></td>
        <td>${r.date}</td>
        <td><b>${r.time}</b></td>
        <td>${otText}</td>
        <td><span class="${typeBadge}">${r.type}</span> ${puncHtml}</td>
        <td class="no-print">${actBtn}</td>
      </tr>`;
    });

    document.getElementById('stfTableBody').innerHTML = html || `<tr><td colspan="9" style="text-align:center; padding:35px;">No staff attendance records found.</td></tr>`;
    updateSummaryCards('stf', rows.length, 'Total Records', inCnt, 'IN Punches', outCnt, 'OUT Punches', formatMinsToHrsMins(totalOTMins), 'Overtime Logged');
    hideLoader();
  } catch (e) { catchError(e); }
}

