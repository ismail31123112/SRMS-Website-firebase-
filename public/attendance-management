function filterTableRows(tableId, query) {
  let filter = (query || "").toUpperCase();
  let trs = document.getElementById(tableId).getElementsByTagName("tr");
  for (let i = 1; i < trs.length; i++) {
    if (trs[i].cells.length <= 1) continue;
    let txt = trs[i].innerText.toUpperCase();
    trs[i].style.display = txt.indexOf(filter) > -1 ? "" : "none";
  }
}

function exportTableCSV(tableId, filename) {
  let csv = [];
  let rows = document.getElementById(tableId).querySelectorAll("tr");
  rows.forEach(r => {
    let row = [];
    r.querySelectorAll("th, td").forEach(c => {
      if (!c.classList.contains('no-print')) {
        row.push('"' + c.innerText.replace(/(\r\n|\n|\r)/gm, " ").replace(/"/g, '""') + '"');
      }
    });
    if (row.length) csv.push(row.join(","));
  });
  let blob = new Blob([csv.join("\n")], { type: "text/csv" });
  let a = document.createElement("a");
  a.download = filename;
  a.href = URL.createObjectURL(blob);
  a.click();
}

