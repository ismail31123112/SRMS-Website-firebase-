async function fetchReportDataFromFirebase(fromDate, toDate, classFilter, punctualityFilter) {
  let snap = await db.collection('AttendanceHistory')
    .where('pureDate', '>=', fromDate)
    .where('pureDate', '<=', toDate)
    .get();

  let records = [];
  let targetNorm = normalizeClass(classFilter);

  snap.forEach(doc => {
    let f = doc.data();
    let dbClass = f.class || "";
    let pStatus = f.punctuality || "On Time";
    let type = f.type || "";

    let matchClass = false;
    if (classFilter === "All") matchClass = true;
    else if (classFilter === "AllStudents") matchClass = (dbClass !== "Teacher");
    else if (classFilter === "Teacher") matchClass = (dbClass === "Teacher");
    else matchClass = (normalizeClass(dbClass) === targetNorm);

    let matchPunctuality = true;
    if (punctualityFilter === "LateEarly") matchPunctuality = (pStatus === "Late" || pStatus === "Early Exit");
    else if (punctualityFilter === "LeaveOnly") matchPunctuality = (type === "LEAVE");

    if (type === "LEAVE" && punctualityFilter !== "LeaveOnly" && punctualityFilter !== "All") {
      matchPunctuality = false;
    }

    if (matchClass && matchPunctuality) {
      records.push({
        docId: doc.id,
        id: f.studentID || "",
        name: f.name || "",
        cls: f.class || "",
        roll: f.roll || "",
        time: f.time || "",
        type: type,
        date: f.pureDate || "",
        punctuality: pStatus,
        smsStatus: f.smsStatus || "N/A"
      });
    }
  });

  records.sort((a, b) => {
    if (a.date !== b.date) return a.date > b.date ? -1 : 1;
    return a.time > b.time ? 1 : -1;
  });
  return records;
}

async function fetchBunkedDataFromFirebase(dateStr, classFilter) {
  let snap = await db.collection('AttendanceHistory').where('pureDate', '==', dateStr).get();
  let records = {};
  snap.forEach(doc => {
    let f = doc.data();
    let sid = String(f.studentID).trim();
    if (!records[sid]) records[sid] = { in: false, out: false, data: f };
    if (f.type === "IN") records[sid].in = true;
    if (f.type === "OUT") records[sid].out = true;
  });

  let bunkedList = [];
  let targetNorm = normalizeClass(classFilter);

  for (let sid in records) {
    if (records[sid].in && !records[sid].out) {
      let f = records[sid].data;
      let dbClass = f.class || "";
      let matchClass = false;
      if (classFilter === "All") matchClass = true;
      else if (classFilter === "AllStudents") matchClass = (dbClass !== "Teacher");
      else if (classFilter === "Teacher") matchClass = (dbClass === "Teacher");
      else matchClass = (normalizeClass(dbClass) === targetNorm);

      if (matchClass) {
        bunkedList.push({
          id: f.studentID || "",
          name: f.name || "",
          cls: f.class || "",
          roll: f.roll || "",
          date: f.pureDate || "",
          inTime: f.time || ""
        });
      }
    }
  }
  return bunkedList;
}

function getFilteredDirectoryMembers(directory, classFilter) {
  let allMembers = [];
  let fetchTeachers = (classFilter === "All" || classFilter === "Teacher");
  let fetchStudents = (classFilter === "All" || classFilter === "AllStudents" || (classFilter !== "Teacher" && classFilter !== "All"));
  let targetNorm = normalizeClass(classFilter);

  if (fetchTeachers) {
    allMembers = allMembers.concat(directory.teachers);
  }
  if (fetchStudents) {
    directory.students.forEach(s => {
      if (classFilter === "All" || classFilter === "AllStudents" || normalizeClass(s.cls) === targetNorm) {
        allMembers.push(s);
      }
    });
  }
  return allMembers;
}

async function fetchAbsentDataFromFirebase(dateStr, classFilter) {
  let [holDoc, directory, aSnap] = await Promise.all([
    db.collection('Holidays').doc(dateStr).get(),
    ensureUserDirectoryCached(false),
    db.collection('AttendanceHistory').where('pureDate', '==', dateStr).get()
  ]);

  if (holDoc.exists && holDoc.data().reason) {
    return { isHoliday: true, reason: holDoc.data().reason };
  }

  let allMembers = getFilteredDirectoryMembers(directory, classFilter);
  if (allMembers.length === 0) return { error: "NO_STUDENTS" };

  let presentIds = new Set();
  let leaveIds = {};
  aSnap.forEach(doc => {
    let p = doc.data();
    let cleanId = String(p.studentID).trim();
    if (p.type === "LEAVE") {
      leaveIds[cleanId] = p.time;
      presentIds.add(cleanId);
    } else {
      presentIds.add(cleanId);
    }
  });

  let absentList = [];
  allMembers.forEach(m => {
    if (!presentIds.has(m.id)) {
      absentList.push(m);
    } else if (leaveIds[m.id]) {
      absentList.push({ ...m, isLeave: true, reason: leaveIds[m.id] });
    }
  });
  return absentList;
}

async function fetchMonthlySummaryFromFirebase(monthStr, classFilter) {
  let monthStart = monthStr + "-01";
  let monthEnd = monthStr + "-31";

  let [directory, aSnap] = await Promise.all([
    ensureUserDirectoryCached(false),
    db.collection('AttendanceHistory')
      .where('pureDate', '>=', monthStart)
      .where('pureDate', '<=', monthEnd)
      .get()
  ]);

  let allMembers = getFilteredDirectoryMembers(directory, classFilter);
  let workingDaysSet = new Set();
  let userStats = {};

  allMembers.forEach(m => {
    userStats[m.id] = {
      ...m,
      presentDays: new Set(),
      leaveDays: new Set(),
      totalLate: 0,
      totalEarly: 0,
      dailyPunches: {}
    };
  });

  aSnap.forEach(doc => {
    let f = doc.data();
    let sid = String(f.studentID || "").trim();
    let pDate = f.pureDate;
    let type = f.type || "";
    if (pDate && pDate.startsWith(monthStr)) {
      workingDaysSet.add(pDate);
      if (userStats[sid]) {
        let time = f.time || "";
        if (!userStats[sid].dailyPunches[pDate]) userStats[sid].dailyPunches[pDate] = {};
        userStats[sid].dailyPunches[pDate][type] = time;

        if (type === "IN") userStats[sid].presentDays.add(pDate);
        else if (type === "LEAVE") userStats[sid].leaveDays.add(pDate);

        let pStatus = f.punctuality || "On Time";
        if (pStatus === "Late") userStats[sid].totalLate++;
        if (pStatus === "Early Exit") userStats[sid].totalEarly++;
      }
    }
  });

  let totalWorkingDays = workingDaysSet.size;
  let finalReport = [];

  Object.keys(userStats).forEach(id => {
    let u = userStats[id];
    u.totalPresent = u.presentDays.size;
    u.totalLeave = u.leaveDays.size;
    u.totalAbsent = totalWorkingDays - (u.totalPresent + u.totalLeave);
    if (u.totalAbsent < 0) u.totalAbsent = 0;
    u.totalWorkingDays = totalWorkingDays;

    let totalMins = 0;
    Object.values(u.dailyPunches).forEach(day => {
      if (day["IN"] && day["OUT"]) {
        let inM = parseTimeToMinutes(day["IN"]);
        let outM = parseTimeToMinutes(day["OUT"]);
        if (outM > inM) totalMins += (outM - inM);
      }
    });
    let hrs = Math.floor(totalMins / 60);
    let mins = totalMins % 60;
    u.totalHoursStr = `${hrs}h ${mins}m`;
    finalReport.push(u);
  });

  finalReport.sort((a, b) => a.totalPresent > b.totalPresent ? -1 : 1);
  return finalReport;
}

// ⚡ সিঙ্গেল-পাস ব্যাচ রেন্ডারিং (৫০০+ রো ০.০২ সেকেন্ডে রেন্ডার হবে)
function displayMonthly(data) {
  hideLoader();
  var tbody = document.getElementById('tableBody');
  if (data.length === 0) {
    tbody.innerHTML = '<tr><td colspan="10" style="text-align:center; padding: 40px; color: var(--text-muted); font-weight: 500;">নির্বাচিত মাসে কোনো তথ্য পাওয়া যায়নি।</td></tr>';
    updateAnalytics(0, 0, 0, 0);
    document.getElementById('chartContainer').style.display = 'none';
    return;
  }
  var tW = 0, tP = 0, tA = 0, tL = 0, tLeave = 0;
  var rowsHtml = [];

  data.forEach(r => {
    tW += r.totalWorkingDays;
    tP += r.totalPresent;
    tA += r.totalAbsent;
    tL += (r.totalLate + r.totalEarly);
    tLeave += r.totalLeave;

    var lateEarlyBadge = (r.totalLate > 0 || r.totalEarly > 0)
      ? `<span style="color:var(--danger); font-weight:bold;">${r.totalLate} L, ${r.totalEarly} E</span>`
      : `0`;
    var leaveBadge = r.totalLeave > 0
      ? `<span style="color:var(--leave); font-weight:bold;">${r.totalLeave} Days</span>`
      : `0`;

    rowsHtml.push(`<tr>
      <td style="font-weight:800; color: var(--primary-dark);">${r.id}</td>
      <td style="font-weight:600;">${r.name}</td>
      <td>${r.cls}</td>
      <td style="font-weight:600; color: var(--accent);">${r.roll}</td>
      <td style="font-weight:bold; color:var(--info);">${r.totalWorkingDays} Days</td>
      <td style="font-weight:bold; color:var(--success);">${r.totalPresent} Days</td>
      <td style="font-weight:bold; color:var(--danger);">${r.totalAbsent} Days</td>
      <td>${leaveBadge}</td>
      <td>${lateEarlyBadge}</td>
      <td style="font-weight:bold; color:var(--primary);">${r.totalHoursStr}</td>
    </tr>`);
  });

  tbody.innerHTML = rowsHtml.join('');

  document.getElementById('statTotal').innerText = data.length;
  document.getElementById('statTotal').parentElement.querySelector('span').innerText = "Total Users";
  document.getElementById('statIn').innerText = tP;
  document.getElementById('statIn').parentElement.querySelector('span').innerText = "Monthly Present";
  document.getElementById('statOut').innerText = tA;
  document.getElementById('statOut').parentElement.querySelector('span').innerText = "Monthly Absent";
  document.getElementById('statSms').innerText = tL;
  document.getElementById('statSms').parentElement.querySelector('span').innerText = "Late / Early Exits";

  updateChartData(tP, tA, tLeave, tL);
}

function displayPresent(data) {
  hideLoader();
  var tbody = document.getElementById('tableBody');
  var totalIn = 0, totalOut = 0, totalSms = 0, totalLate = 0, totalLeave = 0;

  if (data.length === 0) {
    tbody.innerHTML = '<tr><td colspan="8" style="text-align:center; padding: 40px; color: var(--text-muted); font-weight: 500;">নির্বাচিত তারিখে কোনো অ্যাটেনডেন্স রেকর্ড পাওয়া যায়নি।</td></tr>';
    updateAnalytics(0, 0, 0, 0);
    document.getElementById('chartContainer').style.display = 'none';
    return;
  }

  var rowsHtml = [];
  data.forEach(r => {
    var badgeClass = r.type === 'IN' ? 'badge-in' : (r.type === 'OUT' ? 'badge-out' : 'badge-leave');
    var isManual = r.time.includes("(M)") ? '<span class="badge-manual">Manual</span>' : '';
    var cleanTime = r.time.replace(" (M)", "");

    var punctualityHtml = "";
    var actionHtml = "";
    if (r.type === 'LEAVE') {
      punctualityHtml = `<span style="font-size:10px; color:var(--leave); margin-left:5px; font-weight:bold;">${r.punctuality}</span>`;
      actionHtml = `-`;
      totalLeave++;
    } else if (r.punctuality === "Late") {
      punctualityHtml = `<span class="badge-late">LATE</span>`;
      actionHtml = `<button class="btn-warn btn-small" onclick="exemptUser('${r.docId}')">Exempt</button>`;
      totalLate++;
    } else if (r.punctuality === "Early Exit") {
      punctualityHtml = `<span class="badge-early">EARLY EXIT</span>`;
      actionHtml = `<button class="btn-warn btn-small" onclick="exemptUser('${r.docId}')">Exempt</button>`;
      totalLate++;
    } else if (r.punctuality === "Exempt") {
      punctualityHtml = `<span class="badge-exempt">EXEMPT</span>`;
      actionHtml = `-`;
    } else {
      punctualityHtml = `<span style="font-size:10px; color:var(--success); margin-left:5px; font-weight:bold;">ON TIME</span>`;
      actionHtml = `-`;
    }

    var smsHtml = `<span class="sms-na">N/A</span>`;
    if (r.smsStatus === "Sent") {
      smsHtml = `<span class="sms-sent"><i class="fas fa-check"></i> Sent</span>`;
      totalSms++;
    } else if (r.smsStatus === "Failed" || r.smsStatus === "Error") {
      smsHtml = `<span class="sms-failed"><i class="fas fa-times"></i> Failed</span>`;
    }

    if (r.type === 'IN') totalIn++;
    if (r.type === 'OUT') totalOut++;

    rowsHtml.push(`<tr>
      <td style="font-weight:800; color: var(--primary-dark);">${r.id}</td>
      <td style="font-weight:600;">${r.name}</td>
      <td>${r.cls}</td>
      <td style="font-weight:600; color: var(--accent);">${r.roll}</td>
      <td>${r.date}</td>
      <td style="font-weight:600;">${cleanTime}</td>
      <td><span class="${badgeClass}">${r.type}</span> ${isManual} ${punctualityHtml}</td>
      <td class="no-print"><div style="display:flex; gap:6px; align-items:center;">${actionHtml} <span>${smsHtml}</span></div></td>
    </tr>`);
  });

  tbody.innerHTML = rowsHtml.join('');
  updateAnalytics(data.length, totalIn, totalOut, totalSms);
  updateChartData(totalIn, totalOut, totalLeave, totalLate);
}

function displayBunked(data) {
  hideLoader();
  var tbody = document.getElementById('tableBody');

  if (data.length === 0) {
    tbody.innerHTML = '<tr><td colspan="8" style="text-align:center; padding: 40px; color: var(--success); font-weight:700;"><i class="fas fa-check-circle" style="font-size:22px; display:block; margin-bottom:10px;"></i> সকল প্রবেশকারী (IN) ব্যবহারকারীর প্রস্থান (OUT) রেকর্ড সম্পন্ন রয়েছে।</td></tr>';
    updateAnalytics(0, 0, 0, 0);
    document.getElementById('chartContainer').style.display = 'none';
    return;
  }

  var rowsHtml = [];
  data.forEach(r => {
    rowsHtml.push(`<tr>
      <td style="font-weight:800; color: var(--primary-dark);">${r.id}</td>
      <td style="font-weight:600;">${r.name}</td>
      <td>${r.cls}</td>
      <td style="font-weight:600; color: var(--accent);">${r.roll}</td>
      <td>${r.date}</td>
      <td>IN: ${r.inTime}</td>
      <td><span class="badge-absent">MISSING OUT PUNCH</span></td>
      <td class="no-print"><button class="btn-warn btn-small" onclick="sendBunkerAlert('${r.id}', '${r.date}')"><i class="fas fa-sms"></i> Alert Guardian</button></td>
    </tr>`);
  });

  tbody.innerHTML = rowsHtml.join('');

  document.getElementById('statTotal').innerText = data.length;
  document.getElementById('statTotal').parentElement.querySelector('span').innerText = "Missing OUT Punch";
  document.getElementById('statIn').innerText = data.length;
  document.getElementById('statIn').parentElement.querySelector('span').innerText = "Entered (IN)";
  document.getElementById('statOut').innerText = "0";
  document.getElementById('statOut').parentElement.querySelector('span').innerText = "Exited (OUT)";
  document.getElementById('statSms').innerText = data.length;
  document.getElementById('statSms').parentElement.querySelector('span').innerText = "Action Required";

  updateChartData(data.length, 0, 0, data.length);
}

function displayAbsent(data) {
  hideLoader();
  var tbody = document.getElementById('tableBody');

  if (data.isHoliday) {
    tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; padding: 40px; color: #d97706; font-weight:700;"><i class="fas fa-umbrella-beach" style="font-size:28px; display:block; margin-bottom:10px;"></i> বিদ্যালয় ছুটি!<br><span style="font-size:14px; color:#475569;">কারণ: ${data.reason}</span></td></tr>`;
    updateAnalytics(0, 0, 0, 0);
    document.getElementById('chartContainer').style.display = 'none';
    return;
  }

  if (data.error === "NO_STUDENTS") {
    tbody.innerHTML = '<tr><td colspan="8" style="text-align:center; padding: 40px; color: var(--danger); font-weight:700;"><i class="fas fa-exclamation-triangle" style="font-size:20px; display:block; margin-bottom:10px;"></i> এই ক্যাটাগরিতে কোনো ব্যবহারকারী পাওয়া যায়নি!</td></tr>';
    updateAnalytics(0, 0, 0, 0);
    document.getElementById('chartContainer').style.display = 'none';
    return;
  }

  if (data.length === 0) {
    tbody.innerHTML = '<tr><td colspan="8" style="text-align:center; padding: 40px; color: var(--success); font-weight:700;"><i class="fas fa-check-circle" style="font-size:22px; display:block; margin-bottom:10px;"></i> আলহামদুলিল্লাহ, আজ সকলেই উপস্থিত!</td></tr>';
    updateAnalytics(0, 0, 0, 0);
    document.getElementById('chartContainer').style.display = 'none';
    return;
  }

  var totalLeaves = 0;
  var selectedDate = document.getElementById('dateFilterFrom').value;
  var rowsHtml = [];

  data.forEach(r => {
    var isLeave = r.isLeave || false;
    var statusBadge = isLeave ? `<span class="badge-leave">ON LEAVE</span>` : `<span class="badge-absent">ABSENT</span>`;
    var timeText = isLeave ? `<span style="color:var(--leave); font-size:11px; font-weight:bold;">${r.reason}</span>` : `Not Punched`;
    if (isLeave) totalLeaves++;

    rowsHtml.push(`<tr>
      <td style="font-weight:800; color: var(--primary-dark);">${r.id}</td>
      <td style="font-weight:600;">${r.name}</td>
      <td>${r.cls}</td>
      <td style="font-weight:600; color: var(--accent);">${r.roll}</td>
      <td>${selectedDate}</td>
      <td>${timeText}</td>
      <td>${statusBadge}</td>
      <td class="no-print"><span class="sms-na">-</span></td>
    </tr>`);
  });

  tbody.innerHTML = rowsHtml.join('');

  document.getElementById('statTotal').innerText = data.length;
  document.getElementById('statTotal').parentElement.querySelector('span').innerText = "Total Away";
  document.getElementById('statIn').innerText = data.length - totalLeaves;
  document.getElementById('statIn').parentElement.querySelector('span').innerText = "Total Absent";
  document.getElementById('statOut').innerText = totalLeaves;
  document.getElementById('statOut').parentElement.querySelector('span').innerText = "Total On Leave";
  document.getElementById('statSms').innerText = "-";
  document.getElementById('statSms').parentElement.querySelector('span').innerText = "SMS Info";

  updateChartData(0, data.length - totalLeaves, totalLeaves, 0);
}

function updateAnalytics(total, inCount, outCount, smsCount) {
  document.getElementById('statTotal').parentElement.querySelector('span').innerText = "Total Records";
  document.getElementById('statTotal').innerText = total;
  document.getElementById('statIn').innerText = inCount;
  document.getElementById('statIn').parentElement.querySelector('span').innerText = "Total IN (Entry)";
  document.getElementById('statOut').innerText = outCount;
  document.getElementById('statOut').parentElement.querySelector('span').innerText = "Total OUT (Exit)";
  document.getElementById('statSms').innerText = smsCount;
  document.getElementById('statSms').parentElement.querySelector('span').innerText = "Late / Early / SMS";
}
</script>
</body>
</html>
