<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SRMS — Official Attendance & Leave Management Portal</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
if (window.history.replaceState) {
  var cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
  window.history.replaceState({ path: cleanUrl }, '', cleanUrl);
}
</script>

<style>
:root {
  --primary: #005f40;
  --primary-dark: #003d29;
  --accent: #f59e0b;
  --danger: #e11d48;
  --success: #10b981;
  --warning: #f59e0b;
  --info: #2563eb;
  --leave: #4f46e5;
  --bg-color: #f1f5f9;
  --card-bg: #ffffff;
  --text-main: #0f172a;
  --text-muted: #64748b;
}
* { box-sizing: border-box; }
body {
  font-family: 'Poppins', sans-serif;
  background: var(--bg-color);
  margin: 0;
  padding: 20px;
  color: var(--text-main);
  -webkit-font-smoothing: antialiased;
}
.container {
  max-width: 1260px;
  margin: auto;
  display: none;
}
.container.active {
  display: block;
  animation: fadeIn 0.25s ease;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

/* Brand Header */
.brand-header {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: white;
  padding: 26px 30px;
  border-radius: 20px;
  margin-bottom: 24px;
  box-shadow: 0 12px 30px rgba(0, 95, 64, 0.18);
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  border-bottom: 5px solid var(--accent);
}
.header-left {
  display: flex;
  align-items: center;
  gap: 18px;
  z-index: 1;
}
.brand-logo {
  width: 78px;
  height: 78px;
  background: #fff;
  border-radius: 50%;
  padding: 4px;
  border: 3px solid rgba(255,255,255,0.28);
  object-fit: contain;
  box-shadow: 0 8px 20px rgba(0,0,0,0.2);
}
.brand-text h1 {
  margin: 0;
  font-size: 24px;
  font-weight: 800;
  letter-spacing: -0.3px;
  text-transform: uppercase;
}
.brand-text p {
  margin: 4px 0 0 0;
  color: #e2e8f0;
  font-weight: 500;
  font-size: 13.5px;
  letter-spacing: 0.3px;
}
.live-clock-box {
  background: rgba(0,0,0,0.28);
  padding: 12px 20px;
  border-radius: 14px;
  z-index: 1;
  text-align: center;
  border: 1px solid rgba(255,255,255,0.14);
  backdrop-filter: blur(6px);
}
.live-clock-time {
  font-size: 21px;
  font-weight: 800;
  color: var(--accent);
  margin-bottom: 2px;
}
.live-clock-date {
  font-size: 11.5px;
  font-weight: 600;
  color: #e2e8f0;
  text-transform: uppercase;
}

/* Summary Cards */
.summary-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}
.summary-card {
  background: var(--card-bg);
  padding: 20px;
  border-radius: 16px;
  box-shadow: 0 4px 15px rgba(15, 23, 42, 0.04);
  border-left: 5px solid;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s;
}
.summary-card:hover {
  transform: translateY(-3px);
}
.summary-card.total { border-color: var(--info); }
.summary-card.in { border-color: var(--success); }
.summary-card.out { border-color: var(--warning); }
.summary-card.sms { border-color: var(--primary); }
.card-title {
  font-size: 12.5px;
  color: var(--text-muted);
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.card-value {
  font-size: 28px;
  font-weight: 800;
  color: var(--text-main);
}

/* Chart Container */
.chart-container {
  background: var(--card-bg);
  padding: 18px;
  border-radius: 16px;
  box-shadow: 0 4px 15px rgba(15, 23, 42, 0.04);
  border: 1px solid #e2e8f0;
  display: flex;
  justify-content: center;
  align-items: center;
  max-height: 230px;
  margin-bottom: 24px;
}

/* Panels */
.panel-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(480px, 1fr));
  gap: 20px;
  margin-bottom: 24px;
}
.panel {
  background: var(--card-bg);
  padding: 24px;
  border-radius: 20px;
  box-shadow: 0 8px 25px rgba(15, 23, 42, 0.04);
  border: 1px solid #e2e8f0;
  position: relative;
}
.panel-title {
  font-weight: 800;
  font-size: 15.5px;
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 2px solid #f1f5f9;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--primary-dark);
  text-transform: uppercase;
  flex-wrap: wrap;
  gap: 8px;
}
.flex-row {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  align-items: center;
}

select, input {
  padding: 11px 14px;
  border-radius: 10px;
  border: 2px solid #e2e8f0;
  font-size: 13px;
  outline: none;
  font-family: inherit;
  font-weight: 500;
  transition: all 0.2s;
  background: #f8fafc;
  color: var(--text-main);
  width: 100%;
  box-sizing: border-box;
}
input:focus, select:focus {
  border-color: var(--primary);
  background: #fff;
  box-shadow: 0 0 0 3px rgba(0, 95, 64, 0.1);
}
.input-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5px;
  min-width: 135px;
}
.input-label {
  font-size: 11px;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
  margin-left: 2px;
}
.search-wrapper {
  position: relative;
  flex: 1;
}
.search-wrapper i {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-muted);
}
.search-wrapper input {
  padding-left: 38px;
}

/* Buttons */
button {
  padding: 11px 15px;
  border-radius: 10px;
  border: none;
  font-weight: 700;
  font-size: 12.5px;
  font-family: inherit;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  justify-content: center;
  transition: all 0.2s ease;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}
button:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 6px 14px rgba(0,0,0,0.1);
}
button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
.btn-primary { background: var(--primary); color: white; }
.btn-accent { background: var(--accent); color: white; }
.btn-green { background: var(--success); color: white; }
.btn-red { background: var(--danger); color: white; }
.btn-dark { background: #0f172a; color: white; }
.btn-warn { background: var(--warning); color: #000; }
.btn-leave { background: var(--leave); color: white; }
.btn-info { background: var(--info); color: white; }
.btn-small { padding: 5px 10px; font-size: 10.5px; border-radius: 7px; }

/* Loader Overlay */
#loaderOverlay {
  display: flex;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(255,255,255,0.92);
  z-index: 9999;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  backdrop-filter: blur(6px);
}
.loader-box {
  background: white;
  padding: 32px 45px;
  border-radius: 20px;
  box-shadow: 0 20px 45px rgba(0,0,0,0.08);
  text-align: center;
  font-weight: 800;
  color: var(--primary-dark);
  font-size: 15px;
  border-top: 5px solid var(--primary);
}
.spinner {
  border: 4px solid #e2e8f0;
  border-top: 4px solid var(--primary);
  border-radius: 50%;
  width: 48px;
  height: 48px;
  animation: spin 0.7s linear infinite;
  margin: 0 auto 14px auto;
}
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

/* Modals */
.modal {
  display: none;
  position: fixed;
  z-index: 1000;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(4px);
  align-items: center;
  justify-content: center;
}
.modal-content {
  background: #fff;
  padding: 28px;
  border-radius: 20px;
  width: 92%;
  max-width: 450px;
  position: relative;
  animation: zoomIn 0.2s;
  box-shadow: 0 20px 50px rgba(0,0,0,0.2);
  max-height: 90vh;
  overflow-y: auto;
  border-top: 6px solid var(--primary);
}
@keyframes zoomIn { from { transform: scale(0.95); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.close {
  position: absolute;
  top: 14px;
  right: 18px;
  font-size: 24px;
  cursor: pointer;
  color: #94a3b8;
  transition: 0.2s;
  z-index: 10;
}
.close:hover { color: var(--danger); }
.flatpickr-calendar {
  margin: 0 auto 14px auto;
  box-shadow: none !important;
  border: 1px solid #e2e8f0;
  width: 100%;
}

/* Table */
.table-container {
  overflow-x: auto;
  border-radius: 14px;
  border: 1px solid #e2e8f0;
  margin-top: 14px;
}
table {
  width: 100%;
  border-collapse: collapse;
  background: #fff;
}
th, td {
  padding: 12px 15px;
  text-align: left;
  border-bottom: 1px solid #f1f5f9;
  font-size: 13px;
}
th {
  background: #f8fafc;
  color: var(--text-muted);
  font-weight: 700;
  font-size: 11.5px;
  text-transform: uppercase;
  letter-spacing: 0.7px;
  white-space: nowrap;
}
tbody tr:hover {
  background-color: #f8fafc;
}

/* Badges */
.badge-in { background: #dcfce7; color: #166534; padding: 4px 11px; border-radius: 20px; font-size: 11px; font-weight: 800; border: 1px solid #bbf7d0; display: inline-block; }
.badge-out { background: #fef3c7; color: #92400e; padding: 4px 11px; border-radius: 20px; font-size: 11px; font-weight: 800; border: 1px solid #fde68a; display: inline-block; }
.badge-absent { background: #fee2e2; color: #991b1b; padding: 4px 11px; border-radius: 20px; font-size: 11px; font-weight: 800; border: 1px solid #fecaca; display: inline-block; }
.badge-leave { background: #e0e7ff; color: #3730a3; padding: 4px 11px; border-radius: 20px; font-size: 11px; font-weight: 800; border: 1px solid #c7d2fe; display: inline-block; }
.badge-manual { font-size: 10px; color: #b45309; margin-left: 5px; font-weight: 700; background: #fef3c7; padding: 2px 6px; border-radius: 6px; border: 1px solid #fde68a; }
.badge-late { background: #fca5a5; color: #7f1d1d; padding: 3px 8px; border-radius: 6px; font-size: 10px; font-weight: 800; margin-left: 5px; }
.badge-early { background: #fcd34d; color: #78350f; padding: 3px 8px; border-radius: 6px; font-size: 10px; font-weight: 800; margin-left: 5px; }
.badge-exempt { background: #bfdbfe; color: #1e3a8a; padding: 3px 8px; border-radius: 6px; font-size: 10px; font-weight: 800; margin-left: 5px; }

.sms-sent { color: var(--success); font-weight: 700; }
.sms-failed { color: var(--danger); font-weight: 700; }
.sms-na { color: var(--text-muted); font-style: italic; }

/* Print-Only Elements (Hidden on Screen) */
.print-only-meta,
.print-table-spacer,
.print-signature-fixed {
  display: none;
}

/* ============================================================================
   🖨️ ENTERPRISE A4 PRINT ENGINE (FULL PAGE FILL + FIXED SIGNATURE FOOTER)
   ============================================================================ */
@media print {
  @page {
    size: A4 portrait;
    margin: 10mm 10mm 12mm 10mm;
  }
  html, body {
    background: #ffffff !important;
    padding: 0 !important;
    margin: 0 !important;
    color: #000000 !important;
    font-size: 10pt;
    font-family: 'Times New Roman', Times, serif;
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
  /* Remove any transform/animation so position:fixed works across all printed pages */
  .container,
  .container.active,
  .panel,
  #printableArea,
  .table-container {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    box-shadow: none !important;
    overflow: visible !important;
    animation: none !important;
    transform: none !important;
    background: transparent !important;
  }
  .no-print,
  .summary-grid,
  .chart-container,
  .live-clock-box,
  .panel-grid,
  #loaderOverlay,
  .modal,
  button {
    display: none !important;
  }

  /* Official Print Header */
  .brand-header {
    background: transparent !important;
    color: #000 !important;
    box-shadow: none !important;
    border: none !important;
    border-bottom: 2px solid #000 !important;
    border-radius: 0 !important;
    padding: 0 0 8px 0 !important;
    margin: 0 0 10px 0 !important;
    display: flex !important;
    flex-direction: row !important;
    justify-content: center !important;
    align-items: center !important;
  }
  .header-left {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 14px !important;
    width: 100%;
  }
  .brand-logo {
    width: 58px !important;
    height: 58px !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
  }
  .brand-text {
    text-align: center;
  }
  .brand-text h1 {
    font-size: 18pt !important;
    margin: 0 !important;
    color: #000 !important;
    font-family: 'Times New Roman', Times, serif !important;
    font-weight: bold !important;
    letter-spacing: 0.3px !important;
  }
  .brand-text p {
    font-size: 10.5pt !important;
    margin: 2px 0 0 0 !important;
    color: #222 !important;
    font-weight: normal !important;
  }

  /* Report Title & Print Summary Bar */
  #reportTitle {
    font-size: 13pt !important;
    margin: 0 0 6px 0 !important;
    color: #000 !important;
    text-align: center !important;
    width: 100% !important;
    display: block !important;
    font-weight: bold !important;
    text-transform: uppercase;
  }
  .print-only-meta {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    border-top: 1px solid #000;
    border-bottom: 1px solid #000;
    padding: 4px 6px !important;
    margin-bottom: 8px !important;
    font-size: 9.5pt !important;
    font-weight: bold;
    background: #f8fafc !important;
  }

  /* Table Pagination & Full-Page Fill Rules */
  table {
    width: 100% !important;
    border-collapse: collapse !important;
    border: 1px solid #000 !important;
    page-break-inside: auto !important;
  }
  thead {
    display: table-header-group !important;
  }
  tbody {
    display: table-row-group !important;
  }
  /* Reserve space at bottom of each page so rows fill the page cleanly and never overlap fixed signatures */
  tfoot.print-table-spacer {
    display: table-footer-group !important;
  }
  tfoot.print-table-spacer td {
    border: none !important;
    padding: 0 !important;
    background: transparent !important;
  }
  .print-footer-space {
    height: 25mm !important;
  }
  tr {
    page-break-inside: avoid !important;
    break-inside: avoid !important;
    page-break-after: auto !important;
  }
  th, td {
    border: 1px solid #000 !important;
    padding: 5px 6px !important;
    text-align: center !important;
    font-size: 9.5pt !important;
    line-height: 1.25 !important;
    color: #000 !important;
    word-break: break-word;
  }
  td:nth-child(2) {
    text-align: left !important;
    font-weight: bold !important;
  }
  th {
    background-color: #eaeaea !important;
    font-weight: bold !important;
    text-transform: uppercase;
    font-size: 9pt !important;
  }

  .badge-in, .badge-out, .badge-absent, .badge-leave,
  .badge-manual, .badge-late, .badge-early, .badge-exempt,
  .sms-sent, .sms-failed, .sms-na {
    border: none !important;
    background: transparent !important;
    color: #000 !important;
    padding: 0 !important;
    font-weight: bold !important;
    font-size: 9pt !important;
    display: inline !important;
  }

  /* Fixed Official Signature Block at the Bottom of the Page */
  .print-signature-fixed {
    display: flex !important;
    position: fixed !important;
    bottom: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    height: 20mm !important;
    background: #ffffff !important;
    justify-content: space-between !important;
    align-items: flex-end !important;
    padding: 0 8mm 1mm 8mm !important;
    box-sizing: border-box !important;
    z-index: 9999 !important;
  }
  .sig-box {
    width: 30%;
    text-align: center;
    font-family: 'Times New Roman', Times, serif;
  }
  .sig-line {
    border-top: 1.2px solid #000;
    padding-top: 3px;
    font-size: 10pt;
    font-weight: bold;
    color: #000;
  }
  .sig-sub {
    font-size: 8.5pt;
    color: #333;
    display: block;
    margin-top: 1px;
  }
}

@media (max-width: 768px) {
  .brand-header { flex-direction: column; text-align: center; justify-content: center; gap: 14px; }
  .header-left { flex-direction: column; }
  .panel-grid { grid-template-columns: 1fr; }
  .summary-grid { grid-template-columns: 1fr 1fr; }
}
</style>
</head>

<body>

<!-- Session & Process Loader -->
<div id="loaderOverlay">
  <div class="loader-box">
    <div class="spinner"></div>
    <div id="loaderMsg">
      সিস্টেম যাচাই করা হচ্ছে...<br>
      <span style="font-size:11.5px; color:#64748b; font-weight: 500;">অনুগ্রহ করে অপেক্ষা করুন</span>
    </div>
  </div>
</div>

<div class="container" id="appContainer">

  <!-- Official Institutional Header -->
  <div class="brand-header">
    <div class="header-left">
      <img src="https://i.postimg.cc/9FxBsqsj/IMG-20251220-WA0006.jpg" alt="SRMS Logo" class="brand-logo">
      <div class="brand-text">
        <h1>Saidpur Residential Model School</h1>
        <p>Saidpur, Nilphamari &bull; Official Attendance &amp; Leave Management Portal</p>
      </div>
    </div>
    <div class="live-clock-box no-print">
      <div class="live-clock-time" id="clockTime">00:00:00 AM</div>
      <div class="live-clock-date" id="clockDate">Loading...</div>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="summary-grid no-print" id="analyticsGrid">
    <div class="summary-card total">
      <div class="card-title"><span>Total Records</span> <i class="fas fa-database"></i></div>
      <div class="card-value" id="statTotal">0</div>
    </div>
    <div class="summary-card in">
      <div class="card-title"><span>Total IN / Present</span> <i class="fas fa-sign-in-alt"></i></div>
      <div class="card-value" id="statIn">0</div>
    </div>
    <div class="summary-card out">
      <div class="card-title"><span>Total OUT / Absent</span> <i class="fas fa-sign-out-alt"></i></div>
      <div class="card-value" id="statOut">0</div>
    </div>
    <div class="summary-card sms">
      <div class="card-title"><span>Late / Leave / SMS</span> <i class="fas fa-envelope-open-text"></i></div>
      <div class="card-value" id="statSms">0</div>
    </div>
  </div>

  <!-- Interactive Chart Section -->
  <div class="chart-container no-print" id="chartContainer" style="display:none;">
    <canvas id="attendanceChart"></canvas>
  </div>

  <!-- Control Panels -->
  <div class="panel-grid no-print">
    <!-- Manual Attendance & Leave Panel -->
    <div class="panel" style="border-left: 4px solid var(--accent);">
      <div class="panel-title">
        <span><i class="fas fa-user-check"></i> Manual Attendance &amp; Leave</span>
        <div style="display:flex; gap:8px;">
          <button class="btn-warn btn-small" onclick="openTimeModal()"><i class="fas fa-clock"></i> Timings</button>
          <button class="btn-leave btn-small" onclick="openLeaveModal()"><i class="fas fa-calendar-plus"></i> Grant Leave</button>
        </div>
      </div>
      <div class="flex-row">
        <div class="input-group" style="flex: 2;">
          <span class="input-label">User ID / Machine ID</span>
          <input type="text" id="manualId" placeholder="Student ID, Teacher Phone or Machine ID">
        </div>
        <div class="input-group" style="flex: 1;">
          <span class="input-label">Punch Type</span>
          <select id="manualType">
            <option value="IN">Only IN</option>
            <option value="OUT">Only OUT</option>
            <option value="BOTH">Both (IN &amp; OUT)</option>
          </select>
        </div>
      </div>
      <div class="flex-row" style="margin-top: 12px;">
        <div class="input-group" style="flex: 2;">
