  switchModuleTab('hrSetupTab');
  document.getElementById('hrDocId').value = emp.docId;
  document.getElementById('hrFormTitle').innerHTML = `<i class="fas fa-user-edit"></i> Editing: ${emp.name}`;
  document.getElementById('hrRoleType').value = emp.roleType;
  document.getElementById('hrStaffCategory').value = emp.staffCategory;
  document.getElementById('hrName').value = emp.name;
  document.getElementById('hrDesignation').value = emp.designation;
  document.getElementById('hrPhone').value = emp.phone;
  document.getElementById('hrMachineId').value = emp.machineID;
  document.getElementById('hrCardNumber').value = emp.cardNumber;
  document.getElementById('hrBaseSalary').value = emp.baseSalary;
  document.getElementById('hrOvertimeRate').value = emp.overtimeRate;

  let absRate = String(emp.absentDeductionRate || "AUTO").toUpperCase();
  if (absRate === "AUTO" || absRate === "OFF") {
    document.getElementById('hrAbsentRule').value = absRate;
  } else {
    document.getElementById('hrAbsentRule').value = "CUSTOM";
    document.getElementById('hrCustomAbsentRate').value = emp.absentDeductionRate;
  }

  document.getElementById('hrLateRule').value = emp.lateDeductionRule || "3_LATE_1_DAY";
  document.getElementById('hrLateFixedFine').value = emp.lateFixedFine || 0;
  document.getElementById('hrCustomInTime').value = emp.customEntryTime || "";
  document.getElementById('hrCustomOutTime').value = emp.customExitTime || "";
  document.getElementById('hrPortalPass').value = emp.pass === "NO_PORTAL_ACCESS" ? "123456" : emp.pass;

  toggleHrPortalPassVisibility();
  toggleCustomAbsentRateInput();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

async function saveStaffOrTeacherProfile() {
  let pwd = document.getElementById('hrAdminPwd').value.trim();
  let name = document.getElementById('hrName').value.trim();
  let phone = document.getElementById('hrPhone').value.trim();
  if (!name || !phone || !pwd) {
    return Swal.fire("Required", "Name, Mobile Number (ID), and Admin Password are required!", "warning");
  }

  let absRule = document.getElementById('hrAbsentRule').value;
  let finalAbsentRate = absRule === "CUSTOM" ? (document.getElementById('hrCustomAbsentRate').value || "0") : absRule;

  let photoUrl = "";
  let fileInput = document.getElementById('hrPhotoInput');
  showLoader("Saving Employee Profile & Biometric Setup...");

  try {
    if (fileInput.files && fileInput.files[0]) {
      let base64 = await new Promise((resolve) => {
        let reader = new FileReader();
        reader.onload = e => resolve(e.target.result.split(',')[1]);
        reader.readAsDataURL(fileInput.files[0]);
      });
      let formData = new FormData();
      formData.append("key", IMGBB_API_KEY);
      formData.append("image", base64);
      let imgRes = await fetch("https://api.imgbb.com/1/upload", { method: "POST", body: formData });
      let imgJson = await imgRes.json();
      if (imgJson && imgJson.success) photoUrl = imgJson.data.url;
    }

    let payloadData = {
      docId: document.getElementById('hrDocId').value,
      roleType: document.getElementById('hrRoleType').value,
      staffCategory: document.getElementById('hrStaffCategory').value,
      name: name,
      designation: document.getElementById('hrDesignation').value.trim(),
      phone: phone,
      machineID: document.getElementById('hrMachineId').value.trim(),
      cardNumber: document.getElementById('hrCardNumber').value.trim(),
      baseSalary: document.getElementById('hrBaseSalary').value,
      overtimeRate: document.getElementById('hrOvertimeRate').value,
      absentDeductionRate: finalAbsentRate,
      lateDeductionRule: document.getElementById('hrLateRule').value,
      lateFixedFine: document.getElementById('hrLateFixedFine').value,
      customEntryTime: document.getElementById('hrCustomInTime').value,
      customExitTime: document.getElementById('hrCustomOutTime').value,
      pass: document.getElementById('hrPortalPass').value,
      photoUrl: photoUrl
    };

    let res = await apiCall('saveStaffOrTeacher', { data: payloadData, pwd: pwd });
    hideLoader();
    resetHrForm();
    await loadAllDirectoriesAndSettings(true);
    Swal.fire("Saved!", res.msg, "success");
  } catch (e) { catchError(e); }
}

