// ============================================================================
async function apiCall(actionName, payloadData = {}) {
  let token = "";
  if (auth.currentUser) {
    try {
      token = await auth.currentUser.getIdToken(false);
    } catch (e) {
      try { token = await auth.currentUser.getIdToken(true); } catch (err) {}
    }
  }
  let payload = {
    action: actionName,
    token: token,
    adminKey: SRMS_ADMIN_PASSKEY,
    ...payloadData
  };

  let res = await fetch(SCRIPT_URL, {
    method: 'POST',
    body: JSON.stringify(payload),
    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
    redirect: 'follow'
  });
  let data = await res.json();
  if (data.status === "error") throw new Error(data.message || data.msg);
  return data;
}

async function ensureUserDirectoryCached(forceRefresh = false) {
  if (!forceRefresh && cachedTeachersList && cachedStudentsList) {
    return { teachers: cachedTeachersList, students: cachedStudentsList };
  }
  if (!forceRefresh && directoryCachePromise) {
    return directoryCachePromise;
  }

  directoryCachePromise = Promise.all([
    db.collection('Teachers').get(),
    db.collection('Students').get()
  ]).then(([tSnap, sSnap]) => {
    let tList = [];
    tSnap.forEach(t => {
      let d = t.data();
      tList.push({
        id: String(d.phone || t.id).trim(),
        name: d.name || "Unknown",
        roll: d.designation || "Staff",
        cls: "Teacher"
      });
    });

    let sList = [];
    sSnap.forEach(s => {
      let d = s.data();
      sList.push({
        id: String(d.studentID || s.id).trim(),
        name: d.name || "Unknown",
        roll: d.roll || "0",
        cls: d.class || "Student"
      });
    });

    cachedTeachersList = tList;
    cachedStudentsList = sList;
    directoryCachePromise = null;
    return { teachers: tList, students: sList };
  }).catch(err => {
    directoryCachePromise = null;
    throw err;
  });

  return directoryCachePromise;
}

auth.setPersistence(firebase.auth.Auth.Persistence.LOCAL)
