// ============================================================================
// ⚡ INSTANT BACKGROUND PRE-UPLOAD ENGINE (ZERO WAIT ON SUBMIT)
// ============================================================================
async function uploadToMediaHostDirect(base64Image, fileName) {
  var formData = new FormData();
  formData.append("key", MEDIA_API_KEY);
  formData.append("image", base64Image);
  if (fileName) {
    var cleanName = fileName.replace(/\.[^/.]+$/, "");
    formData.append("name", cleanName);
  }

  var response = await fetch(MEDIA_UPLOAD_URL, {
    method: "POST",
    body: formData
  });
  var json = await response.json();
  if (json && json.success && json.data) {
    return {
      url: json.data.url || json.data.display_url,
      thumbUrl: (json.data.thumb && json.data.thumb.url) ? json.data.thumb.url : json.data.url,
      deleteUrl: json.data.delete_url || "",
      imgbbId: json.data.id || ""
    };
  }
  throw new Error("Media upload failed");
}

function clearSelectedFile() {
  document.getElementById('upFile').value = "";
  document.getElementById('filePreviewBox').style.display = "none";
  preparedFilePayload = null;
}

// ছবি সিলেক্ট করার সাথে সাথেই ব্যাকগ্রাউন্ডে আপলোড হয়ে থাকবে, যাতে পাবলিশ বাটনে চাপার সাথে সাথেই কাজ শেষ হয়
function handleFilePreview(input) {
  if (!input.files || input.files.length === 0) {
    clearSelectedFile();
    return;
  }
  var file = input.files[0];
  var previewBox = document.getElementById('filePreviewBox');
  var previewImg = document.getElementById('previewImg');
  var previewMeta = document.getElementById('previewMeta');

  if (file.type.startsWith("image/")) {
    previewMeta.innerHTML = `<i class="fas fa-circle-notch fa-spin"></i> ছবি প্রস্তুত হচ্ছে...`;
    previewBox.style.display = "flex";

    var reader = new FileReader();
    reader.onload = function(e) {
      var img = new Image();
      img.onload = function() {
        var maxDim = 1280;
        var w = img.width;
        var h = img.height;
        if (w > maxDim || h > maxDim) {
          if (w > h) {
            h = Math.round((h * maxDim) / w);
            w = maxDim;
          } else {
            w = Math.round((w * maxDim) / h);
            h = maxDim;
          }
        }
        var canvas = document.createElement('canvas');
        canvas.width = w;
        canvas.height = h;
        var ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, w, h);

        var dataUrl = canvas.toDataURL('image/jpeg', 0.85);
        previewImg.src = dataUrl;
        var cleanName = file.name.replace(/\.[^/.]+$/, "") + ".jpg";
        var rawBase64 = dataUrl.split(',')[1];

        var payloadObj = {
          isImage: true,
          fileData: rawBase64,
          mimeType: 'image/jpeg',
          fileName: cleanName,
          uploadedResult: null,
          uploadPromise: null
        };

        // সিলেক্ট করার সাথে সাথেই ব্যাকগ্রাউন্ডে প্রি-আপলোড শুরু
        payloadObj.uploadPromise = uploadToMediaHostDirect(rawBase64, cleanName)
          .then(res => {
            payloadObj.uploadedResult = res;
            previewMeta.innerHTML = `<b>${cleanName}</b><br><span style="color:#15803d;"><i class="fas fa-check-circle"></i> প্রকাশের জন্য সম্পূর্ণ প্রস্তুত</span>`;
            return res;
          })
          .catch(() => {
            previewMeta.innerHTML = `<b>${cleanName}</b><br>প্রকাশের জন্য প্রস্তুত`;
            return null;
          });

        preparedFilePayload = payloadObj;
        previewMeta.innerHTML = `<b>${cleanName}</b><br><i class="fas fa-sync fa-spin"></i> ব্যাকগ্রাউন্ডে সংযুক্ত হচ্ছে...`;
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  } else {
    previewImg.src = "https://cdn-icons-png.flaticon.com/512/337/337946.png";
    previewMeta.innerHTML = `<i class="fas fa-circle-notch fa-spin"></i> ডকুমেন্ট লোড হচ্ছে...`;
    previewBox.style.display = "flex";

    var reader = new FileReader();
    reader.onload = function(e) {
      var kbSize = Math.round(file.size / 1024);
      preparedFilePayload = {
        isImage: false,
        fileData: e.target.result.split(',')[1],
        mimeType: file.type || 'application/octet-stream',
        fileName: file.name
      };
      previewMeta.innerHTML = `<b>${file.name}</b><br><i class="fas fa-check-circle"></i> ডকুমেন্ট প্রস্তুত (${kbSize} KB)`;
    };
    reader.readAsDataURL(file);
  }
}

