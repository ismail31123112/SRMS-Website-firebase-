<!-- ================= FIREBASE & FRONTEND LOGIC ================= -->
<script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-firestore-compat.js"></script>

<script>
const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwB6vTpulMxhtMXgdhtTt7cXCHeu0Ndg23qo5cG5R0nbqbqxm7zjaevMhAR7YDHiTAq/exec";

const firebaseConfig = {
    apiKey: "AIzaSyBhzidG1s5CsOaiY0RsBG6GJcrE12LLEuU",
    authDomain: "srms-website-management.firebaseapp.com",
    projectId: "srms-website-management"
};
if (!firebase.apps.length) { firebase.initializeApp(firebaseConfig); }
const db = firebase.firestore();
const auth = firebase.auth();

var isAuthReady = false; 
var globalUsersList = []; 

function changeLoaderText(text) { document.getElementById('loaderText').innerHTML = text; }
function showLoader(show, text="PROCESSING...") { 
    if(show) { changeLoaderText(text); document.getElementById('loader').style.display = 'flex'; }
    else { document.getElementById('loader').style.display = 'none'; }
}

async function apiCall(actionName, payloadData = {}) {
    let token = await auth.currentUser.getIdToken(true);
    let payload = { action: actionName, token: token, ...payloadData };
    try {
        let res = await fetch(SCRIPT_URL, {
            method: 'POST', body: JSON.stringify(payload), headers: { 'Content-Type': 'text/plain;charset=utf-8' }
        });
        let text = await res.text();
        if (text.includes("<html") || text.includes("<body")) {
            throw new Error("Deployment Access Error! Apps Script Web App is blocking access. Ensure 'Who has access' is set to 'Anyone'.");
        }
        
        let data;
        try { data = JSON.parse(text); } 
        catch(e) { throw new Error("Invalid Response from server."); }
        
        if (data.error) throw new Error(data.error);
        if (data.status === "error") throw new Error(data.message);
        
        return data;
    } catch (error) {
        throw error;
    }
}

auth.setPersistence(firebase.auth.Auth.Persistence.LOCAL)
.then(() => {
    auth.onAuthStateChanged(function(user) {
        if (user) {
            isAuthReady = true;
            showLoader(false);
            document.getElementById('appContainer').style.display = 'block';
        } else {
            showLoader(true, "UNAUTHORIZED ACCESS!<br><span style='font-size:11px; color:#ef4444;'>Redirecting to Login...</span>");
            setTimeout(() => {
                var currentDomain = window.location.protocol + "//" + window.location.host;
                window.location.replace(currentDomain + "/login-panel/accounting-and-management-department");
            }, 1000);
        }
    });
})
.catch(err => { console.error("Auth Persistence Error:", err); });

function updateTitleLabel(sel) { 
    document.getElementById('titleLabel').innerHTML = `<i class="fas fa-heading" style="color:var(--primary); margin-right:5px;"></i> Title for ` + sel.options[sel.selectedIndex].text.split('(')[0]; 
}

function switchTab(id, btn) {
    if(!isAuthReady) return alert("Security checking in progress... Please wait.");
    document.querySelectorAll('.container').forEach(c => c.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    if(btn) btn.classList.add('active');
    
    if(id === 'manage') loadPosts();
    if(id === 'users') loadUsers(); 
}

async function submitUpload() {
    var title = document.getElementById('upTitle').value.trim();
    if (!title) { Swal.fire("Warning", "Please enter a title!", "warning"); return; }
    
    showLoader(true, "UPLOADING POST...<br><span style='font-size:11px; color:#64748b;'>Sending to Server securely</span>");

    var cat = document.getElementById('upCat').value;
    var desc = document.getElementById('upDesc').value.trim();
    var link = document.getElementById('upLink').value.trim();
    var fileInput = document.getElementById('upFile');

    try {
        let data = { targetPage: cat, title: title, desc: desc, externalUrl: link };
        
        if (fileInput.files.length > 0) {
            var file = fileInput.files[0];
            var reader = new FileReader();
            reader.onload = async function(e) {
                data.fileData = e.target.result.split(',')[1];
                data.mimeType = file.type;
                data.fileName = file.name;
                let res = await apiCall('uploadData', { data: data });
                handleUploadResponse(res);
            };
            reader.readAsDataURL(file);
        } else {
            let res = await apiCall('uploadData', { data: data });
            handleUploadResponse(res);
        }
    } catch(err) {
        showLoader(false); Swal.fire("Request Failed", err.message, "error");
    }
}

function handleUploadResponse(res) {
    showLoader(false);
    if(res.status === "success") {
        Swal.fire({ title: "Success!", text: res.msg, icon: "success", confirmButtonColor: "#005f40" });
        document.getElementById('upTitle').value = ""; document.getElementById('upDesc').value = ""; 
        document.getElementById('upLink').value = ""; document.getElementById('upFile').value = "";
        document.getElementById('upCat').selectedIndex = 0; updateTitleLabel(document.getElementById('upCat')); 
        if(document.getElementById('manage').classList.contains('active')) loadPosts();
    } else { Swal.fire("Error", res.msg || res.message, "error"); }
}

function pubHead() { 
    var t = document.getElementById('hText').value.trim(); 
    if(!t) { Swal.fire("Empty!", "Please write a headline first.", "warning"); return; }
    
    Swal.fire({ title: "Publish Headline?", text: "This will instantly appear as a scrolling notice.", icon: "question", showCancelButton: true, confirmButtonColor: "#d97706", confirmButtonText: "Yes, Publish it!" }).then(async (result) => {
        if (result.isConfirmed) {
            showLoader(true, "PUBLISHING HEADLINE...");
            try {
                let res = await apiCall('addHeadline', { text: t });
                showLoader(false); 
                Swal.fire("Published!", res.msg || res.message, "success"); document.getElementById('hText').value="";
            } catch(err) { showLoader(false); Swal.fire("Error", err.message, "error"); }
        }
    });
}

function delPost(docId) { 
    Swal.fire({ title: 'Delete this post?', text: "It will be permanently removed!", icon: 'warning', showCancelButton: true, confirmButtonColor: '#ef4444', confirmButtonText: 'Yes, delete it!' }).then(async (result) => {
        if (result.isConfirmed) {
            showLoader(true, "DELETING POST..."); 
            try {
                let res = await apiCall('deletePost', { docId: docId });
                showLoader(false); Swal.fire("Deleted!", res.msg || res.message, "success"); loadPosts();
            } catch(err) { showLoader(false); Swal.fire("Error", err.message, "error"); }
        } 
    });
}

async function addUser() {
    var passVal = document.getElementById('uPass').value.trim(); 
    var d = { type: "Teacher", pass: passVal || "123456" };
    
    d.cardNumber = document.getElementById('uCardNumber').value.trim();
    d.id = document.getElementById('uTPhone').value.trim(); 
    d.machineId = document.getElementById('uTMachineId').value.trim(); 
    d.name = document.getElementById('uTName').value.trim(); 
    d.email = document.getElementById('uTEmail').value.trim();
    
    if(!d.id || !d.name) return Swal.fire("Warning", "Name & Phone ID are required for Teacher!", "warning");
    
    showLoader(true, "SAVING ACCOUNT...<br><span style='font-size:11px; color:#64748b;'>Syncing with Machine & Server</span>");
    try {
        let res = await apiCall('addUserDatabase', { info: d });
        showLoader(false); Swal.fire("Success!", res.msg || res.message, "success"); 
        
        document.getElementById('uTMachineId').value = ""; document.getElementById('uTPhone').value = ""; 
        document.getElementById('uTName').value = ""; document.getElementById('uTEmail').value = ""; 
        document.getElementById('uPass').value = ""; document.getElementById('uCardNumber').value = ""; 
        
        if(document.getElementById('users').classList.contains('active')) loadUsers(); 
    } catch(err) { showLoader(false); Swal.fire("Error", err.message, "error"); }
}

async function submitUserEdit() {
    var d = { 
        row: document.getElementById('euRow').value, 
        type: document.getElementById('euType').value, 
        id: document.getElementById('euId').value, 
        pass: document.getElementById('euPass').value.trim(), 
        machineId: document.getElementById('euMachineId').value.trim() 
    };
    
    if(d.type === 'Teacher') { 
        d.name = document.getElementById('euName').value.trim();
        d.email = document.getElementById('euEmail').value.trim();
    }
    
    if(!d.pass) { Swal.fire("Warning", "Password cannot be empty!", "warning"); return; }
    
    showLoader(true, "UPDATING USER...");
    try {
        let res = await apiCall('updateUserDatabase', { info: d });
        showLoader(false); Swal.fire("Updated!", res.msg || res.message, "success"); 
        closeModal('editUserModal'); 
        loadUsers();
    } catch(err) { showLoader(false); Swal.fire("Error", err.message, "error"); }
}

function deleteUser(type, docId) { 
    Swal.fire({ title: 'Remove User Login?', text: "Data stays in database, only login access is removed.", icon: 'warning', showCancelButton: true, confirmButtonColor: '#ef4444', confirmButtonText: 'Yes, remove login!' }).then(async (result) => {
        if (result.isConfirmed) {
            showLoader(true, "REMOVING USER..."); 
            try {
                let res = await apiCall('deleteUser', { type: type, rowId: docId });
                showLoader(false); Swal.fire("Removed!", res.msg || res.message, "success"); loadUsers();
            } catch(err) { showLoader(false); Swal.fire("Error", err.message, "error"); }
        } 
    });
}

async function loadPosts() {
    if(!isAuthReady) return;
    showLoader(true, "FETCHING POSTS...<br><span style='font-size:11px; color:#64748b;'>Querying Database directly</span>");
    try {
        let snap = await db.collection('WebsitePosts').get();
        let posts = [];
        snap.forEach(doc => {
            let f = doc.data();
            posts.push({
                date: f.date || "", targetPage: f.targetPage || "", title: f.title || "",
                desc: f.desc || "", fileType: f.fileType || "", fileUrl: f.fileUrl || "",
                docId: doc.id, time: f.timestamp || 0
            });
        });
        
        posts.sort((a, b) => b.time - a.time);
        showLoader(false);
        
        var h = "<h3 style='margin-top:0; color:var(--primary); font-weight:900; text-transform:uppercase; font-size:18px;'><i class='fas fa-list-ul'></i> Website Posts Manager</h3>";
        
        if(posts.length === 0) h += "<p style='text-align:center; color:#94a3b8; padding:20px; font-weight:600;'>No posts available.</p>";
        
        posts.forEach(r => { 
            h += `<div class="list-item">
            <div style="flex:1;">
            <span style="background:var(--primary-light); color:var(--primary); padding:6px 14px; border-radius:8px; font-size:11px; font-weight:800; border:1px solid rgba(0, 95, 64, 0.1); letter-spacing:0.5px; text-transform:uppercase;">${r.targetPage}</span><br>
            <b style="font-size:15.5px; color:#0f172a; display:block; margin:10px 0 6px 0;">${r.title}</b>
            <small style="color:#64748b; font-weight: 600;"><i class="far fa-calendar-alt"></i> ${r.date}</small>
            </div>
            <button class="btn-delete" onclick="delPost('${r.docId}')"><i class="fas fa-trash"></i></button>
            </div>`; 
        });
        document.getElementById('postList').innerHTML = h;
    } catch(err) {
        showLoader(false); document.getElementById('postList').innerHTML = "<p style='color:red; text-align:center;'>Failed to load posts.</p>";
    }
}

async function loadUsers() {
    if(!isAuthReady) return;
    showLoader(true, "FETCHING USERS...<br><span style='font-size:11px; color:#64748b;'>Querying Database directly</span>");
    try {
        let users = [];
        
        let tSnap = await db.collection('Teachers').get();
        tSnap.forEach(doc => {
            let f = doc.data(); let name = f.name || "N/A"; let pass = f.pass || "123456";
            users.push({ type: "Teacher", id: f.phone || "", machineId: f.machineID || "", name: name, email: f.email || "N/A", pass: pass, info: `Name: ${name} <br> Email: ${f.email||""} <br> Pass: <span style='color:#e11d48; font-weight:600;'>${pass}</span>`, row: doc.id });
        });

        let sSnap = await db.collection('Students').get();
        sSnap.forEach(doc => {
            let f = doc.data(); let sid = f.studentID || ""; if(!sid) return; let pass = f.pass || "123456";
            users.push({ type: "Student", id: sid, machineId: f.machineID || "", name: f.name || "Student", classVal: f.class || "", roll: f.roll || "", email: f.email || "N/A", phone: f.phone || "N/A", pass: pass, info: `Name: ${f.name||""} <br> Pass: <span style='color:#e11d48; font-weight:600;'>${pass}</span>`, row: doc.id });
        });

        showLoader(false);
        globalUsersList = users; 
        renderUserList();
    } catch(err) {
        showLoader(false); document.getElementById('userListDisplay').innerHTML = "<p style='color:red; text-align:center;'>Failed to load users.</p>";
    }
}

function renderUserList() {
    var h = ""; var totalTeachers = 0; var totalStudents = 0; var classCounts = {}; 
    if(globalUsersList.length === 0) { h = "<p style='text-align:center; color:#94a3b8;'>No users found in database.</p>"; } 
    else {
        globalUsersList.forEach((u, index) => {
            if (u.type === 'Teacher') { totalTeachers++; } else if (u.type === 'Student') { totalStudents++; var cls = u.classVal || "Unknown"; classCounts[cls] = (classCounts[cls] || 0) + 1; }
            var icon = u.type === 'Teacher' ? '<i class="fas fa-chalkboard-teacher" style="color:var(--primary); font-size:24px;"></i>' : '<i class="fas fa-user-graduate" style="color:var(--warn); font-size:24px;"></i>';
            var bClr = u.type === 'Teacher' ? 'var(--primary-light)' : '#fef3c7';
            var tClr = u.type === 'Teacher' ? 'var(--primary)' : 'var(--warn)';
            var machineText = (u.machineId) ? ` | <i class="fas fa-fingerprint"></i> ${u.machineId}` : '';
            h += `<div class="list-item user-item" data-type="${u.type}" data-class="${u.classVal || ''}">
            <div style="display:flex; gap:18px; align-items:center;">
            <div style="width:55px; height:55px; border-radius:16px; background:#f8fafc; display:flex; align-items:center; justify-content:center; border: 2px solid #e2e8f0; box-shadow: inset 0 2px 5px rgba(0,0,0,0.02);">${icon}</div>
            <div>
            <span style="background:${bClr}; color:${tClr}; padding:5px 12px; border-radius:8px; font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:0.5px;">${u.type}</span><br>
            <b style="font-size:15px; color:#0f172a; display: inline-block; margin-top: 8px;">${u.id}${machineText}</b><br>
            <small style="color:#64748b; font-weight:500;">${u.info}</small>
            </div>
            </div>
            <div style="display:flex; flex-direction:column; gap:8px;">
            <button class="btn-edit" onclick="openEditUser(${index})"><i class="fas fa-edit"></i></button>
            <button class="btn-delete" onclick="deleteUser('${u.type}', '${u.row}')"><i class="fas fa-trash"></i></button>
            </div>
            </div>`;
        });
    }
    document.getElementById('userListDisplay').innerHTML = h;

    var statsHtml = `<div style="display:flex; justify-content:space-between; margin-bottom:20px; gap:20px;">
    <div style="background:linear-gradient(135deg, var(--primary), var(--primary-dark)); color:white; padding:25px; border-radius:20px; text-align:center; flex:1; box-shadow:0 10px 30px rgba(0, 95, 64, 0.25);">
    <b style="font-size:32px; font-weight:900;">${totalTeachers}</b><br><small style="opacity:0.9; font-weight:700; font-size: 12px; letter-spacing: 1px; text-transform: uppercase;">Total Teachers</small>
    </div>
    <div style="background:linear-gradient(135deg, #d97706, #92400e); color:white; padding:25px; border-radius:20px; text-align:center; flex:1; box-shadow:0 10px 30px rgba(217, 119, 6, 0.25);">
    <b style="font-size:32px; font-weight:900;">${totalStudents}</b><br><small style="opacity:0.9; font-weight:700; font-size: 12px; letter-spacing: 1px; text-transform: uppercase;">Active Students</small>
    </div>
    </div>`;
    if (totalStudents > 0) {
        statsHtml += `<div style="background:#ffffff; padding:20px; border-radius:20px; border:1px solid #e2e8f0; box-shadow: 0 5px 15px rgba(0,0,0,0.02);"><b style="color:var(--primary-dark); font-size:14px; text-transform:uppercase; letter-spacing:0.5px; font-weight:800;"><i class="fas fa-layer-group"></i> Class-wise Students:</b><br><div style="display:flex; flex-wrap:wrap; gap:12px; margin-top:15px;">`;
        for (var cls in classCounts) { statsHtml += `<span style="background:#f8fafc; color:#475569; padding:10px 16px; border-radius:12px; border:1px solid #e2e8f0; font-size:13.5px; font-weight:700; box-shadow:0 2px 8px rgba(0,0,0,0.03);">Class ${cls}: <b style="color:var(--primary); font-size: 16px; margin-left: 6px;">${classCounts[cls]}</b></span>`; }
        statsHtml += `</div></div>`;
    }
    document.getElementById('userStatsDisplay').innerHTML = statsHtml;
    filterUsers();
}

function filterUsers() {
    var textFilter = document.getElementById('searchUserList').value.toLowerCase();
    var classFilter = document.getElementById('filterClass').value;
    var items = document.querySelectorAll('.user-item');
    items.forEach(item => { 
        var text = item.innerText.toLowerCase(); 
        var type = item.getAttribute('data-type');
        var cls = item.getAttribute('data-class');
        var textMatch = text.includes(textFilter);
        var classMatch = true;
        if (classFilter === 'Teacher') { classMatch = (type === 'Teacher'); } 
        else if (classFilter !== 'All') {
            if (type === 'Student') { classMatch = (String(cls).toLowerCase() === String(classFilter).toLowerCase() || String(cls).toLowerCase().replace('class ','') === String(classFilter).toLowerCase().replace('class ','')); } 
            else { classMatch = false; }
        }
        item.style.display = (textMatch && classMatch) ? "flex" : "none"; 
    });
}

function closeModal(id) { document.getElementById(id).style.display = "none"; }

function openEditUser(index) {
    var u = globalUsersList[index];
    
    document.getElementById('euRow').value = u.row; 
    document.getElementById('euType').value = u.type; 
    document.getElementById('euId').value = u.id; 
    document.getElementById('euName').value = u.name; 
    document.getElementById('euPass').value = u.pass; 
    document.getElementById('euMachineId').value = u.machineId || "";
    
    if(u.type === 'Teacher') { 
        document.getElementById('euTeacherEmailDiv').style.display = "block"; 
        document.getElementById('euEmail').value = u.email; 
        document.getElementById('euEmail').disabled = false;
        
        document.getElementById('euName').disabled = false; 
        document.getElementById('euName').style.background = "#fff"; 
        document.getElementById('euName').style.color = "var(--primary-dark)"; 
        
        document.getElementById('euPhoneDiv').style.display = "none";
    } else { 
        document.getElementById('euTeacherEmailDiv').style.display = "block";
        document.getElementById('euEmail').value = u.email;
        document.getElementById('euEmail').disabled = true;
        
        document.getElementById('euName').disabled = true; 
        document.getElementById('euName').style.background = "#f1f5f9"; 
        document.getElementById('euName').style.color = "#94a3b8";
        
        document.getElementById('euPhoneDiv').style.display = "block";
        document.getElementById('euPhone').value = u.phone;
    }
    
    document.getElementById('editUserModal').style.display = "flex";
}
</script>
</body>
</html>
