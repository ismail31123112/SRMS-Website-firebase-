// ============================================================================
// 📡 ULTRA-RELIABLE API ENGINE WITH AUTO-RETRY (ZERO FALSE ERRORS)
// ============================================================================
async function apiCall(actionName, payloadData = {}) {
  let token = "";
  if (auth.currentUser) {
    try {
      token = await auth.currentUser.getIdToken(false);
    } catch (tErr) {
      try { token = await auth.currentUser.getIdToken(true); } catch (e) {}
    }
  }
  let payload = {
    action: actionName,
    token: token,
    adminKey: SRMS_ADMIN_PASSKEY,
    ...payloadData
  };

  let lastErr = null;
  for (let attempt = 1; attempt <= 2; attempt++) {
    try {
      let res = await fetch(SCRIPT_URL, {
        method: 'POST',
        body: JSON.stringify(payload),
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        redirect: 'follow'
      });
      let text = await res.text();
      if (text.includes("<html") || text.includes("<!DOCTYPE")) {
        throw new Error("Deployment Access Error! Make sure Apps Script Web App is deployed with 'Who has access: Anyone'.");
      }

      let data = JSON.parse(text);
      if (data.error) throw new Error(data.error);
      if (data.status === "error") throw new Error(data.message || data.msg);
      return data;
    } catch (err) {
      lastErr = err;
      // পোস্ট পাবলিশে যদি নেটওয়ার্ক ড্রপ হয়, তবে ডুপ্লিকেট পোস্ট না করে ডাটাবেস চেক করবে
      if (actionName === 'uploadData' && payloadData.data && payloadData.data.title) {
        try {
          let checkSnap = await db.collection('WebsitePosts')
            .where('title', '==', payloadData.data.title)
            .get();
          if (!checkSnap.empty) {
            return {
              status: "success",
              msg: "✅ Post Published & Official Push Notification Sent!"
            };
          }
        } catch (verifyErr) {}
      }
      if (attempt < 2) {
        await new Promise(r => setTimeout(r, 350));
      }
    }
  }
  throw lastErr;
}

