async function loadPosts(showSpinner = true, silent = false) {
  if (!isAuthReady) return;
  if (showSpinner && !silent) {
    showLoader(true, "LOADING POSTS...");
  }
  try {
    let snap = await db.collection('WebsitePosts').get();
    let posts = [];
    snap.forEach(doc => {
      let f = doc.data();
      posts.push({
        date: f.date || "",
        targetPage: f.targetPage || "",
        title: f.title || "",
        desc: f.desc || "",
        fileType: f.fileType || "None",
        fileUrl: f.fileUrl || "",
        thumbUrl: f.thumbUrl || f.fileUrl || "",
        driveFileId: f.driveFileId || "",
        imgbbId: f.imgbbId || "",
        imgbbDeleteUrl: f.imgbbDeleteUrl || "",
        docId: doc.id,
        time: parseInt(f.timestamp || 0, 10)
      });
    });

    posts.sort((a, b) => b.time - a.time);
    globalPostsList = posts;
    postsLoadedOnce = true;

    if (showSpinner && !silent) showLoader(false);
    renderPostsList();
  } catch (err) {
    if (showSpinner && !silent) showLoader(false);
    if (!postsLoadedOnce) {
      document.getElementById('postList').innerHTML = "<p style='color:red; text-align:center;'>Failed to load posts.</p>";
    }
  }
}

function renderPostsList() {
  var h = `<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
    <h3 style="margin:0; color:var(--primary); font-weight:800; text-transform:uppercase; font-size:17px;">
      <i class="fas fa-list-ul"></i> Website Posts (${globalPostsList.length})
    </h3>
    <button onclick="loadPosts(true, false)" style="background:var(--primary-light); color:var(--primary); border:1px solid #a7f3d0; padding:6px 12px; border-radius:20px; font-size:12px; font-weight:700; cursor:pointer;">
      <i class="fas fa-sync-alt"></i> Refresh
    </button>
  </div>`;

  if (globalPostsList.length === 0) {
    h += "<p style='text-align:center; color:#94a3b8; padding:20px; font-weight:600;'>No posts available.</p>";
  }

  globalPostsList.forEach(r => {
    var thumbHtml = "";
    if (r.fileType === "Image" && (r.thumbUrl || r.fileUrl)) {
      thumbHtml = `<img src="${r.thumbUrl || r.fileUrl}" loading="lazy" style="width:52px; height:52px; object-fit:cover; border-radius:10px; border:1px solid #cbd5e1; flex-shrink:0;" onerror="this.style.display='none'">`;
    } else if (r.fileType === "PDF" || r.fileType === "Document") {
      thumbHtml = `<div style="width:52px; height:52px; border-radius:10px; background:#fef2f2; border:1px solid #fecaca; display:flex; align-items:center; justify-content:center; color:#ef4444; font-size:22px; flex-shrink:0;"><i class="fas fa-file-pdf"></i></div>`;
    }
    var serverBadge = (r.fileUrl && r.fileUrl.includes("ibb.co"))
      ? `<span style="background:#dbeafe; color:#1d4ed8; padding:2px 7px; border-radius:5px; font-size:9.5px; font-weight:800; margin-left:5px;">ImgBB</span>`
      : (r.fileUrl && r.fileUrl.includes("drive.google.com"))
      ? `<span style="background:#fef3c7; color:#b45309; padding:2px 7px; border-radius:5px; font-size:9.5px; font-weight:800; margin-left:5px;">Drive PDF</span>`
      : "";
    h += `<div class="list-item">
      <div style="display:flex; gap:12px; align-items:center; flex:1;">
        ${thumbHtml}
        <div>
          <span style="background:var(--primary-light); color:var(--primary); padding:4px 10px; border-radius:6px; font-size:10.5px; font-weight:800; text-transform:uppercase;">${r.targetPage}</span>
          <span style="font-size:11px; color:#64748b; margin-left:6px; font-weight:600;">• ${r.fileType}</span>${serverBadge}
          <b style="font-size:15px; color:#0f172a; display:block; margin:6px 0 4px 0;">${r.title}</b>
          <small style="color:#64748b; font-weight:600;"><i class="far fa-calendar-alt"></i> ${r.date}</small>
        </div>
      </div>
      <button class="btn-delete" onclick="delPost('${r.docId}')"><i class="fas fa-trash"></i> Delete</button>
    </div>`;
  });
  document.getElementById('postList').innerHTML = h;
}
