<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SRMS Manager V20 Ultra</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
if (window.history.replaceState) {
  var cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
  window.history.replaceState({path: cleanUrl}, '', cleanUrl);
}
</script>

<style>
:root {
  --primary: #005f40;
  --primary-light: #ecfdf5;
  --primary-dark: #003d29;
  --bg: #f1f5f9;
  --danger: #ef4444;
  --warn: #f59e0b;
  --edit: #2563eb;
  --guardian: #7c3aed;
  --guardian-light: #f3e8ff;
  --gold: #f59e0b;
  --surface: #ffffff;
}
* { box-sizing: border-box; }
body {
  font-family: 'Poppins', sans-serif;
  background: var(--bg);
  margin: 0;
  padding-bottom: 105px;
  color: #0f172a;
}

/* Header */
.header {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(14px);
  padding: 12px 22px;
  box-shadow: 0 4px 25px rgba(0, 95, 64, 0.08);
  display: flex;
  align-items: center;
  gap: 12px;
  position: sticky;
  top: 0;
  z-index: 50;
  border-bottom: 1px solid rgba(0, 95, 64, 0.12);
}
.header img {
  height: 44px;
  width: 44px;
  object-fit: cover;
  border-radius: 50%;
  border: 2px solid var(--gold);
  padding: 2px;
  background: white;
}
.header-title-wrap h2 {
  font-size: 16px;
  color: var(--primary);
  margin: 0;
  font-weight: 800;
  letter-spacing: 0.3px;
}
.header-title-wrap span {
  font-size: 10.5px;
  background: var(--primary-light);
  color: var(--primary);
  padding: 2px 8px;
  border-radius: 20px;
  font-weight: 700;
}
.btn-back {
  margin-left: auto;
  background: var(--surface);
  color: var(--primary);
  border: 1.5px solid #cbd5e1;
  padding: 8px 16px;
  border-radius: 30px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.25s ease;
  display: flex;
  align-items: center;
  gap: 6px;
}
.btn-back:hover {
  background: var(--primary);
  color: white;
  border-color: var(--primary);
  transform: translateY(-1px);
}

/* Containers & Cards */
.container {
  display: none;
  padding: 22px 16px;
  max-width: 720px;
  margin: auto;
  animation: fadeInUp 0.4s ease;
}
.container.active { display: block; }
.card {
  background: var(--surface);
  border-radius: 22px;
  padding: 26px 22px;
  box-shadow: 0 10px 35px rgba(15, 23, 42, 0.05);
  margin-bottom: 24px;
  border: 1px solid rgba(226, 232, 240, 0.9);
  position: relative;
}

/* Typography & Forms */
label {
  display: block;
  font-size: 13px;
  font-weight: 700;
  color: #334155;
  margin-top: 16px;
  margin-bottom: 7px;
}
input, select, textarea {
  width: 100%;
  padding: 13px 16px;
  border: 2px solid #e2e8f0;
  border-radius: 13px;
  font-family: inherit;
  font-size: 14px;
  transition: 0.25s;
  color: #0f172a;
  background: #f8fafc;
  font-weight: 500;
}
input[type="file"] {
  padding: 10px;
  background: #fff;
  border: 2px dashed var(--primary);
  cursor: pointer;
}
input:focus, select:focus, textarea:focus {
  border-color: var(--primary);
  background: #fff;
  outline: none;
  box-shadow: 0 0 0 4px rgba(0, 95, 64, 0.1);
}
input:disabled {
  background: #f1f5f9 !important;
  color: #64748b !important;
  cursor: not-allowed;
  border-color: #e2e8f0;
}

/* Image Preview Box */
.preview-box {
  display: none;
  margin-top: 12px;
  padding: 12px;
  border-radius: 14px;
  background: #f0fdf4;
  border: 1.5px solid #bbf7d0;
  align-items: center;
  gap: 14px;
}
.preview-box img {
  width: 68px;
  height: 68px;
  object-fit: cover;
  border-radius: 10px;
  border: 2px solid var(--primary);
  background: #fff;
}
.preview-info {
  flex: 1;
  font-size: 12px;
  color: #166534;
  font-weight: 600;
}

/* Buttons */
.btn-submit {
  width: 100%;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: white;
  padding: 15px;
  border: none;
  border-radius: 15px;
  font-weight: 800;
  cursor: pointer;
  margin-top: 22px;
  transition: all 0.25s ease;
  font-size: 14.5px;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  box-shadow: 0 8px 22px rgba(0, 95, 64, 0.28);
}
.btn-submit:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(0, 95, 64, 0.38);
}
.btn-delete {
  background: #fef2f2;
  color: var(--danger);
  border: 1px solid #fecaca;
  padding: 9px 13px;
  border-radius: 11px;
  cursor: pointer;
  font-size: 12.5px;
  font-weight: 700;
  transition: 0.25s;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
}
.btn-delete:hover {
  background: var(--danger);
  color: white;
}
.btn-edit {
  background: #eff6ff;
  color: var(--edit);
  border: 1px solid #bfdbfe;
  padding: 9px 14px;
  border-radius: 11px;
  cursor: pointer;
  font-size: 12.5px;
  font-weight: 700;
  transition: 0.25s;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}
.btn-edit:hover {
  background: var(--edit);
  color: white;
}

/* Stats Grid */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 18px;
}
.stat-box {
  padding: 18px 12px;
  border-radius: 18px;
  color: white;
  text-align: center;
  box-shadow: 0 8px 20px rgba(0,0,0,0.08);
}
.stat-box b {
  font-size: 26px;
  font-weight: 900;
  display: block;
  line-height: 1.1;
}
.stat-box small {
  font-size: 10.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  opacity: 0.92;
}

/* Filter Bar */
.filter-container {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 20px;
  background: #f8fafc;
  padding: 12px;
  border-radius: 18px;
  border: 1px solid #e2e8f0;
}
.search-wrapper {
  position: relative;
  flex: 1 1 220px;
}
.search-wrapper i {
  position: absolute;
  left: 15px;
  top: 50%;
  transform: translateY(-50%);
  color: #94a3b8;
  font-size: 14px;
}
.search-wrapper input {
  padding-left: 40px;
  margin: 0;
  border-radius: 25px;
  background: white;
  height: 44px;
}
.filter-wrapper {
  flex: 1 1 150px;
}
.filter-wrapper select {
  margin: 0;
  border-radius: 25px;
  background: white;
  height: 44px;
  padding: 0 16px;
  cursor: pointer;
  font-weight: 700;
  color: #334155;
}

/* List Items */
.list-item {
  padding: 18px;
  border: 1.5px solid #e2e8f0;
  border-radius: 18px;
  margin-bottom: 14px;
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  transition: 0.25s;
}
.list-item:hover {
  box-shadow: 0 8px 25px rgba(0, 95, 64, 0.08);
  border-color: #cbd5e1;
}

/* Policy Notice Banner */
.policy-banner {
  background: #eff6ff;
  border-left: 5px solid var(--edit);
  padding: 12px 15px;
  border-radius: 12px;
  font-size: 12px;
  color: #1e3a8a;
  font-weight: 600;
  margin-bottom: 18px;
  line-height: 1.5;
}

/* Read-only Summary Box inside Modal */
.readonly-summary {
  background: #f8fafc;
  border: 1.5px solid #e2e8f0;
  border-radius: 14px;
  padding: 14px 16px;
  margin-top: 12px;
  margin-bottom: 14px;
  font-size: 13px;
  line-height: 1.7;
  color: #334155;
}
.readonly-summary div {
  display: flex;
  justify-content: space-between;
  border-bottom: 1px dashed #e2e8f0;
  padding: 4px 0;
}
.readonly-summary div:last-child {
  border-bottom: none;
}

/* Bottom Navigation */
.bottom-nav {
  position: fixed;
  bottom: 0;
  width: 100%;
  background: rgba(255,255,255,0.96);
  backdrop-filter: blur(15px);
  display: flex;
  box-shadow: 0 -5px 25px rgba(0, 95, 64, 0.08);
  z-index: 100;
  border-top: 1px solid #e2e8f0;
  border-radius: 22px 22px 0 0;
  padding: 4px 0;
}
.nav-item {
  flex: 1;
  text-align: center;
  color: #94a3b8;
  border: none;
  background: none;
  font-size: 11.5px;
  padding: 10px 4px;
  cursor: pointer;
  transition: 0.3s;
  font-weight: 700;
}
.nav-item i {
  display: block;
  font-size: 20px;
  margin-bottom: 4px;
  transition: 0.3s;
}
.nav-item.active {
  color: var(--primary);
  font-weight: 800;
}
.nav-item.active i {
  transform: translateY(-3px) scale(1.1);
  color: var(--primary);
}

/* Modal & Loader */
.modal {
  display: none;
  position: fixed;
  z-index: 1000;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(15, 23, 42, 0.65);
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(5px);
  padding: 15px;
}
.modal-content {
  background-color: #fff;
  margin: auto;
  padding: 30px 24px;
  border-radius: 24px;
  width: 100%;
  max-width: 440px;
  position: relative;
  animation: zoomIn 0.3s ease;
  box-shadow: 0 25px 50px rgba(0,0,0,0.25);
  border-top: 7px solid var(--primary);
  max-height: 90vh;
  overflow-y: auto;
}
#loader {
  display: flex;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(255,255,255,0.95);
  z-index: 9999;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8px);
}
.spinner {
  width: 54px;
  height: 54px;
  border: 5px solid #e2e8f0;
  border-top: 5px solid var(--primary);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
@keyframes fadeInUp { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
@keyframes zoomIn { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.close {
  position: absolute;
  top: 16px;
  right: 20px;
  color: #94a3b8;
  font-size: 26px;
  font-weight: bold;
  cursor: pointer;
  line-height: 1;
}
.close:hover { color: var(--danger); }

@media (max-width: 500px) {
  .stats-grid { grid-template-columns: 1fr; }
  .list-item { flex-direction: column; align-items: flex-start; }
  .list-actions { width: 100%; display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px; }
}
</style>
</head>
<body>

<!-- 🛑 Security Gate & Processing Loader -->
<div id="loader">
  <div class="spinner"></div>
  <p id="loaderText" style="margin-top:18px; font-size:14px; font-weight:800; color:var(--primary); letter-spacing:0.8px; text-align:center;">
    SECURITY CHECK...<br><span style="font-size:11px; color:#64748b;">Verifying Admin Session</span>
  </p>
</div>

<!-- 🔐 Fallback Admin Login Modal (if session expired or opened directly) -->
<div id="adminLoginModal" class="modal">
  <div class="modal-content" style="text-align:left;">
    <h3 style="text-align:center; color:var(--primary); margin-top:0; font-weight:900; font-size:19px;">
      <i class="fas fa-shield-alt"></i> Admin Authentication
    </h3>
    <p style="font-size:12px; color:#64748b; text-align:center; margin-bottom:18px;">
      Sign in with your SRMS Admin credentials to access Manager V20.
    </p>
    <label>Admin Email</label>
    <input type="email" id="admEmail" value="admin@srms.edu.bd" placeholder="admin@srms.edu.bd">
    <label>Admin Password</label>
    <input type="password" id="admPass" placeholder="Enter Admin Password">
    <button class="btn-submit" onclick="performAdminLogin()">
      <i class="fas fa-lock-open"></i> Login to Manager
    </button>
    <button onclick="redirectToMainLogin()" style="width:100%; background:#f1f5f9; color:#475569; border:none; padding:11px; border-radius:12px; font-weight:700; margin-top:10px; cursor:pointer; font-size:12px;">
      <i class="fas fa-arrow-left"></i> Go to Main Login Portal
    </button>
  </div>
</div>

<!-- ================= MAIN APPLICATION ================= -->
<div id="appContainer" style="display:none;">
  <div class="header">
    <img src="https://i.postimg.cc/9FxBsqsj/IMG-20251220-WA0006.jpg" alt="SRMS Logo">
    <div class="header-title-wrap">
      <h2>SRMS Manager</h2>
      <span>V20 ULTRA FINAL</span>
    </div>
    <button class="btn-back" onclick="window.close();" title="Back to Dashboard">
      <i class="fas fa-sign-out-alt"></i> Dashboard
    </button>
  </div>

  <!-- ================= 1. POST / UPLOAD TAB ================= -->
  <div id="upload" class="container active">
    <!-- Scrolling Headline Card -->
    <div class="card" style="border-left: 7px solid var(--warn); background: linear-gradient(145deg, #ffffff, #fffbeb);">
      <label style="margin-top:0; color: #b45309; font-weight:800; font-size: 14px; text-transform:uppercase;">
        <i class="fas fa-bullhorn"></i> Scrolling Headline Notice
      </label>
      <div style="display:flex; gap:10px; margin-top:12px;">
        <input type="text" id="hText" placeholder="Write urgent scrolling headline here..." style="margin-top:0; border-color: #fde68a;">
        <button onclick="pubHead()" style="background:linear-gradient(135deg, #f59e0b, #d97706); color:white; border:none; padding:0 24px; border-radius:12px; cursor:pointer; box-shadow: 0 4px 12px rgba(217, 119, 6, 0.3);">
          <i class="fas fa-paper-plane" style="font-size: 17px;"></i>
        </button>
      </div>
    </div>

    <!-- Website Content & Photo/File Publisher -->
    <div class="card">
      <h3 style="margin-top:0; color:var(--primary); font-weight:800; font-size:17px;">
        <i class="fas fa-cloud-upload-alt"></i> Publish Website Content & Photos
      </h3>

      <label><i class="fas fa-bullseye" style="color:var(--primary); margin-right:5px;"></i> Target Page / Section</label>
      <select id="upCat" onchange="updateTitleLabel(this)">
        <optgroup label="General">
          <option value="Notice">Notice Board</option>
          <option value="HomeSlide">Home Slide Show</option>
          <option value="HomeVideo">Home Video</option>
          <option value="TeacherDashboard">Teacher Dashboard</option>
        </optgroup>
        <optgroup label="Website & Administration" id="adminOnlyUploads">
          <option value="GoverningBody">Governing Body</option>
          <option value="PresidentMessage">Message of President</option>
          <option value="VPMessage">Message of Vice President</option>
          <option value="HeadmasterMessage">Message of Headmaster</option>
          <option value="Facilities">Facilities</option>
          <option value="News">News</option>
          <option value="Teachers">Teacher List</option>
          <option value="Admission">Admission Info</option>
          <option value="Routine">Routine</option>
          <option value="Syllabus">Syllabus</option>
          <option value="Exam">Exam Routine</option>
          <option value="Gallery">Gallery</option>
        </optgroup>
        <optgroup label="Class Dashboards">
          <option value="ClassPlay">Class Play</option>
          <option value="ClassNursery">Class Nursery</option>
          <option value="ClassKG">Class KG</option>
          <option value="Class1">Class 1</option>
          <option value="Class2">Class 2</option>
          <option value="Class3">Class 3</option>
          <option value="Class4">Class 4</option>
          <option value="Class5">Class 5</option>
          <option value="Class6">Class 6</option>
          <option value="Class7">Class 7</option>
          <option value="Class8">Class 8</option>
          <option value="Class9">Class 9</option>
          <option value="Class10">Class 10</option>
        </optgroup>
      </select>

      <label id="titleLabel"><i class="fas fa-heading" style="color:var(--primary); margin-right:5px;"></i> Title for Notice Board</label>
      <input type="text" id="upTitle" placeholder="Enter post title, caption, or name" required>

      <label><i class="fas fa-align-left" style="color:var(--primary); margin-right:5px;"></i> Description / Message Body</label>
      <textarea id="upDesc" rows="4" placeholder="Write description or full message here..."></textarea>

      <label><i class="fas fa-camera" style="color:var(--primary); margin-right:5px;"></i> Upload Photo / PDF / Document (Auto-Optimized)</label>
      <input type="file" id="upFile" accept="image/*,application/pdf,.doc,.docx,.xls,.xlsx" onchange="handleFilePreview(this)">

      <!-- Live Photo/File Preview -->
      <div id="filePreviewBox" class="preview-box">
        <img id="previewImg" src="" alt="Preview">
        <div class="preview-info" id="previewMeta">Ready to upload</div>
        <button type="button" class="btn-delete" onclick="clearSelectedFile()" title="Remove file">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <label><i class="fas fa-link" style="color:var(--primary); margin-right:5px;"></i> Or Paste External / Google Drive Link (Optional)</label>
      <input type="url" id="upLink" placeholder="https://drive.google.com/... or direct link">

      <button class="btn-submit" onclick="submitUpload()">
        <i class="fas fa-rocket" style="margin-right: 6px;"></i> Publish Content Now
      </button>
    </div>
  </div>

  <!-- ================= 2. USERS TAB ================= -->
  <div id="users" class="container">
    <!-- User Statistics Card (Teachers, Students & Guardians) -->
    <div class="card">
      <h3 style="margin-top:0; color:var(--primary); font-weight:800; text-transform: uppercase; font-size:16.5px;">
        <i class="fas fa-chart-pie"></i> User & Guardian Statistics
      </h3>
      <div id="userStatsDisplay">
        <div style="text-align:center; padding:15px; color:#64748b;">
          <i class="fas fa-circle-notch fa-spin"></i> Loading statistics...
        </div>
      </div>
    </div>

    <!-- Setup Teacher Account ONLY -->
    <div class="card">
      <h3 style="margin-top:0; color:var(--primary); font-weight:800; text-transform: uppercase; font-size:16.5px;">
        <i class="fas fa-chalkboard-teacher"></i> Setup Teacher Account
      </h3>
      <div class="policy-banner">
        <i class="fas fa-info-circle"></i> <b>সিস্টেম পলিসি:</b> এখান থেকে শুধুমাত্র <b>Teacher Account</b> তৈরি করা যাবে। <b>Student</b> এবং <b>Guardian</b> অ্যাকাউন্ট Admission Panel থেকে স্বয়ংক্রিয়ভাবে যুক্ত হয় এবং নিচে তাদের শুধুমাত্র <b>Password</b> পরিবর্তন করা যাবে।
      </div>

      <label>Teacher Phone Number (Login ID) *</label>
      <input type="tel" id="uTPhone" placeholder="017XXXXXXXX">

      <label>Machine / Biometric ID</label>
      <input type="text" id="uTMachineId" placeholder="Blank = Same as Phone Number">

      <label>Teacher Full Name *</label>
      <input type="text" id="uTName" placeholder="Enter Teacher Full Name">

      <label>Email Address (Optional)</label>
      <input type="email" id="uTEmail" placeholder="teacher@email.com">

      <label style="color:#b45309; font-weight:800;">
        <i class="fas fa-id-card"></i> RFID Card Number <small style="color:#64748b;">(Type or Scan for Attendance Machine)</small>
      </label>
      <input type="text" id="uCardNumber" placeholder="Scan or Enter RFID Card Number" style="border-color: var(--gold); background:#fffbeb;">

      <label>Login Password (Min 6 Characters)</label>
      <input type="text" id="uPass" placeholder="Default: 123456">

      <button class="btn-submit" id="accBtn" onclick="addUser()">
        <i class="fas fa-user-plus" style="margin-right: 6px;"></i> Save Teacher Account
      </button>
    </div>

    <!-- Manage All Logins (Teachers, Students, Guardians) -->
    <div class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:14px;">
        <h3 style="margin:0; color:var(--primary); font-weight:800; text-transform: uppercase; font-size:16.5px;">
          <i class="fas fa-users-cog"></i> Manage Logins (Teacher / Student / Guardian)
        </h3>
        <button onclick="loadUsers()" style="background:var(--primary-light); color:var(--primary); border:1px solid #a7f3d0; padding:6px 12px; border-radius:20px; font-size:12px; font-weight:700; cursor:pointer;">
          <i class="fas fa-sync-alt"></i> Refresh
        </button>
      </div>

      <div class="filter-container">
        <div class="search-wrapper">
          <i class="fas fa-search"></i>
          <input type="text" id="searchUserList" placeholder="Search Name, Student ID, or Guardian Phone..." onkeyup="filterUsers()">
        </div>
        <div class="filter-wrapper">
          <select id="filterClass" onchange="filterUsers()">
            <option value="All">All Users (Everyone)</option>
            <option value="Teacher">👨‍🏫 Teachers Only</option>
            <option value="Student">🎓 Students Only</option>
            <option value="Guardian">👪 Guardians Only</option>
            <optgroup label="Filter by Class (Student & Guardian)">
              <option value="Play">Class Play</option>
              <option value="Nursery">Class Nursery</option>
