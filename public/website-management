async function loadUsers(showSpinner = true, silent = false) {
  if (!isAuthReady) return;
  if (showSpinner && !silent) {
    showLoader(true, "ব্যবহারকারীর তালিকা লোড হচ্ছে...");
  }
  try {
    let users = [];

    let [tSnap, sSnap] = await Promise.all([
      db.collection('Teachers').get(),
      db.collection('Students').get()
    ]);

    tSnap.forEach(doc => {
      let f = doc.data();
      let name = f.name || "N/A";
      let pass = f.pass || "123456";
      let phoneId = f.phone || "";
      let tPhoto = extractUserPhoto(f);

      users.push({
        type: "Teacher",
        id: phoneId,
        machineId: f.machineID || "",
        cardNumber: f.cardNumber || "",
        name: name,
        email: f.email || "",
        pass: pass,
        photoUrl: tPhoto,
        row: doc.id,
        infoHtml: `Name: <b>${name}</b> | Email: ${f.email || "N/A"}<br>Password: <span style="color:#e11d48; font-weight:700;">${pass}</span>`
      });
    });

    sSnap.forEach(doc => {
      let f = doc.data();
      let sid = (f.studentID || "").toString().trim();
      if (!sid) return;

      let sName = f.name || "Student";
      let sClass = f.class || "N/A";
      let sRoll = f.roll || "N/A";
      let sPhone = (f.phone || "").toString().trim();
      let pass = f.pass || "123456";
      let sPhoto = extractUserPhoto(f);
      let gPhoto = (f.guardianPhoto || f.fatherPhoto || sPhoto || "").toString().trim();

      users.push({
        type: "Student",
        id: sid,
        studentID: sid,
        machineId: f.machineID || "",
        name: sName,
        classVal: sClass,
        roll: sRoll,
        phone: sPhone,
        email: f.email || "",
        pass: pass,
        photoUrl: sPhoto,
        row: doc.id,
        infoHtml: `Student: <b>${sName}</b> (Class: ${sClass}, Roll: ${sRoll})<br>Guardian Phone: ${sPhone || "N/A"} | Pass: <span style="color:#e11d48; font-weight:700;">${pass}</span>`
      });

      if (sPhone) {
        users.push({
          type: "Guardian",
          id: sPhone,
          studentID: sid,
          machineId: "",
          name: "Guardian of " + sName,
          studentName: sName,
          classVal: sClass,
          roll: sRoll,
          phone: sPhone,
          email: f.email || "",
          pass: pass,
          photoUrl: gPhoto,
          row: doc.id,
          infoHtml: `Guardian Login ID: <b>${sPhone}</b><br>Student: <b>${sName}</b> (ID: ${sid} • Class: ${sClass})<br>Password: <span style="color:#e11d48; font-weight:700;">${pass}</span>`
        });
      }
    });

    usersLoadedOnce = true;
    globalUsersList = users;
    if (showSpinner && !silent) showLoader(false);
    renderUserList();
  } catch (err) {
    if (showSpinner && !silent) showLoader(false);
    if (!usersLoadedOnce) {
      document.getElementById('userListDisplay').innerHTML =
        `<p style="color:red; text-align:center;">তালিকা লোড করা যায়নি: ${err.message}</p>`;
    }
  }
}

