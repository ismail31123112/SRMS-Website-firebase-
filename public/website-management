      try {
        db.collection('WebsitePosts').doc(docId).delete().catch(() => {});
      } catch (e) {}

      try {
        await apiCall('deletePost', {
          docId: docId,
          meta: {
            fileUrl: postObj.fileUrl || "",
            fileType: postObj.fileType || "",
            driveFileId: postObj.driveFileId || "",
            imgbbDeleteUrl: postObj.imgbbDeleteUrl || "",
            imgbbId: postObj.imgbbId || ""
          }
        });
      } catch (err) {
        console.warn("Background cleanup completed via SDK:", err);
      }
    }
  });
}

