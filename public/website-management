        title: title,
        desc: desc,
        fileType: res.fileType || "File",
        fileUrl: res.fileUrl || "",
        thumbUrl: res.thumbUrl || "",
        imgbbId: res.imgbbId || "",
        imgbbDeleteUrl: res.imgbbDeleteUrl || "",
