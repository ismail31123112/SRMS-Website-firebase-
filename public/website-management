// ============================================================================
// 📡 FAST API COMMUNICATION ENGINE
// ============================================================================
async function apiCall(actionName, payloadData = {}) {
  let token = "";
  if (auth.currentUser) {
    try {
      token = await auth.currentUser.getIdToken(false);
    } catch (tErr) {
      try { token = await auth.currentUser.getIdToken(true); } catch (e) {}
    }
  }
  let payload = {
    action: actionName,
    token: token,
    adminKey: SRMS_ADMIN_PASSKEY,
    ...payloadData
  };

  let res = await fetch(SCRIPT_URL, {
    method: 'POST',
    body: JSON.stringify(payload),
    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
    redirect: 'follow'
  });
  let text = await res.text();
  if (text.includes("<html") || text.includes("<!DOCTYPE")) {
    throw new Error("সার্ভার সংযোগে ত্রুটি হয়েছে। অনুগ্রহ করে পেজটি রিফ্রেশ করে আবার চেষ্টা করুন।");
  }

  let data = JSON.parse(text);
  if (data.error) throw new Error(data.error);
  if (data.status === "error") throw new Error(data.message || data.msg);
  return data;
}

