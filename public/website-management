.nav-item { flex: 1; min-width: 60px; text-align: center; color: #94a3b8; border: none; background: none; font-size: 11.5px; padding: 12px 2px; cursor: pointer; white-space: nowrap; transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); font-weight: 700;}
.nav-item i { display: block; font-size: 22px; margin-bottom: 6px; transition: 0.4s;}
.nav-item.active { color: var(--primary); font-weight: 800; }
