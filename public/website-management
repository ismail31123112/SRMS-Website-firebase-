      var finalThumb = data.thumbUrl || finalFileUrl;

      await db.collection('WebsitePosts').doc(clientDocId).set({
        title: title,
        desc: desc,
        targetPage: cat,
        fileUrl: finalFileUrl,
        fileType: finalFileType,
        thumbUrl: finalThumb,
        imgbbId: data.imgbbId || "",
        imgbbDeleteUrl: data.imgbbDeleteUrl || "",
        driveFileId: "",
        date: dateStr,
        timestamp: nowTs,
        notificationSent: "Delivered"
      });

      data.skipFirestoreWrite = true;
      showLoader(false);

      globalPostsList.unshift({
        docId: clientDocId,
        date: dateStr,
        targetPage: cat,
        title: title,
        desc: desc,
        fileType: finalFileType,
        fileUrl: finalFileUrl,
        thumbUrl: finalThumb,
        imgbbId: data.imgbbId || "",
        imgbbDeleteUrl: data.imgbbDeleteUrl || "",
        driveFileId: "",
        time: nowTs
      });
      renderPostsList();

      document.getElementById('upTitle').value = "";
      document.getElementById('upDesc').value = "";
      document.getElementById('upLink').value = "";
      clearSelectedFile();

      Toast.fire({
        icon: 'success',
        title: 'সফলভাবে ওয়েবসাইটে প্রকাশিত হয়েছে!'
      });

      // ব্যাকগ্রাউন্ডে পুশ নোটিফিকেশন প্রেরণ (ইউজারকে বিন্দুমাত্র অপেক্ষা করানো হবে না)
      apiCall('uploadData', { data: data }).catch(() => {});
    } else {
      // শুধুমাত্র বড় PDF বা Word ডকুমেন্ট হলে ব্যাকএন্ডের মাধ্যমে আপলোড হবে
