async function submitUserEdit() {
  var index = parseInt(document.getElementById('euIndex').value, 10);
  var u = globalUsersList[index] || {};
  var row = document.getElementById('euRow').value;
  var type = document.getElementById('euType').value;
  var oldId = document.getElementById('euOldId').value;
  var oldEmail = document.getElementById('euOldEmail').value;
  var oldCard = document.getElementById('euOldCard').value;
  var pass = document.getElementById('euPass').value.trim();

  if (!pass || pass.length < 6) {
    Swal.fire("পাসওয়ার্ড ত্রুটি", "পাসওয়ার্ড কমপক্ষে ৬ অক্ষরের হতে হবে!", "warning");
    return;
  }

  var btn = document.getElementById('saveUserEditBtn');
  if (btn) btn.disabled = true;

  var d = {
    row: row,
    type: type,
    id: oldId,
    oldId: oldId,
    oldEmail: oldEmail,
    oldCardNumber: oldCard,
    pass: pass,
    studentID: u.studentID || "",
    phone: u.phone || "",
    email: u.email || ""
  };

  try {
    if (type === 'Teacher') {
      var rawNewPhone = document.getElementById('euPhone').value.trim();
      var cleanNewPhone = normalizePhoneFrontend(rawNewPhone) || rawNewPhone;
      var newName = document.getElementById('euName').value.trim();

      if (!cleanNewPhone || !newName) {
        if (btn) btn.disabled = false;
        return Swal.fire("তথ্য প্রয়োজন", "শিক্ষকের মোবাইল নম্বর (Login ID) এবং নাম খালি রাখা যাবে না!", "warning");
      }

      d.id = cleanNewPhone;
      d.name = newName;
      d.email = document.getElementById('euEmail').value.trim();
      var inputMachine = document.getElementById('euMachineId').value.trim();
      if (!inputMachine || (oldId !== cleanNewPhone && inputMachine === oldId)) {
        d.machineId = cleanNewPhone;
      } else {
        d.machineId = inputMachine;
      }
      d.cardNumber = document.getElementById('euCardNumber').value.trim();

      if (preparedTeacherEditPhoto) {
        let upRes = preparedTeacherEditPhoto.uploadedResult;
        if (!upRes && preparedTeacherEditPhoto.uploadPromise) {
          showLoader(true, "নতুন ছবি সংযুক্ত হচ্ছে...");
          upRes = await preparedTeacherEditPhoto.uploadPromise;
        }
        if (upRes && upRes.url) {
          d.photoUrl = upRes.url;
        } else {
          d.photoData = preparedTeacherEditPhoto.fileData;
        }
      }
    }

    // সাথে সাথে মোডাল বন্ধ করে ইউআই আপডেট (যাতে ইউজারকে অপেক্ষা করতে না হয়)
    closeModal('editUserModal');

    globalUsersList.forEach(item => {
      if (item.row === row) {
        item.pass = pass;
        if (type === 'Teacher') {
          item.id = d.id;
          item.name = d.name;
          item.email = d.email;
          item.machineId = d.machineId;
          item.cardNumber = d.cardNumber;
          if (d.photoUrl) item.photoUrl = d.photoUrl;
          item.infoHtml = `Name: <b>${item.name}</b> | Email: ${item.email || "N/A"}<br>Password: <span style="color:#e11d48; font-weight:700;">${pass}</span>`;
        } else if (item.type === 'Student') {
          item.infoHtml = `Student: <b>${item.name}</b> (Class: ${item.classVal}, Roll: ${item.roll})<br>Guardian Phone: ${item.phone || "N/A"} | Pass: <span style="color:#e11d48; font-weight:700;">${pass}</span>`;
        } else if (item.type === 'Guardian') {
          item.infoHtml = `Guardian Login ID: <b>${item.phone}</b><br>Student: <b>${item.studentName}</b> (ID: ${item.studentID} • Class: ${item.classVal})<br>Password: <span style="color:#e11d48; font-weight:700;">${pass}</span>`;
        }
      }
    });
    renderUserList();

    Toast.fire({
      icon: 'success',
      title: type === 'Teacher' ? 'শিক্ষকের তথ্য ও পাসওয়ার্ড আপডেট হয়েছে!' : 'পাসওয়ার্ড সফলভাবে পরিবর্তন হয়েছে!'
    });

    // ব্যাকগ্রাউন্ডে সার্ভার ও লগইন সিস্টেম সিঙ্ক
    let res = await apiCall('updateUserDatabase', { info: d });
    if (res && res.photoUrl && type === 'Teacher') {
      globalUsersList.forEach(item => {
        if (item.row === row) item.photoUrl = res.photoUrl;
      });
      renderUserList();
    }
  } catch (err) {
    showLoader(false);
    Swal.fire("আপডেট ব্যর্থ", err.message, "error");
    loadUsers(false, true);
  } finally {
    if (btn) btn.disabled = false;
  }
}

function deleteUser(type, docId) {
  if (type !== 'Teacher') {
    return Swal.fire("অনুমোদিত নয়", "শিক্ষার্থী ও অভিভাবকের অ্যাকাউন্ট এখান থেকে মুছে ফেলা যাবে না।", "info");
  }

  var teacherObj = globalUsersList.find(u => u.type === 'Teacher' && u.row === docId) || {};

  Swal.fire({
    title: 'শিক্ষকের অ্যাকাউন্ট মুছে ফেলতে চান?',
    text: "এটি শিক্ষকের লগইন অ্যাক্সেস এবং প্রোফাইল স্থায়ীভাবে মুছে ফেলবে।",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#ef4444',
    cancelButtonText: 'বাতিল',
    confirmButtonText: 'হ্যাঁ, মুছে ফেলুন'
  }).then(async (result) => {
    if (result.isConfirmed) {
      globalUsersList = globalUsersList.filter(u => !(u.type === 'Teacher' && u.row === docId));
      renderUserList();

      Toast.fire({
        icon: 'success',
        title: 'শিক্ষকের অ্যাকাউন্ট মুছে ফেলা হয়েছে'
      });

      try {
        db.collection('Teachers').doc(docId).delete().catch(() => {});
      } catch (e) {}

      apiCall('deleteUser', {
        type: type,
        rowId: docId,
        meta: {
          id: teacherObj.id || "",
          machineId: teacherObj.machineId || teacherObj.id || "",
          email: teacherObj.email || ""
        }
      }).catch(() => {});
    }
  });
}

