function scheduleFilterUsers() {
  if (filterDebounceTimer) clearTimeout(filterDebounceTimer);
  filterDebounceTimer = setTimeout(filterUsers, 60);
}

function filterUsers() {
  var textFilter = document.getElementById('searchUserList').value.toLowerCase().trim();
  var classFilter = document.getElementById('filterClass').value;
  var items = document.querySelectorAll('.user-item');

  items.forEach(item => {
    var searchData = item.getAttribute('data-search') || '';
    var type = item.getAttribute('data-type');
    var cls = (item.getAttribute('data-class') || '').toLowerCase().replace('class ', '').trim();
    var targetCls = classFilter.toLowerCase().replace('class ', '').trim();

    var textMatch = !textFilter || searchData.includes(textFilter);
    var filterMatch = true;

    if (classFilter === 'Teacher') {
      filterMatch = (type === 'Teacher');
    } else if (classFilter === 'Student') {
      filterMatch = (type === 'Student');
    } else if (classFilter === 'Guardian') {
      filterMatch = (type === 'Guardian');
    } else if (classFilter !== 'All') {
      filterMatch = ((type === 'Student' || type === 'Guardian') && cls === targetCls);
    }

    item.style.display = (textMatch && filterMatch) ? "flex" : "none";
  });
}

function closeModal(id) {
  document.getElementById(id).style.display = "none";
}

