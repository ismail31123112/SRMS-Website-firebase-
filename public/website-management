// ============================================================================
// 📡 SECURE API CALL TO GOOGLE APPS SCRIPT BACKEND
// ============================================================================
async function apiCall(actionName, payloadData = {}) {
  if (!auth.currentUser) {
    throw new Error("Admin session expired! Please login again.");
  }
  let token = await auth.currentUser.getIdToken(true);
  let payload = {
    action: actionName,
    token: token,
    adminKey: SRMS_ADMIN_PASSKEY,
    ...payloadData
  };

  let res = await fetch(SCRIPT_URL, {
    method: 'POST',
    body: JSON.stringify(payload),
    headers: { 'Content-Type': 'text/plain;charset=utf-8' }
  });
  let text = await res.text();
  if (text.includes("<html") || text.includes("<!DOCTYPE")) {
    throw new Error("Deployment Access Error! Make sure Apps Script Web App is deployed with 'Who has access: Anyone'.");
  }

  let data;
  try {
    data = JSON.parse(text);
  } catch (e) {
    throw new Error("Invalid JSON response from server.");
  }

  if (data.error) throw new Error(data.error);
  if (data.status === "error") throw new Error(data.message || data.msg);

  return data;
}

