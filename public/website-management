<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SRMS — Official Administration Portal</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
if (window.history.replaceState) {
  var cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
  window.history.replaceState({ path: cleanUrl }, '', cleanUrl);
}
</script>

<style>
:root {
  --primary: #005f40;
  --primary-light: #ecfdf5;
  --primary-dark: #003d29;
  --bg: #f1f5f9;
  --danger: #ef4444;
  --warn: #f59e0b;
  --edit: #2563eb;
  --guardian: #7c3aed;
  --guardian-light: #f3e8ff;
  --gold: #f59e0b;
  --surface: #ffffff;
}
* { box-sizing: border-box; }
body {
  font-family: 'Poppins', sans-serif;
  background: var(--bg);
  margin: 0;
  padding-bottom: 105px;
  color: #0f172a;
  -webkit-font-smoothing: antialiased;
}

/* Header */
.header {
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(14px);
  padding: 12px 22px;
  box-shadow: 0 4px 25px rgba(0, 95, 64, 0.07);
  display: flex;
  align-items: center;
  gap: 12px;
  position: sticky;
  top: 0;
  z-index: 50;
  border-bottom: 1px solid rgba(0, 95, 64, 0.12);
}
.header img {
  height: 44px;
  width: 44px;
  object-fit: cover;
  border-radius: 50%;
  border: 2px solid var(--gold);
  padding: 2px;
  background: white;
}
.header-title-wrap h2 {
  font-size: 16px;
  color: var(--primary);
  margin: 0;
  font-weight: 800;
  letter-spacing: 0.2px;
}
.header-title-wrap span {
  font-size: 10.5px;
  background: var(--primary-light);
  color: var(--primary);
  padding: 2px 9px;
  border-radius: 20px;
  font-weight: 700;
}
.btn-back {
  margin-left: auto;
  background: var(--surface);
  color: var(--primary);
  border: 1.5px solid #cbd5e1;
  padding: 8px 16px;
  border-radius: 30px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  gap: 6px;
}
.btn-back:hover {
  background: var(--primary);
  color: white;
  border-color: var(--primary);
  transform: translateY(-1px);
}

/* Containers & Cards */
.container {
  display: none;
  padding: 22px 16px;
  max-width: 740px;
  margin: auto;
  animation: fadeInUp 0.18s ease;
}
.container.active { display: block; }
.card {
  background: var(--surface);
  border-radius: 22px;
  padding: 26px 22px;
  box-shadow: 0 10px 35px rgba(15, 23, 42, 0.04);
  margin-bottom: 24px;
  border: 1px solid rgba(226, 232, 240, 0.9);
  position: relative;
}

/* Typography & Forms */
label {
  display: block;
  font-size: 13px;
  font-weight: 700;
  color: #334155;
  margin-top: 16px;
  margin-bottom: 7px;
}
input, select, textarea {
  width: 100%;
  padding: 13px 16px;
  border: 2px solid #e2e8f0;
  border-radius: 13px;
  font-family: inherit;
  font-size: 14px;
  transition: 0.18s;
  color: #0f172a;
  background: #f8fafc;
  font-weight: 500;
}
input[type="file"] {
  padding: 10px;
  background: #fff;
  border: 2px dashed var(--primary);
  cursor: pointer;
}
input:focus, select:focus, textarea:focus {
  border-color: var(--primary);
  background: #fff;
  outline: none;
  box-shadow: 0 0 0 4px rgba(0, 95, 64, 0.1);
}
input:disabled {
  background: #f1f5f9 !important;
  color: #64748b !important;
  cursor: not-allowed;
  border-color: #e2e8f0;
}

/* Preview Box */
.preview-box {
  display: none;
  margin-top: 12px;
  padding: 12px;
  border-radius: 14px;
  background: #f0fdf4;
  border: 1.5px solid #bbf7d0;
  align-items: center;
  gap: 14px;
}
.preview-box img {
  width: 60px;
  height: 60px;
  object-fit: cover;
  border-radius: 12px;
  border: 2px solid var(--primary);
  background: #fff;
}
.preview-info {
  flex: 1;
  font-size: 12px;
  color: #166534;
  font-weight: 600;
}

/* User Avatar in List */
.user-avatar-wrap {
  position: relative;
  width: 56px;
  height: 56px;
  border-radius: 16px;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px solid #e2e8f0;
  flex-shrink: 0;
  overflow: hidden;
  box-shadow: 0 3px 10px rgba(0,0,0,0.04);
}
.user-avatar-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Buttons */
.btn-submit {
  width: 100%;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: white;
  padding: 15px;
  border: none;
  border-radius: 15px;
  font-weight: 800;
  cursor: pointer;
  margin-top: 22px;
  transition: all 0.2s ease;
  font-size: 14.5px;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  box-shadow: 0 8px 22px rgba(0, 95, 64, 0.25);
}
.btn-submit:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(0, 95, 64, 0.35);
}
.btn-submit:disabled {
  opacity: 0.65;
  cursor: not-allowed;
}
.btn-delete {
  background: #fef2f2;
  color: var(--danger);
  border: 1px solid #fecaca;
  padding: 9px 13px;
  border-radius: 11px;
  cursor: pointer;
  font-size: 12.5px;
  font-weight: 700;
  transition: 0.18s;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
}
.btn-delete:hover {
  background: var(--danger);
  color: white;
}
.btn-edit {
  background: #eff6ff;
  color: var(--edit);
  border: 1px solid #bfdbfe;
  padding: 9px 14px;
  border-radius: 11px;
  cursor: pointer;
  font-size: 12.5px;
  font-weight: 700;
  transition: 0.18s;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}
.btn-edit:hover {
  background: var(--edit);
  color: white;
}

/* Stats Grid */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 18px;
}
.stat-box {
  padding: 18px 12px;
  border-radius: 18px;
  color: white;
  text-align: center;
  box-shadow: 0 8px 20px rgba(0,0,0,0.08);
}
.stat-box b {
  font-size: 26px;
  font-weight: 900;
  display: block;
  line-height: 1.1;
}
.stat-box small {
  font-size: 10.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  opacity: 0.92;
}

/* Filter Bar */
.filter-container {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 20px;
  background: #f8fafc;
  padding: 12px;
  border-radius: 18px;
  border: 1px solid #e2e8f0;
}
.search-wrapper {
  position: relative;
  flex: 1 1 220px;
}
.search-wrapper i {
  position: absolute;
  left: 15px;
  top: 50%;
  transform: translateY(-50%);
  color: #94a3b8;
  font-size: 14px;
}
.search-wrapper input {
  padding-left: 40px;
  margin: 0;
  border-radius: 25px;
  background: white;
  height: 44px;
}
.filter-wrapper {
  flex: 1 1 150px;
}
.filter-wrapper select {
  margin: 0;
  border-radius: 25px;
  background: white;
  height: 44px;
  padding: 0 16px;
  cursor: pointer;
  font-weight: 700;
  color: #334155;
}

/* List Items */
.list-item {
  padding: 18px;
  border: 1.5px solid #e2e8f0;
  border-radius: 18px;
  margin-bottom: 14px;
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  transition: 0.18s;
}
.list-item:hover {
  box-shadow: 0 8px 25px rgba(0, 95, 64, 0.07);
  border-color: #cbd5e1;
}

/* Notice Banner */
.policy-banner {
  background: #f8fafc;
  border-left: 4px solid var(--primary);
  padding: 12px 15px;
  border-radius: 12px;
  font-size: 12px;
  color: #334155;
  font-weight: 600;
  margin-bottom: 18px;
  line-height: 1.55;
}

/* Read-only Summary Box inside Modal */
.readonly-summary {
  background: #f8fafc;
  border: 1.5px solid #e2e8f0;
  border-radius: 14px;
  padding: 14px 16px;
  margin-top: 12px;
  margin-bottom: 14px;
  font-size: 13px;
  line-height: 1.7;
  color: #334155;
}
.readonly-summary .ro-row {
  display: flex;
  justify-content: space-between;
  border-bottom: 1px dashed #e2e8f0;
  padding: 4px 0;
}
.readonly-summary .ro-row:last-child {
  border-bottom: none;
}

/* Bottom Navigation */
.bottom-nav {
  position: fixed;
  bottom: 0;
  width: 100%;
  background: rgba(255,255,255,0.97);
  backdrop-filter: blur(15px);
  display: flex;
  box-shadow: 0 -5px 25px rgba(0, 95, 64, 0.08);
  z-index: 100;
  border-top: 1px solid #e2e8f0;
  border-radius: 22px 22px 0 0;
  padding: 4px 0;
}
.nav-item {
  flex: 1;
  text-align: center;
  color: #94a3b8;
  border: none;
  background: none;
  font-size: 11.5px;
  padding: 10px 4px;
  cursor: pointer;
  transition: 0.2s;
  font-weight: 700;
}
.nav-item i {
  display: block;
  font-size: 20px;
  margin-bottom: 4px;
  transition: 0.2s;
}
.nav-item.active {
  color: var(--primary);
  font-weight: 800;
}
.nav-item.active i {
  transform: translateY(-2px);
  color: var(--primary);
}

/* Modal & Loader */
.modal {
  display: none;
  position: fixed;
  z-index: 1000;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(15, 23, 42, 0.6);
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4px);
  padding: 15px;
}
.modal-content {
  background-color: #fff;
  margin: auto;
  padding: 28px 24px;
  border-radius: 24px;
  width: 100%;
  max-width: 450px;
  position: relative;
  animation: zoomIn 0.16s ease;
  box-shadow: 0 25px 50px rgba(0,0,0,0.22);
  border-top: 6px solid var(--primary);
  max-height: 92vh;
  overflow-y: auto;
}
#loader {
  display: flex;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(255,255,255,0.9);
  z-index: 9999;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(5px);
}
.spinner {
  width: 48px;
  height: 48px;
  border: 4px solid #e2e8f0;
  border-top: 4px solid var(--primary);
  border-radius: 50%;
  animation: spin 0.65s linear infinite;
}
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
@keyframes fadeInUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
@keyframes zoomIn { from { transform: scale(0.95); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.close {
  position: absolute;
  top: 16px;
  right: 20px;
  color: #94a3b8;
  font-size: 26px;
  font-weight: bold;
  cursor: pointer;
  line-height: 1;
}
.close:hover { color: var(--danger); }

@media (max-width: 500px) {
  .stats-grid { grid-template-columns: 1fr; }
  .list-item { flex-direction: column; align-items: flex-start; }
  .list-actions { width: 100%; display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px; }
}
</style>
</head>
<body>

<!-- Session Verification Loader -->
<div id="loader">
  <div class="spinner"></div>
  <p id="loaderText" style="margin-top:16px; font-size:14px; font-weight:700; color:var(--primary); text-align:center;">
    অ্যাডমিন প্যানেল লোড হচ্ছে...<br><span style="font-size:11.5px; color:#64748b; font-weight:500;">অনুগ্রহ করে অপেক্ষা করুন</span>
  </p>
</div>

<!-- ================= MAIN APPLICATION ================= -->
<div id="appContainer" style="display:none;">
  <div class="header">
    <img src="https://i.postimg.cc/9FxBsqsj/IMG-20251220-WA0006.jpg" alt="SRMS Logo">
    <div class="header-title-wrap">
      <h2>Saidpur Residential Model School</h2>
      <span>Official Administration Portal</span>
    </div>
    <button class="btn-back" onclick="window.close();" title="Back to Dashboard">
      <i class="fas fa-arrow-left"></i> Dashboard
    </button>
  </div>

  <!-- ================= 1. POST & UPLOAD TAB ================= -->
  <div id="upload" class="container active">
    <!-- Scrolling Headline Card -->
    <div class="card" style="border-left: 6px solid var(--warn); background: linear-gradient(145deg, #ffffff, #fffbeb);">
      <label style="margin-top:0; color: #b45309; font-weight:800; font-size: 13.5px; text-transform:uppercase;">
        <i class="fas fa-bullhorn"></i> জরুরি স্ক্রলিং হেডলাইন (Scrolling Notice)
      </label>
      <div style="display:flex; gap:10px; margin-top:10px;">
        <input type="text" id="hText" placeholder="ওয়েবসাইটের স্ক্রলিং হেডলাইন এখানে লিখুন..." style="margin-top:0; border-color: #fde68a;">
        <button id="headBtn" onclick="pubHead()" style="background:linear-gradient(135deg, #f59e0b, #d97706); color:white; border:none; padding:0 24px; border-radius:12px; cursor:pointer; box-shadow: 0 4px 12px rgba(217, 119, 6, 0.25);">
          <i class="fas fa-paper-plane" style="font-size: 16px;"></i>
        </button>
      </div>
    </div>

    <!-- Website Content Publisher -->
    <div class="card">
      <h3 style="margin-top:0; color:var(--primary); font-weight:800; font-size:17px;">
        <i class="fas fa-file-signature"></i> ওয়েবসাইটে নতুন কন্টেন্ট ও বিজ্ঞপ্তি প্রকাশ
      </h3>

      <label><i class="fas fa-layer-group" style="color:var(--primary); margin-right:5px;"></i> নির্ধারিত পেজ / সেকশন নির্বাচন করুন</label>
      <select id="upCat" onchange="updateTitleLabel(this)">
        <optgroup label="General">
          <option value="Notice">Notice Board</option>
          <option value="HomeSlide">Home Slide Show</option>
          <option value="HomeVideo">Home Video</option>
          <option value="TeacherDashboard">Teacher Dashboard</option>
        </optgroup>
        <optgroup label="Website & Administration" id="adminOnlyUploads">
          <option value="GoverningBody">Governing Body</option>
          <option value="PresidentMessage">Message of President</option>
          <option value="VPMessage">Message of Vice President</option>
          <option value="HeadmasterMessage">Message of Headmaster</option>
          <option value="Facilities">Facilities</option>
          <option value="News">News & Events</option>
          <option value="Teachers">Teacher List</option>
          <option value="Admission">Admission Info</option>
          <option value="Routine">Class Routine</option>
          <option value="Syllabus">Syllabus</option>
          <option value="Exam">Exam Routine</option>
          <option value="Gallery">Photo Gallery</option>
        </optgroup>
        <optgroup label="Class Dashboards">
          <option value="ClassPlay">Class Play</option>
          <option value="ClassNursery">Class Nursery</option>
          <option value="ClassKG">Class KG</option>
          <option value="Class1">Class 1</option>
          <option value="Class2">Class 2</option>
          <option value="Class3">Class 3</option>
          <option value="Class4">Class 4</option>
          <option value="Class5">Class 5</option>
          <option value="Class6">Class 6</option>
          <option value="Class7">Class 7</option>
          <option value="Class8">Class 8</option>
          <option value="Class9">Class 9</option>
          <option value="Class10">Class 10</option>
        </optgroup>
      </select>

      <label id="titleLabel"><i class="fas fa-heading" style="color:var(--primary); margin-right:5px;"></i> শিরোনাম (Notice Board)</label>
      <input type="text" id="upTitle" placeholder="বিজ্ঞপ্তির শিরোনাম বা ক্যাপশন লিখুন" required>

      <label><i class="fas fa-align-left" style="color:var(--primary); margin-right:5px;"></i> বিস্তারিত বিবরণ (ঐচ্ছিক)</label>
      <textarea id="upDesc" rows="4" placeholder="বিস্তারিত তথ্য বা বার্তা এখানে লিখুন..."></textarea>

      <label><i class="fas fa-paperclip" style="color:var(--primary); margin-right:5px;"></i> ছবি অথবা ফাইল সংযুক্ত করুন (Image / PDF / Doc)</label>
      <input type="file" id="upFile" accept="image/*,application/pdf,.doc,.docx,.xls,.xlsx" onchange="handleFilePreview(this)">

      <!-- Live File Preview -->
      <div id="filePreviewBox" class="preview-box">
        <img id="previewImg" src="" alt="Preview">
        <div class="preview-info" id="previewMeta">ফাইল প্রস্তুত হচ্ছে...</div>
        <button type="button" class="btn-delete" onclick="clearSelectedFile()" title="বাতিল করুন">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <label><i class="fas fa-link" style="color:var(--primary); margin-right:5px;"></i> ওয়েব লিংক / ভিডিও লিংক (ঐচ্ছিক)</label>
      <input type="url" id="upLink" placeholder="https://...">

      <button class="btn-submit" id="pubPostBtn" onclick="submitUpload()">
        <i class="fas fa-check-circle" style="margin-right: 6px;"></i> ওয়েবসাইটে প্রকাশ করুন
      </button>
    </div>
  </div>

  <!-- ================= 2. USERS & GUARDIANS TAB ================= -->
  <div id="users" class="container">
    <!-- User Statistics Card -->
    <div class="card">
      <h3 style="margin-top:0; color:var(--primary); font-weight:800; font-size:16.5px;">
        <i class="fas fa-chart-pie"></i> পোর্টাল ব্যবহারকারীর পরিসংখ্যান
      </h3>
      <div id="userStatsDisplay">
        <div style="text-align:center; padding:15px; color:#64748b;">
          <i class="fas fa-circle-notch fa-spin"></i> পরিসংখ্যান লোড হচ্ছে...
        </div>
      </div>
    </div>

    <!-- Setup Teacher Account -->
    <div class="card">
      <h3 style="margin-top:0; color:var(--primary); font-weight:800; font-size:16.5px;">
        <i class="fas fa-user-tie"></i> নতুন শিক্ষক অ্যাকাউন্ট নিবন্ধন
      </h3>
      <div class="policy-banner">
        <i class="fas fa-info-circle" style="color:var(--primary);"></i> এখান থেকে সম্মানিত শিক্ষকদের পোর্টাল অ্যাকাউন্ট তৈরি ও পরিচালনা করা যাবে। শিক্ষার্থী এবং অভিভাবকদের অ্যাকাউন্ট ভর্তি প্যানেল থেকে স্বয়ংক্রিয়ভাবে তৈরি হয় এবং নিচের তালিকা থেকে তাদের পাসওয়ার্ড পরিবর্তন করা যাবে।
      </div>

      <label><i class="fas fa-camera" style="color:var(--primary); margin-right:5px;"></i> শিক্ষকের প্রোফাইল ছবি</label>
      <input type="file" id="uTPhoto" accept="image/*" onchange="handleTeacherPhotoPreview(this, 'add')">
      <div id="uTPhotoPreviewBox" class="preview-box">
        <img id="uTPhotoPreviewImg" src="" alt="Teacher Photo" style="border-radius:50%;">
        <div class="preview-info" id="uTPhotoPreviewMeta">ছবি প্রস্তুত</div>
        <button type="button" class="btn-delete" onclick="clearTeacherPhoto('add')" title="ছবি সরান">
          <i class="fas fa-times"></i>
        </button>
      </div>

