      <div class="ro-row"><span>Guardian Phone:</span> <b>${u.phone || 'N/A'}</b></div>
    `;
    passNote.innerHTML = `⚡ <b>Admin Special Power:</b> স্টুডেন্ট এবং অভিভাবকের অন্যান্য তথ্য এখানে অপরিবর্তনীয়। শুধুমাত্র নতুন <b>Password</b> সেট করলে তা সরাসরি ১ সেকেন্ডে কার্যকর হবে।`;
  }

  document.getElementById('editUserModal').style.display = "flex";
}

async function submitUserEdit() {
  var index = parseInt(document.getElementById('euIndex').value, 10);
  var u = globalUsersList[index] || {};
  var row = document.getElementById('euRow').value;
  var type = document.getElementById('euType').value;
  var id = document.getElementById('euId').value;
  var pass = document.getElementById('euPass').value.trim();

  if (!pass || pass.length < 6) {
    Swal.fire("Invalid Password", "Password must be at least 6 characters long!", "warning");
    return;
  }

  var d = {
    row: row,
    type: type,
    id: id,
    pass: pass,
    studentID: u.studentID || "",
    phone: u.phone || "",
    email: u.email || ""
  };

  try {
    if (type === 'Teacher') {
      d.name = document.getElementById('euName').value.trim();
      d.email = document.getElementById('euEmail').value.trim();
      d.machineId = document.getElementById('euMachineId').value.trim();
      d.cardNumber = document.getElementById('euCardNumber').value.trim();

      if (preparedTeacherEditPhoto) {
        showLoader(true, "UPLOADING NEW TEACHER PHOTO TO IMGBB...");
        try {
          let imgRes = await uploadToImgBBDirect(preparedTeacherEditPhoto.fileData, preparedTeacherEditPhoto.fileName);
          d.photoUrl = imgRes.url;
        } catch (e) {
          d.photoData = preparedTeacherEditPhoto.fileData;
        }
      }
    }

    showLoader(true, "APPLYING ADMIN OVERRIDE...<br><span style='font-size:11px; color:#64748b;'>Parallel Sync in Progress</span>");
    let res = await apiCall('updateUserDatabase', { info: d });
    showLoader(false);
    closeModal('editUserModal');

    // ইনস্ট্যান্ট মেমোরি আপডেট (যাতে রিলোড ছাড়াই নতুন পাসওয়ার্ড দেখায়)
    globalUsersList.forEach(item => {
      if (item.row === row) {
        item.pass = pass;
        if (type === 'Teacher') {
          item.name = d.name;
          item.email = d.email;
          item.machineId = d.machineId;
          item.cardNumber = d.cardNumber;
          if (res.photoUrl || d.photoUrl) item.photoUrl = res.photoUrl || d.photoUrl;
          item.infoHtml = `Name: <b>${item.name}</b> | Email: ${item.email || "N/A"}<br>Password: <span style="color:#e11d48; font-weight:700;">${pass}</span>`;
        } else if (item.type === 'Student') {
          item.infoHtml = `Student: <b>${item.name}</b> (Class: ${item.classVal}, Roll: ${item.roll})<br>Guardian Phone: ${item.phone || "N/A"} | Pass: <span style="color:#e11d48; font-weight:700;">${pass}</span>`;
        } else if (item.type === 'Guardian') {
          item.infoHtml = `Guardian Login ID: <b>${item.phone}</b><br>Student: <b>${item.studentName}</b> (ID: ${item.studentID} • Class: ${item.classVal})<br>Password: <span style="color:#e11d48; font-weight:700;">${pass}</span>`;
        }
      }
    });
    renderUserList();

    Swal.fire("Success!", res.msg || "Updated successfully!", "success");
  } catch (err) {
    showLoader(false);
    Swal.fire("Update Failed", err.message, "error");
  }
}

function deleteUser(type, docId) {
  if (type !== 'Teacher') {
    return Swal.fire("Not Allowed", "Student & Guardian accounts cannot be deleted from here.", "info");
  }
  Swal.fire({
    title: 'Remove Teacher Account?',
    text: "This will remove the teacher's login access, profile, and attendance machine card.",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#ef4444',
    confirmButtonText: 'Yes, remove!'
  }).then(async (result) => {
    if (result.isConfirmed) {
      // ইনস্ট্যান্ট UI আপডেট
      globalUsersList = globalUsersList.filter(u => !(u.type === 'Teacher' && u.row === docId));
      renderUserList();

      showLoader(true, "REMOVING TEACHER...");
      try {
        let res = await apiCall('deleteUser', { type: type, rowId: docId });
        showLoader(false);
        Swal.fire("Removed!", res.msg || "Teacher removed.", "success");
      } catch (err) {
        showLoader(false);
        Swal.fire("Error", err.message, "error");
        loadUsers(false, true);
      }
    }
  });
}

