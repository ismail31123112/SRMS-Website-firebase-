function extractUserPhoto(f) {
  if (!f) return "";
  return (
    f.photoUrl ||
    f.photo ||
    f.imageUrl ||
    f.image ||
    f.imgUrl ||
    f.profilePic ||
    f.avatar ||
    ""
  ).toString().trim();
}

function normalizePhoneFrontend(phoneStr) {
  if (!phoneStr) return "";
  var digits = phoneStr.toString().replace(/[^0-9]/g, "");
  if (digits.startsWith("880") && digits.length === 13) {
    digits = "0" + digits.substring(3);
  } else if (digits.length === 10 && !digits.startsWith("0")) {
    digits = "0" + digits;
  }
  return digits;
}

