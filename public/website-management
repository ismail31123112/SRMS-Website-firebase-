async function uploadToImgBBDirect(base64Image, fileName) {
  var formData = new FormData();
  formData.append("key", IMGBB_API_KEY);
  formData.append("image", base64Image);
  if (fileName) {
    var cleanName = fileName.replace(/\.[^/.]+$/, "");
    formData.append("name", cleanName);
  }

  var response = await fetch(IMGBB_UPLOAD_URL, {
    method: "POST",
    body: formData
  });
  var json = await response.json();
  if (json && json.success && json.data) {
    return {
      url: json.data.url || json.data.display_url,
      thumbUrl: (json.data.thumb && json.data.thumb.url) ? json.data.thumb.url : json.data.url,
      deleteUrl: json.data.delete_url || "",
      imgbbId: json.data.id || ""
    };
  }
  throw new Error((json && json.error && json.error.message) ? json.error.message : "ImgBB Direct Upload Failed");
}

async function submitUpload() {
  var title = document.getElementById('upTitle').value.trim();
  if (!title) {
    Swal.fire("Warning", "Please enter a title!", "warning");
    return;
  }

  var cat = document.getElementById('upCat').value;
  var desc = document.getElementById('upDesc').value.trim();
  var link = document.getElementById('upLink').value.trim();

  let data = {
    targetPage: cat,
    title: title,
    desc: desc,
    externalUrl: link
  };

  try {
    if (preparedFilePayload) {
      if (preparedFilePayload.isImage) {
        showLoader(true, "UPLOADING PHOTO TO IMGBB...<br><span style='font-size:11px; color:#64748b;'>Turbo Upload in Progress</span>");
        try {
          let imgbbResult = await uploadToImgBBDirect(preparedFilePayload.fileData, preparedFilePayload.fileName);
          data.externalUrl = imgbbResult.url;
          data.fileUrl = imgbbResult.url;
          data.fileType = "Image";
          data.thumbUrl = imgbbResult.thumbUrl;
          data.imgbbId = imgbbResult.imgbbId;
          data.imgbbDeleteUrl = imgbbResult.deleteUrl;
        } catch (directErr) {
          data.fileData = preparedFilePayload.fileData;
          data.mimeType = preparedFilePayload.mimeType;
          data.fileName = preparedFilePayload.fileName;
        }
      } else {
        data.fileData = preparedFilePayload.fileData;
        data.mimeType = preparedFilePayload.mimeType;
        data.fileName = preparedFilePayload.fileName;
      }
    }

    showLoader(true, "PUBLISHING & SENDING PUSH...<br><span style='font-size:11px; color:#64748b;'>Saving to Database & Notifying Subscribers</span>");
    let res = await apiCall('uploadData', { data: data });
    showLoader(false);

    // মেমোরি ক্যাশে সাথে সাথে নতুন পোস্ট যুক্ত করা
    if (res.docId) {
      globalPostsList.unshift({
        docId: res.docId,
        date: res.date || new Date().toLocaleDateString('en-GB').replace(/\//g, '-'),
        targetPage: cat,
        title: title,
        desc: desc,
        fileType: res.fileType || data.fileType || (link ? "Link" : "None"),
        fileUrl: res.fileUrl || data.fileUrl || link || "",
        thumbUrl: res.thumbUrl || data.thumbUrl || res.fileUrl || "",
        imgbbId: res.imgbbId || data.imgbbId || "",
        imgbbDeleteUrl: res.imgbbDeleteUrl || data.imgbbDeleteUrl || "",
        driveFileId: res.driveFileId || "",
        time: res.timestamp || Date.now()
      });
      renderPostsList();
    } else {
      loadPosts(false, true);
    }

    Swal.fire({
      title: "Published!",
      text: res.msg || "Content published & Push Notification sent!",
      icon: "success",
      confirmButtonColor: "#005f40"
    });
    document.getElementById('upTitle').value = "";
    document.getElementById('upDesc').value = "";
    document.getElementById('upLink').value = "";
    clearSelectedFile();
  } catch (err) {
    showLoader(false);
    Swal.fire("Upload Failed", err.message, "error");
  }
}

