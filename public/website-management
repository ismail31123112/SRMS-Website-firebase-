          data.fileData = preparedFilePayload.fileData;
          data.mimeType = preparedFilePayload.mimeType;
          data.fileName = preparedFilePayload.fileName;
        }
      } else {
        data.fileData = preparedFilePayload.fileData;
        data.mimeType = preparedFilePayload.mimeType;
        data.fileName = preparedFilePayload.fileName;
      }
