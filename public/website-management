async function loadUsers() {
  if (!isAuthReady) return;
  showLoader(true, "LOADING USERS & GUARDIANS...<br><span style='font-size:11px; color:#64748b;'>Fetching live records from Firestore</span>");
  try {
    let users = [];

    // ১. Teachers লোড করা
    let tSnap = await db.collection('Teachers').get();
    tSnap.forEach(doc => {
      let f = doc.data();
      let name = f.name || "N/A";
      let pass = f.pass || "123456";
      let phoneId = f.phone || "";
      users.push({
        type: "Teacher",
        id: phoneId,
        machineId: f.machineID || "",
        name: name,
        email: f.email || "",
        pass: pass,
        row: doc.id,
        infoHtml: `Name: <b>${name}</b> | Email: ${f.email || "N/A"}<br>Password: <span style="color:#e11d48; font-weight:700;">${pass}</span>`
      });
    });

    // ২. Students এবং Guardians উভয় কার্ড তৈরি করা
    let sSnap = await db.collection('Students').get();
    sSnap.forEach(doc => {
      let f = doc.data();
      let sid = (f.studentID || "").toString().trim();
      if (!sid) return;

      let sName = f.name || "Student";
      let sClass = f.class || "N/A";
      let sRoll = f.roll || "N/A";
      let sPhone = (f.phone || "").toString().trim();
      let pass = f.pass || "123456";

      // Student Login Entry
      users.push({
        type: "Student",
        id: sid,
        studentID: sid,
        machineId: f.machineID || "",
        name: sName,
        classVal: sClass,
        roll: sRoll,
        phone: sPhone,
        email: f.email || "",
        pass: pass,
        row: doc.id,
        infoHtml: `Student: <b>${sName}</b> (Class: ${sClass}, Roll: ${sRoll})<br>Guardian Phone: ${sPhone || "N/A"} | Pass: <span style="color:#e11d48; font-weight:700;">${pass}</span>`
      });

      // Guardian Login Entry (অভিভাবকের মোবাইল নম্বর থাকলে আলাদা Guardian কার্ড যুক্ত হবে)
      if (sPhone) {
        users.push({
          type: "Guardian",
          id: sPhone,
          studentID: sid,
          machineId: "",
          name: "Guardian of " + sName,
          studentName: sName,
          classVal: sClass,
          roll: sRoll,
          phone: sPhone,
          email: f.email || "",
          pass: pass,
          row: doc.id,
          infoHtml: `Guardian Login ID: <b>${sPhone}</b><br>Student: <b>${sName}</b> (ID: ${sid} • Class: ${sClass})<br>Password: <span style="color:#e11d48; font-weight:700;">${pass}</span>`
        });
      }
    });

    showLoader(false);
    globalUsersList = users;
    renderUserList();
  } catch (err) {
    showLoader(false);
    document.getElementById('userListDisplay').innerHTML =
      `<p style="color:red; text-align:center;">Failed to load users: ${err.message}</p>`;
  }
}

function renderUserList() {
  var h = "";
  var totalTeachers = 0;
  var totalStudents = 0;
  var totalGuardians = 0;
  var classCounts = {};

  if (globalUsersList.length === 0) {
    h = "<p style='text-align:center; color:#94a3b8;'>No users found in database.</p>";
  } else {
    globalUsersList.forEach((u, index) => {
      if (u.type === 'Teacher') {
        totalTeachers++;
      } else if (u.type === 'Student') {
        totalStudents++;
        var cls = u.classVal || "Unknown";
        classCounts[cls] = (classCounts[cls] || 0) + 1;
      } else if (u.type === 'Guardian') {
        totalGuardians++;
      }

      var icon, badgeBg, badgeClr, actionBtns;
      if (u.type === 'Teacher') {
        icon = '<i class="fas fa-chalkboard-teacher" style="color:var(--primary); font-size:22px;"></i>';
        badgeBg = 'var(--primary-light)';
        badgeClr = 'var(--primary)';
        actionBtns = `
          <button class="btn-edit" onclick="openEditUser(${index})" title="Edit Teacher"><i class="fas fa-edit"></i> Edit</button>
          <button class="btn-delete" onclick="deleteUser('Teacher', '${u.row}')" title="Remove Teacher"><i class="fas fa-trash"></i></button>
        `;
      } else if (u.type === 'Student') {
        icon = '<i class="fas fa-user-graduate" style="color:var(--warn); font-size:22px;"></i>';
        badgeBg = '#fef3c7';
        badgeClr = '#b45309';
        // Student-এর শুধুমাত্র পাসওয়ার্ড পরিবর্তনের বাটন থাকবে (অন্য কোনো তথ্য এডিট বা ডিলিট হবে না)
        actionBtns = `
          <button class="btn-edit" onclick="openEditUser(${index})" title="Change Student Password"><i class="fas fa-key"></i> Change Pass</button>
        `;
      } else {
        icon = '<i class="fas fa-user-shield" style="color:var(--guardian); font-size:22px;"></i>';
        badgeBg = 'var(--guardian-light)';
        badgeClr = 'var(--guardian)';
        // Guardian-এর শুধুমাত্র পাসওয়ার্ড পরিবর্তনের বাটন থাকবে
        actionBtns = `
          <button class="btn-edit" style="background:#f3e8ff; color:#7c3aed; border-color:#ddd6fe;" onclick="openEditUser(${index})" title="Change Guardian Password"><i class="fas fa-key"></i> Change Pass</button>
        `;
      }

      var machineText = u.machineId ? ` <span style="color:#64748b; font-size:12px;">| <i class="fas fa-fingerprint"></i> ${u.machineId}</span>` : '';

      h += `<div class="list-item user-item" data-type="${u.type}" data-class="${u.classVal || ''}">
        <div style="display:flex; gap:14px; align-items:center;">
          <div style="width:50px; height:50px; border-radius:14px; background:#f8fafc; display:flex; align-items:center; justify-content:center; border: 1.5px solid #e2e8f0; flex-shrink:0;">
            ${icon}
          </div>
          <div>
            <span style="background:${badgeBg}; color:${badgeClr}; padding:3px 10px; border-radius:6px; font-size:10px; font-weight:800; text-transform:uppercase;">${u.type}</span>
            <div style="font-size:14.5px; font-weight:800; color:#0f172a; margin-top:5px;">
              ID: ${u.id}${machineText}
            </div>
            <div style="font-size:12px; color:#475569; margin-top:2px; line-height:1.45;">
              ${u.infoHtml}
            </div>
          </div>
        </div>
        <div class="list-actions" style="display:flex; gap:8px; flex-shrink:0;">
          ${actionBtns}
        </div>
      </div>`;
    });
  }
  document.getElementById('userListDisplay').innerHTML = h;

  // Statistics Render (Teachers, Students & Guardians)
  var statsHtml = `
    <div class="stats-grid">
      <div class="stat-box" style="background:linear-gradient(135deg, var(--primary), var(--primary-dark));">
        <b>${totalTeachers}</b>
        <small>Teachers</small>
      </div>
      <div class="stat-box" style="background:linear-gradient(135deg, #d97706, #92400e);">
        <b>${totalStudents}</b>
        <small>Students</small>
      </div>
      <div class="stat-box" style="background:linear-gradient(135deg, #7c3aed, #5b21b6);">
        <b>${totalGuardians}</b>
        <small>Guardians</small>
      </div>
    </div>
  `;

  if (totalStudents > 0) {
    statsHtml += `<div style="background:#f8fafc; padding:14px; border-radius:15px; border:1px solid #e2e8f0;">
      <b style="color:var(--primary-dark); font-size:12.5px; text-transform:uppercase;"><i class="fas fa-layer-group"></i> Class-wise Students:</b>
      <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:10px;">`;
    for (var cls in classCounts) {
      statsHtml += `<span style="background:#fff; color:#334155; padding:6px 12px; border-radius:10px; border:1px solid #cbd5e1; font-size:12px; font-weight:700;">
        Class ${cls}: <b style="color:var(--primary); margin-left:4px;">${classCounts[cls]}</b>
      </span>`;
    }
    statsHtml += `</div></div>`;
  }
  document.getElementById('userStatsDisplay').innerHTML = statsHtml;
  filterUsers();
}

function filterUsers() {
  var textFilter = document.getElementById('searchUserList').value.toLowerCase().trim();
  var classFilter = document.getElementById('filterClass').value;
  var items = document.querySelectorAll('.user-item');

  items.forEach(item => {
    var text = item.innerText.toLowerCase();
    var type = item.getAttribute('data-type');
    var cls = (item.getAttribute('data-class') || '').toLowerCase().replace('class ', '').trim();
    var targetCls = classFilter.toLowerCase().replace('class ', '').trim();

    var textMatch = !textFilter || text.includes(textFilter);
    var filterMatch = true;

    if (classFilter === 'Teacher') {
      filterMatch = (type === 'Teacher');
    } else if (classFilter === 'Student') {
      filterMatch = (type === 'Student');
    } else if (classFilter === 'Guardian') {
      filterMatch = (type === 'Guardian');
    } else if (classFilter !== 'All') {
      filterMatch = ((type === 'Student' || type === 'Guardian') && cls === targetCls);
    }

    item.style.display = (textMatch && filterMatch) ? "flex" : "none";
  });
}

function closeModal(id) {
  document.getElementById(id).style.display = "none";
}

function openEditUser(index) {
  var u = globalUsersList[index];
  document.getElementById('euRow').value = u.row;
  document.getElementById('euType').value = u.type;
  document.getElementById('euId').value = u.id;
  document.getElementById('euPass').value = u.pass;

  var summaryBox = document.getElementById('studentGuardianReadOnlyBox');
  var teacherBox = document.getElementById('teacherEditableFields');
  var modalTitle = document.getElementById('modalTitle');
  var passNote = document.getElementById('passSyncNote');

  if (u.type === 'Teacher') {
    modalTitle.innerHTML = `<i class="fas fa-user-edit"></i> Edit Teacher Account`;
    summaryBox.style.display = "none";
    teacherBox.style.display = "block";

    document.getElementById('euTeacherIdDisplay').value = u.id;
    document.getElementById('euName').value = u.name || "";
    document.getElementById('euEmail').value = u.email || "";
    document.getElementById('euMachineId').value = u.machineId || "";
    passNote.innerText = "Updating will sync Teacher's Firestore profile and Firebase Auth login.";
  } else {
    // Student এবং Guardian-এর ক্ষেত্রে পাসওয়ার্ড ব্যতীত অন্য কোনো তথ্য এডিট করার অপশন থাকবে না!
    modalTitle.innerHTML = `<i class="fas fa-key"></i> Change ${u.type} Password`;
    teacherBox.style.display = "none";
    summaryBox.style.display = "block";

    summaryBox.innerHTML = `
      <div style="color:var(--primary); font-weight:800; margin-bottom:4px; border-bottom:1px solid #cbd5e1;">
        <span><i class="fas fa-lock"></i> Read-Only Profile Info</span>
        <span>${u.type}</span>
      </div>
      <div><span>Student Name:</span> <b>${u.studentName || u.name}</b></div>
      <div><span>Student ID:</span> <b>${u.studentID}</b></div>
      <div><span>Class & Roll:</span> <b>Class ${u.classVal || 'N/A'} (Roll: ${u.roll || 'N/A'})</b></div>
      <div><span>Guardian Phone:</span> <b>${u.phone || 'N/A'}</b></div>
    `;
    passNote.innerHTML = `ℹ️ স্টুডেন্ট এবং অভিভাবকের অন্যান্য তথ্য শুধুমাত্র Admission Panel থেকে পরিবর্তনযোগ্য। এখানে শুধু <b>Password</b> পরিবর্তন হবে।`;
  }

  document.getElementById('editUserModal').style.display = "flex";
}

async function submitUserEdit() {
  var row = document.getElementById('euRow').value;
  var type = document.getElementById('euType').value;
  var id = document.getElementById('euId').value;
  var pass = document.getElementById('euPass').value.trim();

  if (!pass || pass.length < 6) {
    Swal.fire("Invalid Password", "Password must be at least 6 characters long!", "warning");
    return;
  }

  var d = {
    row: row,
    type: type,
    id: id,
    pass: pass
  };

  // শুধুমাত্র Teacher হলে অতিরিক্ত ফিল্ডগুলো পাঠানো হবে
  if (type === 'Teacher') {
    d.name = document.getElementById('euName').value.trim();
    d.email = document.getElementById('euEmail').value.trim();
    d.machineId = document.getElementById('euMachineId').value.trim();
  }

  showLoader(true, "UPDATING PASSWORD...<br><span style='font-size:11px; color:#64748b;'>Syncing with Firebase Auth & Database</span>");
  try {
    let res = await apiCall('updateUserDatabase', { info: d });
    showLoader(false);
    Swal.fire("Updated!", res.msg || "Password updated successfully!", "success");
    closeModal('editUserModal');
    loadUsers();
  } catch (err) {
    showLoader(false);
    Swal.fire("Update Failed", err.message, "error");
  }
}

function deleteUser(type, docId) {
  if (type !== 'Teacher') {
    return Swal.fire("Not Allowed", "Student & Guardian accounts cannot be deleted from here.", "info");
  }
  Swal.fire({
    title: 'Remove Teacher Account?',
    text: "This will remove the teacher's login access and profile.",
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#ef4444',
    confirmButtonText: 'Yes, remove!'
  }).then(async (result) => {
    if (result.isConfirmed) {
      showLoader(true, "REMOVING TEACHER...");
      try {
        let res = await apiCall('deleteUser', { type: type, rowId: docId });
        showLoader(false);
        Swal.fire("Removed!", res.msg || "Teacher removed.", "success");
        loadUsers();
      } catch (err) {
        showLoader(false);
        Swal.fire("Error", err.message, "error");
      }
    }
  });
}

// ============================================================================
// 📋 WEBSITE POSTS MANAGER
// ============================================================================
async function loadPosts() {
  if (!isAuthReady) return;
  showLoader(true, "LOADING POSTS...");
  try {
    let snap = await db.collection('WebsitePosts').get();
    let posts = [];
    snap.forEach(doc => {
      let f = doc.data();
      posts.push({
        date: f.date || "",
        targetPage: f.targetPage || "",
        title: f.title || "",
        desc: f.desc || "",
        fileType: f.fileType || "None",
        fileUrl: f.fileUrl || "",
        docId: doc.id,
        time: parseInt(f.timestamp || 0, 10)
      });
    });

    posts.sort((a, b) => b.time - a.time);
    showLoader(false);

    var h = `<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
      <h3 style="margin:0; color:var(--primary); font-weight:800; text-transform:uppercase; font-size:17px;">
        <i class="fas fa-list-ul"></i> Website Posts (${posts.length})
      </h3>
      <button onclick="loadPosts()" style="background:var(--primary-light); color:var(--primary); border:1px solid #a7f3d0; padding:6px 12px; border-radius:20px; font-size:12px; font-weight:700; cursor:pointer;">
        <i class="fas fa-sync-alt"></i> Refresh
      </button>
    </div>`;

    if (posts.length === 0) {
      h += "<p style='text-align:center; color:#94a3b8; padding:20px; font-weight:600;'>No posts available.</p>";
    }

    posts.forEach(r => {
      var thumbHtml = "";
      if (r.fileType === "Image" && r.fileUrl) {
        thumbHtml = `<img src="${r.fileUrl}" style="width:52px; height:52px; object-fit:cover; border-radius:10px; border:1px solid #cbd5e1; flex-shrink:0;" onerror="this.style.display='none'">`;
      }
      h += `<div class="list-item">
        <div style="display:flex; gap:12px; align-items:center; flex:1;">
          ${thumbHtml}
          <div>
            <span style="background:var(--primary-light); color:var(--primary); padding:4px 10px; border-radius:6px; font-size:10.5px; font-weight:800; text-transform:uppercase;">${r.targetPage}</span>
            <span style="font-size:11px; color:#64748b; margin-left:6px; font-weight:600;">• ${r.fileType}</span>
            <b style="font-size:15px; color:#0f172a; display:block; margin:6px 0 4px 0;">${r.title}</b>
            <small style="color:#64748b; font-weight:600;"><i class="far fa-calendar-alt"></i> ${r.date}</small>
          </div>
        </div>
        <button class="btn-delete" onclick="delPost('${r.docId}')"><i class="fas fa-trash"></i> Delete</button>
      </div>`;
    });
    document.getElementById('postList').innerHTML = h;
  } catch (err) {
    showLoader(false);
    document.getElementById('postList').innerHTML = "<p style='color:red; text-align:center;'>Failed to load posts.</p>";
  }
}
</script>
