// ============================================================================
function clearSelectedFile() {
  document.getElementById('upFile').value = "";
  document.getElementById('filePreviewBox').style.display = "none";
  preparedFilePayload = null;
}

function handleFilePreview(input) {
  if (!input.files || input.files.length === 0) {
    clearSelectedFile();
    return;
  }
  var file = input.files[0];
  var previewBox = document.getElementById('filePreviewBox');
  var previewImg = document.getElementById('previewImg');
  var previewMeta = document.getElementById('previewMeta');

  if (file.type.startsWith("image/")) {
    previewMeta.innerHTML = `<i class="fas fa-spinner fa-spin"></i> Optimizing image for Turbo Upload...`;
    previewBox.style.display = "flex";

    var reader = new FileReader();
    reader.onload = function(e) {
      var img = new Image();
      img.onload = function() {
        var maxDim = 1280;
        var w = img.width;
        var h = img.height;
        if (w > maxDim || h > maxDim) {
          if (w > h) {
            h = Math.round((h * maxDim) / w);
            w = maxDim;
          } else {
            w = Math.round((w * maxDim) / h);
            h = maxDim;
          }
        }
        var canvas = document.createElement('canvas');
        canvas.width = w;
        canvas.height = h;
        var ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, w, h);

        var dataUrl = canvas.toDataURL('image/jpeg', 0.85);
        previewImg.src = dataUrl;
        var kbSize = Math.round((dataUrl.length * 0.75) / 1024);
        var cleanName = file.name.replace(/\.[^/.]+$/, "") + ".jpg";

        preparedFilePayload = {
          isImage: true,
          fileData: dataUrl.split(',')[1],
          mimeType: 'image/jpeg',
          fileName: cleanName
        };
        previewMeta.innerHTML = `<b>${cleanName}</b><br>⚡ Turbo Ready (${w}×${h}px • ~${kbSize} KB)`;
      };
      img.src = e.target.result;
    };
    reader.readAsDataURL(file);
  } else {
    previewImg.src = "https://cdn-icons-png.flaticon.com/512/337/337946.png";
    previewMeta.innerHTML = `<i class="fas fa-spinner fa-spin"></i> Reading document...`;
    previewBox.style.display = "flex";

    var reader = new FileReader();
    reader.onload = function(e) {
      var kbSize = Math.round(file.size / 1024);
      preparedFilePayload = {
        isImage: false,
        fileData: e.target.result.split(',')[1],
        mimeType: file.type || 'application/octet-stream',
        fileName: file.name
      };
      previewMeta.innerHTML = `<b>${file.name}</b><br>✅ Document Ready (${kbSize} KB)`;
    };
    reader.readAsDataURL(file);
  }
}

