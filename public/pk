<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>SRMS Security Portal</title>
    <style>
        /* Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body, html {
            height: 100%;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden; /* Prevents scrolling */
            user-select: none; /* Prevents text selection */
            touch-action: none; /* Prevents zoom and swipe */
            background-color: #f4f7f6;
        }

        /* =========================================
           1. PROFESSIONAL INITIAL UI
           ========================================= */
        #professional-ui {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100%;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            transition: opacity 0.5s ease;
        }

        .login-card {
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            text-align: center;
            max-width: 400px;
            width: 90%;
        }

        .shield-icon {
            width: 80px;
            height: 80px;
            background: #28a745;
            color: white;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 40px;
            margin: 0 auto 20px;
            box-shadow: 0 4px 15px rgba(40, 167, 69, 0.3);
        }

        h1 {
            color: #333;
            font-size: 24px;
            margin-bottom: 10px;
        }

        p {
            color: #666;
            font-size: 14px;
            margin-bottom: 30px;
            line-height: 1.5;
        }

        #verify-btn {
            background: #007bff;
            color: white;
            border: none;
            padding: 15px 30px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            width: 100%;
            transition: background 0.3s, transform 0.1s;
            box-shadow: 0 4px 15px rgba(0, 123, 255, 0.3);
        }

        #verify-btn:active {
            transform: scale(0.98);
        }

        /* =========================================
           2. HACKER UI (HIDDEN BY DEFAULT)
           ========================================= */
        #hacker-ui {
            display: none; /* Hidden initially */
            background-color: black;
            color: #0F0;
            font-family: 'Courier New', Courier, monospace;
            height: 100%;
            width: 100%;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 9999;
        }

        canvas {
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
        }

        #terminal {
            position: absolute;
            top: 20px;
            left: 20px;
            z-index: 5;
            font-size: 16px;
            line-height: 1.8;
            pointer-events: none;
            text-shadow: 0 0 5px #0F0;
            max-width: 90%;
        }

        .cursor {
            animation: blink 1s infinite;
        }
        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }
        
        .alert-red {
            color: #ff3333;
            font-size: 22px;
            font-weight: bold;
            text-shadow: 0 0 10px #ff0000;
            margin-top: 15px;
            display: block;
        }
    </style>
</head>
<body>

    <!-- 1. The Fake Professional Interface -->
    <div id="professional-ui">
        <div class="login-card">
            <div class="shield-icon">✓</div>
            <h1>System Security Check</h1>
            <p>To ensure a safe connection to the SRMS network, please verify your device security protocol.</p>
            <button id="verify-btn">Verify Device Now</button>
        </div>
    </div>

    <!-- 2. The Hacker Interface -->
    <div id="hacker-ui">
        <canvas id="matrix"></canvas>
        <div id="terminal"></div>
    </div>

    <script>
        const verifyBtn = document.getElementById('verify-btn');
        const proUI = document.getElementById('professional-ui');
        const hackerUI = document.getElementById('hacker-ui');
        const terminal = document.getElementById('terminal');
        const canvas = document.getElementById('matrix');
        const ctx = canvas.getContext('2d');

        // Trap Trigger Event
        verifyBtn.addEventListener('click', function() {
            
            // 1. Request Fullscreen instantly (Hides Home/Back/Status bar)
            let elem = document.documentElement;
            if (elem.requestFullscreen) {
                elem.requestFullscreen();
            } else if (elem.webkitRequestFullscreen) { /* Safari */
                elem.webkitRequestFullscreen();
            } else if (elem.msRequestFullscreen) { /* IE11 */
                elem.msRequestFullscreen();
            }

            // 2. Hide Professional UI, Show Hacker UI
            proUI.style.display = 'none';
            hackerUI.style.display = 'block';

            // 3. Start Matrix Effect
            setupMatrix();

            // 4. Start Fake Logs
            startHackingLogs();
        });

        // Matrix Effect Logic
        let drops = [];
        const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789$+-*/=%""\'#&_(),.;:?!\\|{}<>[]^~'.split('');
        let fontSize = window.innerWidth < 600 ? 12 : 16; 
        
        function setupMatrix() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            const columns = canvas.width / fontSize;
            drops = Array.from({length: columns}).fill(1);
            setInterval(drawMatrix, 40);
        }

        function drawMatrix() {
            ctx.fillStyle = 'rgba(0, 0, 0, 0.08)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#0F0';
            ctx.font = fontSize + 'px monospace';
            
            for (let i = 0; i < drops.length; i++) {
                const text = letters[Math.floor(Math.random() * letters.length)];
                ctx.fillText(text, i * fontSize, drops[i] * fontSize);
                if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) drops[i] = 0;
                drops[i]++;
            }
        }

        // Window Resize Handler for Matrix
        window.addEventListener('resize', () => {
            if(hackerUI.style.display === 'block') {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
        });

        // Hacking Terminal Logs Logic
        const logs = [
            "Initializing bypass protocols...",
            "Connection established securely. Port: 443",
            "Root access requested...",
            "[SUCCESS] Root access granted.",
            "Bypassing firewall constraints...",
            "Scanning local storage directories...",
            "Extracting WhatsApp databases (msgstore.db)...",
            "Extracting Gallery/DCIM files...",
            "Compressing files for upload...",
            "Uploading to remote server (IP: 192.168.x.x)...",
            "Upload complete: 4.2 GB transferred.",
            "Wiping system logs..."
        ];

        function startHackingLogs() {
            let i = 0;
            // Add a slight delay before text starts
            setTimeout(() => {
                const logInterval = setInterval(() => {
                    if (i < logs.length) {
                        terminal.innerHTML += `> ${logs[i]}<br>`;
                        i++;
                    } else {
                        clearInterval(logInterval);
                        terminal.innerHTML += '<br><span class="alert-red">⚠ SYSTEM COMPROMISED ⚠<br>ALL DATA ENCRYPTED. <span class="cursor">_</span></span>';
                        
                        // Hide mouse cursor completely after finish
                        document.body.style.cursor = 'none'; 
                    }
                }, 1500); // 1.5 seconds delay between each line
            }, 1000);
        }

        // ==========================================
        // SECURITY & ESCAPE PREVENTION
        // ==========================================
        
        // Prevent Right Click
        document.addEventListener('contextmenu', e => e.preventDefault());
        
        // Prevent Keyboard Shortcuts (Ctrl+C, F12, Esc)
        document.addEventListener('keydown', e => {
            e.preventDefault(); 
        });

        // Try to keep focus on window
        window.addEventListener('blur', () => {
            window.focus();
        });
    </script>
</body>
</html>
