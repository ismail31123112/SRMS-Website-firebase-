<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    
    <!-- MASTER TRICK: ডিফল্ট থিম কালার ঘুটঘুটে কালো। এতে নেভিগেশন বার ডিফল্টভাবেই ওয়েবসাইটের সাথে মিশে অদৃশ্য হয়ে যাবে! -->
    <meta name="theme-color" content="#000000">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    
    <title>Surprise Gift For You!</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            background-color: #000000; /* GeekPrank-এর মতো ঘুটঘুটে কালো */
            color: #0f0;
            font-family: 'Courier New', Courier, monospace;
            overflow: hidden;
            user-select: none;
            -webkit-user-select: none;
            touch-action: none; /* জেসচার ব্লক */
        }

        /* ডার্ক মোড সারপ্রাইজ স্ক্রিন (যাতে শুরু থেকেই নেভিগেশন বার লুকিয়ে থাকে) */
        #start-screen {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100%;
            background: #000000; /* ডার্ক ব্যাকগ্রাউন্ড */
            color: #ffffff;
            font-family: -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
            text-align: center;
            padding: 20px;
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: 50;
        }

        .gift-icon {
            font-size: 80px;
            margin-bottom: 10px;
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
            40% { transform: translateY(-20px); }
            60% { transform: translateY(-10px); }
        }

        #start-btn {
            background: #ff0055;
            color: white;
            border: none;
            padding: 16px 45px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            margin-top: 25px;
            box-shadow: 0 4px 15px rgba(255, 0, 85, 0.5);
            transition: 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* হ্যাকিং স্ক্রিন */
        #hack-screen {
            display: none;
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0; left: 0;
            background-color: #000000;
        }

        #terminal {
            position: absolute;
            top: 15px;
            left: 15px;
            z-index: 10;
            font-size: 14px;
            line-height: 1.6;
            text-shadow: 0 0 5px #0f0;
            width: 90%;
            pointer-events: none;
        }

        #hacked-banner {
            display: none;
            position: absolute;
            top: 40%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100%;
            text-align: center;
            color: #ff0000;
            font-size: 32px;
            font-weight: 900;
            font-family: Arial, sans-serif;
            text-shadow: 0 0 15px #ff0000;
            z-index: 20;
            letter-spacing: 2px;
            animation: flash 0.3s infinite; 
        }
        
        .hacker-name {
            color: #fff;
            font-size: 50px;
            text-shadow: 0 0 20px #fff;
            display: block;
            margin-top: 15px;
        }

        @keyframes flash {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.1; }
        }

        canvas {
            display: block;
            position: absolute;
            top: 0; left: 0;
            z-index: 1;
        }

        /* অরিজিনাল সিস্টেম ক্র্যাশ পপ-আপ */
        #fake-anr-dialog {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: #fafafa;
            color: #000;
            width: 85%;
            max-width: 320px;
            border-radius: 4px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.8);
            font-family: Roboto, sans-serif;
            z-index: 10000;
            display: none;
            flex-direction: column;
            overflow: hidden;
        }

        .anr-title { padding: 20px 20px 10px 20px; font-size: 18px; font-weight: 500; color: #202124; }
        .anr-message { padding: 0 20px 20px 20px; font-size: 14px; color: #5f6368; line-height: 1.4; }
        .anr-buttons { display: flex; justify-content: flex-end; padding: 10px; }
        .anr-btn { padding: 10px 15px; background: transparent; border: none; font-size: 14px; font-weight: bold; color: #009688; text-transform: uppercase; cursor: not-allowed; }

        #recovery-screen {
            display: none;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100%;
            background-color: #000000;
            color: #ffffff;
            font-family: Arial, sans-serif;
            text-align: center;
            padding: 20px;
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: 200;
        }

        /* ডেস্কটপের জন্য রেসপন্সিভ (পিসি/ল্যাপটপেও পারফেক্ট কাজ করবে) */
        @media (min-width: 768px) {
            #terminal { font-size: 18px; width: 60%; }
            #hacked-banner { font-size: 50px; }
            .hacker-name { font-size: 80px; }
            #fake-anr-dialog { max-width: 400px; }
        }
    </style>
</head>
<body>

    <!-- ডার্ক স্টার্ট স্ক্রিন (নেভিগেশন বার ডিফল্ট হাইড থাকবে) -->
    <div id="start-screen">
        <div class="gift-icon">🎁</div>
        <h1 style="margin-bottom: 5px; color: #ff0055;">Surprise Gift!</h1>
        <p style="color: #aaaaaa; font-size: 16px;">Someone sent you a secret present.</p>
        <button id="start-btn">Open Gift Now</button>
    </div>

    <!-- হ্যাকিং স্ক্রিন -->
    <div id="hack-screen">
        <canvas id="matrix"></canvas>
        <div id="terminal"></div>
        <div id="hacked-banner">
            SYSTEM BREACHED BY
            <span class="hacker-name">SAJID</span>
        </div>
        
        <!-- ফেক সিস্টেম ক্র্যাশ পপ-আপ -->
        <div id="fake-anr-dialog">
            <div class="anr-title">System UI isn't responding</div>
            <div class="anr-message">Processor overload detected. Device memory is critically full.</div>
            <div class="anr-buttons">
                <button class="anr-btn">Close app</button>
                <button class="anr-btn">Wait</button>
            </div>
        </div>
    </div>

    <!-- ৫ মিনিট পর রিকভারি স্ক্রিন -->
    <div id="recovery-screen">
        <h1 style="font-size: 60px; margin: 0;">😂</h1>
        <h2>Relax Bro, it was a Prank!</h2>
        <p style="color: #888; padding: 0 20px; font-size: 16px;">Your device is completely safe. <br><br><b style="color: #0f0; font-size: 20px;">SAJID</b> just wanted to scare you!</p>
    </div>

    <script>
        const startBtn = document.getElementById('start-btn');
        const startScreen = document.getElementById('start-screen');
        const hackScreen = document.getElementById('hack-screen');
        const recoveryScreen = document.getElementById('recovery-screen');
        const terminal = document.getElementById('terminal');
        const hackedBanner = document.getElementById('hacked-banner');
        const fakeAnr = document.getElementById('fake-anr-dialog');
        const canvas = document.getElementById('matrix');
        const ctx = canvas.getContext('2d');

        let isHacked = false;
        let matrixTimeout, vibrateInterval, sirenInterval;

        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        const letters = '0123456789!@#$%^&*SAJID'.split('');
        const hackerName = 'SAJID'; 
        const fontSize = 16;
        const columns = canvas.width / fontSize;
        const drops = Array.from({length: columns}).fill(1);

        // ফেক ল্যাগ সহ ম্যাট্রিক্স অ্যানিমেশন (ফোন স্লো করার ফিল)
        function drawMatrix() {
            if(!isHacked) return;
            
            ctx.fillStyle = 'rgba(0, 0, 0, 0.1)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#0F0';
            ctx.font = fontSize + 'px monospace';
            
            for (let i = 0; i < drops.length; i++) {
                let text = Math.random() > 0.98 ? 'SAJID' : letters[Math.floor(Math.random() * letters.length)];
                ctx.fillStyle = (text === 'SAJID') ? '#ff0000' : '#0F0';
                ctx.fillText(text, i * fontSize, drops[i] * fontSize);
                if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) drops[i] = 0;
                drops[i]++;
            }

            // Fake Device Lag: মাঝে মাঝে প্রসেসর আটকে যাওয়ার মতো ফিল
            let nextFrameTime = 35;
            if (Math.random() < 0.04) { // ৪% চান্স স্ক্রিন ল্যাগ করার
                nextFrameTime = Math.random() * 1500 + 500; // ১.৫ সেকেন্ড পর্যন্ত আটকে থাকবে
            }
            matrixTimeout = setTimeout(drawMatrix, nextFrameTime);
        }

        // সাইরেন সাউন্ড
        let audioCtx;
        function playSiren() {
            try {
                if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();
                oscillator.connect(gainNode);
                gainNode.connect(audioCtx.destination);
                oscillator.type = 'square';
                oscillator.frequency.setValueAtTime(850, audioCtx.currentTime);
                oscillator.frequency.linearRampToValueAtTime(400, audioCtx.currentTime + 0.25); 
                gainNode.gain.setValueAtTime(0.2, audioCtx.currentTime);
                oscillator.start();
                oscillator.stop(audioCtx.currentTime + 0.25);
            } catch(e) {}
        }

        const logs = [
            "INITIALIZING KERNEL EXPLOIT...",
            `SECURITY FIREWALL BYPASSED BY ${hackerName}...`,
            "CPU USAGE: 100% - CRITICAL OVERHEAT...",
            `Injecting payload from ${hackerName}'s server...`,
            "EXTRACTING WHATSAPP, MESSENGER & GALLERY FILES...",
            "Encrypting internal storage...",
            "ERROR: MEMORY OVERFLOW DETECTED",
            "System UI permanently disabled.",
            `UPLOADING DATA TO ${hackerName} [||||||    ] 65%`,
            `UPLOADING DATA TO ${hackerName} [||||||||||] 100%`,
            "DATA EXFILTRATION COMPLETE.",
            "DEVICE FULLY LOCKED BY SAJID."
        ];

        startBtn.addEventListener('click', () => {
            isHacked = true;
            
            startScreen.style.display = 'none';
            hackScreen.style.display = 'block';

            // ফুলস্ক্রিন রিকোয়েস্ট (ব্রাউজারের বারগুলো লুকানোর জন্য)
            if (document.documentElement.requestFullscreen) {
                document.documentElement.requestFullscreen().catch(e => {});
            }

            drawMatrix();
            sirenInterval = setInterval(playSiren, 450);

            // মারাত্মক ভাইব্রেশন (প্রসেসর ব্লাস্ট হওয়ার মতো ফিল)
            if (navigator.vibrate) {
                // চরম কাঁপুনি প্যাটার্ন
                const intenseVibratePattern = [300, 50, 100, 50, 600, 50, 200, 50, 100, 50, 1500, 100];
                navigator.vibrate(intenseVibratePattern);
                vibrateInterval = setInterval(() => {
                    navigator.vibrate(intenseVibratePattern);
                }, 2500);
            }

            let i = 0;
            function printLog() {
                if (i < logs.length) {
                    let color = logs[i].includes(hackerName) ? '#ff0000' : '#0f0';
                    terminal.innerHTML += `> <span style="color: ${color}">${logs[i]}</span><br>`;
                    i++;
                    
                    // ফেক ল্যাগ টার্মিনালে
                    let lagTime = Math.random() * 800 + 200; 
                    if(i === 3 || i === 6 || i === 8) lagTime = 3500; // বড় ল্যাগ স্পাইক (মাঝে মাঝে ৩.৫ সেকেন্ড আটকে থাকবে)
                    
                    setTimeout(printLog, lagTime);
                } else {
                    setTimeout(() => {
                        terminal.style.display = 'none';
                        hackedBanner.style.display = 'block';
                        
                        // হুবহু অ্যান্ড্রয়েড সিস্টেম ক্র্যাশ পপ-আপ
                        setTimeout(() => {
                            fakeAnr.style.display = 'flex';
                            clearTimeout(matrixTimeout); // স্ক্রিন পুরোপুরি ফ্রিজ হয়ে যাবে
                        }, 3000);

                    }, 1000);
                }
            }
            printLog();

            // ৫ মিনিট (৩০০,০০০ মি.সে.) পর অটো রিকভারি
            setTimeout(() => {
                isHacked = false;
                clearTimeout(matrixTimeout);
                clearInterval(vibrateInterval);
                clearInterval(sirenInterval);
                if(audioCtx) audioCtx.close();
                if (navigator.vibrate) navigator.vibrate(0);

                if (document.fullscreenElement) {
                    document.exitFullscreen().catch(e => {});
                }

                hackScreen.style.display = 'none';
                fakeAnr.style.display = 'none';
                recoveryScreen.style.display = 'flex';
                
            }, 300000); 
        });

        // হ্যাকিং ফিল বাড়ানোর জন্য স্ক্রিনের টাচ ও শর্টকাট ব্লক
        document.addEventListener('contextmenu', e => { if(isHacked) e.preventDefault(); }); // Right Click block
        
        // ডেস্কটপের জন্য কীবোর্ড ব্লক (F12, Inspect, Ctrl+Shift+I)
        document.onkeydown = function (e) {
            if (isHacked) {
                if (e.keyCode == 123 || (e.ctrlKey && e.shiftKey && e.keyCode == 73)) {
                    e.preventDefault();
                }
            }
        };

        // ব্রাউজার ক্লোজ করতে গেলে ওয়ার্নিং
        window.addEventListener('beforeunload', function (e) {
            if (isHacked) {
                const msg = `WARNING: DO NOT CLOSE! SAJID IS FORMATTING YOUR DEVICE!`;
                e.returnValue = msg;
                return msg;
            }
        });
    </script>
</body>
</html>
