<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <!-- viewport-fit=cover forces the webpage to go under the nav bar and notch -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    
    <!-- Forces the OS status bar and nav bar area to be pitch black -->
    <meta name="theme-color" content="#000000">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    
    <title>Surprise Gift For You!</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            background-color: #000000;
            color: #0f0;
            font-family: 'Courier New', Courier, monospace;
            overflow: hidden;
            user-select: none;
            touch-action: none; /* Prevents all default browser swiping/scrolling */
        }

        /* 1. Beautiful Surprise Start Screen */
        #start-screen {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100%;
            background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%);
            color: #333;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            text-align: center;
            padding: 20px;
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: 50;
        }

        .gift-icon {
            font-size: 80px;
            margin-bottom: 10px;
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
            40% { transform: translateY(-20px); }
            60% { transform: translateY(-10px); }
        }

        #start-btn {
            background: linear-gradient(to right, #ff416c, #ff4b2b);
            color: white;
            border: none;
            padding: 15px 35px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
            margin-top: 25px;
            box-shadow: 0 4px 15px rgba(255, 65, 108, 0.4);
            transition: 0.3s;
        }

        #start-btn:active {
            transform: scale(0.95);
        }

        /* 2. Scary Hack Screen */
        #hack-screen {
            display: none;
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0; left: 0;
            background-color: #000000;
        }

        #terminal {
            position: absolute;
            top: 15px;
            left: 15px;
            z-index: 10;
            font-size: 14px;
            line-height: 1.6;
            text-shadow: 0 0 5px #0f0;
            width: 90%;
            pointer-events: none;
        }

        /* Professional Hacker Banner */
        #hacked-banner {
            display: none;
            position: absolute;
            top: 40%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100%;
            text-align: center;
            color: #ff0000;
            font-size: 32px;
            font-weight: 900;
            font-family: Arial, sans-serif;
            text-shadow: 0 0 15px #ff0000, 0 0 30px #ff0000;
            z-index: 20;
            letter-spacing: 2px;
            animation: flash 1s infinite;
        }
        
        .hacker-name {
            color: #fff;
            font-size: 40px;
            text-shadow: 0 0 10px #fff;
            display: block;
            margin-top: 10px;
        }

        @keyframes flash {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }

        /* 
           OPTICAL ILLUSION: The Camouflage Footer 
           This area stays pitch black at the absolute bottom. 
           If the user swipes up, the OS nav bar (which is usually black) 
           will perfectly blend into this area, making it invisible!
        */
        #bottom-camouflage {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: max(60px, env(safe-area-inset-bottom));
            background-color: #000000;
            z-index: 9999;
            pointer-events: none;
            box-shadow: 0 -20px 30px #000000; /* Blends smoothly upwards */
        }

        /* Screen Edge Darkener */
        .screen-edge-darkener {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            box-shadow: inset 0 0 50px #000000;
            pointer-events: none;
            z-index: 100;
        }

        canvas {
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
        }

        /* 3. Recovery Screen (After 5 mins) */
        #recovery-screen {
            display: none;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100%;
            background-color: #ffffff;
            color: #000;
            font-family: Arial, sans-serif;
            text-align: center;
            padding: 20px;
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: 200;
        }
    </style>
</head>
<body>

    <div id="start-screen">
        <div class="gift-icon">🎁</div>
        <h1 style="margin-bottom: 5px; color: #ff4b2b;">Surprise Gift!</h1>
        <p style="color: #555; font-size: 16px; font-weight: bold;">Someone sent you a secret present.</p>
        <p style="color: #777; font-size: 13px;">Tap the button below to open it.</p>
        <button id="start-btn">Open Gift Now</button>
    </div>

    <div id="hack-screen">
        <!-- The Camouflage Layer for Navigation Bar -->
        <div id="bottom-camouflage"></div>
        
        <div class="screen-edge-darkener"></div>
        <canvas id="matrix"></canvas>
        <div id="terminal"></div>
        
        <div id="hacked-banner">
            DEVICE FULLY HACKED BY
            <span class="hacker-name">[তোমার নাম]</span>
        </div>
    </div>

    <div id="recovery-screen">
        <h1 style="font-size: 50px; margin: 0;">😂</h1>
        <h2>Bro, it was just a Prank!</h2>
        <p style="color: #666; padding: 0 20px;">Your phone is completely safe. <br><b>[তোমার নাম]</b> just wanted to scare you!</p>
    </div>

    <script>
        const startBtn = document.getElementById('start-btn');
        const startScreen = document.getElementById('start-screen');
        const hackScreen = document.getElementById('hack-screen');
        const recoveryScreen = document.getElementById('recovery-screen');
        const terminal = document.getElementById('terminal');
        const hackedBanner = document.getElementById('hacked-banner');
        const canvas = document.getElementById('matrix');
        const ctx = canvas.getContext('2d');

        let isHacked = false;
        let matrixInterval, vibrateInterval, sirenInterval;

        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        const letters = '0123456789!@#$%^&*'.split('');
        const hackerName = '[তোমার নাম]'; 
        const fontSize = 14;
        const columns = canvas.width / fontSize;
        const drops = Array.from({length: columns}).fill(1);

        function drawMatrix() {
            ctx.fillStyle = 'rgba(0, 0, 0, 0.08)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#0F0';
            ctx.font = fontSize + 'px monospace';
            
            for (let i = 0; i < drops.length; i++) {
                let text = Math.random() > 0.95 ? hackerName : letters[Math.floor(Math.random() * letters.length)];
                if (text === hackerName) {
                    ctx.fillStyle = '#ff0000';
                } else {
                    ctx.fillStyle = '#0F0';
                }

                ctx.fillText(text, i * fontSize, drops[i] * fontSize);
                if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) drops[i] = 0;
                drops[i]++;
            }
        }

        let audioCtx;
        function playSiren() {
            try {
                if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();
                oscillator.connect(gainNode);
                gainNode.connect(audioCtx.destination);
                oscillator.type = 'sawtooth';
                oscillator.frequency.setValueAtTime(600, audioCtx.currentTime);
                oscillator.frequency.linearRampToValueAtTime(1000, audioCtx.currentTime + 0.5);
                gainNode.gain.setValueAtTime(0.15, audioCtx.currentTime);
                oscillator.start();
                oscillator.stop(audioCtx.currentTime + 0.5);
            } catch(e) {}
        }

        const logs = [
            "ACCESSING ROOT SYSTEM DIRECTORY...",
            "SECURITY FIREWALL BREACHED BY [তোমার নাম]...",
            "Overriding Android OS protocols...",
            "Injecting payload from [তোমার নাম]'s server...",
            "FETCHING WHATSAPP MESSAGES...",
            "DOWNLOADING DCIM/GALLERY FILES...",
            "System UI permanently disabled.",
            "Transferring data to [তোমার নাম]'s Cloud Drive...",
            "UPLOADING [||||||||          ] 34%",
            "UPLOADING [||||||||||||||    ] 89%",
            "UPLOADING [||||||||||||||||||] 100%",
            "DATA EXFILTRATION COMPLETE.",
            "WARNING: DEVICE CONTROL TAKEN OVER BY [তোমার নাম]!"
        ];

        startBtn.addEventListener('click', () => {
            isHacked = true;
            
            startScreen.style.display = 'none';
            hackScreen.style.display = 'block';

            if (document.documentElement.requestFullscreen) {
                document.documentElement.requestFullscreen();
            }

            matrixInterval = setInterval(drawMatrix, 35);
            sirenInterval = setInterval(playSiren, 600);

            if (navigator.vibrate) {
                vibrateInterval = setInterval(() => navigator.vibrate([1000, 200, 1000, 200]), 2400);
            }

            let i = 0;
            function printLog() {
                if (i < logs.length) {
                    terminal.innerHTML += `> <span style="color: ${logs[i].includes('[তোমার নাম]') ? '#ff0000' : '#0f0'}">${logs[i]}</span><br>`;
                    i++;
                    
                    let lagTime = Math.random() * 800 + 400; 
                    if(i === 7 || i === 10) lagTime = 2000; 
                    
                    setTimeout(printLog, lagTime);
                } else {
                    setTimeout(() => {
                        terminal.style.display = 'none';
                        hackedBanner.style.display = 'block';
                    }, 1000);
                }
            }
            printLog();

            // 5 MINUTES RECOVERY
            setTimeout(() => {
                isHacked = false;
                
                clearInterval(matrixInterval);
                clearInterval(vibrateInterval);
                clearInterval(sirenInterval);
                if(audioCtx) audioCtx.close();
                if (navigator.vibrate) navigator.vibrate(0);

                if (document.fullscreenElement) {
                    document.exitFullscreen().catch(err => console.log(err));
                }

                hackScreen.style.display = 'none';
                recoveryScreen.style.display = 'flex';
                
            }, 300000); // 300,000 ms = 5 Minutes
        });

        // BLOCKING EDGE SWIPES & NAVIGATION GESTURES
        document.addEventListener('touchstart', function(e) {
            if (isHacked) e.preventDefault();
        }, {passive: false});

        document.addEventListener('touchmove', function(e) {
            if (isHacked) e.preventDefault();
        }, {passive: false});
        
        document.addEventListener('contextmenu', e => e.preventDefault());

        window.addEventListener('beforeunload', function (e) {
            if (isHacked) {
                const msg = "WARNING: IF YOU CLOSE THIS, [তোমার নাম] WILL DELETE ALL YOUR FILES!";
                e.returnValue = msg;
                return msg;
            }
        });
    </script>
</body>
</html>
