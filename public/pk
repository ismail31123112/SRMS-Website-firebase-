<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    
    <!-- শুরুতে সুন্দর কালার, হ্যাক হলে ঘুটঘুটে কালো হবে যাতে নেভিগেশন বার মিশে যায় -->
    <meta id="theme-color-meta" name="theme-color" content="#fecfef"> 
    
    <title>Surprise Gift For You!</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            background-color: #fecfef; 
            color: #0f0;
            font-family: 'Courier New', Courier, monospace;
            overflow: hidden;
            user-select: none;
            touch-action: none;
            -webkit-user-select: none;
        }

        #start-screen {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100%;
            background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%);
            color: #333;
            font-family: -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
            text-align: center;
            padding: 20px;
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: 50;
        }

        .gift-icon {
            font-size: 80px;
            margin-bottom: 10px;
            animation: bounce 2s infinite;
        }

        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
            40% { transform: translateY(-20px); }
            60% { transform: translateY(-10px); }
        }

        #start-btn {
            background: linear-gradient(to right, #ff416c, #ff4b2b);
            color: white;
            border: none;
            padding: 15px 35px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
            margin-top: 25px;
            box-shadow: 0 4px 15px rgba(255, 65, 108, 0.4);
            transition: 0.3s;
        }

        /* হ্যাকিং স্ক্রিন একদম ঘুটঘুটে কালো */
        #hack-screen {
            display: none;
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0; left: 0;
            background-color: #000000;
            padding-bottom: env(safe-area-inset-bottom); /* নেভিগেশন বারের সাথে মেশানোর ট্রিক */
        }

        #terminal {
            position: absolute;
            top: 15px;
            left: 15px;
            z-index: 10;
            font-size: 14px;
            line-height: 1.6;
            text-shadow: 0 0 5px #0f0;
            width: 90%;
            pointer-events: none;
        }

        #hacked-banner {
            display: none;
            position: absolute;
            top: 40%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100%;
            text-align: center;
            color: #ff0000;
            font-size: 32px;
            font-weight: 900;
            font-family: Arial, sans-serif;
            text-shadow: 0 0 15px #ff0000;
            z-index: 20;
            letter-spacing: 2px;
            animation: flash 0.5s infinite; /* অনেক দ্রুত ফ্ল্যাশ করবে, প্যানিক তৈরির জন্য */
        }
        
        .hacker-name {
            color: #fff;
            font-size: 40px;
            text-shadow: 0 0 10px #fff;
            display: block;
            margin-top: 10px;
        }

        @keyframes flash {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.1; }
        }

        canvas {
            display: block;
            position: absolute;
            top: 0; left: 0;
            z-index: 1;
        }

        /* হুবহু অ্যান্ড্রয়েডের System UI ক্র্যাশ পপ-আপ */
        #fake-anr-dialog {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: #fafafa;
            color: #000;
            width: 85%;
            max-width: 320px;
            border-radius: 4px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            font-family: Roboto, sans-serif;
            z-index: 9999;
            display: none;
            flex-direction: column;
            overflow: hidden;
        }

        .anr-title { padding: 20px 20px 10px 20px; font-size: 18px; font-weight: 500; color: #202124; }
        .anr-message { padding: 0 20px 20px 20px; font-size: 14px; color: #5f6368; line-height: 1.4; }
        .anr-buttons { display: flex; justify-content: flex-end; padding: 10px; }
        .anr-btn { padding: 10px 15px; background: transparent; border: none; font-size: 14px; font-weight: bold; color: #009688; text-transform: uppercase; cursor: not-allowed; }

        #recovery-screen {
            display: none;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100%;
            background-color: #ffffff;
            color: #000;
            font-family: Arial, sans-serif;
            text-align: center;
            padding: 20px;
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: 200;
        }
    </style>
</head>
<body>

    <div id="start-screen">
        <div class="gift-icon">🎁</div>
        <h1 style="margin-bottom: 5px; color: #ff4b2b;">Surprise Gift!</h1>
        <p style="color: #555; font-size: 16px; font-weight: bold;">Someone sent you a secret present.</p>
        <button id="start-btn">Open Gift Now</button>
    </div>

    <div id="hack-screen">
        <canvas id="matrix"></canvas>
        <div id="terminal"></div>
        <div id="hacked-banner">
            DEVICE HACKED BY
            <span class="hacker-name">Sajid</span>
        </div>
        
        <!-- Fake System Crash Popup (Lag effect) -->
        <div id="fake-anr-dialog">
            <div class="anr-title">System UI isn't responding</div>
            <div class="anr-message">System processor is critically overloaded. Close app or wait?</div>
            <div class="anr-buttons">
                <button class="anr-btn">Close app</button>
                <button class="anr-btn">Wait</button>
            </div>
        </div>
    </div>

    <div id="recovery-screen">
        <h1 style="font-size: 50px; margin: 0;">😂</h1>
        <h2>Bro, it was just a Prank!</h2>
        <p style="color: #666; padding: 0 20px;">Your phone is completely safe. <br><b>Sajid</b> just wanted to scare you!</p>
    </div>

    <script>
        const startBtn = document.getElementById('start-btn');
        const startScreen = document.getElementById('start-screen');
        const hackScreen = document.getElementById('hack-screen');
        const recoveryScreen = document.getElementById('recovery-screen');
        const terminal = document.getElementById('terminal');
        const hackedBanner = document.getElementById('hacked-banner');
        const fakeAnr = document.getElementById('fake-anr-dialog');
        const canvas = document.getElementById('matrix');
        const ctx = canvas.getContext('2d');
        const themeMeta = document.getElementById('theme-color-meta');

        let isHacked = false;
        let matrixTimeout, vibrateInterval, sirenInterval;

        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        const letters = '0123456789!@#$%^&*'.split('');
        const hackerName = 'Sajid'; 
        const fontSize = 14;
        const columns = canvas.width / fontSize;
        const drops = Array.from({length: columns}).fill(1);

        // Fake Lag Function for Matrix Animation
        function drawMatrix() {
            if(!isHacked) return;
            
            ctx.fillStyle = 'rgba(0, 0, 0, 0.08)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = '#0F0';
            ctx.font = fontSize + 'px monospace';
            
            for (let i = 0; i < drops.length; i++) {
                let text = Math.random() > 0.95 ? hackerName : letters[Math.floor(Math.random() * letters.length)];
                ctx.fillStyle = (text === hackerName) ? '#ff0000' : '#0F0';
                ctx.fillText(text, i * fontSize, drops[i] * fontSize);
                if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) drops[i] = 0;
                drops[i]++;
            }

            // Fake Device Lag: Randomly pause the animation for 0.5s to 1.5s to simulate processor hang
            let nextFrameTime = 35;
            if (Math.random() < 0.02) { // 2% chance per frame to cause a massive lag spike
                nextFrameTime = Math.random() * 1000 + 500; 
            }
            matrixTimeout = setTimeout(drawMatrix, nextFrameTime);
        }

        let audioCtx;
        function playSiren() {
            try {
                if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();
                oscillator.connect(gainNode);
                gainNode.connect(audioCtx.destination);
                oscillator.type = 'sawtooth';
                oscillator.frequency.setValueAtTime(800, audioCtx.currentTime);
                oscillator.frequency.linearRampToValueAtTime(1200, audioCtx.currentTime + 0.3); // Faster, scarier siren
                gainNode.gain.setValueAtTime(0.2, audioCtx.currentTime);
                oscillator.start();
                oscillator.stop(audioCtx.currentTime + 0.3);
            } catch(e) {}
        }

        const logs = [
            "ACCESSING ROOT SYSTEM...",
            `FIREWALL BYPASSED BY ${hackerName}...`,
            "CPU USAGE: 99% - OVERHEATING...",
            `Injecting malware from ${hackerName}'s server...`,
            "DOWNLOADING GALLERY FILES...",
            "Encrypting internal storage...",
            "ERROR: MEMORY LEAK DETECTED",
            "System UI permanently disabled.",
            `UPLOADING DATA TO ${hackerName} [||||||    ] 45%`,
            `UPLOADING DATA TO ${hackerName} [||||||||||] 100%`,
            "DATA EXFILTRATION COMPLETE.",
            "DEVICE LOCKED."
        ];

        startBtn.addEventListener('click', () => {
            isHacked = true;
            
            // হ্যাকিং শুরু হলে নেভিগেশন বারের ব্যাকগ্রাউন্ড ঘুটঘুটে কালো করে দেবে
            themeMeta.setAttribute('content', '#000000'); 
            
            startScreen.style.display = 'none';
            hackScreen.style.display = 'block';

            if (document.documentElement.requestFullscreen) {
                document.documentElement.requestFullscreen().catch(e => {});
            }

            drawMatrix();
            sirenInterval = setInterval(playSiren, 400);

            // মারাত্মক ভাইব্রেশন: পাগলের মতো কাঁপবে
            if (navigator.vibrate) {
                const intenseVibratePattern = [200, 50, 100, 50, 500, 50, 200, 50, 100, 50, 1000, 100];
                navigator.vibrate(intenseVibratePattern);
                vibrateInterval = setInterval(() => {
                    navigator.vibrate(intenseVibratePattern);
                }, 2500);
            }

            let i = 0;
            function printLog() {
                if (i < logs.length) {
                    let color = logs[i].includes(hackerName) ? '#ff0000' : '#0f0';
                    terminal.innerHTML += `> <span style="color: ${color}">${logs[i]}</span><br>`;
                    i++;
                    
                    // ফেক ল্যাগ: টার্মিনালের লেখাও মাঝে মাঝে আটকে আটকে আসবে
                    let lagTime = Math.random() * 500 + 200; 
                    if(i === 3 || i === 7) lagTime = 2500; // বড় ল্যাগ
                    
                    setTimeout(printLog, lagTime);
                } else {
                    setTimeout(() => {
                        terminal.style.display = 'none';
                        hackedBanner.style.display = 'block';
                        
                        // হ্যাকিং শেষ হওয়ার একটু পর ফেক সিস্টেম ক্র্যাশ পপ-আপ আসবে!
                        setTimeout(() => {
                            fakeAnr.style.display = 'flex';
                            clearTimeout(matrixTimeout); // ম্যাট্রিক্স ফ্রিজ করে দেবে যাতে মনে হয় ফোন হ্যাং করেছে
                        }, 2000);

                    }, 1000);
                }
            }
            printLog();

            // ৫ মিনিট পর অটো রিকভারি
            setTimeout(() => {
                isHacked = false;
                themeMeta.setAttribute('content', '#ffffff');
                clearTimeout(matrixTimeout);
                clearInterval(vibrateInterval);
                clearInterval(sirenInterval);
                if(audioCtx) audioCtx.close();
                if (navigator.vibrate) navigator.vibrate(0);

                if (document.fullscreenElement) {
                    document.exitFullscreen().catch(e => {});
                }

                hackScreen.style.display = 'none';
                fakeAnr.style.display = 'none';
                recoveryScreen.style.display = 'flex';
                
            }, 300000); 
        });

        // সোয়াইপ এবং টাচ ব্লক (ফোন হ্যাং হওয়ার ফিলিংস দেওয়ার জন্য)
        document.addEventListener('touchstart', function(e) { if (isHacked) e.preventDefault(); }, {passive: false});
        document.addEventListener('touchmove', function(e) { if (isHacked) e.preventDefault(); }, {passive: false});
        document.addEventListener('contextmenu', e => e.preventDefault());

        window.addEventListener('beforeunload', function (e) {
            if (isHacked) {
                const msg = `WARNING: DO NOT CLOSE! ${hackerName} IS FORMATTING YOUR DEVICE!`;
                e.returnValue = msg;
                return msg;
            }
        });
    </script>
</body>
</html>
