// ============================================================================
// 🧾 2. PRINT OFFICIAL DUAL-COPY RECEIPT ON 1 SINGLE A4 SHEET (GUARDIAN + OFFICE)
// ============================================================================
function printGeneratedReceipt() {
  if (!currentReceiptData) return;
  let d = currentReceiptData;
  let items = (d.itemsList || []).map(i => {
    let payable = parseFloat(i.original) || 0;
    let paid = parseFloat(i.paid) || parseFloat(i.amount) || payable;
    let dueAmt = Math.max(0, payable - paid);
    return `<tr>
      <td style="font-weight:700; color:#0f172a;">${i.title}</td>
      <td style="text-align:right;">৳ ${payable.toFixed(2)}</td>
      <td style="text-align:right; font-weight:800; color:#005f40;">৳ ${paid.toFixed(2)}</td>
      <td style="text-align:right; font-weight:700; color:#b91c1c;">৳ ${dueAmt.toFixed(2)}</td>
    </tr>`;
  }).join('');

  let secStr = d.section ? ` (Sec: ${d.section})` : "";
  let catStr = d.category ? ` • ${d.category}` : "";

  let copiesHtml = [
    "STUDENT / GUARDIAN COPY (অভিভাবক কপি)",
    "OFFICE COPY (অফিস কপি)"
  ].map((copyLabel, idx) => `
    <div class="rcp-box">
      <div class="rcp-top-zone">
        <div class="rcp-header">
          <div class="rcp-header-left">
            <img src="${DEFAULT_STUDENT_AVATAR}" style="width:42px; height:42px; border-radius:50%; border:2px solid #005f40; padding:1.5px;">
            <div class="rcp-header-text">
              <h2>SAIDPUR RESIDENTIAL MODEL SCHOOL</h2>
              <p>Sultan Nagar, Saidpur, Nilphamari | Official Fee Payment Receipt</p>
            </div>
          </div>
          <div class="rcp-tag">${copyLabel}</div>
        </div>

        <div class="rcp-info-grid">
          <div>
            <div><b>Receipt No:</b> <span style="color:#005f40; font-weight:800;">${d.rNo}</span></div>
            <div><b>Student ID:</b> ${d.id}${catStr}</div>
            <div><b>Student Name:</b> <span style="text-transform:uppercase; font-weight:800;">${d.name}</span></div>
          </div>
          <div style="text-align:right;">
            <div><b>Date:</b> ${d.date}</div>
            <div><b>Class:</b> Class ${d.class}${secStr} (Roll: ${d.roll})</div>
            <div><b>Billing Period:</b> ${d.month} ${d.year}</div>
          </div>
        </div>

        <table class="rcp-table">
          <thead>
            <tr>
              <th>Fee Particulars (ফি-এর বিবরণ)</th>
              <th style="text-align:right; width:105px;">Payable (TK)</th>
              <th style="text-align:right; width:105px;">Paid Now (TK)</th>
              <th style="text-align:right; width:105px;">Due (TK)</th>
            </tr>
          </thead>
          <tbody>${items}</tbody>
        </table>

        <div class="rcp-summary-wrap">
          <div class="rcp-summary-box">
            <div class="rcp-sum-row"><span>Total Payable:</span> <b>৳ ${ Number(d.totalBill || 0).toFixed(2) }</b></div>
            <div class="rcp-sum-row" style="background:#ecfdf5 !important; color:#005f40;"><span>Amount Paid Now:</span> <b>৳ ${ Number(d.paid || 0).toFixed(2) }</b></div>
            <div class="rcp-sum-row" style="background:#fef2f2 !important; color:#b91c1c;"><span>Remaining Due:</span> <b>৳ ${ Number(d.remaining || 0).toFixed(2) }</b></div>
          </div>
        </div>
      </div>

      <div class="rcp-signatures">
        <div class="rcp-sig-line">Student / Guardian Signature</div>
        <div class="rcp-sig-line">Accounts / Cashier Signature</div>
        <div class="rcp-sig-line">Principal / Headmaster</div>
      </div>
    </div>
    ${idx === 0 ? '<div class="rcp-cut-line">✂ - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - ✂</div>' : ''}
  `).join('');

  var printBox = document.getElementById('printArea');
  printBox.innerHTML = `<div class="rcp-single-page-sheet">${copiesHtml}</div>`;
  window.print();
  setTimeout(() => { printBox.innerHTML = ''; }, 1000);
}
</script>
