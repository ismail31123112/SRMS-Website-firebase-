// 💡 AUTO FETCH FEES LOGIC
async function fetchFeesForClass(clsId, resId, gridId) {
    let cls = document.getElementById(clsId).value;
    let resStatus = document.getElementById(resId).value;
    let zoneId = gridId === 'admitFeeGrid' ? 'admitFeeZone' : 'editFeeZone';
    
    if(!cls) { document.getElementById(zoneId).style.display = "none"; return; }
    
    document.getElementById(gridId).innerHTML = "<p style='grid-column: span 2; color:#64748b; font-weight:bold;'><i class='fas fa-spinner fa-spin'></i> Loading automated fees...</p>";
    document.getElementById(zoneId).style.display = "block";
    
    try {
        let doc = await db.collection('Admin').doc('AdmissionFees_' + cls).get();
        let sFee = 0, hFee = 0, aFee = 0;
        if(doc.exists) {
            let d = doc.data();
            sFee = parseFloat(d.schoolFee) || 0;
            hFee = parseFloat(d.hostelFee) || 0;
            aFee = parseFloat(d.admissionFee) || 0;
        }
        
        let html = "";
        if(sFee > 0) {
            html += `<div style="background:#fff; padding:15px; border-radius:12px; border:1px solid #cbd5e1;">
                <label style="margin-top:0; color:#005f40;">School Fee (${sFee} TK)</label>
                <input type="hidden" class="${gridId}-total" data-name="School Fee" value="${sFee}">
                <input type="number" class="${gridId}-paid" style="border-color:#005f40; color:#005f40; font-weight:900; text-align:center; font-size:18px;" placeholder="Amount Paying" value="${sFee}">
            </div>`;
        }
        if(hFee > 0 && resStatus === 'Residential') {
            html += `<div style="background:#fff; padding:15px; border-radius:12px; border:1px solid #cbd5e1;">
                <label style="margin-top:0; color:#ef4444;">Hostel Fee (${hFee} TK)</label>
                <input type="hidden" class="${gridId}-total" data-name="Hostel Fee" value="${hFee}">
                <input type="number" class="${gridId}-paid" style="border-color:#ef4444; color:#ef4444; font-weight:900; text-align:center; font-size:18px;" placeholder="Amount Paying" value="${hFee}">
            </div>`;
        }
        if(aFee > 0) {
            let labelName = gridId === 'editFeeGrid' ? 'Session/Promotion Fee' : 'Admission Fee';
            html += `<div style="background:#fff; padding:15px; border-radius:12px; border:1px solid #cbd5e1;">
                <label style="margin-top:0; color:#7e22ce;">${labelName} (${aFee} TK)</label>
                <input type="hidden" class="${gridId}-total" data-name="${labelName}" value="${aFee}">
                <input type="number" class="${gridId}-paid" style="border-color:#8b5cf6; color:#8b5cf6; font-weight:900; text-align:center; font-size:18px;" placeholder="Amount Paying" value="${aFee}">
            </div>`;
        }
        
        if(html === "") html = "<p style='grid-column: span 2; color:#ef4444; font-weight:bold;'>No advance fees configured for Class " + cls + " in Accounts Portal.</p>";
        document.getElementById(gridId).innerHTML = html;
    } catch(e) {
        document.getElementById(gridId).innerHTML = "<p style='color:red;'>Error loading fees.</p>";
    }
}

function getFeeData(gridId) {
    let fees = { schoolFeeTotal: 0, schoolFeePaid: 0, hostelFeeTotal: 0, hostelFeePaid: 0, admFeeTotal: 0, admFeePaid: 0, admFeeName: "Session Fee" };
    let totals = document.querySelectorAll(`.${gridId}-total`);
    let paids = document.querySelectorAll(`.${gridId}-paid`);
    
    for(let i=0; i<totals.length; i++) {
        let name = totals[i].getAttribute('data-name');
        let t = parseFloat(totals[i].value) || 0;
        let p = parseFloat(paids[i].value) || 0;
        
        if(name === "School Fee") { fees.schoolFeeTotal = t; fees.schoolFeePaid = p; }
        else if(name === "Hostel Fee") { fees.hostelFeeTotal = t; fees.hostelFeePaid = p; }
        else { fees.admFeeName = name; fees.admFeeTotal = t; fees.admFeePaid = p; }
    }
    return fees;
}

