<body>

<div id="loader">
  <div class="spinner"></div>
  <p id="loaderText" style="margin-top:15px; font-weight:800; color:var(--primary); text-align: center;">
    সিস্টেম প্রস্তুত হচ্ছে...<br><span style="font-size:11px; color:#64748b;">অ্যাডমিন সেশন যাচাই করা হচ্ছে</span>
  </p>
</div>

<!-- Dedicated Print Area for Both Student List & Payment Receipts -->
<div id="printArea"></div>

<div id="appContainer" style="display: none;">
  <div class="header">
    <div class="header-left">
      <img src="https://i.postimg.cc/Y9bdXZPQ/dtg96fyddcib2okq9820.png" alt="SRMS Logo">
      <div class="header-title">
        <h2>Saidpur Residential Model School</h2>
        <p>Official Student Admission &amp; Academic Records Portal</p>
      </div>
    </div>
    <button class="btn-back" onclick="window.close();"><i class="fas fa-sign-out-alt"></i> প্রস্থান</button>
  </div>

  <!-- ================= 1. ADMIT TAB ================= -->
  <div id="admitTab" class="container active">
    <div class="card">
      <h3 class="card-title"><i class="fas fa-user-plus"></i> New Student Admission (নতুন শিক্ষার্থী ভর্তি)</h3>
      
      <div class="form-section">
        <h4><i class="fas fa-id-card"></i> Personal Information &amp; Photo</h4>

