function filterStudents() {
    var fCls = document.getElementById('filterClass').value; var fSec = document.getElementById('filterSection').value; var fCat = document.getElementById('filterCategory').value; var fTxt = document.getElementById('stuSearch').value.toLowerCase();
    var filtered = allData.filter(s => {
        var matchCls = fCls === "" || String(s.class) === fCls; var matchSec = fSec === "" || String(s.section) === fSec; var matchCat = fCat === "" || String(s.category) === fCat;
        var matchTxt = String(s.name).toLowerCase().includes(fTxt) || String(s.studentID).toLowerCase().includes(fTxt) || String(s.roll).includes(fTxt) || (s.phone && String(s.phone).includes(fTxt)); 
        return matchCls && matchSec && matchCat && matchTxt;
    });
    renderStats(filtered);
    renderList(filtered);
}

