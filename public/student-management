<style>
:root {
  --primary: #005f40;
  --primary-dark: #003d29;
  --light: #e8f5e9;
  --bg: #f4f7f9;
  --danger: #ef4444;
  --edit: #2563eb;
  --gold: #f59e0b;
  --gold-light: #fef3c7;
  --border: #cbd5e1;
  --purple: #7c3aed;
}
* { box-sizing: border-box; }
body {
  font-family: 'Poppins', sans-serif;
  background: var(--bg);
  margin: 0;
  padding-bottom: 95px;
  color: #334155;
  -webkit-font-smoothing: antialiased;
}
@keyframes slideUp { from { transform: translateY(14px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

/* Header */
.header {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  padding: 14px 24px;
  box-shadow: 0 8px 25px rgba(0, 95, 64, 0.18);
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 50;
  border-bottom: 4px solid var(--gold);
}
.header-left {
  display: flex;
  align-items: center;
  gap: 13px;
}
.header-left img {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: contain;
  border: 2.5px solid var(--gold);
  background: #fff;
  padding: 2px;
}
.header-title h2 {
  font-size: 18px;
  color: #fff;
  margin: 0;
  font-weight: 800;
  letter-spacing: 0.3px;
  text-transform: uppercase;
}
.header-title p {
  margin: 2px 0 0 0;
  font-size: 11.5px;
  color: #a7f3d0;
  font-weight: 600;
}

.btn-back {
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
  border: 1.5px solid rgba(255, 255, 255, 0.3);
  padding: 8px 16px;
  border-radius: 25px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: 0.2s;
  display: flex;
  align-items: center;
  gap: 6px;
}
.btn-back:hover {
  background: #fff;
  color: var(--primary);
  border-color: #fff;
  transform: translateY(-1px);
}

.container {
  display: none;
  padding: 22px 15px;
  max-width: 1040px;
  margin: auto;
  animation: slideUp 0.25s ease;
}
.container.active { display: block; }

.card {
  background: white;
  border-radius: 20px;
  padding: 25px;
  box-shadow: 0 10px 30px rgba(0, 95, 64, 0.05);
  margin-bottom: 25px;
  border: 1px solid var(--border);
}
.card-title {
  margin: 0 0 20px 0;
  color: var(--primary);
  font-weight: 900;
  text-transform: uppercase;
  font-size: 17.5px;
  border-bottom: 2px solid var(--light);
  padding-bottom: 10px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.form-section {
  background: #f8fafc;
  padding: 20px;
  border-radius: 16px;
  border: 1px solid #e2e8f0;
  margin-bottom: 20px;
}
.form-section h4 {
  margin: 0 0 15px 0;
  color: #334155;
  font-size: 14.5px;
  display: flex;
  align-items: center;
  gap: 8px;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

label {
  display: block;
  font-size: 12px;
  font-weight: 700;
  color: #475569;
  margin-top: 14px;
  margin-left: 4px;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}
input, select, textarea {
  width: 100%;
  padding: 13px 15px;
  border: 2px solid #e2e8f0;
  border-radius: 12px;
  box-sizing: border-box;
  margin-top: 6px;
  font-family: inherit;
  font-size: 14px;
  transition: 0.2s;
  background: #fff;
  font-weight: 600;
  color: #0f172a;
}
input[type="file"] {
  padding: 10px;
  border: 2px dashed var(--primary);
  background: #f0fdf4;
  cursor: pointer;
}
input:focus, select:focus, textarea:focus {
  border-color: var(--primary);
  outline: none;
  box-shadow: 0 0 0 4px rgba(0, 95, 64, 0.1);
}

.flex-row { display: flex; gap: 15px; flex-wrap: wrap; }
.flex-col { flex: 1; min-width: 200px; }

/* Photo Upload Preview Box */
.photo-preview-box {
  display: none;
  margin-top: 12px;
  padding: 12px 16px;
  border-radius: 14px;
  background: #ecfdf5;
  border: 1.5px solid #a7f3d0;
  align-items: center;
  gap: 14px;
}
.photo-preview-box img {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  object-fit: cover;
  border: 2.5px solid var(--primary);
  background: #fff;
  flex-shrink: 0;
}
.photo-preview-meta {
  flex: 1;
  font-size: 12.5px;
  color: #065f46;
  font-weight: 600;
  line-height: 1.45;
}
.btn-clear-photo {
  background: #fef2f2;
  color: var(--danger);
  border: 1px solid #fecaca;
  padding: 7px 12px;
  border-radius: 10px;
  cursor: pointer;
  font-weight: 700;
  font-size: 12px;
}

/* Student Avatar in List */
.stu-avatar {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  object-fit: cover;
  border: 2.5px solid var(--primary);
  background: #fff;
  flex-shrink: 0;
  box-shadow: 0 4px 10px rgba(0,0,0,0.06);
}

.btn-submit {
  width: 100%;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: white;
  padding: 16px;
  border: none;
  border-radius: 14px;
  font-weight: 800;
  cursor: pointer;
  margin-top: 22px;
  transition: 0.2s;
  font-size: 14.5px;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  box-shadow: 0 8px 20px rgba(0, 95, 64, 0.25);
}
.btn-submit:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 12px 25px rgba(0, 95, 64, 0.35);
}
.btn-submit:disabled {
  opacity: 0.65;
  cursor: not-allowed;
  transform: none;
}

/* Bottom Nav */
.bottom-nav {
  position: fixed;
  bottom: 0;
  width: 100%;
  background: rgba(255,255,255,0.96);
  backdrop-filter: blur(12px);
  display: flex;
  box-shadow: 0 -5px 25px rgba(0, 95, 64, 0.08);
  z-index: 100;
  border-radius: 24px 24px 0 0;
  border-top: 1px solid #e2e8f0;
  padding: 6px 0;
}
.nav-item {
  flex: 1;
  text-align: center;
  color: #64748b;
  border: none;
  background: none;
  font-size: 11.5px;
  padding: 10px 6px;
  cursor: pointer;
  font-weight: 700;
  transition: 0.2s;
}
.nav-item i {
  display: block;
  font-size: 21px;
  margin-bottom: 4px;
  transition: 0.2s;
}
.nav-item.active {
  color: var(--primary);
  font-weight: 800;
}
.nav-item.active i {
  transform: translateY(-3px) scale(1.08);
  color: var(--gold);
}

.list-item {
  padding: 16px 20px;
  border-radius: 16px;
  margin-bottom: 14px;
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1px solid #e2e8f0;
  transition: 0.2s;
  flex-wrap: wrap;
  gap: 12px;
}
.list-item:hover {
  box-shadow: 0 8px 25px rgba(0, 95, 64, 0.07);
  border-color: #cbd5e1;
}
.btn-group button {
  border: none;
  background: #f1f5f9;
  cursor: pointer;
  padding: 9px 14px;
  border-radius: 10px;
  transition: 0.2s;
  font-weight: 700;
  font-size: 12px;
}
.btn-group button:hover {
  opacity: 0.9;
  transform: translateY(-2px);
}

/* Modals */
.modal {
  display: none;
  position: fixed;
  z-index: 1000;
  left: 0; top: 0; width: 100%; height: 100%;
  background: rgba(15,23,42,0.65);
  backdrop-filter: blur(5px);
  align-items: center;
  justify-content: center;
  padding: 15px;
}
.modal-content {
  background: #fff;
  padding: 30px;
  border-radius: 24px;
  width: 100%;
  max-width: 800px;
  max-height: 88vh;
  overflow-y: auto;
  position: relative;
  border-top: 6px solid var(--primary);
  box-shadow: 0 25px 50px rgba(0,0,0,0.3);
}
.close {
  position: absolute;
  top: 18px; right: 24px;
  font-size: 28px;
  cursor: pointer;
  color: #94a3b8;
  font-weight: bold;
  transition: 0.2s;
}
.close:hover { color: var(--danger); }

/* Dashboard Stats */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 14px;
  margin-bottom: 20px;
}
.stat-card {
  background: linear-gradient(135deg, #ffffff, #f8fafc);
  padding: 15px;
  border-radius: 15px;
  text-align: center;
  border: 1px solid #e2e8f0;
  box-shadow: 0 4px 10px rgba(0,0,0,0.02);
}
.stat-card h3 { margin: 0; font-size: 24px; color: var(--primary); font-weight: 900; }
.stat-card p { margin: 4px 0 0 0; font-size: 11.5px; color: #64748b; font-weight: 700; text-transform: uppercase; }
.total-stat { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: white; border: none; }
.total-stat h3, .total-stat p { color: white; }

/* Readonly Info Table */
.info-table { width: 100%; border-collapse: collapse; margin-top: 15px; font-size: 14px; }
.info-table td { padding: 11px 15px; border-bottom: 1px solid #e2e8f0; }
.info-table td:first-child { font-weight: 700; color: #64748b; width: 35%; text-transform: uppercase; font-size: 11px; }
.info-table td:last-child { font-weight: 600; color: #0f172a; }

/* Loader */
#loader {
  display: flex;
  position: fixed;
  top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(255,255,255,0.92);
  z-index: 9999;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(6px);
}
.spinner {
  width: 50px;
  height: 50px;
  border: 4px solid #e2e8f0;
  border-top: 4px solid var(--primary);
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

/* ============================================================================
