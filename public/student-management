function resolveStudentPhotoUrl(s) {
  if (!s) return DEFAULT_STUDENT_AVATAR;
  let raw = (s.photoUrl || s.photo || s.thumbUrl || "").toString().trim();
  if (!raw || raw === "No Photo" || raw === "None") return DEFAULT_STUDENT_AVATAR;
  let driveId = (raw.match(/id=([a-zA-Z0-9_-]{15,})/) || raw.match(/\/d\/([a-zA-Z0-9_-]{15,})/) || [])[1];
  if (driveId && raw.includes("drive.google.com")) {
    return `https://drive.google.com/thumbnail?id=${driveId}&sz=w500`;
  }
  return raw;
}

function clearStudentPhoto(mode) {
