<!DOCTYPE html>
<html>
<head>
<base target="_top">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
:root { --primary: #005f40; --primary-dark: #003d29; --light: #e8f5e9; --bg: #f4f7f9; --danger: #ef4444; --edit: #3b82f6; --gold: #f59e0b; --gold-light: #fef3c7; }
body { font-family: 'Poppins', sans-serif; background: var(--bg); margin: 0; padding-bottom: 95px; color: #334155; }
@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.header { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(12px); padding: 15px 20px; box-shadow: 0 4px 20px rgba(0, 95, 64, 0.08); display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 50; border-bottom: 2px solid var(--light); }
.header-left { display: flex; align-items: center; gap: 10px; }
.header h2 { font-size: 16px; color: var(--primary); margin: 0; font-weight: 800; letter-spacing: 0.5px;}

.btn-back { background: var(--light); color: var(--primary); border: 1.5px solid #a7f3d0; padding: 8px 16px; border-radius: 20px; font-size: 12px; font-weight: 700; cursor: pointer; transition: 0.3s; display: flex; align-items: center; gap: 6px; white-space: nowrap; box-shadow: 0 2px 8px rgba(0,0,0,0.03); }
.btn-back:hover { background: var(--primary); color: white; border-color: var(--primary); transform: translateY(-2px); box-shadow: 0 6px 15px rgba(0, 95, 64, 0.2);}

.container { display: none; padding: 20px 15px; max-width: 900px; margin: auto; animation: slideUp 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
.container.active { display: block; }

.card { background: white; border-radius: 20px; padding: 25px; box-shadow: 0 10px 30px rgba(0, 95, 64, 0.05); margin-bottom: 25px; border: 1px solid #e2e8f0; transition: all 0.3s ease;}
label { display: block; font-size: 12px; font-weight: 700; color: #475569; margin-top: 15px; margin-left: 5px; text-transform: uppercase; letter-spacing: 0.5px;}
input, select, textarea { width: 100%; padding: 14px 15px; border: 2px solid #e2e8f0; border-radius: 12px; box-sizing: border-box; margin-top: 6px; font-family: inherit; font-size: 14px; transition: 0.3s; background: #f8fafc; font-weight: 500;}
input:focus, select:focus, textarea:focus { border-color: var(--primary); outline: none; background: #fff; box-shadow: 0 0 0 4px rgba(0, 95, 64, 0.1); transform: translateY(-1px);}
input[readonly] { background-color: #f1f5f9; color: var(--danger); font-weight: bold; border-color: #cbd5e1;}

.btn-submit { width: 100%; background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: white; padding: 16px; border: none; border-radius: 14px; font-weight: 800; cursor: pointer; margin-top: 25px; transition: 0.3s; font-size: 15px; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 8px 20px rgba(0, 95, 64, 0.25);}
.btn-submit:hover { transform: translateY(-3px); box-shadow: 0 12px 25px rgba(0, 95, 64, 0.35); }

.bottom-nav { position: fixed; bottom: 0; width: 100%; background: rgba(255,255,255,0.95); backdrop-filter: blur(12px); display: flex; box-shadow: 0 -5px 25px rgba(0, 95, 64, 0.08); z-index: 100; border-radius: 24px 24px 0 0; border-top: 1px solid #e2e8f0; padding: 6px 0;}
.nav-item { flex: 1; text-align: center; color: #94a3b8; border: none; background: none; font-size: 11px; padding: 12px; cursor: pointer; font-weight: 600; transition: 0.3s;}
.nav-item i { display: block; font-size: 22px; margin-bottom: 5px; transition: 0.3s;}
.nav-item.active { color: var(--primary); font-weight: 800; }
.nav-item.active i { transform: translateY(-4px) scale(1.1); color: var(--gold); }

.list-item { padding: 20px; border-radius: 16px; margin-bottom: 15px; background: #fff; display: flex; justify-content: space-between; align-items: center; border: 1px solid #e2e8f0; transition: 0.3s; animation: fadeIn 0.5s;}
.btn-group button { border: none; background: #f1f5f9; cursor: pointer; padding: 10px 14px; border-radius: 10px; margin-left: 8px; transition: 0.3s; font-weight: bold;}

.modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(15,23,42,0.65); backdrop-filter: blur(6px); align-items: center; justify-content: center; }
.modal-content { background: #fff; padding: 35px; border-radius: 24px; width: 95%; max-width: 600px; max-height: 85vh; overflow-y: auto; position: relative; border-top: 6px solid var(--primary); box-shadow: 0 25px 50px rgba(0,0,0,0.3);}
.close { position: absolute; top: 20px; right: 25px; font-size: 26px; cursor: pointer; color: #94a3b8; font-weight: bold; transition: 0.3s;}
.close:hover { color: var(--danger); transform: rotate(90deg);}

#loader { display:flex; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(255,255,255,0.95); z-index:9999; flex-direction:column; align-items:center; justify-content:center; backdrop-filter: blur(8px); }
.spinner { width:55px; height:55px; border:4px solid #e2e8f0; border-top:4px solid var(--primary); border-radius:50%; animation:spin 1s cubic-bezier(0.55, 0.15, 0.45, 0.85) infinite; }

.badge-army { background: linear-gradient(135deg, var(--gold), #b45309); color: white; padding: 3px 8px; border-radius: 6px; font-size: 10px; font-weight: 800; text-transform: uppercase;}
.badge-civil { background: var(--light); color: var(--primary); padding: 3px 8px; border-radius: 6px; font-size: 10px; font-weight: 800; border: 1px solid #a7f3d0; text-transform: uppercase;}

.fee-zone { background: #f8fafc; padding: 20px; border-radius: 12px; margin-top: 20px; border: 2px dashed #005f40; }
.fee-box { background: #fff; padding: 15px; border-radius: 10px; border: 1px solid #cbd5e1; box-shadow: 0 4px 10px rgba(0,0,0,0.02); }
.pay-input { border-color: var(--primary) !important; color: var(--primary); font-weight: 900; font-size: 18px; text-align: center; }

.profile-table { width: 100%; border-collapse: collapse; margin-top: 15px; font-size: 14px; }
.profile-table th { text-align: left; padding: 10px; background: #f1f5f9; color: #475569; width: 35%; border: 1px solid #e2e8f0; }
.profile-table td { padding: 10px; border: 1px solid #e2e8f0; font-weight: 600; color: #0f172a; }

@media print { 
    body * { visibility: hidden; } 
    #printArea, #printArea * { visibility: visible; } 
    #printArea { position: absolute; left: 0; top: 0; width: 100%; display: block !important; padding: 0; margin:0;} 
}
</style>
</head>
<body>

<div id="loader"><div class="spinner"></div><p id="loaderText" style="margin-top:15px; font-weight:800; color:var(--primary); text-align: center;">SECURITY CHECK...<br><span style="font-size:11px; color:#64748b;">Verifying Admin Session</span></p></div>

<div id="appContainer" style="display: none;">
    <div class="header">
        <div class="header-left"><h2>SRMS Student DB V7</h2></div>
        <button class="btn-back" onclick="window.close();"><i class="fas fa-sign-out-alt"></i> Dashboard</button>
    </div>

    <!-- ================= ADMIT TAB ================= -->
    <div id="admitTab" class="container active">
    <div class="card">
    <h3 style="margin:0 0 20px 0; color:var(--primary); font-weight:900; text-transform: uppercase; font-size: 18px;"><i class="fas fa-user-plus"></i> New Admission</h3>
    
    <label>Full Name *</label><input type="text" id="sName" placeholder="Student's Full Name">
    <div style="display:flex; gap:15px;">
        <div style="flex:1;"><label>Class *</label>
        <select id="sClass" onchange="fetchFeesForClass('sClass', 'sRes', 'admitFeeGrid'); toggleGroup('sClass', 'sGroupDiv');">
            <option value="">Select Class</option><option value="Play">Play</option><option value="Nursery">Nursery</option><option value="KG">KG</option><option value="1">Class 1</option><option value="2">Class 2</option><option value="3">Class 3</option><option value="4">Class 4</option><option value="5">Class 5</option><option value="6">Class 6</option><option value="7">Class 7</option><option value="8">Class 8</option><option value="9">Class 9</option><option value="10">Class 10</option>
        </select></div>
        <div style="flex:1;"><label>Roll *</label><input type="number" id="sRoll" placeholder="Roll No."></div>
    </div>

    <div style="display:flex; gap:15px;">
        <div style="flex:1;"><label>Status *</label>
        <select id="sRes" onchange="fetchFeesForClass('sClass', 'sRes', 'admitFeeGrid')">
            <option value="Non-Residential">Non-Residential</option><option value="Residential">Residential</option>
        </select></div>
        <div style="flex:1;"><label style="color:var(--primary-dark);">Category *</label>
        <select id="sCategory" style="border-color:var(--primary); font-weight:700;"><option value="Civil">Civil</option><option value="Army">Army</option></select></div>
    </div>

    <div style="display:flex; gap:15px;">
        <div style="flex:1;"><label>Father's Name</label><input type="text" id="sFatherName" placeholder="Father's Name"></div>
        <div style="flex:1;"><label>Mother's Name</label><input type="text" id="sMotherName" placeholder="Mother's Name"></div>
    </div>

    <div style="display:flex; gap:15px;">
        <div style="flex:1;"><label>Father NID</label><input type="number" id="sFatherNid" placeholder="Optional"></div>
        <div style="flex:1;"><label>Mother NID</label><input type="number" id="sMotherNid" placeholder="Optional"></div>
    </div>

    <div style="display:flex; gap:15px;">
        <div style="flex:1;"><label>Date of Birth</label><input type="date" id="sDob"></div>
        <div style="flex:1;"><label>Gender</label>
        <select id="sGender"><option value="Male">Male</option><option value="Female">Female</option></select></div>
        <div style="flex:1;"><label>Religion</label>
        <select id="sReligion"><option value="Islam">Islam</option><option value="Hindu">Hindu</option><option value="Christian">Christian</option><option value="Buddhist">Buddhist</option></select></div>
    </div>

    <div style="display:flex; gap:15px;">
        <div style="flex:1;"><label>Section</label><select id="sSection"><option value="">Select Section</option></select></div>
        <div id="sGroupDiv" style="flex:1; display:none;"><label>Group *</label><select id="sGroup"><option value="">Select</option><option value="Science">Science</option><option value="Arts">Arts</option><option value="Commerce">Commerce</option></select></div>
    </div>

    <div style="display:flex; gap:15px;">
        <div style="flex:1;"><label>Phone Number *</label><input type="tel" id="sPhone" placeholder="017XXXXXXXX"></div>
        <div style="flex:1;"><label>Card Number (RFID)</label><input type="text" id="sCardNumber" placeholder="Enter Card Number"></div>
    </div>

    <div style="display:flex; gap:15px;">
        <div style="flex:1;"><label>Email</label><input type="email" id="sEmail" placeholder="student@email.com"></div>
        <div style="flex:1;"><label>Blood Group</label><select id="sBloodGroup"><option value="">Select</option><option value="A+">A+</option><option value="A-">A-</option><option value="B+">B+</option><option value="B-">B-</option><option value="AB+">AB+</option><option value="AB-">AB-</option><option value="O+">O+</option><option value="O-">O-</option></select></div>
    </div>

    <label>Present Address</label><textarea id="sAddr" rows="2" placeholder="Present Address"></textarea>
    <label>Permanent Address</label><textarea id="sPermAddr" rows="2" placeholder="Permanent Address"></textarea>
    
    <!-- 💡 AUTO FETCHED ADMISSION FEES ZONE -->
    <div id="admitFeeZone" class="fee-zone" style="display:none;">
        <h4 style="margin-top:0; color:#005f40; font-size:16px;"><i class="fas fa-file-invoice-dollar"></i> Auto-Fetched Admission Fees</h4>
        <div id="admitFeeGrid" style="display:grid; grid-template-columns:1fr 1fr; gap:15px;"></div>
    </div>

    <button class="btn-submit" onclick="saveStudent()"><i class="fas fa-rocket"></i> Admit & Collect Fees</button>
    </div>
    </div>

    <!-- ================= VIEW TAB ================= -->
    <div id="viewTab" class="container">
    <div class="card">
        <div style="display:flex; flex-wrap: wrap; gap:10px; margin-bottom:15px;">
        <select id="filterClass" onchange="filterStudents()" style="flex:1; min-width:90px;"><option value="">All Classes</option><option value="Play">Play</option><option value="Nursery">Nursery</option><option value="KG">KG</option><option value="1">Class 1</option><option value="2">Class 2</option><option value="3">Class 3</option><option value="4">Class 4</option><option value="5">Class 5</option><option value="6">Class 6</option><option value="7">Class 7</option><option value="8">Class 8</option><option value="9">Class 9</option><option value="10">Class 10</option></select>
        <select id="filterSection" onchange="filterStudents()" style="flex:1; min-width:90px;"><option value="">All Sections</option></select>
        <button onclick="openTcForm()" style="background:linear-gradient(135deg, #f59e0b, #d97706); color:white; border:none; padding:12px 18px; border-radius:12px; cursor:pointer; font-weight:800;"><i class="fas fa-file-signature"></i> Create TC</button>
        <button onclick="printReport()" style="background:linear-gradient(135deg, var(--primary), var(--primary-dark)); color:white; border:none; padding:12px 18px; border-radius:12px; cursor:pointer; box-shadow: 0 4px 10px rgba(0, 95, 64, 0.3);"><i class="fas fa-print"></i></button>
        </div>
        <div style="position: relative;"><i class="fas fa-search" style="position:absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #94a3b8;"></i><input type="text" id="stuSearch" placeholder="Search Name, ID, Phone..." onkeyup="filterStudents()" style="padding-left: 40px; border-radius: 30px;"></div>
    </div>
    
    <div class="card" style="background: linear-gradient(145deg, var(--primary), var(--primary-dark)); color:white; padding: 20px; border: none; margin-bottom: 25px;">
        <div style="text-align: center; font-weight: 900; font-size: 18px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase;">
        Total Displayed Students: <span id="totalStuCount" style="color:var(--gold); font-size:22px;">0</span>
        </div>
        <div id="classWiseStats" style="display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; font-size: 13px;"></div>
    </div>

    <div id="studentListDisplay"></div>
    </div>

    <!-- ================= EDIT MODAL (CLASS UPDATE) ================= -->
    <div id="editModal" class="modal">
    <div class="modal-content">
    <span class="close" onclick="closeModal('editModal')">×</span>
    <h3 style="color:var(--edit); margin-top:0; font-weight:900; text-transform: uppercase;"><i class="fas fa-user-edit"></i> Edit Profile / Update Class</h3>

    <div style="display:flex; gap:15px;">
        <div style="flex:1;"><label>Student ID</label><input type="text" id="eId" readonly></div>
        <div style="flex:1;"><label>Class</label>
        <select id="eClass" onchange="onEditClassChange()">
            <option value="Play">Play</option><option value="Nursery">Nursery</option><option value="KG">KG</option>
            <option value="1">Class 1</option><option value="2">Class 2</option><option value="3">Class 3</option>
            <option value="4">Class 4</option><option value="5">Class 5</option><option value="6">Class 6</option>
            <option value="7">Class 7</option><option value="8">Class 8</option><option value="9">Class 9</option><option value="10">Class 10</option>
        </select></div>
    </div>
    <input type="hidden" id="eRowId">
    <label>Name</label><input type="text" id="eName">

    <div style="display:flex; gap:15px;">
        <div style="flex:1;"><label>Father's Name</label><input type="text" id="eFatherName"></div>
        <div style="flex:1;"><label>Mother's Name</label><input type="text" id="eMotherName"></div>
    </div>

    <div style="display:flex; gap:15px;">
        <div style="flex:1;"><label>Roll</label><input type="number" id="eRoll"></div>
        <div style="flex:1;"><label>Status</label><select id="eRes" onchange="onEditClassChange()"><option value="Non-Residential">Non-Residential</option><option value="Residential">Residential</option></select></div>
    </div>
    
    <div style="display:flex; gap:15px;">
        <div style="flex:1;"><label>Phone Number</label><input type="tel" id="ePhone"></div>
        <div style="flex:1;"><label>Section</label><select id="eSection"><option value="">Select</option></select></div>
    </div>
    
    <div style="display:flex; gap:15px;">
        <div style="flex:1;"><label>Date of Birth</label><input type="date" id="eDob"></div>
        <div style="flex:1;"><label>Gender</label><select id="eGender"><option value="Male">Male</option><option value="Female">Female</option></select></div>
    </div>
    
    <label>Present Address</label><textarea id="eAddr" rows="2"></textarea>
    <label>Permanent Address</label><textarea id="ePermAddr" rows="2"></textarea>

    <!-- 💡 AUTO FETCHED SESSION/PROMOTION FEES ZONE -->
    <div id="editFeeZone" class="fee-zone" style="display:none; border-color:#3b82f6;">
        <h4 style="margin-top:0; color:#3b82f6; font-size:16px;"><i class="fas fa-level-up-alt"></i> New Session / Promotion Fees</h4>
        <div id="editFeeGrid" style="display:grid; grid-template-columns:1fr 1fr; gap:15px;"></div>
    </div>

    <button class="btn-submit" style="background:linear-gradient(135deg, var(--edit), #1d4ed8);" onclick="updateStudent()"><i class="fas fa-sync"></i> Update Profile & Collect</button>
    </div>
    </div>

    <!-- ================= VIEW PROFILE MODAL ================= -->
    <div id="viewProfileModal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeModal('viewProfileModal')">×</span>
        <h3 style="color:var(--primary); margin-top:0; font-weight:900; text-transform: uppercase;"><i class="fas fa-user-circle"></i> Student Profile</h3>
        <table class="profile-table" id="viewProfileTable"></table>
    </div>
    </div>

    <!-- ================= TC FORM MODAL ================= -->
    <div id="tcModal" class="modal">
    <div class="modal-content">
        <span class="close" onclick="closeModal('tcModal')">×</span>
        <h3 style="color:#d97706; margin-top:0; font-weight:900; text-transform: uppercase;"><i class="fas fa-file-signature"></i> Issue Transfer Certificate</h3>
        
        <div style="display:flex; gap:10px; margin-bottom:15px;">
            <input type="text" id="tcSearchId" placeholder="Enter Student ID to Auto-fill" style="margin:0;">
            <button class="btn-submit" style="margin:0; width:120px; padding:10px; background:#475569;" onclick="autoFillTc()"><i class="fas fa-magic"></i> Auto-fill</button>
        </div>

        <div style="display:flex; gap:10px;"><div style="flex:1;"><label>Student Name</label><input type="text" id="tcName"></div><div style="flex:1;"><label>Date of Birth</label><input type="date" id="tcDob"></div></div>
        <div style="display:flex; gap:10px;"><div style="flex:1;"><label>Father's Name</label><input type="text" id="tcFather"></div><div style="flex:1;"><label>Mother's Name</label><input type="text" id="tcMother"></div></div>
        <div style="display:flex; gap:10px;"><div style="flex:1;"><label>Class Admitted In</label><input type="text" id="tcAdmClass"></div><div style="flex:1;"><label>Date of Admission</label><input type="text" id="tcAdmDate"></div></div>
        <div style="display:flex; gap:10px;"><div style="flex:1;"><label>Current Class</label><input type="text" id="tcCurrClass"></div><div style="flex:1;"><label>Section</label><input type="text" id="tcSec"></div></div>
        <div style="display:flex; gap:10px;"><div style="flex:1;"><label>Date of Leaving</label><input type="date" id="tcLeaveDate"></div><div style="flex:1;"><label>Character/Conduct</label><select id="tcConduct"><option>Good</option><option>Excellent</option><option>Satisfactory</option></select></div></div>
        <label>Reason for Leaving</label><input type="text" id="tcReason" value="Transfer of Guardian / Parent Request">
        
        <button class="btn-submit" style="background:linear-gradient(135deg, #f59e0b, #d97706);" onclick="printTC()"><i class="fas fa-print"></i> Generate & Print TC</button>
    </div>
    </div>

    <!-- RECEIPT MODAL -->
    <div id="receiptModal" class="modal" style="z-index:9999;">
        <div class="modal-content" style="text-align:center;">
            <h2 style="color:#16a34a; font-size:28px; margin:0;"><i class="fas fa-check-circle"></i> Success!</h2>
            <p id="receiptMsg" style="font-weight:600; color:#334155;">Student Data Saved & Fees Collected.</p>
            <button class="btn-submit" onclick="printGeneratedReceipt()"><i class="fas fa-print"></i> Print Official Receipt</button>
            <button class="btn-submit" style="background:#64748b; margin-top:10px;" onclick="closeModal('receiptModal')">Close</button>
        </div>
    </div>

    <!-- PRINT AREA FOR STUDENT LIST -->
    <div id="printArea" style="display:none;">
    <div style="text-align:center; border-bottom:3px solid #005f40; margin-bottom:15px; padding-bottom: 10px;">
    <h2 style="margin:0; color:#005f40; font-family:'Times New Roman', serif; text-transform:uppercase; font-size: 20px; font-weight: 800;">Saidpur Residential Model School</h2>
    <p id="printTitle" style="margin:5px 0; font-weight:bold; font-size:13px; color:#475569; font-family:sans-serif; letter-spacing: 0.5px;"></p>
    </div>
    <table class="print-table">
    <thead>
    <tr><th>ID</th><th>Name</th><th>Father</th><th>Mother</th><th>Class</th><th>Sec</th><th>Roll</th><th>Phone</th><th>Status</th></tr>
    </thead>
    <tbody id="printTableBody"></tbody>
    </table>
    </div>

    <div class="bottom-nav">
    <button class="nav-item active" onclick="switchTab('admitTab', this)"><i class="fas fa-user-plus"></i>Admit</button>
    <button class="nav-item" onclick="switchTab('viewTab', this)"><i class="fas fa-users"></i>Students</button>
    </div>
</div> 

<script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-firestore-compat.js"></script>

<script>
const SCRIPT_URL = "https://script.google.com/macros/s/AKfycby4mCNGwS3UHSadoNF2exXw3D-aZtspe4kEew9BliSkCR2HbBQtaifmzoWZoFKdDL8g/exec";
const LOGO_URL = "https://i.postimg.cc/9FxBsqsj/IMG-20251220-WA0006.jpg";

const firebaseConfig = { apiKey: "AIzaSyBhzidG1s5CsOaiY0RsBG6GJcrE12LLEuU", projectId: "srms-website-management" };
if (!firebase.apps.length) { firebase.initializeApp(firebaseConfig); }
const db = firebase.firestore();
const auth = firebase.auth();

var allData = [];
var isAuthReady = false; 
var originalEditClass = "";
var currentReceiptData = null;
var currentlyFilteredData = [];

function showLoaderText(text) { document.getElementById('loaderText').innerHTML = text; }

window.onload = function() {
    auth.onAuthStateChanged(function(user) {
        if (user) {
            user.getIdToken(true).then(token => {
                sessionStorage.setItem('portal_token', token);
                isAuthReady = true;
                document.getElementById('loader').style.display = 'none';
                document.getElementById('appContainer').style.display = 'block';
                loadSectionsData();
            });
        } else {
            showLoaderText("UNAUTHORIZED ACCESS!<br><span style='font-size:11px; color:#ef4444;'>Redirecting to Login...</span>");
