    <div style="display:flex; gap:15px;">
        <div style="flex:1;"><label>Roll</label><input type="number" id="eRoll"></div>
        <div style="flex:1;"><label>Status</label><select id="eRes" onchange="onEditClassChange()"><option value="Non-Residential">Non-Residential</option><option value="Residential">Residential</option></select></div>
    </div>
    
