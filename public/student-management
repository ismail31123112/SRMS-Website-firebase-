// ============================================================================
function resolveStudentPhotoUrl(s) {
  if (!s) return DEFAULT_STUDENT_AVATAR;
  let raw = (s.photoUrl || s.photo || s.thumbUrl || "").toString().trim();
  if (!raw || raw === "No Photo" || raw === "None") return DEFAULT_STUDENT_AVATAR;
  let driveId = (raw.match(/id=([a-zA-Z0-9_-]{15,})/) || raw.match(/\/d\/([a-zA-Z0-9_-]{15,})/) || [])[1];
  if (driveId && raw.includes("drive.google.com")) {
    return `https://drive.google.com/thumbnail?id=${driveId}&sz=w500`;
  }
  return raw;
}

function clearStudentPhoto(mode) {
  if (mode === 'admit') {
    document.getElementById('sPhotoInput').value = "";
    document.getElementById('sPhotoPreviewBox').style.display = "none";
    preparedAdmitPhoto = null;
  } else {
    document.getElementById('ePhotoInput').value = "";
    document.getElementById('ePhotoPreviewBox').style.display = "none";
    preparedEditPhoto = null;
  }
}

function handleStudentPhotoSelect(input, mode) {
  if (!input.files || input.files.length === 0) {
    clearStudentPhoto(mode);
    return;
  }
  const file = input.files[0];
  const boxId = mode === 'admit' ? 'sPhotoPreviewBox' : 'ePhotoPreviewBox';
  const imgId = mode === 'admit' ? 'sPhotoPreviewImg' : 'ePhotoPreviewImg';
  const metaId = mode === 'admit' ? 'sPhotoPreviewMeta' : 'ePhotoPreviewMeta';

  const box = document.getElementById(boxId);
  const imgEl = document.getElementById(imgId);
  const metaEl = document.getElementById(metaId);

  metaEl.innerHTML = `<i class="fas fa-spinner fa-spin"></i> Optimizing student photo...`;
  box.style.display = "flex";

  const reader = new FileReader();
  reader.onload = function(e) {
    const img = new Image();
    img.onload = function() {
      const maxDim = 650;
      let w = img.width, h = img.height;
      if (w > maxDim || h > maxDim) {
        if (w > h) { h = Math.round((h * maxDim) / w); w = maxDim; }
        else { w = Math.round((w * maxDim) / h); h = maxDim; }
      }
      const canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0, w, h);

      const dataUrl = canvas.toDataURL('image/jpeg', 0.86);
      imgEl.src = dataUrl;
      const kbSize = Math.round((dataUrl.length * 0.75) / 1024);
      const cleanName = "SRMS_Student_" + Date.now() + ".jpg";

      const payloadObj = {
        fileData: dataUrl.split(',')[1],
        mimeType: "image/jpeg",
        fileName: cleanName
      };

      if (mode === 'admit') preparedAdmitPhoto = payloadObj;
      else preparedEditPhoto = payloadObj;

      metaEl.innerHTML = `<b>Student Photo Ready</b><br>⚡ ImgBB Ready (${w}×${h}px • ~${kbSize} KB)`;
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}

async function uploadPhotoToImgBBDirect(base64Data, fileName) {
  const formData = new FormData();
  formData.append("key", IMGBB_API_KEY);
  formData.append("image", base64Data);
  if (fileName) {
    formData.append("name", fileName.replace(/\.[^/.]+$/, ""));
  }
  const res = await fetch(IMGBB_UPLOAD_URL, { method: "POST", body: formData });
  const json = await res.json();
  if (json && json.success && json.data) {
    return {
      url: json.data.url || json.data.display_url,
      thumbUrl: (json.data.thumb && json.data.thumb.url) ? json.data.thumb.url : json.data.url,
      deleteUrl: json.data.delete_url || "",
      imgbbId: json.data.id || ""
    };
  }
  throw new Error("ImgBB direct upload failed");
}

