async function apiCall(actionName, payloadData = {}) {
  let token = sessionStorage.getItem('portal_token') || "";
  if (auth.currentUser) {
    try { token = await auth.currentUser.getIdToken(false); } catch (e) {}
  }
  let payload = {
    action: actionName,
    token: token,
    adminKey: SRMS_ADMIN_PASSKEY,
    ...payloadData
  };
  let res = await fetch(SCRIPT_URL, {
    method: 'POST',
    body: JSON.stringify(payload),
    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
    redirect: 'follow'
  });
  let text = await res.text();
  if (text.includes("<html")) throw new Error("সার্ভার কানেকশন ত্রুটি! অনুগ্রহ করে পুনরায় চেষ্টা করুন।");
  let data = JSON.parse(text);
  if (data.status === "error" || data.error) throw new Error(data.message || data.error);
  return data;
}

