function renderClassUpdateFeesForStudent() {
  let zoneEl = document.getElementById('editFeeZone');
  let gridEl = document.getElementById('editFeeGrid');
  let badgeEl = document.getElementById('editFeeCategoryBadge');
  let titleEl = document.getElementById('editFeeZoneTitle');

  if (!currentEditingStudent) {
    zoneEl.style.display = "none";
    gridEl.innerHTML = "";
    return;
  }

  let s = currentEditingStudent;
  let sDue = (s.schoolFeeStatus !== "Paid") ? (parseFloat(s.schoolFeeDue) || 0) : 0;
  let customArr = [];
  if (s.customFees) {
    try { customArr = JSON.parse(s.customFees) || []; } catch (e) { customArr = []; }
  }
  let activeCustomDues = customArr.filter(cf => cf.name && (parseFloat(cf.amount) || 0) > 0 && (cf.status || "").toLowerCase() !== "paid");
  let hasSessionFeeIndicator = activeCustomDues.some(cf => cf.name.toLowerCase().includes("session") || cf.name.toLowerCase().includes("promotion"));

  let currentCls = document.getElementById('eClass').value;
  let currentCat = document.getElementById('eCategory').value || "";
  let isClassOrCatChanged = (currentCls !== originalEditClass || currentCat !== originalEditCategory);

  if (!isClassOrCatChanged && !hasSessionFeeIndicator) {
    zoneEl.style.display = "none";
    gridEl.innerHTML = "";
    return;
  }

  zoneEl.style.display = "block";
  if (hasSessionFeeIndicator) {
    badgeEl.style.background = "#16a34a";
    badgeEl.innerHTML = `<i class="fas fa-check-circle"></i> Session Fee Active`;
    titleEl.innerHTML = `<i class="fas fa-level-up-alt"></i> Class Promotion — Collect All Student Fees`;
  } else {
    badgeEl.style.background = "#f59e0b";
    badgeEl.innerHTML = `Pending Dues Check`;
    titleEl.innerHTML = `<i class="fas fa-file-invoice-dollar"></i> Student Due Fees on Class / Category Update`;
  }

  let html = "";
  if (sDue > 0) {
    html += `<div style="background:#fff; padding:15px; border-radius:12px; border:1.5px solid #a7f3d0;">
      <label style="margin-top:0; color:#005f40;"><i class="fas fa-graduation-cap"></i> School Fee Due (${sDue} TK)</label>
      <input type="hidden" class="editFeeGrid-total" data-name="School Fee" data-mode="settle" value="${sDue}">
      <input type="number" class="editFeeGrid-paid" style="border-color:#005f40; color:#005f40; font-weight:900; text-align:center; font-size:18px;" placeholder="Amount Paying" value="${sDue}">
    </div>`;
  }

  activeCustomDues.forEach(cf => {
    let cName = cf.name;
    let cAmt = parseFloat(cf.amount) || 0;
    let safeName = cName.replace(/"/g, "&quot;");
    let isSession = cName.toLowerCase().includes("session") || cName.toLowerCase().includes("promotion");
    let borderClr = isSession ? "#3b82f6" : "#d8b4fe";
    let textClr = isSession ? "#1d4ed8" : "#7e22ce";

    html += `<div style="background:#fff; padding:15px; border-radius:12px; border:2px solid ${borderClr};">
      <label style="margin-top:0; color:${textClr};"><i class="fas ${isSession ? 'fa-award' : 'fa-star'}"></i> ${cName} (${cAmt} TK)</label>
      <input type="hidden" class="editFeeGrid-total" data-name="${safeName}" data-col="${cf.colIdx || ''}" data-mode="settle" value="${cAmt}">
      <input type="number" class="editFeeGrid-paid" style="border-color:${textClr}; color:${textClr}; font-weight:900; text-align:center; font-size:18px;" placeholder="Amount Paying" value="${cAmt}">
    </div>`;
  });

  if (html === "") {
    html = `<p style="grid-column: 1 / -1; color:#0f766e; font-weight:700; margin:0;">
      ℹ️ এই শিক্ষার্থীর কোনো বকেয়া সেশন ফি বা অন্য কোনো বকেয়া ফি নেই।
    </p>`;
  }

  gridEl.innerHTML = html;
}

function getFeeData(gridId) {
  let fees = {
    schoolFeeTotal: 0,
    schoolFeePaid: 0,
    schoolFeeMode: gridId === 'editFeeGrid' ? "settle" : "add",
    customFeesList: []
  };
  let totals = document.querySelectorAll(`.${gridId}-total`);
  let paids = document.querySelectorAll(`.${gridId}-paid`);

  for (let i = 0; i < totals.length; i++) {
    let name = totals[i].getAttribute('data-name');
    let colIdx = totals[i].getAttribute('data-col') || "";
    let mode = totals[i].getAttribute('data-mode') || (gridId === 'editFeeGrid' ? "settle" : "add");
    let t = parseFloat(totals[i].value) || 0;
    let p = parseFloat(paids[i].value) || 0;

    if (name === "School Fee") {
      fees.schoolFeeTotal = t;
      fees.schoolFeePaid = p;
      fees.schoolFeeMode = mode;
    } else if (name && (t > 0 || p > 0)) {
      fees.customFeesList.push({
        name: name,
        total: t,
        paid: p,
        colIdx: colIdx,
        mode: mode
      });
    }
  }
  return fees;
}

