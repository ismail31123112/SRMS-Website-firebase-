  let cls = document.getElementById(clsId).value;
  let category = (catId && document.getElementById(catId)) ? (document.getElementById(catId).value || "All") : "All";
  let zoneId = gridId === 'admitFeeGrid' ? 'admitFeeZone' : 'editFeeZone';
  let badgeId = gridId === 'admitFeeGrid' ? 'admitFeeCategoryBadge' : 'editFeeCategoryBadge';
  let isEditMode = (gridId === 'editFeeGrid');

  if (document.getElementById(badgeId)) {
    document.getElementById(badgeId).innerText = `Category: ${category || 'Default'}`;
  }

  if (!cls) {
    document.getElementById(zoneId).style.display = "none";
    return;
  }

  document.getElementById(gridId).innerHTML = "<p style='grid-column: span 2; color:#64748b; font-weight:bold;'><i class='fas fa-spinner fa-spin'></i> Loading automated fees for Class " + cls + " (" + (category || "Default") + ")...</p>";
  document.getElementById(zoneId).style.display = "block";

  try {
    let sFee = 0, secondFee = 0;

    const [catDoc, mainDoc] = await Promise.all([
      (category && category !== "All")
        ? db.collection('Admin').doc(`AdmissionFees_${cls}_${category}`).get().catch(() => ({ exists: false }))
        : Promise.resolve({ exists: false }),
      db.collection('Admin').doc(`AdmissionFees_${cls}`).get().catch(() => ({ exists: false }))
    ]);

    if (catDoc && catDoc.exists) {
      let cd = catDoc.data();
      sFee = parseFloat(cd.schoolFee) || 0;
      secondFee = isEditMode
        ? (cd.sessionFee !== undefined ? (parseFloat(cd.sessionFee) || 0) : (parseFloat(cd.admissionFee) || 0))
        : (parseFloat(cd.admissionFee) || 0);
    } else if (mainDoc && mainDoc.exists) {
      let d = mainDoc.data();
      let foundInMap = false;
      if (category && category !== "All" && d.categoryFeesJSON) {
        try {
          let map = JSON.parse(d.categoryFeesJSON);
          if (map[category]) {
            sFee = parseFloat(map[category].schoolFee) || 0;
            secondFee = isEditMode
              ? (map[category].sessionFee !== undefined ? (parseFloat(map[category].sessionFee) || 0) : (parseFloat(map[category].admissionFee) || 0))
              : (parseFloat(map[category].admissionFee) || 0);
            foundInMap = true;
          }
        } catch (err) {}
      }
      if (!foundInMap) {
        sFee = parseFloat(d.schoolFee) || 0;
        secondFee = isEditMode
          ? (d.sessionFee !== undefined ? (parseFloat(d.sessionFee) || 0) : (parseFloat(d.admissionFee) || 0))
          : (parseFloat(d.admissionFee) || 0);
      }
    }

    let html = "";
    if (sFee > 0) {
      html += `<div style="background:#fff; padding:15px; border-radius:12px; border:1px solid #cbd5e1;">
        <label style="margin-top:0; color:#005f40;">School Fee (${sFee} TK)</label>
        <input type="hidden" class="${gridId}-total" data-name="School Fee" value="${sFee}">
        <input type="number" class="${gridId}-paid" style="border-color:#005f40; color:#005f40; font-weight:900; text-align:center; font-size:18px;" placeholder="Amount Paying" value="${sFee}">
      </div>`;
    }
    if (secondFee > 0) {
      let labelName = isEditMode ? 'Session Fee' : 'Admission Fee';
      html += `<div style="background:#fff; padding:15px; border-radius:12px; border:1px solid #cbd5e1;">
        <label style="margin-top:0; color:#7e22ce;">${labelName} (${secondFee} TK)</label>
        <input type="hidden" class="${gridId}-total" data-name="${labelName}" value="${secondFee}">
        <input type="number" class="${gridId}-paid" style="border-color:#8b5cf6; color:#8b5cf6; font-weight:900; text-align:center; font-size:18px;" placeholder="Amount Paying" value="${secondFee}">
      </div>`;
    }

    if (html === "") {
      html = `<p style='grid-column: span 2; color:#ef4444; font-weight:bold;'>No advance fees configured for Class ${cls} (${category || 'Default'}) in Accounts Portal.</p>`;
    }
    document.getElementById(gridId).innerHTML = html;
  } catch (e) {
    document.getElementById(gridId).innerHTML = "<p style='color:red;'>Error loading fees.</p>";
  }
}

function getFeeData(gridId) {
  let fees = { schoolFeeTotal: 0, schoolFeePaid: 0, admFeeTotal: 0, admFeePaid: 0, admFeeName: gridId === 'editFeeGrid' ? "Session Fee" : "Admission Fee" };
  let totals = document.querySelectorAll(`.${gridId}-total`);
  let paids = document.querySelectorAll(`.${gridId}-paid`);

  for (let i = 0; i < totals.length; i++) {
    let name = totals[i].getAttribute('data-name');
    let t = parseFloat(totals[i].value) || 0;
    let p = parseFloat(paids[i].value) || 0;

    if (name === "School Fee") { fees.schoolFeeTotal = t; fees.schoolFeePaid = p; }
    else { fees.admFeeName = name; fees.admFeeTotal = t; fees.admFeePaid = p; }
  }
  return fees;
}

