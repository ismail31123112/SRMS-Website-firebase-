    <div class="bottom-nav">
    <button class="nav-item active" onclick="switchTab('admitTab', this)"><i class="fas fa-user-plus"></i>Admit</button>
    <button class="nav-item" onclick="switchTab('viewTab', this)"><i class="fas fa-users"></i>Students</button>
    <button class="nav-item" onclick="switchTab('sectionTab', this)"><i class="fas fa-layer-group"></i>Sections</button>
    </div>
</div> 

<script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.9.0/firebase-firestore-compat.js"></script>

<script>
// 🚀 🚀 🚀 IMPORTANT: Insert your actual Google Apps Script Web App URL below 🚀 🚀 🚀
const SCRIPT_URL = "https://script.google.com/macros/s/AKfycby4mCNGwS3UHSadoNF2exXw3D-aZtspe4kEew9BliSkCR2HbBQtaifmzoWZoFKdDL8g/exec";

const firebaseConfig = { apiKey: "AIzaSyBhzidG1s5CsOaiY0RsBG6GJcrE12LLEuU", projectId: "srms-website-management" };
if (!firebase.apps.length) { firebase.initializeApp(firebaseConfig); }
const db = firebase.firestore();
const auth = firebase.auth();

var allData = [];
var globalSections = []; 
var isAuthReady = false; 
var originalEditClass = "";
var currentReceiptData = null;

function showLoaderText(text) { document.getElementById('loaderText').innerHTML = text; }

window.onload = function() {
    auth.onAuthStateChanged(function(user) {
        if (user) {
            user.getIdToken(true).then(token => {
                sessionStorage.setItem('portal_token', token);
                isAuthReady = true;
                document.getElementById('loader').style.display = 'none';
                document.getElementById('appContainer').style.display = 'block';
                loadSectionsData();
            });
        } else {
            showLoaderText("UNAUTHORIZED ACCESS!<br><span style='font-size:11px; color:#ef4444;'>Redirecting to Login...</span>");
            setTimeout(() => {
                var currentDomain = window.location.protocol + "//" + window.location.host;
                window.location.replace(currentDomain + "/login-panel/accounting-and-management-department");
            }, 1000);
        }
    });
}

async function apiCall(actionName, payloadData = {}) {
    let payload = { action: actionName, token: sessionStorage.getItem('portal_token'), ...payloadData };
    let res = await fetch(SCRIPT_URL, { method: 'POST', body: JSON.stringify(payload), headers: { 'Content-Type': 'text/plain;charset=utf-8' } });
    let text = await res.text();
    if (text.includes("<html")) throw new Error("Deployment Access Error! Ensure Apps Script 'Who has access' is 'Anyone'.");
    let data = JSON.parse(text);
    if(data.status === "error") throw new Error(data.message);
    return data;
}

function switchTab(id, btn) {
    if(!isAuthReady) return;
    document.querySelectorAll('.container').forEach(c => c.classList.remove('active'));
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    btn.classList.add('active');
    if(id === 'viewTab') loadStudents();
}

function toggleGroup(selId, divId) {
    var cls = document.getElementById(selId).value;
    var div = document.getElementById(divId);
    if(div) div.style.display = (cls == "9" || cls == "10") ? "block" : "none";
}

async function loadSectionsData() {
    try {
        const doc = await db.collection('Admin').doc('Settings').get();
        let opts = '<option value="">Select Section</option>';
        if (doc.exists && doc.data().sections) {
            globalSections = doc.data().sections.split(',').filter(s => s.trim() !== '');
            globalSections.forEach(s => { opts += `<option value="${s}">${s}</option>`; });
        } else {
            globalSections = ["Section A", "Section B", "Section C", "Boys", "Girls"];
            globalSections.forEach(s => { opts += `<option value="${s}">${s}</option>`; });
        }
        document.getElementById('sSection').innerHTML = opts;
        document.getElementById('eSection').innerHTML = opts;
        document.getElementById('filterSection').innerHTML = '<option value="">All Sections</option>' + opts;
        renderSectionList();
    } catch (e) {}
}

function renderSectionList() {
    let h = "";
    globalSections.forEach(s => {
        h += `<div class="list-item" style="padding:12px 20px; box-shadow:none; border-color:#a7f3d0;">
        <b style="color:#005f40; font-size:15px;">${s}</b>
        <button onclick="deleteSection('${s}')" style="background:#fef2f2; color:#ef4444; border:none; padding:8px 12px; border-radius:8px; cursor:pointer; transition:0.3s;"><i class="fas fa-trash"></i></button>
        </div>`;
    });
    document.getElementById('sectionListDisplay').innerHTML = h || "<p style='text-align:center; color:#94a3b8; font-weight:600;'>No custom sections added yet.</p>";
}

async function addSection() {
    if(!isAuthReady) return;
    let name = document.getElementById('newSecName').value.trim();
    if(!name) return alert("Please enter section name.");
    document.getElementById('loader').style.display = 'flex'; showLoaderText("ADDING SECTION...");
    try {
        if (!globalSections.includes(name)) globalSections.push(name);
        await db.collection('Admin').doc('Settings').set({ sections: globalSections.join(',') }, { merge: true });
        document.getElementById('newSecName').value = "";
        
        let opts = '<option value="">Select Section</option>';
        globalSections.forEach(s => { opts += `<option value="${s}">${s}</option>`; });
        document.getElementById('sSection').innerHTML = opts;
        document.getElementById('eSection').innerHTML = opts;
        document.getElementById('filterSection').innerHTML = '<option value="">All Sections</option>' + opts;
        
        renderSectionList(); document.getElementById('loader').style.display = 'none';
    } catch(e) { document.getElementById('loader').style.display = 'none'; alert("Error adding section"); }
}

async function deleteSection(name) {
    if(!isAuthReady) return;
    if(!confirm(`Delete section "${name}"?`)) return;
    document.getElementById('loader').style.display = 'flex'; showLoaderText("DELETING SECTION...");
    try {
        globalSections = globalSections.filter(s => s !== name);
        await db.collection('Admin').doc('Settings').set({ sections: globalSections.join(',') }, { merge: true });
        
        let opts = '<option value="">Select Section</option>';
        globalSections.forEach(s => { opts += `<option value="${s}">${s}</option>`; });
        document.getElementById('sSection').innerHTML = opts;
        document.getElementById('eSection').innerHTML = opts;
        document.getElementById('filterSection').innerHTML = '<option value="">All Sections</option>' + opts;

        renderSectionList(); document.getElementById('loader').style.display = 'none';
    } catch(e) { document.getElementById('loader').style.display = 'none'; alert("Error deleting section"); }
}

// 💡 AUTO FETCH FEES LOGIC
async function fetchFeesForClass(clsId, resId, gridId) {
    let cls = document.getElementById(clsId).value;
    let resStatus = document.getElementById(resId).value;
    let zoneId = gridId === 'admitFeeGrid' ? 'admitFeeZone' : 'editFeeZone';
    
    if(!cls) { document.getElementById(zoneId).style.display = "none"; return; }
    
    document.getElementById(gridId).innerHTML = "<p style='grid-column: span 2; color:#64748b; font-weight:bold;'><i class='fas fa-spinner fa-spin'></i> Loading automated fees...</p>";
    document.getElementById(zoneId).style.display = "block";
    
    try {
        let doc = await db.collection('Admin').doc('AdmissionFees_' + cls).get();
        let sFee = 0, hFee = 0, aFee = 0;
        if(doc.exists) {
            let d = doc.data();
            sFee = parseFloat(d.schoolFee) || 0;
            hFee = parseFloat(d.hostelFee) || 0;
            aFee = parseFloat(d.admissionFee) || 0;
        }
        
        let html = "";
        if(sFee > 0) {
            html += `<div class="fee-box">
                <label style="margin-top:0; color:#005f40;">School Fee (${sFee} TK)</label>
                <input type="hidden" class="${gridId}-total" data-name="School Fee" value="${sFee}">
                <input type="number" class="${gridId}-paid pay-input" placeholder="Amount Paying" value="${sFee}">
            </div>`;
        }
        if(hFee > 0 && resStatus === 'Residential') {
            html += `<div class="fee-box" style="border-color:#ef4444;">
                <label style="margin-top:0; color:#ef4444;">Hostel Fee (${hFee} TK)</label>
                <input type="hidden" class="${gridId}-total" data-name="Hostel Fee" value="${hFee}">
                <input type="number" class="${gridId}-paid pay-input" style="color:#ef4444;" placeholder="Amount Paying" value="${hFee}">
            </div>`;
        }
        if(aFee > 0) {
            let labelName = gridId === 'editFeeGrid' ? 'Session/Promotion Fee' : 'Admission Fee';
            html += `<div class="fee-box" style="border-color:#8b5cf6;">
                <label style="margin-top:0; color:#7e22ce;">${labelName} (${aFee} TK)</label>
                <input type="hidden" class="${gridId}-total" data-name="${labelName}" value="${aFee}">
                <input type="number" class="${gridId}-paid pay-input" style="color:#8b5cf6;" placeholder="Amount Paying" value="${aFee}">
            </div>`;
        }
        
        if(html === "") html = "<p style='grid-column: span 2; color:#ef4444; font-weight:bold;'>No advance fees configured for Class " + cls + " in Accounts Portal.</p>";
        document.getElementById(gridId).innerHTML = html;
    } catch(e) {
        document.getElementById(gridId).innerHTML = "<p style='color:red;'>Error loading fees.</p>";
    }
}

function getFeeData(gridId) {
    let fees = { schoolFeeTotal: 0, schoolFeePaid: 0, hostelFeeTotal: 0, hostelFeePaid: 0, admFeeTotal: 0, admFeePaid: 0, admFeeName: "Session Fee" };
    let totals = document.querySelectorAll(`.${gridId}-total`);
    let paids = document.querySelectorAll(`.${gridId}-paid`);
    
    for(let i=0; i<totals.length; i++) {
        let name = totals[i].getAttribute('data-name');
        let t = parseFloat(totals[i].value) || 0;
        let p = parseFloat(paids[i].value) || 0;
        
        if(name === "School Fee") { fees.schoolFeeTotal = t; fees.schoolFeePaid = p; }
        else if(name === "Hostel Fee") { fees.hostelFeeTotal = t; fees.hostelFeePaid = p; }
        else { fees.admFeeName = name; fees.admFeeTotal = t; fees.admFeePaid = p; }
    }
    return fees;
}

// 🚀 ADMIT WITH FEES
async function saveStudent() {
    var cls = document.getElementById('sClass').value;
    var d = { 
        name: document.getElementById('sName').value, classVal: cls, sectionVal: document.getElementById('sSection').value || "", 
        roll: document.getElementById('sRoll').value, resStatus: document.getElementById('sRes').value, 
        category: document.getElementById('sCategory').value || "Civil", phone: document.getElementById('sPhone').value || "",
        fees: getFeeData('admitFeeGrid')
    };

    if(!d.name || !d.roll || !d.phone || !cls) return alert("Name, Class, Roll and Phone are required!");

    document.getElementById('loader').style.display = 'flex'; 
    showLoaderText("SAVING PROFILE & COLLECTING FEES...<br><span style='font-size:11px; color:#64748b;'>Syncing with Accounts securely...</span>");
    
    try {
        let res = await apiCall('addNewStudentProfile', {data: d});
        document.getElementById('loader').style.display = 'none'; 
        
        if(res.receiptData) {
            currentReceiptData = res.receiptData;
            document.getElementById('receiptMsg').innerText = `ID: ${res.id} generated. Fees collected successfully.`;
            document.getElementById('receiptModal').style.display = 'flex';
        } else {
            alert(`Admission Successful! Student ID: ${res.id}\n(No fees collected)`);
        }
        
        // Reset Form
        document.getElementById('sName').value = ""; document.getElementById('sRoll').value = ""; document.getElementById('sPhone').value = ""; document.getElementById('admitFeeZone').style.display = "none";
    } catch(err) {
        document.getElementById('loader').style.display = 'none'; 
        alert("Error: " + err.message);
    }
}

async function loadStudents() {
    if(!isAuthReady) return;
    document.getElementById('loader').style.display = 'flex'; showLoaderText("FETCHING DATA...");
    try {
        const snapshot = await db.collection('Students').get();
        let data = [];
        snapshot.forEach(doc => { let f = doc.data(); f.rowId = doc.id; data.push(f); });
        data.sort((a,b) => (parseInt(a.roll)||9999) - (parseInt(b.roll)||9999));
        allData = data.reverse();
        renderList(allData);
        document.getElementById('loader').style.display = 'none';
    } catch(e) { document.getElementById('loader').style.display = 'none'; }
}

function renderList(data) {
    var h = ""; var total = data.length; 
    data.forEach(s => {
        h += `<div class="list-item">
        <div style="flex:1;">
        <div style="margin-bottom:5px;"><b style="font-size:16px; color:#005f40;">${s.name || 'Unknown'}</b></div>
        <small style="color:#64748b; font-weight:500; font-size:12px; line-height:1.6;">
        <b style="color:#334155;">ID:</b> ${s.studentID} | <b style="color:#334155;">Class:</b> ${s.class} | <b style="color:#334155;">Roll:</b> ${s.roll} | <b style="color:#334155;">Phone:</b> ${s.phone || 'N/A'}
        </small>
        </div>
        <div class="btn-group" style="display:flex; flex-direction:column; gap:8px;">
        <button onclick="openEditByRow('${s.rowId}')" style="color:var(--edit)"><i class="fas fa-edit"></i> Edit/Promote</button>
        <button onclick="delStu('${s.rowId}')" style="color:var(--danger)"><i class="fas fa-trash"></i> Del</button>
        </div>
        </div>`;
    });
    document.getElementById('studentListDisplay').innerHTML = h;
    document.getElementById('totalStuCount').innerText = total;
}

function filterStudents() {
    var fCls = document.getElementById('filterClass').value; var fSec = document.getElementById('filterSection').value; var fGrp = document.getElementById('filterGroup').value; var fRes = document.getElementById('filterRes').value; var fCat = document.getElementById('filterCategory').value; var fTxt = document.getElementById('stuSearch').value.toLowerCase();
    var filtered = allData.filter(s => {
        var matchCls = fCls === "" || String(s.class) === fCls; var matchSec = fSec === "" || String(s.section) === fSec; var matchGrp = fGrp === "" || String(s.group) === fGrp; var matchRes = fRes === "" || String(s.resStatus) === fRes; var matchCat = fCat === "" || String(s.category) === fCat;
        var matchTxt = String(s.name).toLowerCase().includes(fTxt) || String(s.studentID).toLowerCase().includes(fTxt) || String(s.roll).includes(fTxt) || (s.machineID && String(s.machineID).toLowerCase().includes(fTxt)) || (s.phone && String(s.phone).includes(fTxt)); 
        return matchCls && matchSec && matchGrp && matchRes && matchCat && matchTxt;
    });
    renderList(filtered);
}

function printReport() {
    var fCls = document.getElementById('filterClass').value; var fSec = document.getElementById('filterSection').value; var fCat = document.getElementById('filterCategory').value; var fTxt = document.getElementById('stuSearch').value.toLowerCase();
    var data = allData.filter(s => {
        var matchCls = fCls === "" || String(s.class) === fCls; var matchSec = fSec === "" || String(s.section) === fSec; var matchCat = fCat === "" || String(s.category) === fCat; var matchTxt = String(s.name).toLowerCase().includes(fTxt) || String(s.studentID).toLowerCase().includes(fTxt);
        return matchCls && matchSec && matchCat && matchTxt;
    });

    var rows = "";
    data.forEach(s => { rows += `<tr><td>${s.studentID}</td><td>${s.name}</td><td>${s.fatherName || '-'}</td><td>${s.motherName || '-'}</td><td>${s.class}</td><td>${s.section || '-'}</td><td>${s.group || '-'}</td><td>${s.roll}</td><td><b>${s.category || 'Civil'}</b></td><td>${s.phone || ''}</td></tr>`; });
    document.getElementById('printTitle').innerText = "Student General Information List: " + (fCls ? "Class "+fCls : "All Classes") + (fSec ? " | Sec: "+fSec : "") + (fCat ? " | Cat: "+fCat : "");
    document.getElementById('printTableBody').innerHTML = rows;
    setTimeout(() => { window.print(); }, 800);
}

function openEditByRow(rid) {
    if(!isAuthReady) return;
    var s = allData.find(item => item.rowId == rid);
    if(!s) return;
    originalEditClass = s.class;
    
    document.getElementById('eId').value = s.studentID; document.getElementById('eRowId').value = s.rowId; document.getElementById('eName').value = s.name || ""; document.getElementById('eClass').value = s.class; document.getElementById('eSection').value = s.section || ""; document.getElementById('eRoll').value = s.roll; document.getElementById('eRes').value = s.resStatus; document.getElementById('ePhone').value = s.phone || "";
    
    document.getElementById('editFeeZone').style.display = 'none';
    document.getElementById('editModal').style.display = 'flex';
}

function onEditClassChange() {
    let currentCls = document.getElementById('eClass').value;
    if(currentCls !== originalEditClass) {
        fetchFeesForClass('eClass', 'eRes', 'editFeeGrid');
    } else {
        document.getElementById('editFeeZone').style.display = 'none';
        document.getElementById('editFeeGrid').innerHTML = "";
    }
}

// 🚀 EDIT / UPDATE CLASS WITH FEES
async function updateStudent() {
    var d = { 
        rowId: document.getElementById('eRowId').value, id: document.getElementById('eId').value,
        name: document.getElementById('eName').value, classVal: document.getElementById('eClass').value, 
        sectionVal: document.getElementById('eSection').value, roll: document.getElementById('eRoll').value, 
        resStatus: document.getElementById('eRes').value, phone: document.getElementById('ePhone').value,
        fees: getFeeData('editFeeGrid')
    };
    
    document.getElementById('loader').style.display = 'flex'; 
    showLoaderText("UPDATING PROFILE & FEES...<br><span style='font-size:11px; color:#64748b;'>Direct Write + Smart SMS Trigger</span>");
    
    try {
        let res = await apiCall('updateStudentProfileDirect', { data: d });
        document.getElementById('loader').style.display = 'none';
        
        closeModal('editModal');
        loadStudents();

        if(res.receiptData) {
            currentReceiptData = res.receiptData;
            document.getElementById('receiptMsg').innerText = `Class Updated Successfully & Fees Collected.`;
            document.getElementById('receiptModal').style.display = 'flex';
        } else {
            alert("Update Successful! Profile saved and SMS sent.");
        }
    } catch(e) {
        document.getElementById('loader').style.display = 'none'; 
        alert("Update Failed: " + e.message);
    }
}

function delStu(row) { 
    if(confirm("Confirm delete?")) {
        document.getElementById('loader').style.display = 'flex'; showLoaderText("DELETING...");
        apiCall('deleteStudent', {docId: row}).then(() => { alert("Deleted!"); loadStudents(); }).catch(e => {document.getElementById('loader').style.display = 'none'; alert("Error: "+e.message);}); 
    } 
}
function closeModal(id) { document.getElementById(id).style.display = 'none'; }

// 🖨️ RECEIPT PRINTING LOGIC (Copied from Accounts)
function printGeneratedReceipt() {
    if(!currentReceiptData) return;
    let d = currentReceiptData;
    let items = d.itemsList.map(i => {
        let payable = parseFloat(i.original) || 0;
        let paid = parseFloat(i.paid) || parseFloat(i.amount) || payable; 
        let dueAmt = payable - paid;
        return `<tr style="border-bottom: 1px solid #e2e8f0;"><td style="color:#1e293b; font-weight:700;">${i.title}</td><td style="text-align:right; color:#64748b; font-weight:600;">${payable.toFixed(2)}</td><td style="text-align:right; color:#005f40; font-weight:800;">${paid.toFixed(2)}</td><td style="text-align:right; color:#ef4444; font-weight:700;">${dueAmt.toFixed(2)}</td></tr>`;
    }).join('');

    let secStr = d.section ? ` (Sec: ${d.section})` : "";
    let h = `<html><head><style>@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap'); @page { size: A4 portrait; margin: 0; } body { font-family: 'Inter', sans-serif; padding: 6mm; margin: 0; background: #fff; color: #0f172a; -webkit-print-color-adjust: exact; box-sizing: border-box; height: 297mm; overflow: hidden; } .box { height: 138mm; border: 2px solid #cbd5e1; padding: 20px; border-radius: 16px; position: relative; box-sizing: border-box; margin-bottom: 3mm; box-shadow: 0 4px 15px rgba(0,0,0,0.02); } .header { display: flex; align-items: center; justify-content: space-between; border-bottom: 3px solid #005f40; padding-bottom: 12px; margin-bottom: 15px; } .header-left { display: flex; align-items: center; gap: 15px; } .header-text h2 { margin: 0; font-size: 19px; font-weight: 900; color: #005f40; letter-spacing: 0.5px; } .header-text p { margin: 4px 0 0 0; font-size: 11px; color: #475569; font-weight: 600; } .receipt-tag { background: #005f40; color: white; padding: 6px 14px; border-radius: 20px; font-size: 11px; font-weight: 800; letter-spacing: 1.5px; } .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 12px; margin-bottom: 15px; background: #f8fafc; padding: 15px; border-radius: 12px; border: 1px solid #e2e8f0; } .info-grid div { line-height: 1.6; } .info-label { color: #64748b; font-size: 11px; text-transform: uppercase; font-weight: 800; display: inline-block; width: 75px; } table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 12px; } th { background: #f1f5f9; color: #334155; font-weight: 800; text-transform: uppercase; font-size: 11px; padding: 10px; text-align: left; border-bottom: 2px solid #cbd5e1; border-radius: 6px 6px 0 0; } td { border-bottom: 1px solid #e2e8f0; padding: 8px 10px; } .summary-container { display: flex; justify-content: flex-end; margin-top: 15px; } .summary-box { width: 260px; border: 1.5px solid #cbd5e1; border-radius: 8px; overflow: hidden; background: white; } .summary-row { display: flex; justify-content: space-between; padding: 8px 12px; font-size: 12px; border-bottom: 1px solid #e2e8f0; } .summary-row:last-child { border-bottom: none; } .total-payable { font-weight: 700; color: #475569; } .total-paid { font-weight: 800; color: #005f40; background: #ecfdf5; border-bottom: 1px solid #a7f3d0;} .total-due { font-weight: 800; color: #b91c1c; background: #fef2f2; } .watermark { position: absolute; top: 55%; left: 50%; transform: translate(-50%,-50%) rotate(-30deg); font-size: 80px; opacity: 0.03; color: #005f40; font-weight: 900; z-index: -1; pointer-events: none; letter-spacing: 12px; } .signatures { position: absolute; bottom: 20px; left: 25px; right: 25px; display: flex; justify-content: space-between; font-weight: 800; font-size: 12px; color: #475569; } .sig-line { border-top: 2px dashed #94a3b8; width: 160px; text-align: center; padding-top: 8px; } .cut-line { text-align: center; margin: 6px 0; font-size: 12px; color: #94a3b8; font-weight: 700; letter-spacing: 3px; }</style></head><body>
    ${["STUDENT COPY", "OFFICE COPY"].map((c, idx) => `<div class="box"><div class="watermark">SRMS</div><div class="header"><div class="header-left"><div class="header-text"><h2>SAIDPUR RESIDENTIAL MODEL SCHOOL</h2><p>Sultan Nagar, Saidpur, Nilphamari | Official Payment Receipt</p></div></div><div class="receipt-tag">${c}</div></div><div class="info-grid"><div><div><span class="info-label">Receipt No:</span> <b style="color:#005f40;">${d.rNo}</b></div><div><span class="info-label">Student ID:</span> <b>${d.id}</b></div><div><span class="info-label">Name:</span> <b style="color:#0f172a; font-size:13px; text-transform:uppercase;">${d.name}</b></div></div><div style="text-align: right;"><div><span class="info-label" style="text-align:left;">Date:</span> <b>${d.date}</b></div><div><span class="info-label" style="text-align:left;">Class:</span> <b>${d.class}${secStr} (Roll:${d.roll})</b></div><div><span class="info-label" style="text-align:left;">Session:</span> <b>${d.month}${d.year}</b></div></div></div><table><thead><tr><th>Fee Particulars</th><th style="text-align:right; width: 95px;">Payable (TK)</th><th style="text-align:right; width: 100px;">Paid Now (TK)</th><th style="text-align:right; width: 95px;">Due (TK)</th></tr></thead><tbody>${items}</tbody></table><div class="summary-container"><div class="summary-box"><div class="summary-row total-payable"><span>Total Payable:</span> <span>৳ ${d.totalBill.toFixed(2)}</span></div><div class="summary-row total-paid"><span>Amount Paid Now:</span> <span>৳ ${d.paid.toFixed(2)}</span></div><div class="summary-row total-due"><span>Remaining Due:</span> <span>৳ ${d.remaining.toFixed(2)}</span></div></div></div><div class="signatures"><div class="sig-line">Accountant / Cashier</div><div class="sig-line">Student / Guardian</div></div></div>${idx === 0 ? '<div class="cut-line">✂ - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - ✂</div>' : ''}`).join('')}
    </body></html>`;

    let w = window.open('','','width=900,height=950'); w.document.write(h); w.document.close(); setTimeout(()=>w.print(), 1000);
}
</script>
