    document.getElementById('eSection').value = s.section || ""; document.getElementById('eRoll').value = s.roll || ""; 
    document.getElementById('eRes').value = s.resStatus || ""; document.getElementById('eCategory').value = s.category || "Civil";
    document.getElementById('eDob').value = s.dob || ""; document.getElementById('ePhone').value = s.phone || ""; 
    document.getElementById('eFatherName').value = s.fatherName || ""; document.getElementById('eMotherName').value = s.motherName || "";
    document.getElementById('eAddress').value = s.address || "";
    
    document.getElementById('editFeeZone').style.display = 'none';
    document.getElementById('editModal').style.display = 'flex';
}

function onEditClassChange() {
    let currentCls = document.getElementById('eClass').value;
    if(currentCls !== originalEditClass) {
        fetchFeesForClass('eClass', 'eRes', 'editFeeGrid');
    } else {
        document.getElementById('editFeeZone').style.display = 'none';
        document.getElementById('editFeeGrid').innerHTML = "";
    }
}

async function updateStudent() {
    var d = { 
        rowId: document.getElementById('eRowId').value, id: document.getElementById('eId').value,
        name: document.getElementById('eName').value, classVal: document.getElementById('eClass').value, 
        sectionVal: document.getElementById('eSection').value, roll: document.getElementById('eRoll').value, 
        resStatus: document.getElementById('eRes').value, category: document.getElementById('eCategory').value,
        dob: document.getElementById('eDob').value, phone: document.getElementById('ePhone').value,
        fatherName: document.getElementById('eFatherName').value, motherName: document.getElementById('eMotherName').value,
        address: document.getElementById('eAddress').value,
        fees: getFeeData('editFeeGrid')
    };
    
    document.getElementById('loader').style.display = 'flex'; 
    showLoaderText("UPDATING PROFILE & FEES...<br><span style='font-size:11px; color:#64748b;'>Direct Write + Smart SMS Trigger</span>");
    
    try {
        let res = await apiCall('updateStudentProfileDirect', { data: d });
        document.getElementById('loader').style.display = 'none';
        
        closeModal('editModal');
        loadStudents();

        if(res.receiptData) {
            currentReceiptData = res.receiptData;
            document.getElementById('receiptMsg').innerText = `Class Updated Successfully & Fees Collected.`;
            document.getElementById('receiptModal').style.display = 'flex';
        } else {
            alert("Update Successful! Profile saved and SMS sent.");
        }
    } catch(e) {
        document.getElementById('loader').style.display = 'none'; 
        alert("Update Failed: " + e.message);
    }
}

function delStu(row) { 
    if(confirm("Confirm delete? This action cannot be undone.")) {
        document.getElementById('loader').style.display = 'flex'; showLoaderText("DELETING...");
        apiCall('deleteStudent', {docId: row}).then(() => { alert("Deleted!"); loadStudents(); }).catch(e => {document.getElementById('loader').style.display = 'none'; alert("Error: "+e.message);}); 
    } 
}

// 📜 TC GENERATOR 
function openTcModal() {
    // Fill with first filtered student data if available to save time
    var fTxt = document.getElementById('stuSearch').value.toLowerCase();
    if(fTxt !== "" && allData.length > 0) {
        let match = allData.find(s => String(s.name).toLowerCase().includes(fTxt) || String(s.studentID).toLowerCase().includes(fTxt));
        if(match) {
            document.getElementById('tcName').value = match.name || "";
            document.getElementById('tcId').value = match.studentID || "";
            document.getElementById('tcFather').value = match.fatherName || "";
            document.getElementById('tcMother').value = match.motherName || "";
            document.getElementById('tcClass').value = match.class || "";
            document.getElementById('tcRoll').value = match.roll || "";
            document.getElementById('tcAdDate').value = match.admissionDate || "";
        }
    }
    document.getElementById('tcLeaveDate').valueAsDate = new Date();
    document.getElementById('tcModal').style.display = 'flex';
}

