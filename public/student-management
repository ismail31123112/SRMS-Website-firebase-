async function loadSectionsAndCategoriesData() {
  try {
    const doc = await db.collection('Admin').doc('Settings').get();
    const d = doc.exists ? doc.data() : {};

    globalSections = (d.sections && d.sections.trim() !== "")
      ? d.sections.split(',').map(s => s.trim()).filter(Boolean)
      : [];

    globalCategories = (d.categories && d.categories.trim() !== "")
      ? d.categories.split(',').map(c => c.trim()).filter(Boolean)
      : [];

    refreshSectionDropdowns();
    refreshCategoryDropdowns();
    renderSectionList();
    renderCategoryList();
  } catch (e) {
    refreshSectionDropdowns();
    refreshCategoryDropdowns();
  }
}

function refreshSectionDropdowns() {
  let opts = '<option value="">Select Section</option>';
  globalSections.forEach(s => { opts += `<option value="${s}">${s}</option>`; });
  document.getElementById('sSection').innerHTML = opts;
  document.getElementById('eSection').innerHTML = opts;

  let filterOpts = '<option value="">All Sections</option>';
  globalSections.forEach(s => { filterOpts += `<option value="${s}">${s}</option>`; });
  document.getElementById('filterSection').innerHTML = filterOpts;
}

function refreshCategoryDropdowns() {
  const curAdmitCat = document.getElementById('sCategory').value;
  const curEditCat = document.getElementById('eCategory').value;
  const curFilterCat = document.getElementById('filterCategory').value;

  let catOpts = "";
  if (globalCategories.length === 0) {
    catOpts = `<option value="">-- First Add Category in 'Sections & Categories' Tab --</option>`;
  } else {
    globalCategories.forEach(c => {
      catOpts += `<option value="${c}">${c}</option>`;
    });
  }

  document.getElementById('sCategory').innerHTML = catOpts;
  document.getElementById('eCategory').innerHTML = catOpts;

  if (curAdmitCat && globalCategories.includes(curAdmitCat)) {
    document.getElementById('sCategory').value = curAdmitCat;
  }
  if (curEditCat && globalCategories.includes(curEditCat)) {
    document.getElementById('eCategory').value = curEditCat;
  }

  let filterCatOpts = '<option value="">All Categories</option>';
  globalCategories.forEach(c => {
    filterCatOpts += `<option value="${c}">${c}</option>`;
  });
  document.getElementById('filterCategory').innerHTML = filterCatOpts;
  if (curFilterCat && globalCategories.includes(curFilterCat)) {
    document.getElementById('filterCategory').value = curFilterCat;
  }
}

