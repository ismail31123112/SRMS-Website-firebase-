function getFilteredStudentsList() {
  var fCls = document.getElementById('filterClass').value;
  var fSec = document.getElementById('filterSection').value;
  var fCat = document.getElementById('filterCategory').value;
  var fTxt = document.getElementById('stuSearch').value.toLowerCase().trim();

  return allData.filter(s => {
    var stuCat = String(s.category || s.resStatus || "");
    var matchCls = fCls === "" || String(s.class) === fCls;
    var matchSec = fSec === "" || String(s.section) === fSec;
    var matchCat = fCat === "" || stuCat === fCat;
    var matchTxt = !fTxt ||
      String(s.name || "").toLowerCase().includes(fTxt) ||
      String(s.studentID || "").toLowerCase().includes(fTxt) ||
      String(s.roll || "").includes(fTxt) ||
      stuCat.toLowerCase().includes(fTxt) ||
      (s.phone && String(s.phone).includes(fTxt)) ||
      (s.email && String(s.email).toLowerCase().includes(fTxt));
    return matchCls && matchSec && matchCat && matchTxt;
  });
}

function filterStudents() {
  var filtered = getFilteredStudentsList();
  renderStats(filtered);
  renderList(filtered);
}

