}

async function uploadPhotoDirect(base64Data, fileName) {
  const formData = new FormData();
  formData.append("key", MEDIA_STORAGE_KEY);
  formData.append("image", base64Data);
  if (fileName) {
    formData.append("name", fileName.replace(/\.[^/.]+$/, ""));
  }
  const res = await fetch(MEDIA_UPLOAD_URL, { method: "POST", body: formData });
  const json = await res.json();
  if (json && json.success && json.data) {
    return {
      url: json.data.url || json.data.display_url,
      thumbUrl: (json.data.thumb && json.data.thumb.url) ? json.data.thumb.url : json.data.url,
      deleteUrl: json.data.delete_url || "",
      imgbbId: json.data.id || ""
    };
  }
  throw new Error("Photo upload error");
}

function handleStudentPhotoSelect(input, mode) {
  if (!input.files || input.files.length === 0) {
    clearStudentPhoto(mode);
    return;
  }
  const file = input.files[0];
  const boxId = mode === 'admit' ? 'sPhotoPreviewBox' : 'ePhotoPreviewBox';
  const imgId = mode === 'admit' ? 'sPhotoPreviewImg' : 'ePhotoPreviewImg';
  const metaId = mode === 'admit' ? 'sPhotoPreviewMeta' : 'ePhotoPreviewMeta';

  const box = document.getElementById(boxId);
  const imgEl = document.getElementById(imgId);
  const metaEl = document.getElementById(metaId);

  metaEl.innerHTML = `<i class="fas fa-circle-notch fa-spin"></i> ছবি অপ্টিমাইজ ও প্রস্তুত করা হচ্ছে...`;
  box.style.display = "flex";

  const reader = new FileReader();
  reader.onload = function(e) {
    const img = new Image();
    img.onload = function() {
      const maxDim = 650;
      let w = img.width, h = img.height;
      if (w > maxDim || h > maxDim) {
        if (w > h) { h = Math.round((h * maxDim) / w); w = maxDim; }
        else { w = Math.round((w * maxDim) / h); h = maxDim; }
      }
      const canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0, w, h);

      const dataUrl = canvas.toDataURL('image/jpeg', 0.86);
      imgEl.src = dataUrl;
      const kbSize = Math.round((dataUrl.length * 0.75) / 1024);
      const cleanName = "SRMS_Student_" + Date.now() + ".jpg";

      const payloadObj = {
        fileData: dataUrl.split(',')[1],
        mimeType: "image/jpeg",
        fileName: cleanName,
        uploadedRes: null,
        uploadPromise: null
      };

      // Start background pre-upload immediately
      payloadObj.uploadPromise = uploadPhotoDirect(payloadObj.fileData, cleanName)
        .then(res => {
          payloadObj.uploadedRes = res;
          metaEl.innerHTML = `<b>ছবি সম্পূর্ণ প্রস্তুত</b><br><span style="color:#059669;"><i class="fas fa-check-circle"></i> ক্লাউডে প্রস্তুত (${w}×${h}px • ~${kbSize} KB)</span>`;
          return res;
        })
        .catch(() => {
          metaEl.innerHTML = `<b>ছবি প্রস্তুত</b> (${w}×${h}px • ~${kbSize} KB)`;
          return null;
        });

      if (mode === 'admit') preparedAdmitPhoto = payloadObj;
      else preparedEditPhoto = payloadObj;
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}

