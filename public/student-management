    <div style="display:flex; gap:15px;">
        <div style="flex:1;"><label>Phone Number *</label><input type="tel" id="sPhone" placeholder="017XXXXXXXX"></div>
        <div style="flex:1;"><label>Card Number (RFID)</label><input type="text" id="sCardNumber" placeholder="Enter Card Number"></div>
