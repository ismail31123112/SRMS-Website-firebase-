    </div>
    <div id="studentListDisplay"></div>
    </div>

    <!-- ================= SECTION MANAGER TAB ================= -->
    <div id="sectionTab" class="container">
    <div class="card" style="border-top-color: #005f40;">
    <h3 style="margin:0 0 15px 0; color:#005f40; font-weight:900;"><i class="fas fa-layer-group"></i> Manage Custom Sections</h3>
    <p style="font-size:13px; color:#64748b; font-weight:600; margin-bottom: 20px;">এখানে একবার কোনো সেকশন অ্যাড করলে তা অটোমেটিক অ্যাডমিট এবং এডিট ফর্মে সেভ হয়ে থাকবে।</p>
    <div style="display:flex; gap:10px;">
    <input type="text" id="newSecName" placeholder="Enter new section name (e.g. Padma, Lotus)" style="flex:1; border-color:#a7f3d0;">
    <button onclick="addSection()" class="btn-submit" style="width:130px; margin-top:0; padding:10px; background: linear-gradient(135deg, #005f40, #003d29); box-shadow: 0 6px 15px rgba(0, 95, 64, 0.2);"><i class="fas fa-plus"></i> Add</button>
