<!DOCTYPE html>
<html>
<head>
<base target="_top">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<script>
if (window.history.replaceState) {
var cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
window.history.replaceState({path: cleanUrl}, '', cleanUrl);
}
</script>

<style>
:root { --primary: #005f40; --primary-dark: #003d29; --light: #e8f5e9; --bg: #f4f7f9; --danger: #ef4444; --edit: #3b82f6; --gold: #f59e0b; --gold-light: #fef3c7; }
body { font-family: 'Poppins', sans-serif; background: var(--bg); margin: 0; padding-bottom: 95px; color: #334155; }
@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.header { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(12px); padding: 15px 20px; box-shadow: 0 4px 20px rgba(0, 95, 64, 0.08); display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 50; border-bottom: 2px solid var(--light); }
.header-left { display: flex; align-items: center; gap: 10px; }
.header h2 { font-size: 16px; color: var(--primary); margin: 0; font-weight: 800; letter-spacing: 0.5px;}

.btn-back { background: var(--light); color: var(--primary); border: 1.5px solid #a7f3d0; padding: 8px 16px; border-radius: 20px; font-size: 12px; font-weight: 700; cursor: pointer; transition: 0.3s; display: flex; align-items: center; gap: 6px; white-space: nowrap; box-shadow: 0 2px 8px rgba(0,0,0,0.03); }
.btn-back:hover { background: var(--primary); color: white; border-color: var(--primary); transform: translateY(-2px); box-shadow: 0 6px 15px rgba(0, 95, 64, 0.2);}

.container { display: none; padding: 20px 15px; max-width: 900px; margin: auto; animation: slideUp 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
.container.active { display: block; }

.card { background: white; border-radius: 20px; padding: 25px; box-shadow: 0 10px 30px rgba(0, 95, 64, 0.05); margin-bottom: 25px; border: 1px solid #e2e8f0; transition: all 0.3s ease;}
label { display: block; font-size: 12px; font-weight: 700; color: #475569; margin-top: 15px; margin-left: 5px; text-transform: uppercase; letter-spacing: 0.5px;}
input, select, textarea { width: 100%; padding: 14px 15px; border: 2px solid #e2e8f0; border-radius: 12px; box-sizing: border-box; margin-top: 6px; font-family: inherit; font-size: 14px; transition: 0.3s; background: #f8fafc; font-weight: 500;}
input:focus, select:focus, textarea:focus { border-color: var(--primary); outline: none; background: #fff; box-shadow: 0 0 0 4px rgba(0, 95, 64, 0.1); transform: translateY(-1px);}

.btn-submit { width: 100%; background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: white; padding: 16px; border: none; border-radius: 14px; font-weight: 800; cursor: pointer; margin-top: 25px; transition: 0.3s; font-size: 15px; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 8px 20px rgba(0, 95, 64, 0.25);}
.btn-submit:hover { transform: translateY(-3px); box-shadow: 0 12px 25px rgba(0, 95, 64, 0.35); }

.bottom-nav { position: fixed; bottom: 0; width: 100%; background: rgba(255,255,255,0.95); backdrop-filter: blur(12px); display: flex; box-shadow: 0 -5px 25px rgba(0, 95, 64, 0.08); z-index: 100; border-radius: 24px 24px 0 0; border-top: 1px solid #e2e8f0; padding: 6px 0;}
.nav-item { flex: 1; text-align: center; color: #94a3b8; border: none; background: none; font-size: 11px; padding: 12px; cursor: pointer; font-weight: 600; transition: 0.3s;}
.nav-item i { display: block; font-size: 22px; margin-bottom: 5px; transition: 0.3s;}
.nav-item.active { color: var(--primary); font-weight: 800; }
.nav-item.active i { transform: translateY(-4px) scale(1.1); color: var(--gold); }

.list-item { padding: 20px; border-radius: 16px; margin-bottom: 15px; background: #fff; display: flex; justify-content: space-between; align-items: center; border: 1px solid #e2e8f0; transition: 0.3s; animation: fadeIn 0.5s;}
.btn-group button { border: none; background: #f1f5f9; cursor: pointer; padding: 10px 14px; border-radius: 10px; margin-left: 8px; transition: 0.3s; font-weight: bold;}

.modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(15,23,42,0.65); backdrop-filter: blur(6px); align-items: center; justify-content: center; }
.modal-content { background: #fff; padding: 35px; border-radius: 24px; width: 95%; max-width: 550px; max-height: 85vh; overflow-y: auto; position: relative; border-top: 6px solid var(--primary); box-shadow: 0 25px 50px rgba(0,0,0,0.3);}
.close { position: absolute; top: 20px; right: 25px; font-size: 26px; cursor: pointer; color: #94a3b8; font-weight: bold; transition: 0.3s;}
.close:hover { color: var(--danger); transform: rotate(90deg);}

#loader { display:flex; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(255,255,255,0.95); z-index:9999; flex-direction:column; align-items:center; justify-content:center; backdrop-filter: blur(8px); }
.spinner { width:55px; height:55px; border:4px solid #e2e8f0; border-top:4px solid var(--primary); border-radius:50%; animation:spin 1s cubic-bezier(0.55, 0.15, 0.45, 0.85) infinite; }

.badge-army { background: linear-gradient(135deg, var(--gold), #b45309); color: white; padding: 3px 8px; border-radius: 6px; font-size: 10px; font-weight: 800; text-transform: uppercase;}
.badge-civil { background: var(--light); color: var(--primary); padding: 3px 8px; border-radius: 6px; font-size: 10px; font-weight: 800; border: 1px solid #a7f3d0; text-transform: uppercase;}

.fee-zone { background: #f8fafc; padding: 20px; border-radius: 12px; margin-top: 20px; border: 2px dashed #005f40; }
.fee-box { background: #fff; padding: 15px; border-radius: 10px; border: 1px solid #cbd5e1; box-shadow: 0 4px 10px rgba(0,0,0,0.02); }
.pay-input { border-color: var(--primary) !important; color: var(--primary); font-weight: 900; font-size: 18px; text-align: center; }

@media print { body * { visibility: hidden; } #printArea, #printArea * { visibility: visible; } #printArea { position: absolute; left: 0; top: 0; width: 100%; display: block !important; padding: 0;} }
</style>
</head>
<body>

<div id="loader"><div class="spinner"></div><p id="loaderText" style="margin-top:15px; font-weight:800; color:var(--primary); text-align: center;">SECURITY CHECK...<br><span style="font-size:11px; color:#64748b;">Verifying Admin Session</span></p></div>

<div id="appContainer" style="display: none;">
    <div class="header">
        <div class="header-left"><h2>SRMS Student DB V6.5</h2></div>
        <button class="btn-back" onclick="window.close();"><i class="fas fa-sign-out-alt"></i> Dashboard</button>
    </div>

    <!-- ================= ADMIT TAB ================= -->
