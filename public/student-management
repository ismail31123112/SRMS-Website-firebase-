async function apiCall(actionName, payloadData = {}) {
    let payload = { action: actionName, token: sessionStorage.getItem('portal_token'), ...payloadData };
    let res = await fetch(SCRIPT_URL, { method: 'POST', body: JSON.stringify(payload), headers: { 'Content-Type': 'text/plain;charset=utf-8' } });
    let text = await res.text();
    if (text.includes("<html")) throw new Error("Deployment Access Error! Ensure Apps Script 'Who has access' is 'Anyone'.");
    let data = JSON.parse(text);
    if(data.status === "error") throw new Error(data.message);
    return data;
}

