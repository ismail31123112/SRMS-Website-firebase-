    title: `${stuObj.name || 'শিক্ষার্থী'}-এর প্রোফাইল মুছে ফেলবেন?`,
    text: "এটি ডাটাবেস, পোর্টাল লগইন এবং অ্যাটেনডেন্স ডিভাইস থেকে স্থায়ীভাবে মুছে যাবে।",
    icon: "warning",
    showCancelButton: true,
    confirmButtonColor: "#ef4444",
    confirmButtonText: "হ্যাঁ, মুছে ফেলুন",
    cancelButtonText: "বাতিল"
  });
  if (!confirmRes.isConfirmed) return;

  // Instant optimistic removal from UI
  allData = allData.filter(s => s.rowId !== row);
  filterStudents();

  Swal.fire({
    title: "মুছে ফেলা হয়েছে!",
    text: "শিক্ষার্থীর প্রোফাইল সফলভাবে অপসারণ করা হয়েছে।",
    icon: "success",
    timer: 1300,
    showConfirmButton: false
  });

  try {
    await apiCall('deleteStudent', {
      docId: row,
      meta: {
        studentID: stuObj.studentID || "",
        machineID: stuObj.machineID || stuObj.studentID || "",
        phone: stuObj.phone || "",
        email: stuObj.email || "",
        imgbbDeleteUrl: stuObj.imgbbDeleteUrl || "",
        imgbbId: stuObj.imgbbId || ""
      }
    });
  } catch (e) {
    console.warn("Cleanup warning:", e);
  }
}

function closeModal(id) { document.getElementById(id).style.display = 'none'; }

