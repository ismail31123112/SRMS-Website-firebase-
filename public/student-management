        <div style="flex:1;"><label>Phone Number</label><input type="tel" id="ePhone"></div>
        <div style="flex:1;"><label>Section</label><select id="eSection"><option value="">Select</option></select></div>
    </div>

    <!-- 💡 AUTO FETCHED SESSION/PROMOTION FEES ZONE -->
    <div id="editFeeZone" class="fee-zone" style="display:none; border-color:#3b82f6;">
        <h4 style="margin-top:0; color:#3b82f6; font-size:16px;"><i class="fas fa-level-up-alt"></i> New Session / Promotion Fees</h4>
        <div id="editFeeGrid" style="display:grid; grid-template-columns:1fr 1fr; gap:15px;"></div>
    </div>

    <button class="btn-submit" style="background:linear-gradient(135deg, var(--edit), #1d4ed8);" onclick="updateStudent()"><i class="fas fa-sync"></i> Update Profile & Collect</button>
    </div>
    </div>

    <!-- RECEIPT MODAL -->
    <div id="receiptModal" class="modal" style="z-index:9999;">
        <div class="modal-content" style="text-align:center;">
            <h2 style="color:#16a34a; font-size:28px; margin:0;"><i class="fas fa-check-circle"></i> Success!</h2>
            <p id="receiptMsg" style="font-weight:600; color:#334155;">Student Data Saved & Fees Collected.</p>
            <button class="btn-submit" onclick="printGeneratedReceipt()"><i class="fas fa-print"></i> Print Official Receipt</button>
            <button class="btn-submit" style="background:#64748b; margin-top:10px;" onclick="closeModal('receiptModal')">Close</button>
