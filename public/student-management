// 💡 1. NEW ADMISSION FEE LOADER (WITH IN-MEMORY CACHE FOR INSTANT SWITCHING)
// ============================================================================
async function fetchAdmissionFeesForAdmit() {
  let cls = document.getElementById('sClass').value;
  let category = document.getElementById('sCategory').value || "All";
  let zoneEl = document.getElementById('admitFeeZone');
  let gridEl = document.getElementById('admitFeeGrid');
  let badgeEl = document.getElementById('admitFeeCategoryBadge');

  if (badgeEl) badgeEl.innerText = `Category: ${category || 'Default'}`;

  if (!cls) {
    zoneEl.style.display = "none";
    gridEl.innerHTML = "";
    return;
  }

  let cacheKey = `${cls}__${category}`;
  if (admissionFeesCache[cacheKey]) {
    zoneEl.style.display = "block";
    gridEl.innerHTML = admissionFeesCache[cacheKey];
    return;
  }

  gridEl.innerHTML = `<p style="grid-column: 1 / -1; color:#64748b; font-weight:bold;"><i class="fas fa-spinner fa-spin"></i> নির্ধারিত ভর্তি ফি লোড হচ্ছে...</p>`;
  zoneEl.style.display = "block";

  try {
    let sFee = 0, aFee = 0, customAdvList = [];

    const [catDoc, mainDoc] = await Promise.all([
      (category && category !== "All")
        ? db.collection('Admin').doc(`AdmissionFees_${cls}_${category}`).get().catch(() => ({ exists: false }))
        : Promise.resolve({ exists: false }),
      db.collection('Admin').doc(`AdmissionFees_${cls}`).get().catch(() => ({ exists: false }))
    ]);

    if (catDoc && catDoc.exists) {
      let cd = catDoc.data();
      sFee = parseFloat(cd.schoolFee) || 0;
      aFee = parseFloat(cd.admissionFee) || 0;
      if (cd.customAdvanceFeesJSON) {
        try { customAdvList = JSON.parse(cd.customAdvanceFeesJSON) || []; } catch (e) { customAdvList = []; }
      }
    } else if (mainDoc && mainDoc.exists) {
      let d = mainDoc.data();
      let foundInMap = false;
      if (category && category !== "All" && d.categoryFeesJSON) {
        try {
          let map = JSON.parse(d.categoryFeesJSON);
          if (map[category]) {
            sFee = parseFloat(map[category].schoolFee) || 0;
            aFee = parseFloat(map[category].admissionFee) || 0;
            customAdvList = Array.isArray(map[category].customAdvanceFees) ? map[category].customAdvanceFees : [];
            foundInMap = true;
          }
        } catch (err) {}
      }
      if (!foundInMap) {
        sFee = parseFloat(d.schoolFee) || 0;
        aFee = parseFloat(d.admissionFee) || 0;
        if (d.customAdvanceFeesJSON) {
          try { customAdvList = JSON.parse(d.customAdvanceFeesJSON) || []; } catch (e) { customAdvList = []; }
        }
      }
    }

    let html = "";
    if (sFee > 0) {
      html += `<div style="background:#fff; padding:15px; border-radius:12px; border:1.5px solid #a7f3d0;">
        <label style="margin-top:0; color:#005f40;">Advance School Fee (${sFee} TK)</label>
        <input type="hidden" class="admitFeeGrid-total" data-name="School Fee" data-mode="add" value="${sFee}">
        <input type="number" class="admitFeeGrid-paid" style="border-color:#005f40; color:#005f40; font-weight:900; text-align:center; font-size:18px;" placeholder="Amount Paying" value="${sFee}">
      </div>`;
    }
    if (aFee > 0) {
      html += `<div style="background:#fff; padding:15px; border-radius:12px; border:1.5px solid #cbd5e1;">
        <label style="margin-top:0; color:#0f766e;">Admission Fee (${aFee} TK)</label>
        <input type="hidden" class="admitFeeGrid-total" data-name="Admission Fee" data-mode="add" value="${aFee}">
        <input type="number" class="admitFeeGrid-paid" style="border-color:#0f766e; color:#0f766e; font-weight:900; text-align:center; font-size:18px;" placeholder="Amount Paying" value="${aFee}">
      </div>`;
    }

    customAdvList.forEach(cf => {
      let cName = (cf.name || "").toString().trim();
      let cAmt = parseFloat(cf.amount) || 0;
      if (cName && cAmt > 0) {
        let safeName = cName.replace(/"/g, "&quot;");
        html += `<div style="background:#faf5ff; padding:15px; border-radius:12px; border:1.5px solid #d8b4fe;">
          <label style="margin-top:0; color:#7e22ce;"><i class="fas fa-star"></i> ${cName} (${cAmt} TK)</label>
          <input type="hidden" class="admitFeeGrid-total" data-name="${safeName}" data-mode="add" value="${cAmt}">
          <input type="number" class="admitFeeGrid-paid" style="border-color:#8b5cf6; color:#8b5cf6; font-weight:900; text-align:center; font-size:18px;" placeholder="Amount Paying" value="${cAmt}">
        </div>`;
      }
    });

    if (html === "") {
      html = `<p style="grid-column: 1 / -1; color:#64748b; font-weight:600; margin:0;">Class ${cls} (${category || 'Default'})-এর জন্য কোনো অগ্রিম ভর্তি ফি সেট করা নেই।</p>`;
    }
    admissionFeesCache[cacheKey] = html;
    gridEl.innerHTML = html;
  } catch (e) {
    gridEl.innerHTML = `<p style="color:red;">ভর্তি ফি লোড করতে সমস্যা হয়েছে।</p>`;
  }
}

