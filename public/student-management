            <span><i class="fas fa-id-badge" style="color:#94a3b8;"></i> ID: <b>${s.studentID}</b></span>
            <span><i class="fas fa-graduation-cap" style="color:#94a3b8;"></i> Class: <b>${s.class}</b></span>
            <span><i class="fas fa-list-ol" style="color:#94a3b8;"></i> Roll: <b>${s.roll}</b></span>
            <span><i class="fas fa-phone" style="color:#94a3b8;"></i> <b>${s.phone || 'N/A'}</b></span>
