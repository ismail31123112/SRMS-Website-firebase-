<!DOCTYPE html>
<html>
<head>
<base target="_top">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SRMS Student DB Manager V7 ERP</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
:root { --primary: #005f40; --primary-dark: #003d29; --light: #e8f5e9; --bg: #f4f7f9; --danger: #ef4444; --edit: #3b82f6; --gold: #f59e0b; --gold-light: #fef3c7; --border: #cbd5e1; }
body { font-family: 'Poppins', sans-serif; background: var(--bg); margin: 0; padding-bottom: 95px; color: #334155; }
@keyframes slideUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.header { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(12px); padding: 15px 20px; box-shadow: 0 4px 20px rgba(0, 95, 64, 0.08); display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 50; border-bottom: 2px solid var(--light); }
.header h2 { font-size: 18px; color: var(--primary); margin: 0; font-weight: 900; letter-spacing: 0.5px;}

.btn-back { background: var(--light); color: var(--primary); border: 1.5px solid #a7f3d0; padding: 8px 16px; border-radius: 20px; font-size: 12px; font-weight: 700; cursor: pointer; transition: 0.3s; display: flex; align-items: center; gap: 6px; }
.btn-back:hover { background: var(--primary); color: white; border-color: var(--primary); transform: translateY(-2px); box-shadow: 0 6px 15px rgba(0, 95, 64, 0.2);}

.container { display: none; padding: 20px 15px; max-width: 1000px; margin: auto; animation: slideUp 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
.container.active { display: block; }

.card { background: white; border-radius: 20px; padding: 25px; box-shadow: 0 10px 30px rgba(0, 95, 64, 0.05); margin-bottom: 25px; border: 1px solid var(--border); transition: all 0.3s ease;}
.card-title { margin:0 0 20px 0; color:var(--primary); font-weight:900; text-transform: uppercase; font-size: 18px; border-bottom: 2px solid var(--light); padding-bottom: 10px;}

.form-section { background: #f8fafc; padding: 20px; border-radius: 16px; border: 1px solid #e2e8f0; margin-bottom: 20px; }
.form-section h4 { margin: 0 0 15px 0; color: #475569; font-size: 15px; display: flex; align-items: center; gap: 8px; }

label { display: block; font-size: 12px; font-weight: 700; color: #475569; margin-top: 15px; margin-left: 5px; text-transform: uppercase; letter-spacing: 0.5px;}
input, select, textarea { width: 100%; padding: 14px 15px; border: 2px solid #e2e8f0; border-radius: 12px; box-sizing: border-box; margin-top: 6px; font-family: inherit; font-size: 14px; transition: 0.3s; background: #fff; font-weight: 500;}
input:focus, select:focus, textarea:focus { border-color: var(--primary); outline: none; box-shadow: 0 0 0 4px rgba(0, 95, 64, 0.1); transform: translateY(-1px);}

.flex-row { display: flex; gap: 15px; flex-wrap: wrap; }
.flex-col { flex: 1; min-width: 200px; }

.btn-submit { width: 100%; background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: white; padding: 16px; border: none; border-radius: 14px; font-weight: 800; cursor: pointer; margin-top: 25px; transition: 0.3s; font-size: 15px; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 8px 20px rgba(0, 95, 64, 0.25);}
.btn-submit:hover { transform: translateY(-3px); box-shadow: 0 12px 25px rgba(0, 95, 64, 0.35); }

/* Bottom Nav */
.bottom-nav { position: fixed; bottom: 0; width: 100%; background: rgba(255,255,255,0.95); backdrop-filter: blur(12px); display: flex; box-shadow: 0 -5px 25px rgba(0, 95, 64, 0.08); z-index: 100; border-radius: 24px 24px 0 0; border-top: 1px solid #e2e8f0; padding: 6px 0;}
.nav-item { flex: 1; text-align: center; color: #94a3b8; border: none; background: none; font-size: 11px; padding: 12px; cursor: pointer; font-weight: 600; transition: 0.3s;}
.nav-item i { display: block; font-size: 22px; margin-bottom: 5px; transition: 0.3s;}
.nav-item.active { color: var(--primary); font-weight: 800; }
.nav-item.active i { transform: translateY(-4px) scale(1.1); color: var(--gold); }

/* List Item */
.list-item { padding: 20px; border-radius: 16px; margin-bottom: 15px; background: #fff; display: flex; justify-content: space-between; align-items: center; border: 1px solid #e2e8f0; transition: 0.3s; animation: fadeIn 0.5s; flex-wrap: wrap; gap: 10px;}
.btn-group button { border: none; background: #f1f5f9; cursor: pointer; padding: 10px 14px; border-radius: 10px; margin-left: 8px; transition: 0.3s; font-weight: bold; font-size: 12px;}
.btn-group button:hover { opacity: 0.8; transform: translateY(-2px); }

/* Modals */
.modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(15,23,42,0.65); backdrop-filter: blur(6px); align-items: center; justify-content: center; }
.modal-content { background: #fff; padding: 35px; border-radius: 24px; width: 95%; max-width: 800px; max-height: 85vh; overflow-y: auto; position: relative; border-top: 6px solid var(--primary); box-shadow: 0 25px 50px rgba(0,0,0,0.3);}
.close { position: absolute; top: 20px; right: 25px; font-size: 30px; cursor: pointer; color: #94a3b8; font-weight: bold; transition: 0.3s;}
.close:hover { color: var(--danger); transform: rotate(90deg);}

/* Dashboard Stats */
.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 15px; margin-bottom: 20px; }
.stat-card { background: linear-gradient(135deg, #f8fafc, #f1f5f9); padding: 15px; border-radius: 15px; text-align: center; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px rgba(0,0,0,0.02); transition: 0.3s; }
.stat-card:hover { transform: translateY(-3px); border-color: var(--primary); }
.stat-card h3 { margin: 0; font-size: 24px; color: var(--primary); font-weight: 900; }
.stat-card p { margin: 5px 0 0 0; font-size: 12px; color: #64748b; font-weight: 700; text-transform: uppercase; }
.total-stat { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: white; border: none; }
.total-stat h3, .total-stat p { color: white; }

/* Readonly Info Table */
.info-table { width: 100%; border-collapse: collapse; margin-top: 15px; font-size: 14px; }
.info-table td { padding: 12px 15px; border-bottom: 1px solid #e2e8f0; }
.info-table td:first-child { font-weight: 700; color: #64748b; width: 35%; text-transform: uppercase; font-size: 11px; }
.info-table td:last-child { font-weight: 600; color: #0f172a; }

/* Loader */
#loader { display:flex; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(255,255,255,0.95); z-index:9999; flex-direction:column; align-items:center; justify-content:center; backdrop-filter: blur(8px); }
.spinner { width:55px; height:55px; border:4px solid #e2e8f0; border-top:4px solid var(--primary); border-radius:50%; animation:spin 1s cubic-bezier(0.55, 0.15, 0.45, 0.85) infinite; }
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

/* Print Handling */
@media print { 
    body * { visibility: hidden; } 
    .print-active, .print-active * { visibility: visible; } 
    .print-active { position: absolute; left: 0; top: 0; width: 100%; display: block !important; padding: 0; margin: 0; background: #fff;} 
    @page { size: A4; margin: 15mm; }
}

/* TC Specific Styles for Print */
.tc-pad { font-family: 'Times New Roman', Times, serif; color: #000; line-height: 1.6; }
.tc-header { text-align: center; border-bottom: 3px solid #005f40; padding-bottom: 15px; margin-bottom: 30px; position: relative; }
.tc-header h1 { font-size: 26px; color: #005f40; margin: 0 0 5px 0; font-weight: 900; letter-spacing: 1px; text-transform: uppercase; }
.tc-header p { margin: 3px 0; font-size: 13px; font-weight: bold; font-family: Arial, sans-serif; }
.tc-title { text-align: center; font-size: 22px; font-weight: bold; text-decoration: underline; margin-bottom: 30px; letter-spacing: 2px; }
.tc-body { font-size: 16px; text-align: justify; }
.tc-body .line { margin-bottom: 15px; }
.tc-body b { border-bottom: 1px dotted #000; padding: 0 10px; }
.tc-footer { margin-top: 80px; display: flex; justify-content: space-between; font-weight: bold; }
</style>
</head>
<body>

<div id="loader"><div class="spinner"></div><p id="loaderText" style="margin-top:15px; font-weight:800; color:var(--primary); text-align: center;">SYSTEM INITIALIZING...<br><span style="font-size:11px; color:#64748b;">Verifying Admin Session</span></p></div>

<div id="appContainer" style="display: none;">
    <div class="header">
        <h2><i class="fas fa-school"></i> SRMS ERP DB V7</h2>
        <button class="btn-back" onclick="window.close();"><i class="fas fa-sign-out-alt"></i> Dashboard</button>
    </div>

    <!-- ================= ADMIT TAB ================= -->
    <div id="admitTab" class="container active">
        <div class="card">
            <h3 class="card-title"><i class="fas fa-user-plus"></i> New Student Admission</h3>
            
            <div class="form-section">
                <h4><i class="fas fa-id-card"></i> Personal Information</h4>
                <div class="flex-row">
                    <div class="flex-col"><label>Full Name *</label><input type="text" id="sName" placeholder="Student's Name"></div>
                    <div class="flex-col"><label>Date of Birth</label><input type="date" id="sDob"></div>
                </div>
                <div class="flex-row">
                    <div class="flex-col"><label>Gender</label><select id="sGender"><option value="">Select</option><option value="Male">Male</option><option value="Female">Female</option></select></div>
                    <div class="flex-col"><label>Religion</label><select id="sReligion"><option value="">Select</option><option value="Islam">Islam</option><option value="Hinduism">Hinduism</option><option value="Christianity">Christianity</option><option value="Buddhism">Buddhism</option></select></div>
                    <div class="flex-col"><label>Blood Group</label><select id="sBloodGroup"><option value="">Select</option><option value="A+">A+</option><option value="A-">A-</option><option value="B+">B+</option><option value="B-">B-</option><option value="AB+">AB+</option><option value="AB-">AB-</option><option value="O+">O+</option><option value="O-">O-</option></select></div>
                </div>
                <div class="flex-row">
                    <div class="flex-col"><label>Birth Certificate / NID</label><input type="text" id="sBirthCert" placeholder="Registration No"></div>
                </div>
            </div>

            <div class="form-section">
                <h4><i class="fas fa-graduation-cap"></i> Academic Information</h4>
                <div class="flex-row">
                    <div class="flex-col"><label>Class *</label>
                        <select id="sClass" onchange="fetchFeesForClass('sClass', 'sRes', 'admitFeeGrid'); toggleGroup('sClass', 'sGroupDiv');">
                            <option value="">Select Class</option><option value="Play">Play</option><option value="Nursery">Nursery</option><option value="KG">KG</option><option value="1">Class 1</option><option value="2">Class 2</option><option value="3">Class 3</option><option value="4">Class 4</option><option value="5">Class 5</option><option value="6">Class 6</option><option value="7">Class 7</option><option value="8">Class 8</option><option value="9">Class 9</option><option value="10">Class 10</option>
                        </select>
                    </div>
                    <div class="flex-col"><label>Section</label><select id="sSection"><option value="">Select Section</option></select></div>
                    <div class="flex-col"><label>Roll *</label><input type="number" id="sRoll" placeholder="Roll No."></div>
                </div>
                <div class="flex-row">
                    <div id="sGroupDiv" class="flex-col" style="display:none;"><label>Group</label><select id="sGroup"><option value="">Select</option><option value="Science">Science</option><option value="Arts">Arts</option><option value="Commerce">Commerce</option></select></div>
                    <div class="flex-col"><label>Status *</label>
                        <select id="sRes" onchange="fetchFeesForClass('sClass', 'sRes', 'admitFeeGrid')">
                            <option value="Non-Residential">Non-Residential</option><option value="Residential">Residential</option>
                        </select>
                    </div>
                    <div class="flex-col"><label style="color:var(--primary-dark);">Category *</label><select id="sCategory" style="border-color:var(--primary); font-weight:700;"><option value="Civil">Civil</option><option value="Army">Army</option></select></div>
                </div>
                <div class="flex-row">
                    <div class="flex-col"><label>Admission Date</label><input type="date" id="sAdmissionDate"></div>
                    <div class="flex-col"><label>Previous School (If any)</label><input type="text" id="sPrevSchool" placeholder="School Name"></div>
                </div>
            </div>

            <div class="form-section">
                <h4><i class="fas fa-users"></i> Guardian & Contact Information</h4>
                <div class="flex-row">
                    <div class="flex-col"><label>Father's Name</label><input type="text" id="sFatherName" placeholder="Father's Name"></div>
                    <div class="flex-col"><label>Mother's Name</label><input type="text" id="sMotherName" placeholder="Mother's Name"></div>
                </div>
                <div class="flex-row">
                    <div class="flex-col"><label>Primary Phone Number *</label><input type="tel" id="sPhone" placeholder="017XXXXXXXX (For SMS/Portal)"></div>
                    <div class="flex-col"><label>Alternative/Guardian Phone</label><input type="tel" id="sGuardianPhone" placeholder="01XXXXXXXXX"></div>
                </div>
                <div class="flex-row">
                    <div class="flex-col"><label>Present Address</label><textarea id="sAddress" rows="2" placeholder="Full Present Address"></textarea></div>
                    <div class="flex-col"><label>Permanent Address</label><textarea id="sPermanentAddress" rows="2" placeholder="Full Permanent Address"></textarea></div>
                </div>
            </div>

            <div class="form-section" style="border-color: #8b5cf6;">
                <h4 style="color:#7e22ce;"><i class="fas fa-microchip"></i> System & ID Card</h4>
                <div class="flex-row">
                    <div class="flex-col"><label>Machine Card Number (RFID)</label><input type="text" id="sCardNumber" placeholder="Enter RFID Card No"></div>
                </div>
            </div>

            <!-- 💡 AUTO FETCHED ADMISSION FEES ZONE -->
            <div id="admitFeeZone" style="display:none; background:#f0fdf4; padding:20px; border-radius:16px; border:2px dashed var(--primary); margin-bottom:20px;">
                <h4 style="margin:0 0 15px 0; color:#005f40; font-size:16px;"><i class="fas fa-file-invoice-dollar"></i> Initial Admission Fees</h4>
                <div id="admitFeeGrid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:15px;"></div>
            </div>

            <button class="btn-submit" onclick="saveStudent()"><i class="fas fa-rocket"></i> Submit Admission & Collect Fees</button>
        </div>
    </div>

    <!-- ================= VIEW TAB ================= -->
    <div id="viewTab" class="container">
        <!-- Live Dashboard Stats -->
        <h3 style="margin-top:0; color:#475569;"><i class="fas fa-chart-pie"></i> School Demographics</h3>
        <div id="statsDashboard" class="stats-grid"></div>

        <div class="card">
            <div class="flex-row" style="margin-bottom:15px;">
                <select id="filterClass" onchange="filterStudents()" style="flex:1; min-width:110px;"><option value="">All Classes</option><option value="Play">Play</option><option value="Nursery">Nursery</option><option value="KG">KG</option><option value="1">Class 1</option><option value="2">Class 2</option><option value="3">Class 3</option><option value="4">Class 4</option><option value="5">Class 5</option><option value="6">Class 6</option><option value="7">Class 7</option><option value="8">Class 8</option><option value="9">Class 9</option><option value="10">Class 10</option></select>
                <select id="filterSection" onchange="filterStudents()" style="flex:1; min-width:110px;"><option value="">All Sections</option></select>
                <select id="filterCategory" onchange="filterStudents()" style="flex:1; min-width:110px;"><option value="">All Category</option><option value="Civil">Civil</option><option value="Army">Army</option></select>
                
                <button onclick="openTcModal()" style="background:#f59e0b; color:white; border:none; padding:14px 20px; border-radius:12px; cursor:pointer; font-weight:800; min-width:130px;"><i class="fas fa-file-signature"></i> Create TC</button>
                <button onclick="printReport()" style="background:linear-gradient(135deg, var(--primary), var(--primary-dark)); color:white; border:none; padding:14px 20px; border-radius:12px; cursor:pointer; box-shadow: 0 4px 10px rgba(0, 95, 64, 0.3);"><i class="fas fa-print"></i> List</button>
            </div>
            <div style="position: relative;"><i class="fas fa-search" style="position:absolute; left: 15px; top: 50%; transform: translateY(-50%); color: #94a3b8;"></i><input type="text" id="stuSearch" placeholder="Search Name, ID, Phone, Roll..." onkeyup="filterStudents()" style="padding-left: 45px; border-radius: 30px; font-size: 15px;"></div>
        </div>
        
        <div id="studentListDisplay"></div>
    </div>

    <!-- ================= SECTION MANAGER TAB ================= -->
    <div id="sectionTab" class="container">
        <div class="card" style="border-top: 4px solid var(--primary);">
            <h3 class="card-title"><i class="fas fa-layer-group"></i> Manage Custom Sections</h3>
            <p style="font-size:13px; color:#64748b; font-weight:600; margin-bottom: 20px;">Add sections here globally. They will automatically appear in all Admission and Edit forms.</p>
            <div style="display:flex; gap:10px;">
                <input type="text" id="newSecName" placeholder="E.g., Padma, Lotus, A, B" style="flex:1; border-color:#a7f3d0;">
                <button onclick="addSection()" class="btn-submit" style="width:130px; margin-top:0; padding:10px; box-shadow: 0 6px 15px rgba(0, 95, 64, 0.2);"><i class="fas fa-plus"></i> Add</button>
            </div>
            <div id="sectionListDisplay" style="margin-top:25px; border: 1px solid #e2e8f0; border-radius: 16px; padding: 15px; background: #f0fdf4;"></div>
        </div>
    </div>

    <!-- ================= MODALS ================= -->

    <!-- 👁️ VIEW MODAL -->
    <div id="viewModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeModal('viewModal')">&times;</span>
            <h3 style="color:var(--primary); margin-top:0; font-weight:900; border-bottom: 2px solid var(--light); padding-bottom:10px;"><i class="fas fa-user-circle"></i> Student Profile</h3>
            
            <table class="info-table" id="viewTable">
                <!-- Dynamically Populated -->
            </table>
            
            <button class="btn-submit" style="background:#64748b; margin-top:20px;" onclick="closeModal('viewModal')">Close View</button>
        </div>
    </div>

    <!-- ✏️ EDIT MODAL -->
    <div id="editModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeModal('editModal')">&times;</span>
            <h3 style="color:var(--edit); margin-top:0; font-weight:900; border-bottom: 2px solid #e0e7ff; padding-bottom:10px;"><i class="fas fa-user-edit"></i> Edit Profile & Academic Update</h3>

            <input type="hidden" id="eRowId">
            <div class="form-section">
                <div class="flex-row">
                    <div class="flex-col"><label>Student ID (Read Only)</label><input type="text" id="eId" readonly style="background:#f1f5f9; color:#94a3b8; border:none;"></div>
                    <div class="flex-col"><label>Full Name</label><input type="text" id="eName"></div>
                </div>
                <div class="flex-row">
                    <div class="flex-col"><label>Class</label>
                        <select id="eClass" onchange="onEditClassChange()">
                            <option value="Play">Play</option><option value="Nursery">Nursery</option><option value="KG">KG</option><option value="1">Class 1</option><option value="2">Class 2</option><option value="3">Class 3</option><option value="4">Class 4</option><option value="5">Class 5</option><option value="6">Class 6</option><option value="7">Class 7</option><option value="8">Class 8</option><option value="9">Class 9</option><option value="10">Class 10</option>
                        </select>
                    </div>
                    <div class="flex-col"><label>Section</label><select id="eSection"><option value="">Select</option></select></div>
                    <div class="flex-col"><label>Roll</label><input type="number" id="eRoll"></div>
                </div>
                <div class="flex-row">
                    <div class="flex-col"><label>Status</label><select id="eRes" onchange="onEditClassChange()"><option value="Non-Residential">Non-Residential</option><option value="Residential">Residential</option></select></div>
                    <div class="flex-col"><label>Category</label><select id="eCategory"><option value="Civil">Civil</option><option value="Army">Army</option></select></div>
                </div>
            </div>

            <div class="form-section">
                <div class="flex-row">
                    <div class="flex-col"><label>Date of Birth</label><input type="date" id="eDob"></div>
                    <div class="flex-col"><label>Phone Number</label><input type="tel" id="ePhone"></div>
                </div>
                <div class="flex-row">
                    <div class="flex-col"><label>Father's Name</label><input type="text" id="eFatherName"></div>
                    <div class="flex-col"><label>Mother's Name</label><input type="text" id="eMotherName"></div>
                </div>
                <div class="flex-row">
                    <div class="flex-col"><label>Present Address</label><textarea id="eAddress" rows="2"></textarea></div>
                </div>
            </div>

            <!-- 💡 AUTO FETCHED SESSION/PROMOTION FEES ZONE -->
            <div id="editFeeZone" style="display:none; background:#eff6ff; padding:20px; border-radius:16px; border:2px dashed #3b82f6; margin-bottom:20px;">
                <h4 style="margin:0 0 15px 0; color:#1d4ed8; font-size:16px;"><i class="fas fa-level-up-alt"></i> New Session / Promotion Fees</h4>
                <div id="editFeeGrid" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:15px;"></div>
            </div>

            <button class="btn-submit" style="background:linear-gradient(135deg, var(--edit), #1d4ed8);" onclick="updateStudent()"><i class="fas fa-sync"></i> Save Updates & Collect</button>
        </div>
    </div>

    <!-- 📜 TC GENERATOR MODAL -->
    <div id="tcModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeModal('tcModal')">&times;</span>
            <h3 style="color:#f59e0b; margin-top:0; font-weight:900; border-bottom: 2px solid #fef3c7; padding-bottom:10px;"><i class="fas fa-file-signature"></i> Generate Transfer Certificate</h3>
            
            <div class="form-section">
                <div class="flex-row">
                    <div class="flex-col"><label>Student Name</label><input type="text" id="tcName" placeholder="Student Name"></div>
                    <div class="flex-col"><label>Student ID (Optional)</label><input type="text" id="tcId" placeholder="System ID"></div>
                </div>
                <div class="flex-row">
                    <div class="flex-col"><label>Father's Name</label><input type="text" id="tcFather"></div>
                    <div class="flex-col"><label>Mother's Name</label><input type="text" id="tcMother"></div>
                </div>
                <div class="flex-row">
                    <div class="flex-col"><label>Class</label><input type="text" id="tcClass"></div>
                    <div class="flex-col"><label>Roll</label><input type="text" id="tcRoll"></div>
                </div>
                <div class="flex-row">
                    <div class="flex-col"><label>Admission Date</label><input type="date" id="tcAdDate"></div>
                    <div class="flex-col"><label>Date of Leaving</label><input type="date" id="tcLeaveDate"></div>
                </div>
