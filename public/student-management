async function loadStudents() {
    if(!isAuthReady) return;
    document.getElementById('loader').style.display = 'flex'; showLoaderText("FETCHING DATA...");
    try {
        const snapshot = await db.collection('Students').get();
        let data = [];
        snapshot.forEach(doc => { let f = doc.data(); f.rowId = doc.id; data.push(f); });
        data.sort((a,b) => (parseInt(a.roll)||9999) - (parseInt(b.roll)||9999));
        allData = data;
        filterStudents(); 
        document.getElementById('loader').style.display = 'none';
    } catch(e) { document.getElementById('loader').style.display = 'none'; }
}

function filterStudents() {
    var fCls = document.getElementById('filterClass').value; var fSec = document.getElementById('filterSection').value; var fGrp = document.getElementById('filterGroup').value; var fRes = document.getElementById('filterRes').value; var fCat = document.getElementById('filterCategory').value; var fTxt = document.getElementById('stuSearch').value.toLowerCase();
    
    currentlyFilteredData = allData.filter(s => {
        var matchCls = fCls === "" || String(s.class) === fCls; var matchSec = fSec === "" || String(s.section) === fSec; var matchGrp = fGrp === "" || String(s.group) === fGrp; var matchRes = fRes === "" || String(s.resStatus) === fRes; var matchCat = fCat === "" || String(s.category) === fCat;
        var matchTxt = String(s.name).toLowerCase().includes(fTxt) || String(s.studentID).toLowerCase().includes(fTxt) || String(s.roll).includes(fTxt) || (s.phone && String(s.phone).includes(fTxt)); 
        return matchCls && matchSec && matchGrp && matchRes && matchCat && matchTxt;
    });
    
    renderList(currentlyFilteredData);
}

function renderList(data) {
    var h = ""; var classCounts = {};
    data.forEach(s => {
        var cls = s.class || "N/A"; classCounts[cls] = (classCounts[cls] || 0) + 1;
        var cBadge = s.category === 'Army' ? `<span class="badge-army">Army</span>` : `<span class="badge-civil">Civil</span>`;
        var sBadge = s.resStatus === 'Residential' ? `<span class="badge-civil" style="border-color:#f87171; color:#dc2626;">RES</span>` : ``;
        h += `<div class="list-item">
        <div style="flex:1;">
        <div style="margin-bottom:5px;"><b style="font-size:16px; color:#005f40;">${s.name || 'Unknown'}</b> <span style="margin-left:8px;">${cBadge} ${sBadge}</span></div>
        <small style="color:#64748b; font-weight:500; font-size:12px; line-height:1.6;">
        <b style="color:#334155;">ID:</b> ${s.studentID} | <b style="color:#334155;">Class:</b> ${s.class} (${s.section || '-'}) | <b style="color:#334155;">Roll:</b> ${s.roll} | <b style="color:#334155;">Phone:</b> ${s.phone || 'N/A'}
        </small>
        </div>
        <div class="btn-group" style="display:flex; flex-wrap:wrap; gap:8px;">
        <button onclick="viewProfile('${s.rowId}')" style="color:#0f766e"><i class="fas fa-eye"></i> View</button>
        <button onclick="openEditByRow('${s.rowId}')" style="color:var(--edit)"><i class="fas fa-edit"></i> Edit</button>
        <button onclick="delStu('${s.rowId}')" style="color:var(--danger)"><i class="fas fa-trash"></i> Del</button>
        </div>
        </div>`;
    });
    document.getElementById('studentListDisplay').innerHTML = h || "<p style='text-align:center;'>No matching records.</p>";
    document.getElementById('totalStuCount').innerText = data.length;
    
    var statsHtml = "";
    for(var c in classCounts) { statsHtml += `<span style="background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); padding: 6px 12px; border-radius: 8px;">Class ${c}: <b style="color:var(--gold); margin-left:4px;">${classCounts[c]}</b></span>`; }
    document.getElementById('classWiseStats').innerHTML = statsHtml;
}

