function showLoaderText(text) { document.getElementById('loaderText').innerHTML = text; }
function showLoading() { document.getElementById('loader').style.display = "flex"; }
function hideLoading() { document.getElementById('loader').style.display = "none"; }

// 🌐 BACKEND API CALLER 
async function apiCall(actionName, payloadData = {}) {
    let token = await auth.currentUser.getIdToken(true);
    let payload = { action: actionName, token: token, ...payloadData };
    try {
        let res = await fetch(SCRIPT_URL, {
            method: 'POST', body: JSON.stringify(payload), headers: { 'Content-Type': 'text/plain;charset=utf-8' }
        });
        return await res.json();
    } catch (error) {
        console.error("API Call Failed:", error); throw error;
    }
}

// 🛡️ Security Gate - Check Auth State
auth.setPersistence(firebase.auth.Auth.Persistence.LOCAL)
.then(() => {
    auth.onAuthStateChanged(function(user) {
        if (user) {
            isAuthReady = true;
            document.getElementById('loader').style.display = 'none';
            document.getElementById('appContainer').style.display = 'block';
            loadSectionsData();
        } else {
            showLoaderText("UNAUTHORIZED ACCESS!<br><span style='font-size:11px; color:#ef4444;'>Redirecting to Login...</span>");
            setTimeout(() => {
                var currentDomain = window.location.protocol + "//" + window.location.host;
                window.location.replace(currentDomain + "/login-panel/accounting-and-management-department");
            }, 1000);
        }
    });
})
.catch(err => { console.error("Auth Persistence Error:", err); });

function switchTab(id, btn) {
    if(!isAuthReady) return alert("Security checking in progress... Please wait.");
    document.querySelectorAll('.container').forEach(c => c.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    btn.classList.add('active');
}

// 🚀 DIRECT FIREBASE: Load Sections 
async function loadSectionsData() {
    try {
        const doc = await db.collection('Admin').doc('Settings').get();
        let opts = '<option value="">All Sections</option>';
        if (doc.exists && doc.data().sections) {
            doc.data().sections.split(',').filter(s=>s.trim()!=='').forEach(s => { opts += `<option value="${s}">${s}</option>`; });
        }
        document.getElementById('rSec').innerHTML = opts;
        document.getElementById('hSec').innerHTML = opts;
    } catch (e) { console.error(e); }
}

// 🚀 DIRECT FIREBASE: Search Single Student
async function searchStu() {
    if(!isAuthReady) return;
    let id = document.getElementById('sid').value.trim();
    if(!id) return;
    showLoading(); showLoaderText("SEARCHING...<br><span style='font-size:11px; color:#64748b;'>Querying Database securely</span>");
    
    try {
        let snap = await db.collection('Students').where('studentID', '==', id).get();
        hideLoading();
        if(snap.empty) { alert("Student ID not found in database!"); return; }
        
        let fields = snap.docs[0].data();
        let customFees = fields.customFees ? JSON.parse(fields.customFees) : [];
        let activeCustomFees = customFees.filter(cf => cf.name && parseFloat(cf.amount) > 0 && cf.status.toLowerCase() !== "paid");
        
        let d = {
            found: true,
            name: fields.name || "", class: fields.class || "", section: fields.section || "", roll: fields.roll || "",
            category: fields.category || "Civil", year: fields.feeYear || "", month: fields.feeMonth || "",
            genAmt: parseFloat(fields.schoolFeeDue) || 0, genStatus: fields.schoolFeeStatus || "Paid",
            hosAmt: parseFloat(fields.hostelFeeDue) || 0, hosStatus: fields.hostelFeeStatus || "Paid",
            isRes: fields.resStatus === "Residential", email: fields.email || "", phone: fields.phone || "",
            customFees: activeCustomFees
        };
        
        renderPaymentZone(d);
        
    } catch(err) {
        hideLoading(); console.error(err); alert("Error fetching student data!");
    }
}

function renderPaymentZone(d) {
    document.getElementById('payZone').style.display = "block";
    document.getElementById('btnPrint').style.display = "none";
    document.getElementById('success-msg').style.display = "none";
    document.getElementById('btnPay').style.display = "flex";
    document.getElementById('dName').innerText = d.name;
    let secStr = d.section ? ` (Sec: ${d.section})` : "";
    document.getElementById('dInfo').innerText = "Class: " + d.class + secStr + " | Roll: " + d.roll;
    document.getElementById('dMonth').innerText = (d.month || "-") + " " + (d.year || "");

    let totalDueAmount = 0;
    let genAmtNum = parseFloat(d.genAmt) || 0;
    if(d.genStatus !== "Paid") totalDueAmount += genAmtNum;

    let fg = document.getElementById('feeGrid');
    let html = `
    <div class="fee-card gen">
    <h4 style="margin-top:0; color:var(--main);"><i class="fas fa-graduation-cap"></i> School Fee (${d.genStatus})</h4>
    <div style="background:#f1f5f9; padding:15px; border-radius:12px; margin-bottom:15px; border:1px dashed #cbd5e1;">
    <span style="font-size:12px; color:#64748b; font-weight:800; text-transform:uppercase;">Total Due Amount:</span><br>
    <b style="font-size:24px; color:var(--main);">${d.genAmt} TK</b>
    </div>
    <div style="text-align:left;">
    <label style="font-size:13px; font-weight:800; color:#334155; margin-bottom:8px; display:block;">Amount Paying Now:</label>
    <input type="number" id="pGen" class="pay-input calc-pay" placeholder="0.00" value="${d.genStatus!=='Paid'?d.genAmt:0}" oninput="calcTotalPay()" style="margin:0; width:100%; border-radius:10px;">
    </div>
    </div>`;

    let hosAmtNum = d.isRes ? (parseFloat(d.hosAmt) || 0) : 0;
    if(d.isRes && d.hosStatus !== "Paid") totalDueAmount += hosAmtNum;

    html += `
    <div class="fee-card hos" id="hosBox" style="opacity:${d.isRes ? '1' : '0.5'}">
    <h4 style="margin-top:0; color:var(--accent);"><i class="fas fa-bed"></i> Hostel Fee (${d.isRes ? d.hosStatus : 'N/A'})</h4>
    <div style="background:#fef2f2; padding:15px; border-radius:12px; margin-bottom:15px; border:1px dashed #fecaca;">
    <span style="font-size:12px; color:#ef4444; font-weight:800; text-transform:uppercase;">Total Due Amount:</span><br>
    <b style="font-size:24px; color:var(--accent);">${d.isRes ? d.hosAmt : 0} TK</b>
    </div>
    <div style="text-align:left;">
    <label style="font-size:13px; font-weight:800; color:#334155; margin-bottom:8px; display:block;">Amount Paying Now:</label>
    <input type="number" id="pHos" class="pay-input calc-pay" placeholder="0.00" value="${(d.isRes && d.hosStatus!=='Paid') ? d.hosAmt : 0}" ${d.isRes ? '' : 'disabled'} oninput="calcTotalPay()" style="margin:0; width:100%; border-color:var(--accent) !important; color:var(--accent); border-radius:10px;">
    </div>
    </div>`;

    if (d.customFees && d.customFees.length > 0) {
        d.customFees.forEach((cf) => {
            let cAmtNum = parseFloat(cf.amount) || 0;
            totalDueAmount += cAmtNum;
            html += `
            <div class="fee-card custom" style="background: #faf5ff;">
            <h4 style="margin-top:0; color:#8b5cf6;"><i class="fas fa-star"></i> ${cf.name} (<span style="color:#7e22ce;">${cf.status}</span>)</h4>
            <div style="background:#f3e8ff; padding:15px; border-radius:12px; margin-bottom:15px; border:1px dashed #d8b4fe;">
            <span style="font-size:12px; color:#7e22ce; font-weight:800; text-transform:uppercase;">Total Due Amount:</span><br>
            <b style="font-size:24px; color:#8b5cf6;">${cf.amount} TK</b>
            </div>
            <div style="text-align:left;">
            <label style="font-size:13px; font-weight:800; color:#8b5cf6; margin-bottom:8px; display:block;">Amount Paying Now:</label>
            <input type="number" class="pay-input custom-pay calc-pay" data-col="${cf.colIdx}" data-name="${cf.name}" placeholder="0" value="${cf.amount}" style="border-color:#8b5cf6 !important; color:#8b5cf6; margin:0; width:100%; border-radius:10px;" oninput="calcTotalPay()">
            </div>
            </div>`;
        });
    }

    fg.innerHTML = html;
    document.getElementById('sumDueAmt').innerText = totalDueAmount.toFixed(2);
    calcTotalPay(); 
}

function calcTotalPay() {
    let total = 0;
    document.querySelectorAll('.calc-pay').forEach(inp => {
        if (!inp.disabled) { total += parseFloat(inp.value) || 0; }
    });
    document.getElementById('sumPayingAmt').innerText = total.toFixed(2);
}

// 🚀 BACKEND API: Pay Now
async function payNow() {
    if(!isAuthReady) return;
    let gP = parseFloat(document.getElementById('pGen').value) || 0;
    let hP = parseFloat(document.getElementById('pHos').value) || 0;
    let customArr = [];
    document.querySelectorAll('.custom-pay').forEach(inp => {
        let p = parseFloat(inp.value) || 0;
        if(p > 0) customArr.push({ colIdx: parseInt(inp.getAttribute('data-col')), name: inp.getAttribute('data-name'), paid: p });
    });

    let sendSms = document.getElementById('sendSmsChk') ? document.getElementById('sendSmsChk').checked : false;

    showLoading(); showLoaderText("PROCESSING PAYMENT...<br><span style='font-size:11px; color:#64748b;'>Securely updating Server</span>");
    
    try {
        let res = await apiCall('processPayment', {
            id: document.getElementById('sid').value, genPay: gP, hosPay: hP, customPayments: customArr, sendSms: sendSms
        });
        hideLoading();
        if(res.status === "error") { alert(res.message); return; }
        
        lastR = res;
        document.getElementById('btnPay').style.display = "none";
        document.getElementById('success-msg').style.display = "block";
        document.getElementById('btnPrint').style.display = "block"; 
    } catch(err) {
        hideLoading(); console.error(err); alert("Payment Failed due to network error.");
    }
}

// 🚀 BACKEND API: Process Bulk Update & Factory Reset
async function runBulk() { 
    if(!isAuthReady) return;
    let ids = Array.from(document.querySelectorAll('.s-chk:checked')).map(c => c.value).join(","); 
    let type = document.getElementById('bType').value;
    let amt = document.getElementById('bAmt').value;
    let actionType = document.getElementById('feeAction').value;
    let pwd = document.getElementById('setupPwd').value;

    if (actionType === "Edit" && !pwd) { alert("Please enter the Admin Password to edit fees!"); return; }

    let customFeesArr = [];
    if (type === "Custom") {
        document.querySelectorAll('.custom-fee-item').forEach(item => {
            let n = item.querySelector('.c-fee-name').value;
            let a = item.querySelector('.c-fee-amt').value;
            if(n.trim() && parseFloat(a) > 0) { customFeesArr.push({ name: n.trim(), amt: parseFloat(a) }); }
        });
        if(customFeesArr.length === 0) { alert("Please enter at least one Custom Fee Name and Amount!"); return; }
    } else {
        if(!amt || amt < 0) { alert("Please enter a valid amount!"); return; }
    }

    showLoading(); showLoaderText("UPDATING STUDENTS...<br><span style='font-size:11px; color:#64748b;'>Sending data to Server</span>");
    
    try {
        let res = await apiCall('processBulkUpdate', {
            ids: ids, feeType: type, amount: amt, month: document.getElementById('bMon').value, year: document.getElementById('bYear').value, customFeesJSON: JSON.stringify(customFeesArr), actionType: actionType, pwd: pwd
        });
        hideLoading();
        if(res && res.status === "error") { alert(res.message); } 
        else {
            alert(actionType === "Edit" ? "Fees Setup Successfully Updated & Edited!" : "Fees Setup Completed Successfully!"); 
            document.getElementById('bulkControls').style.display = "none";
            document.getElementById('setupPwd').value = "";
            document.getElementById('bAmt').value = "";
            document.getElementById('customFeeList').innerHTML = `<div class="custom-fee-item" style="display:flex; gap:12px; margin-bottom:10px;">
            <input type="text" class="c-fee-name" placeholder="Fee Name">
            <input type="number" class="c-fee-amt" placeholder="Amount">
            </div>`;
        }
    } catch(err) { hideLoading(); alert("Error processing bulk update."); }
}

async function executeFactoryReset() {
    if(!isAuthReady) return;
    let pwd = document.getElementById('resetPwd').value;
    if(!pwd) { alert("Please enter the Admin Password to perform a Factory Reset."); return; }
    if(confirm("⚠️ Critical Warning!\nAre you 100% sure you want to CLEAR ALL FEES for ALL STUDENTS? This action cannot be undone.")) {
        showLoading(); showLoaderText("FACTORY RESET...<br><span style='font-size:11px; color:#ef4444;'>Executing Critical Update</span>");
        try {
            let res = await apiCall('processFactoryReset', {pwd: pwd});
            hideLoading();
            if(res && res.status === "error") { alert(res.message); } 
            else {
                alert("Factory Reset Complete! All fees have been cleared successfully.");
                document.getElementById('resetPwd').value = "";
                document.getElementById('feeAction').value = "Add";
                toggleActionUI();
            }
        } catch(err) { hideLoading(); alert("Error processing factory reset."); }
    }
}

// 🚀 DIRECT FIREBASE: Load Bulk List
async function loadBulk() { 
    if(!isAuthReady) return;
    let clsValues = [];
    if(document.getElementById('bClsAll').checked) { clsValues.push("All"); } 
    else { document.querySelectorAll('.bCls-chk:checked').forEach(c => clsValues.push(c.value)); }
    
    if(clsValues.length === 0) { alert("Please select at least one class."); return; }
    
    showLoading(); showLoaderText("LOADING LIST...<br><span style='font-size:11px; color:#64748b;'>Querying Database securely</span>");
    
    try {
        let snap = await db.collection('Students').get();
        let list = [];
        snap.forEach(doc => {
            let f = doc.data();
            let sId = f.studentID || ""; if(!sId) return;
            let sClass = f.class ? f.class.trim().toLowerCase() : "";
            let isRes = f.resStatus === "Residential";
            let sCat = f.category || "Civil";
            
            let targetClasses = clsValues.map(c => c.trim().toLowerCase());
            let categoryFilter = document.getElementById('bCat').value;
            let feeType = document.getElementById('bType').value;
            
            let matchCat = (categoryFilter === "All" || sCat === categoryFilter);
            let matchClass = targetClasses.includes("all") || targetClasses.includes(sClass);
            
            if (matchClass && matchCat && (feeType === "General" || feeType === "Custom" || isRes)) {
                list.push({ id: sId, name: f.name || "", category: sCat });
            }
        });
        
        hideLoading();
        let h = "<table style='box-shadow:none; border:none;'><thead><tr><th style='border-radius:10px 0 0 0;'><input type='checkbox' checked onclick='toggleAll(this)' style='width:18px; height:18px; cursor:pointer;'></th><th>Student ID</th><th>Student Name</th><th style='border-radius:0 10px 0 0;'>Category</th></tr></thead><tbody>"; 
        list.forEach(s => {
            let badgeClass = s.category === 'Army' ? 'badge-army' : 'badge-civil';
            h += `<tr><td><input type='checkbox' class='s-chk' value='${s.id}' checked style='width:18px; height:18px; cursor:pointer;'></td><td><b style='color:#005f40;'>${s.id}</b></td><td><b>${s.name}</b></td><td><span class="${badgeClass}">${s.category || 'Civil'}</span></td></tr>`;
        }); 
        document.getElementById('bulkList').innerHTML = h + "</tbody></table>"; 
        document.getElementById('bulkControls').style.display = "block"; 

        if(document.getElementById('feeAction').value === "Edit") {
            document.getElementById('pwdZoneSetup').style.display = "block";
        } else {
            document.getElementById('pwdZoneSetup').style.display = "none";
        }
