    let dueAmt = Math.max(0, payable - paid);
    return `
    <tr>
      <td style="font-weight:700; color:#0f172a;">${i.title}</td>
      <td style="text-align:right;">৳ ${payable.toFixed(2)}</td>
      <td style="text-align:right; font-weight:800; color:#005f40;">৳ ${paid.toFixed(2)}</td>
      <td style="text-align:right; font-weight:700; color:#b91c1c;">৳ ${dueAmt.toFixed(2)}</td>
