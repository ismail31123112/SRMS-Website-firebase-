for (let i = 2020; i <= 2099; i++) years.push(i);
document.getElementById('bYear').innerHTML = years.map(function(y) { return "<option " + (y === currentY ? "selected" : "") + ">" + y + "</option>"; }).join('');
document.getElementById('hYear').innerHTML += years.map(function(y) { return "<option>" + y + "</option>"; }).join('');
document.getElementById('cbYear').innerHTML += years.map(function(y) { return "<option>" + y + "</option>"; }).join('');

function showLoaderText(text) { document.getElementById('loaderText').innerHTML = text; }
function showLoading() { document.getElementById('loader').style.display = "flex"; }
function hideLoading() { document.getElementById('loader').style.display = "none"; }

function formatCategoryBadge(catName) {
  let c = (catName || "").toString().trim();
  if (!c) return `<span style="color:#94a3b8;">-</span>`;
  return `<span class="badge-custom-cat">${c}</span>`;
}

function resolveStudentAvatar(fields) {
  if (!fields) return DEFAULT_AVATAR;
  let raw = (fields.photoUrl || fields.photo || fields.thumbUrl || "").toString().trim();
  if (!raw || raw === "No Photo" || raw === "None") return DEFAULT_AVATAR;
  let driveId = (raw.match(/id=([a-zA-Z0-9_-]{15,})/) || raw.match(/\/d\/([a-zA-Z0-9_-]{15,})/) || [])[1];
  if (driveId && raw.includes("drive.google.com")) {
    return `https://drive.google.com/thumbnail?id=${driveId}&sz=w400`;
  }
  return raw;
}

async function apiCall(actionName, payloadData = {}) {
  let token = "";
  if (auth.currentUser) {
    try { token = await auth.currentUser.getIdToken(false); } catch (e) {}
  }
  let payload = {
    action: actionName,
    token: token,
    adminKey: SRMS_ADMIN_PASSKEY,
    ...payloadData
  };

  let res = await fetch(SCRIPT_URL, {
    method: 'POST',
    body: JSON.stringify(payload),
    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
    redirect: 'follow'
  });

  let text = await res.text();
  if (text.includes("<html") || text.includes("<body")) {
    throw new Error("সার্ভার কানেকশন ত্রুটি! অনুগ্রহ করে পুনরায় চেষ্টা করুন।");
  }

  let data = JSON.parse(text);
  if (data.error) throw new Error(data.error);
  if (data.status === "error") throw new Error(data.message);
  return data;
}

// ============================================================================
// ⚡ AUTH GATE & SILENT BACKGROUND PREFETCH (0.05s INSTANT TAB & SEARCH SPEED)
// ============================================================================
auth.setPersistence(firebase.auth.Auth.Persistence.LOCAL).then(() => {
  auth.onAuthStateChanged(function(user) {
    if (user) {
      isAuthReady = true;
      document.getElementById('loader').style.display = 'none';
      document.getElementById('appContainer').style.display = 'block';
      loadSectionsAndCategoriesData();
      loadFineSettingsFromDB();
      // Background prefetch so Student Search, Reports, Cashbook & Ledger are instant
      setTimeout(() => {
        ensureStudentsCached(false);
        loadCashbook(false, true);
        loadHistory(false, true);
      }, 150);
    } else {
      showLoaderText("অনুমোদনহীন অ্যাক্সেস!<br><span style='font-size:11px; color:#ef4444;'>লগইন পেজে নিয়ে যাওয়া হচ্ছে...</span>");
      setTimeout(() => {
        var currentDomain = window.location.protocol + "//" + window.location.host;
        window.location.replace(currentDomain + "/login-panel/accounting-and-management-department");
      }, 900);
    }
  });
}).catch(err => { console.error("Auth Persistence Error:", err); });

async function ensureStudentsCached(forceRefresh = false) {
  if (studentsLoadedOnce && !forceRefresh) return allStudentsCache;
  let snap = await db.collection('Students').get();
  let list = [];
  let newCatDetected = false;
  snap.forEach(doc => {
    let f = doc.data();
    f._docId = doc.id;
    let sCat = (f.category || f.resStatus || "").toString().trim();
    if (sCat && !globalCategories.includes(sCat)) {
      globalCategories.push(sCat);
      newCatDetected = true;
    }
    list.push(f);
  });
  if (newCatDetected) populateAllCategoryDropdowns();
  allStudentsCache = list;
  studentsLoadedOnce = true;
  return allStudentsCache;
}

function switchTab(id, btn) {
  if (!isAuthReady) return;
  document.querySelectorAll('.container').forEach(c => c.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  btn.classList.add('active');

  if (id === 'cashbookTab') {
    if (cashbookLoadedOnce) {
      renderCashbook();
      loadCashbook(false, true);
    } else {
      loadCashbook(true, false);
    }
  } else if (id === 'reportsTab') {
    loadRep(false);
  } else if (id === 'historyTab') {
    if (historyLoadedOnce) {
      filterHistory();
      loadHistory(false, true);
    } else {
      loadHistory(true, false);
    }
  }
}

// ============================================================================
// 🏷️ DATABASE-DRIVEN SECTIONS & CUSTOM CATEGORIES (`Admin/Settings`)
// ============================================================================
async function loadSectionsAndCategoriesData() {
  try {
    const doc = await db.collection('Admin').doc('Settings').get();
    const d = doc.exists ? doc.data() : {};

    let secOpts = '<option value="">All Sections</option>';
    if (d.sections && d.sections.trim() !== "") {
      d.sections.split(',').map(s => s.trim()).filter(Boolean).forEach(s => {
        secOpts += `<option value="${s}">${s}</option>`;
      });
    }
    document.getElementById('rSec').innerHTML = secOpts;
    document.getElementById('hSec').innerHTML = secOpts;

    globalCategories = (d.categories && d.categories.trim() !== "")
      ? d.categories.split(',').map(c => c.trim()).filter(Boolean)
      : [];

    populateAllCategoryDropdowns();
  } catch (e) {
    populateAllCategoryDropdowns();
  }
}

function populateAllCategoryDropdowns() {
  const curBCat = document.getElementById('bCat').value;
  const curRCat = document.getElementById('rCat').value;
  const curHCat = document.getElementById('hCat').value;
  const curAdvCat = document.getElementById('advCategory').value;

  let filterCatOpts = '<option value="All">All Categories</option>';
  let advCatOpts = '<option value="All">All Categories (Class Default)</option>';

  globalCategories.forEach(c => {
    filterCatOpts += `<option value="${c}">${c}</option>`;
    advCatOpts += `<option value="${c}">${c}</option>`;
  });

  document.getElementById('bCat').innerHTML = filterCatOpts;
  document.getElementById('rCat').innerHTML = filterCatOpts;
  document.getElementById('hCat').innerHTML = filterCatOpts;
  document.getElementById('advCategory').innerHTML = advCatOpts;

  if (curBCat && (curBCat === "All" || globalCategories.includes(curBCat))) document.getElementById('bCat').value = curBCat;
  if (curRCat && (curRCat === "All" || globalCategories.includes(curRCat))) document.getElementById('rCat').value = curRCat;
  if (curHCat && (curHCat === "All" || globalCategories.includes(curHCat))) document.getElementById('hCat').value = curHCat;
  if (curAdvCat && (curAdvCat === "All" || globalCategories.includes(curAdvCat))) document.getElementById('advCategory').value = curAdvCat;
}

async function loadFineSettingsFromDB() {
  try {
    const doc = await db.collection('Admin').doc('FineSettings').get();
    if (doc.exists) {
      let data = doc.data();
      if (data.lateFeeAmount) document.getElementById('fLateAmount').value = data.lateFeeAmount;
      if (data.lateFeeDate) document.getElementById('fLateDay').value = data.lateFeeDate;
      if (data.absenceFineAmount) document.getElementById('fAbsenceAmount').value = data.absenceFineAmount;
    }
  } catch (e) {}
}

async function saveFineSettings() {
  let lAmt = document.getElementById('fLateAmount').value;
  let lDate = document.getElementById('fLateDay').value;
  let aAmt = document.getElementById('fAbsenceAmount').value;
  showLoading();
