<style>
:root {
  --main: #005f40;
  --main-dark: #003d29;
  --accent: #d32f2f;
  --gold: #f59e0b;
  --purple: #7c3aed;
  --bg: #f8fafc;
}
* { box-sizing: border-box; }
body {
  font-family: 'Poppins', sans-serif;
  background: var(--bg);
  margin: 0;
  color: #334155;
  padding-bottom: 95px;
  -webkit-font-smoothing: antialiased;
}

#loader {
  display: flex;
  position: fixed;
  top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(255,255,255,0.92);
  z-index: 9999;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(6px);
}
.spinner {
  width: 50px;
  height: 50px;
  border: 4px solid #e2e8f0;
  border-top: 4px solid var(--main);
  border-radius: 50%;
  animation: spin 0.75s linear infinite;
}
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

.navbar {
  background: linear-gradient(135deg, var(--main), var(--main-dark));
  color: white;
  padding: 14px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4px 20px rgba(0, 95, 64, 0.22);
  position: sticky;
  top: 0;
  z-index: 50;
  border-bottom: 4px solid var(--gold);
}
.nav-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}
.nav-brand img {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #fff;
  padding: 2px;
  border: 2px solid var(--gold);
  object-fit: contain;
}
.nav-brand-text h2 {
  margin: 0;
  font-size: 18px;
  font-weight: 800;
  letter-spacing: 0.4px;
  text-transform: uppercase;
}
.nav-brand-text p {
  margin: 2px 0 0 0;
  font-size: 11px;
  color: #a7f3d0;
  font-weight: 600;
}
.nav-right {
  display: flex;
  align-items: center;
  gap: 14px;
}

.btn-back {
  background: rgba(255,255,255,0.15);
  color: white;
  border: 1px solid rgba(255,255,255,0.3);
  padding: 8px 16px;
  border-radius: 20px;
  font-size: 12.5px;
  font-weight: 700;
  cursor: pointer;
  transition: 0.2s;
  display: flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
}
.btn-back:hover {
  background: white;
  color: var(--main);
  transform: translateY(-1px);
}

.container {
  display: none;
  max-width: 1100px;
  margin: 22px auto;
  padding: 0 15px;
  animation: fadeInUp 0.25s ease;
}
.container.active { display: block; }

.card {
  background: white;
  padding: 28px;
  border-radius: 20px;
  box-shadow: 0 10px 30px rgba(0, 95, 64, 0.06);
  margin-bottom: 26px;
  border-top: 6px solid var(--main);
  border-left: 1px solid #e2e8f0;
  border-right: 1px solid #e2e8f0;
  border-bottom: 1px solid #e2e8f0;
}
@keyframes fadeInUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }

input, select, textarea {
  width: 100%;
  padding: 13px 14px;
  margin: 8px 0;
  border: 2px solid #e2e8f0;
  border-radius: 12px;
  box-sizing: border-box;
  outline: none;
  font-family: inherit;
  transition: 0.2s;
  background: #f8fafc;
  font-size: 14px;
  font-weight: 600;
  color: #0f172a;
}
input:focus, select:focus, textarea:focus {
  border-color: var(--main);
  background: #fff;
  box-shadow: 0 0 0 4px rgba(0, 95, 64, 0.1);
}

.btn {
  padding: 14px 18px;
  border: none;
  border-radius: 14px;
  font-weight: 800;
  cursor: pointer;
  transition: 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  font-size: 14.5px;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  font-family: inherit;
}
.btn:disabled { opacity: 0.65; cursor: not-allowed; }
.btn-main {
  background: linear-gradient(135deg, var(--main), var(--main-dark));
  color: white;
  box-shadow: 0 6px 20px rgba(0, 95, 64, 0.25);
}
.btn-main:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(0, 95, 64, 0.35);
}
.btn-print-big {
  background: linear-gradient(135deg, #0284c7, #0369a1);
  color: white;
  font-size: 15.5px;
  margin-top: 15px;
  display: none;
  box-shadow: 0 6px 20px rgba(2,132,199,0.25);
}
.btn-print-big:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(2,132,199,0.35);
}

.fee-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 18px;
  margin-top: 20px;
}
.fee-card {
  padding: 22px 18px;
  border-radius: 16px;
  text-align: center;
  border: 1px solid #e2e8f0;
  transition: 0.2s;
  background: #fff;
}
.fee-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 24px rgba(0,0,0,0.06);
}
.fee-card.gen { border-top: 6px solid var(--main); }
.fee-card.custom { border-top: 6px solid #8b5cf6; background: #faf5ff; }

.pay-input {
  margin-top: 10px;
  border: 2.5px solid var(--main) !important;
  font-weight: 900;
  text-align: center;
  font-size: 20px;
  color: var(--main);
  border-radius: 10px;
}

table { width: 100%; border-collapse: collapse; font-size: 13.5px; background: white; }
th, td { padding: 13px 12px; border-bottom: 1px solid #e2e8f0; text-align: left; }
th {
  background: #f8fafc;
  position: sticky;
  top: 0;
  z-index: 5;
  font-weight: 800;
  color: #1e293b;
  text-transform: uppercase;
  font-size: 11.5px;
  letter-spacing: 0.5px;
}

#success-msg {
  display: none;
  text-align: center;
  color: #16a34a;
  font-weight: 900;
  font-size: 18px;
  margin: 20px 0;
  background: #dcfce7;
  padding: 15px;
  border-radius: 12px;
  border: 1px solid #bbf7d0;
}

.custom-fee-item input, .adv-custom-fee-item input {
  border: 2px solid #8b5cf6 !important;
  background: #fff;
}

.badge-custom-cat {
  background: #f3e8ff;
  color: var(--purple);
  padding: 4px 10px;
  border-radius: 8px;
  font-size: 11px;
  font-weight: 800;
  border: 1px solid #ddd6fe;
  display: inline-block;
}
.badge-income {
  background: #dcfce7;
  color: #16a34a;
  padding: 4px 8px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: bold;
  border: 1px solid #bbf7d0;
}
.badge-expense {
  background: #fee2e2;
  color: #dc2626;
  padding: 4px 8px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: bold;
  border: 1px solid #fecaca;
}

/* Bottom Nav */
.bottom-nav {
  position: fixed;
  bottom: 0;
  width: 100%;
  background: rgba(255,255,255,0.96);
  backdrop-filter: blur(10px);
  display: flex;
  box-shadow: 0 -5px 25px rgba(0, 95, 64, 0.08);
  z-index: 100;
  border-radius: 20px 20px 0 0;
  border-top: 1px solid #e2e8f0;
  padding: 5px 0;
}
.nav-item {
  flex: 1;
  text-align: center;
  color: #64748b;
  border: none;
  background: none;
  font-size: 11px;
  padding: 10px 5px;
  cursor: pointer;
  font-weight: 700;
  transition: 0.2s;
}
.nav-item i {
  display: block;
  font-size: 20px;
  margin-bottom: 4px;
  transition: 0.2s;
}
.nav-item.active { color: var(--main); font-weight: 900; }
.nav-item.active i { transform: translateY(-3px) scale(1.08); color: var(--gold); }

/* Accountant Calculator Box */
.calc-box {
  background: #0f172a;
  padding: 15px;
  border-radius: 20px;
  width: 280px;
  margin: 0 auto;
  box-shadow: 0 10px 20px rgba(0,0,0,0.18);
}
.calc-scr {
  width: 100%;
  height: 50px;
  background: #020617;
  color: #4ade80;
  text-align: right;
  padding: 10px;
  font-size: 24px;
  border-radius: 10px;
  margin-bottom: 10px;
  font-family: monospace;
  border: 1px solid #1e293b;
  font-weight: bold;
}
.calc-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
.calc-btn {
  padding: 14px;
  border: none;
  border-radius: 8px;
  background: #1e293b;
  color: white;
  font-weight: bold;
  cursor: pointer;
  transition: 0.15s;
}
.calc-btn:hover { background: #334155; transform: scale(1.04); }

