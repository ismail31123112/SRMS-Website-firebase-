              <th>Fee Particulars (ফি-এর বিবরণ)</th>
              <th style="text-align:right; width:105px;">Payable (TK)</th>
              <th style="text-align:right; width:105px;">Paid Now (TK)</th>
              <th style="text-align:right; width:105px;">Due (TK)</th>
            </tr>
          </thead>
          <tbody>${items}</tbody>
        </table>

        <div class="rcp-footer-row">
          <div class="rcp-stamp">SRMS OFFICIAL<br>PAID &amp; VERIFIED</div>
          <div class="rcp-summary-box">
            <div class="rcp-sum-row"><span>Total Payable:</span> <b>৳ ${Number(d.totalBill || 0).toFixed(2)}</b></div>
            <div class="rcp-sum-row" style="background:#ecfdf5 !important; color:#005f40;"><span>Amount Paid Now:</span> <b>৳ ${Number(d.paid || 0).toFixed(2)}</b></div>
            <div class="rcp-sum-row" style="background:#fef2f2 !important; color:#b91c1c;"><span>Remaining Due:</span> <b>৳ ${Number(d.remaining || 0).toFixed(2)}</b></div>
          </div>
        </div>
      </div>

      <div class="rcp-signatures">
        <div class="rcp-sig-line">Student / Guardian Signature</div>
        <div class="rcp-sig-line">Accounts / Cashier Signature</div>
        <div class="rcp-sig-line">Principal / Headmaster</div>
      </div>
    </div>
    ${idx === 0 ? '<div class="rcp-cut-line">✂ - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - ✂</div>' : ''}`;
  }).join('');

  let printBox = document.getElementById('printArea');
  printBox.innerHTML = `<div class="rcp-single-page-sheet">${copiesHtml}</div>`;
  window.print();
  setTimeout(function() { printBox.innerHTML = ''; }, 1000);
