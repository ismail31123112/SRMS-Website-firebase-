<body>

<div id="loader">
  <div class="spinner"></div>
  <p id="loaderText" style="margin-top:15px; font-weight:800; color:var(--main); letter-spacing: 0.5px; text-align: center;">
    সিস্টেম প্রস্তুত হচ্ছে...<br><span style="font-size:11px; color:#64748b;">অ্যাডমিন সেশন যাচাই করা হচ্ছে</span>
  </p>
</div>

<!-- Dedicated Print Area -->
<div id="printArea"></div>

<div id="appContainer" style="display:none;">
  <div class="navbar">
    <div class="nav-brand">
      <img src="https://i.postimg.cc/Y9bdXZPQ/dtg96fyddcib2okq9820.png" alt="SRMS Logo">
      <div class="nav-brand-text">
        <h2>Saidpur Residential Model School</h2>
        <p>Official Accounts, Fee Collection &amp; Finance Portal</p>
      </div>
    </div>
    <div class="nav-right">
      <div id="clock" style="font-weight: 600; font-size: 12.5px;"></div>
      <button class="btn-back" onclick="window.close();" title="Back to Admin Dashboard">
        <i class="fas fa-sign-out-alt"></i> প্রস্থান
      </button>
    </div>
  </div>

  <!-- ================= 1. COLLECT TAB ================= -->
  <div id="collectTab" class="container active">
    <div class="card" style="border-top-color: #1e293b;">
      <h3 style="margin-top:0;"><i class="fas fa-calculator"></i> Quick Calculator (হিসাব ক্যালকুলেটর)</h3>
      <div class="calc-box">
        <input type="text" id="cScr" class="calc-scr" readonly value="0">
        <div class="calc-grid">
          <button class="calc-btn" style="background:#ef4444" onclick="cClr()">C</button>
          <button class="calc-btn" onclick="cPush('/')">÷</button>
          <button class="calc-btn" onclick="cPush('*')">×</button>
          <button class="calc-btn" onclick="cBack()">←</button>
          <button class="calc-btn" onclick="cPush('7')">7</button>
          <button class="calc-btn" onclick="cPush('8')">8</button>
          <button class="calc-btn" onclick="cPush('9')">9</button>
          <button class="calc-btn" style="background:var(--main)" onclick="cPush('-')">-</button>
          <button class="calc-btn" onclick="cPush('4')">4</button>
          <button class="calc-btn" onclick="cPush('5')">5</button>
          <button class="calc-btn" onclick="cPush('6')">6</button>
          <button class="calc-btn" style="background:var(--main)" onclick="cPush('+')">+</button>
          <button class="calc-btn" onclick="cPush('1')">1</button>
