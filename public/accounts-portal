  let secStr = d.section ? " (Sec: " + d.section + ")" : "";
  let catStr = d.category ? " • " + d.category : "";

  let copiesHtml = [
    "STUDENT / GUARDIAN COPY (অভিভাবক কপি)",
    "OFFICE COPY (অফিস কপি)"
  ].map(function(copyLabel, idx) {
    return `
    <div class="rcp-box">
