async function loadSavedAdvanceFeePreview() {
  let cls = document.getElementById('advClass').value;
  let cat = document.getElementById('advCategory').value || "All";
  let statusEl = document.getElementById('advCurrentSavedStatus');
  let customContainer = document.getElementById('advCustomFeeList');
  if (!cls || !statusEl) return;

  statusEl.innerHTML = `<i class="fas fa-spinner fa-spin"></i> Class ${cls} (${cat})-এর নির্ধারিত ভর্তি ফি যাচাই করা হচ্ছে...`;

  try {
    const [catDoc, mainDoc] = await Promise.all([
      (cat && cat !== "All")
        ? db.collection('Admin').doc(`AdmissionFees_${cls}_${cat}`).get().catch(() => ({ exists: false }))
        : Promise.resolve({ exists: false }),
      db.collection('Admin').doc(`AdmissionFees_${cls}`).get().catch(() => ({ exists: false }))
    ]);

    let found = false;
    let s = 0, a = 0, customArr = [];

    if (catDoc && catDoc.exists) {
      let d = catDoc.data();
      s = parseFloat(d.schoolFee) || 0;
      a = parseFloat(d.admissionFee) || 0;
      if (d.customAdvanceFeesJSON) {
        try { customArr = JSON.parse(d.customAdvanceFeesJSON) || []; } catch (e) { customArr = []; }
      }
      found = true;
    } else if (mainDoc && mainDoc.exists) {
      let d = mainDoc.data();
      if (cat && cat !== "All" && d.categoryFeesJSON) {
        try {
          let map = JSON.parse(d.categoryFeesJSON);
          if (map[cat]) {
            s = parseFloat(map[cat].schoolFee) || 0;
            a = parseFloat(map[cat].admissionFee) || 0;
            customArr = Array.isArray(map[cat].customAdvanceFees) ? map[cat].customAdvanceFees : [];
            found = true;
          }
        } catch (err) {}
      }
      if (!found && cat === "All") {
        s = parseFloat(d.schoolFee) || 0;
        a = parseFloat(d.admissionFee) || 0;
        if (d.customAdvanceFeesJSON) {
          try { customArr = JSON.parse(d.customAdvanceFeesJSON) || []; } catch (e) { customArr = []; }
        }
        found = true;
      }
    }

    customContainer.innerHTML = "";
    if (found) {
      document.getElementById('advSchoolFee').value = s;
      document.getElementById('advAdmFee').value = a;
      if (customArr.length > 0) {
        customArr.forEach(cf => addAdvCustomFeeRow(cf.name, cf.amount));
      }
      let customSummary = customArr.length > 0
        ? (" | " + customArr.map(c => `${c.name}: <b>${c.amount} TK</b>`).join(" | "))
        : "";
      statusEl.innerHTML = `✅ সংরক্ষিত আছে: <b>Class ${cls} (${cat})</b> &rarr; School Fee: <b>${s} TK</b> | Admission Fee: <b>${a} TK</b>${customSummary}`;
    } else {
      document.getElementById('advSchoolFee').value = "";
      document.getElementById('advAdmFee').value = "";
      statusEl.innerHTML = `ℹ️ <b>Class ${cls} (${cat})</b>-এর জন্য এখনো কোনো অগ্রিম ভর্তি ফি সেট করা হয়নি। নিচে পরিমাণ লিখে সেভ করুন।`;
    }
  } catch (e) {
    statusEl.innerHTML = `⚠️ ফি যাচাই করা যায়নি।`;
  }
}

