async function loadHistory(showSpinner = true, silent = false) {
  if (!isAuthReady) return;
  if (showSpinner && !silent) {
    showLoading();
    showLoaderText("লেনদেনের লেজার লোড হচ্ছে...");
  }

  try {
    let snap = await db.collection('Transactions').get();
    let list = [];
    let newCatDetected = false;
    snap.forEach(doc => {
      let d = doc.data();
      let c = (d.category || "").toString().trim();
      if (c && !globalCategories.includes(c)) {
        globalCategories.push(c);
        newCatDetected = true;
      }
      list.push(d);
    });
    if (newCatDetected) populateAllCategoryDropdowns();
    list.sort((a, b) => parseInt(b.timestamp || 0) - parseInt(a.timestamp || 0));
    historyData = list;
    historyLoadedOnce = true;
    filterHistory();
    if (showSpinner && !silent) hideLoading();
  } catch (err) {
    if (showSpinner && !silent) hideLoading();
  }
}

function renderHistory(data) {
  let total = 0;
  let rows = data.map(x => {
    total += parseFloat(x.paidAmount) || 0;
    let cBadge = formatCategoryBadge(x.category || "");
    return `<tr>
      <td>${x.date || "-"}</td>
      <td><b>${x.receiptNo || "-"}</b></td>
      <td><b style="color:var(--main);">${x.studentID || "-"}</b></td>
      <td><b>${x.name || "-"}</b></td>
      <td>Class ${x.class || "-"} (Roll: ${x.roll || "-"})</td>
      <td>${x.section || "-"}</td>
      <td>${cBadge}</td>
      <td>${(x.month || "-") + " " + (x.year || "-")}</td>
      <td><b style="color:#0369a1;">${x.paidAmount || "0"} TK</b></td>
    </tr>`;
  });
  document.querySelector("#hTable tbody").innerHTML = rows.join('') || '<tr><td colspan="9" style="text-align:center; padding:25px; color:#94a3b8;">কোনো লেনদেন পাওয়া যায়নি।</td></tr>';
  document.getElementById('hTotalVal').innerText = total.toFixed(2);
}

function filterHistory() {
  let fSearch = document.getElementById('hSearch').value.toLowerCase().trim();
  let fSec = document.getElementById('hSec').value;
  let fClass = document.getElementById('hClass').value;
  let fCat = document.getElementById('hCat').value;
  let fMonth = document.getElementById('hMonth').value;
  let fYear = document.getElementById('hYear').value;

  let filtered = (historyData || []).filter(x => {
    let name = x.name ? x.name.toLowerCase() : "";
    let sid = x.studentID ? x.studentID.toLowerCase() : "";
    let rno = x.receiptNo ? x.receiptNo.toLowerCase() : "";
    let cat = x.category ? x.category.toString().trim() : "";
    let matchSearch = !fSearch || name.includes(fSearch) || sid.includes(fSearch) || rno.includes(fSearch) || cat.toLowerCase().includes(fSearch);

    let matchSec = fSec === "" || (x.section && x.section === fSec);
    let matchClass = fClass === "All" || x.class === fClass;
    let matchCat = fCat === "All" || cat === fCat;
    let matchMonth = fMonth === "All" || x.month === fMonth;
    let matchYear = fYear === "All" || x.year === fYear;
    return matchSearch && matchSec && matchClass && matchCat && matchMonth && matchYear;
  });
  renderHistory(filtered);
}

