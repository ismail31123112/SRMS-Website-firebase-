async function loadCashbook(showSpinner = true, silent = false) {
  if (showSpinner && !silent) {
    showLoading();
    showLoaderText("ক্যাশবুক লোড হচ্ছে...");
  }
  try {
    let snap = await db.collection('Cashbook').get();
    let list = [];
    snap.forEach(doc => {
      let d = doc.data();
      d.docId = doc.id;
      list.push(d);
    });
    list.sort((a, b) => parseInt(b.timestamp || 0) - parseInt(a.timestamp || 0));
    cashbookData = list;
    cashbookLoadedOnce = true;
    renderCashbook();
    if (showSpinner && !silent) hideLoading();
  } catch (e) {
    if (showSpinner && !silent) hideLoading();
  }
}

function renderCashbook() {
  let mFilter = document.getElementById('cbMonth').value;
  let yFilter = document.getElementById('cbYear').value;

  let tInc = 0;
  let tExp = 0;

  let filtered = cashbookData.filter(d => {
    let parts = (d.date || "").split('/');
    let month = parts[1];
    let year = parts[2];
    let matchM = mFilter === "All" || month === mFilter;
    let matchY = yFilter === "All" || year === yFilter;
    return matchM && matchY;
  });

  let rows = filtered.map(data => {
    let amount = parseFloat(data.amount) || 0;
    if (data.type === 'Income') tInc += amount;
    else tExp += amount;
    let badge = data.type === 'Income' ? '<span class="badge-income">Income</span>' : '<span class="badge-expense">Expense</span>';
    let color = data.type === 'Income' ? '#16a34a' : '#dc2626';
    return `<tr>
      <td>${data.date}</td>
      <td>${badge}</td>
      <td><b>${data.title}</b></td>
      <td>${data.description || ""}</td>
      <td><b style="color:${color};">৳ ${amount}</b></td>
      <td class="no-print"><button onclick="delCashbookEntry('${data.docId}')" style="background:#fef2f2; color:#ef4444; border:none; padding:6px 11px; border-radius:6px; cursor:pointer;"><i class="fas fa-trash"></i></button></td>
    </tr>`;
  });

  document.querySelector("#cbTable tbody").innerHTML = rows.join('') || '<tr><td colspan="6" style="text-align:center; padding:20px; color:#94a3b8;">কোনো এন্ট্রি পাওয়া যায়নি।</td></tr>';
  document.getElementById('cbTotalIncome').innerText = tInc;
  document.getElementById('cbTotalExpense').innerText = tExp;
}

function filterCashbook() { renderCashbook(); }

async function delCashbookEntry(id) {
  const res = await Swal.fire({
    title: "এন্ট্রিটি মুছে ফেলবেন?",
    icon: "warning",
    showCancelButton: true,
    confirmButtonColor: "#ef4444",
    confirmButtonText: "হ্যাঁ, মুছে ফেলুন",
    cancelButtonText: "বাতিল"
  });
  if (res.isConfirmed) {
    cashbookData = cashbookData.filter(d => d.docId !== id);
    renderCashbook();
    try {
      await apiCall('deleteCashbookEntry', { docId: id });
    } catch (e) {}
  }
