<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>SRMS Accounts Portal V4</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<!-- 🔒 URL Security Script -->
<script>
if (window.history.replaceState) {
var cleanUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
window.history.replaceState({path: cleanUrl}, '', cleanUrl);
}
</script>

<style>
/* 🎨 PREMIUM THEME: SRMS Green & Gold */
:root { --main: #005f40; --main-dark: #003d29; --accent: #d32f2f; --gold: #f59e0b; --bg: #f8fafc; }
body { font-family: 'Poppins', sans-serif; background: var(--bg); margin: 0; color: #334155; padding-bottom: 90px;}

/* 🛑 SECURITY SHIELD LOADER */
#loader { display:flex; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(255,255,255,0.95); z-index:9999; flex-direction:column; align-items:center; justify-content:center; backdrop-filter: blur(8px); }
.spinner { width:55px; height:55px; border:4px solid #e2e8f0; border-top:4px solid var(--main); border-radius:50%; animation:spin 1s cubic-bezier(0.55, 0.15, 0.45, 0.85) infinite; }
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

/* Premium Header */
.navbar { background: linear-gradient(135deg, var(--main), var(--main-dark)); color: white; padding: 18px 30px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 20px rgba(0, 95, 64, 0.25); position: sticky; top: 0; z-index: 50; border-bottom: 4px solid var(--gold);}
.nav-title { font-weight: 900; font-size: 22px; letter-spacing: 1px; text-shadow: 0 2px 5px rgba(0,0,0,0.2);}
.nav-right { display: flex; align-items: center; gap: 15px; }

.btn-back { background: rgba(255,255,255,0.15); color: white; border: 1px solid rgba(255,255,255,0.3); padding: 8px 16px; border-radius: 10px; font-size: 13px; font-weight: 700; cursor: pointer; transition: 0.3s; display: flex; align-items: center; gap: 6px; white-space: nowrap; backdrop-filter: blur(5px);}
.btn-back:hover { background: white; color: var(--main); transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0,0,0,0.15);}

.container { display: none; max-width: 1050px; margin: 25px auto; padding: 0 15px; animation: fadeInUp 0.4s ease;}
.container.active { display: block; }

.card { background: white; padding: 30px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0, 95, 64, 0.06); margin-bottom: 30px; border-top: 6px solid var(--main); border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;}
@keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

input, select { width: 100%; padding: 14px; margin: 10px 0; border: 2px solid #e2e8f0; border-radius: 12px; box-sizing: border-box; outline: none; font-family: inherit; transition: 0.3s; background: #f8fafc;}
input:focus, select:focus { border-color: var(--main); background: #fff; box-shadow: 0 0 0 4px rgba(0, 95, 64, 0.1); transform: translateY(-1px);}

.btn { padding: 15px; border: none; border-radius: 14px; font-weight: 800; cursor: pointer; transition: 0.3s; display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; font-size: 15px; text-transform: uppercase; letter-spacing: 1px; font-family: inherit;}
.btn-main { background: linear-gradient(135deg, var(--main), var(--main-dark)); color: white; box-shadow: 0 6px 20px rgba(0, 95, 64, 0.25);}
.btn-main:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(0, 95, 64, 0.35);}
.btn-print-big { background: linear-gradient(135deg, #0284c7, #0369a1); color: white; font-size: 16px; margin-top: 15px; display: none; box-shadow: 0 6px 20px rgba(2,132,199,0.25);}
.btn-print-big:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(2,132,199,0.35); }

.fee-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-top: 20px; }
.fee-card { padding: 25px 20px; border-radius: 16px; text-align: center; border: 1px solid #e2e8f0; transition: 0.3s; background: #fff;}
.fee-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.06); }
.fee-card.gen { border-top: 6px solid var(--main); }
.fee-card.hos { border-top: 6px solid var(--accent); }

.pay-input { margin-top: 10px; border: 2.5px solid var(--main) !important; font-weight: 900; text-align: center; font-size: 20px; color: var(--main); }

table { width: 100%; border-collapse: collapse; font-size: 13.5px; background: white; }
th, td { padding: 15px; border-bottom: 1px solid #e2e8f0; text-align: left; }
th { background: #f8fafc; position: sticky; top: 0; font-weight: 800; color: #1e293b; text-transform: uppercase; font-size: 12px; letter-spacing: 0.5px;}
#success-msg { display: none; text-align: center; color: #16a34a; font-weight: 900; font-size: 20px; margin: 20px 0; background: #dcfce7; padding: 15px; border-radius: 12px; border: 1px solid #bbf7d0;}

#btnRunBulk { background: linear-gradient(135deg, #059669, #166534); box-shadow: 0 6px 20px rgba(5,150,105,0.25); }
#btnRep { background: linear-gradient(135deg, var(--gold), #b45309); box-shadow: 0 6px 20px rgba(245,158,11,0.25); }
.custom-fee-item input { border: 2px solid #8b5cf6 !important; }
.fee-card.custom { border-top: 6px solid #8b5cf6; }

/* Badges */
.badge-army { background: #fff8e1; color: #b45309; padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: bold; border: 1px solid #fcd34d; }
.badge-civil { background: #eff6ff; color: #005f40; padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: bold; border: 1px solid #a7f3d0; }

/* Bottom Nav */
.bottom-nav { position: fixed; bottom: 0; width: 100%; background: rgba(255,255,255,0.95); backdrop-filter: blur(10px); display: flex; box-shadow: 0 -5px 25px rgba(0, 95, 64, 0.08); z-index: 100; border-radius: 20px 20px 0 0; border-top: 1px solid #e2e8f0; padding: 5px 0;}
.nav-item { flex: 1; text-align: center; color: #94a3b8; border: none; background: none; font-size: 11px; padding: 12px; cursor: pointer; font-weight: 700; transition: 0.3s;}
.nav-item i { display: block; font-size: 20px; margin-bottom: 5px; transition: 0.3s;}
.nav-item.active { color: var(--main); font-weight: 900; }
.nav-item.active i { transform: translateY(-4px) scale(1.1); color: var(--gold); }

/* Accountant Calculator Box */
.calc-box { background: #111; padding: 15px; border-radius: 20px; width: 280px; margin: 0 auto; box-shadow: 0 10px 20px rgba(0,0,0,0.2); }
.calc-scr { width: 100%; height: 50px; background: #000; color: #0f0; text-align: right; padding: 10px; font-size: 24px; border-radius: 10px; margin-bottom: 10px; font-family: monospace; border: none; font-weight: bold; }
.calc-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
.calc-btn { padding: 15px; border: none; border-radius: 8px; background: #333; color: white; font-weight: bold; cursor: pointer; transition: 0.2s;}
.calc-btn:hover { background: #555; transform: scale(1.05); }

/* 🖨️ Pro Print Formatting for A4 Landscape */
@media print {
body * { visibility: hidden; }
#printArea, #printArea * { visibility: visible; }
#printArea { position: absolute; left: 0; top: 0; width: 100%; display: block !important; }
}
</style>
</head>
<body>

<!-- 🛑 Security Gate UI -->
<div id="loader">
    <div class="spinner"></div>
    <p id="loaderText" style="margin-top:15px; font-weight:800; color:var(--main); letter-spacing: 1px; text-align: center;">SECURITY CHECK...<br><span style="font-size:11px; color:#64748b;">Verifying Admin Session</span></p>
</div>

<!-- Main App -->
<div id="appContainer" style="display:none;">
    <div class="navbar">
    <div class="nav-title">SRMS ACCOUNTS PORTAL</div>
    <div class="nav-right">
    <div id="clock" style="font-weight: 600; font-size: 14px;"></div>
    <button class="btn-back" onclick="window.close();" title="Back to Admin Dashboard">
    <i class="fas fa-sign-out-alt"></i> Dashboard
    </button>
    </div>
    </div>

    <!-- ================= COLLECT TAB ================= -->
    <div id="collectTab" class="container active">
    <!-- Calculator Card -->
    <div class="card" style="border-top-color: #333;">
    <h3><i class="fas fa-calculator"></i> Accountant Calculator</h3>
    <div class="calc-box">
    <input type="text" id="cScr" class="calc-scr" readonly value="0">
    <div class="calc-grid">
    <button class="calc-btn" style="background:#e74c3c" onclick="cClr()">C</button>
    <button class="calc-btn" onclick="cPush('/')">/</button>
    <button class="calc-btn" onclick="cPush('*')">×</button>
    <button class="calc-btn" onclick="cBack()">←</button>
    <button class="calc-btn" onclick="cPush('7')">7</button>
    <button class="calc-btn" onclick="cPush('8')">8</button>
    <button class="calc-btn" onclick="cPush('9')">9</button>
    <button class="calc-btn" style="background:var(--main)" onclick="cPush('-')">-</button>
    <button class="calc-btn" onclick="cPush('4')">4</button>
    <button class="calc-btn" onclick="cPush('5')">5</button>
    <button class="calc-btn" onclick="cPush('6')">6</button>
    <button class="calc-btn" style="background:var(--main)" onclick="cPush('+')">+</button>
    <button class="calc-btn" onclick="cPush('1')">1</button>
    <button class="calc-btn" onclick="cPush('2')">2</button>
    <button class="calc-btn" onclick="cPush('3')">3</button>
    <button class="calc-btn" style="grid-column:span 2; background:var(--gold)" onclick="cSolve()">=</button>
    <button class="calc-btn" onclick="cPush('0')">0</button>
    <button class="calc-btn" onclick="cPush('.')">.</button>
    </div>
    </div>
    </div>

    <div class="card">
    <h3 style="color:var(--main); font-weight:900; margin-top:0;"><i class="fas fa-hand-holding-dollar"></i> Cash/Money/Fees Collection</h3>
    <div style="display:flex; gap:15px; align-items:center;">
    <input type="text" id="sid" placeholder="Scan or Enter Student ID..." style="margin:0; flex:1;">
    <button onclick="searchStu()" id="btnSearch" class="btn btn-main" style="width:160px; margin:0;"><i class="fas fa-search"></i> Search</button>
    </div>

    <div id="payZone" style="display:none; margin-top:25px;">
    <div style="background:linear-gradient(145deg, #f8fafc, #f1f5f9); padding:25px; border-radius:16px; border:1px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center; box-shadow: 0 4px 15px rgba(0,0,0,0.02);">
    <div><h2 id="dName" style="margin:0; color:var(--main); font-size:26px; font-weight:900;"></h2><p id="dInfo" style="font-weight:600; color:#64748b; margin:5px 0 0 0; font-size:14px;"></p></div>
    <div style="text-align:right; background: white; padding: 10px 15px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 1px solid #e2e8f0;"><p style="margin:0; color:#94a3b8; font-size:11px; font-weight:800; letter-spacing:1px;">BILLING PERIOD</p><b id="dMonth" style="font-size:18px; color:var(--main);"></b></div>
    </div>

    <div class="fee-grid" id="feeGrid"></div>

    <div id="paymentSummary" style="background:linear-gradient(135deg, #0f172a, #1e293b); color:white; padding:25px; border-radius:20px; margin-top:25px; display:flex; justify-content:space-between; align-items:center; box-shadow: 0 10px 30px rgba(15,23,42,0.3); border: 1px solid #334155;">
    <div>
    <span style="font-size:12px; color:#94a3b8; font-weight:800; text-transform:uppercase; letter-spacing:1px;">Total Due Amount</span><br>
    <b style="font-size:28px; color:#fb7185;">৳ <span id="sumDueAmt">0.00</span></b>
    </div>
    <div style="text-align:right;">
    <span style="font-size:12px; color:#94a3b8; font-weight:800; text-transform:uppercase; letter-spacing:1px;">Total Paying Now</span><br>
    <b style="font-size:32px; color:#4ade80;">৳ <span id="sumPayingAmt">0.00</span></b>
    </div>
    </div>

    <div style="margin-top:25px; background:#eff6ff; padding:15px 20px; border-radius:12px; border:2px dashed #bfdbfe; display:flex; align-items:center; gap:12px; justify-content:center;">
    <input type="checkbox" id="sendSmsChk" checked style="width:24px; height:24px; margin:0; cursor:pointer; accent-color: var(--main);">
    <label for="sendSmsChk" style="font-weight:800; color:#005f40; cursor:pointer; font-size:15px; margin:0;">Enable SMS Notification for Parent</label>
    </div>

    <div id="success-msg"><i class="fas fa-check-circle"></i> PAYMENT RECORDED SUCCESSFULLY</div>

    <button onclick="payNow()" id="btnPay" class="btn btn-main" style="background:linear-gradient(135deg, #059669, #166534); margin-top:25px; box-shadow: 0 8px 25px rgba(5,150,105,0.3);"><i class="fas fa-check-double"></i> Confirm Transaction</button>
    <button onclick="printReceipt()" id="btnPrint" class="btn btn-print-big"><i class="fas fa-print"></i> PRINT OFFICIAL RECEIPT</button>
    </div>
    </div>
    </div>

    <!-- ================= SETUP TAB ================= -->
    <div id="setupTab" class="container">
    <div class="card" style="border-top-color: #8b5cf6;">
    <h3 style="color:#8b5cf6; font-weight:900; margin:0;"><i class="fas fa-layer-group"></i> Fees Setup & Management</h3>
    <div style="margin-bottom: 20px; background:#faf5ff; padding:18px; border-radius:14px; border-left:6px solid #8b5cf6;">
    <label style="font-weight:800; color:#4c1d95; margin-bottom:8px; display:block; font-size:14px;">Select Action Type:</label>
    <select id="feeAction" onchange="toggleActionUI()" style="border-color:#d8b4fe; font-weight:bold; color:#7e22ce;">
    <option value="Add">1. Create / Add New Fees</option>
    <option value="Edit">2. Edit / Override Existing Fees</option>
    <option value="Reset">3. Factory Reset (Clear Current Dues)</option>
    </select>
    </div>
    <div id="setupZone">
    <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:15px;">
    <div style="display:flex; flex-direction:column;">
    <div style="height: 120px; overflow-y: auto; border: 2px solid var(--main); border-radius: 12px; padding: 10px; background: #fff;" id="bClsContainer">
    <label style="display:flex; align-items:center; gap:8px; margin-bottom:5px; cursor:pointer; font-weight:bold; color:var(--main);"><input type="checkbox" value="All" id="bClsAll" onchange="toggleClassCheckboxes(this)" checked style="width:16px; height:16px; margin:0; accent-color:var(--main);"> All Classes</label>
    <hr style="margin:5px 0; border:0; border-top:1px solid #e2e8f0;">
    <label style="display:flex; align-items:center; gap:8px; margin-bottom:5px; cursor:pointer;"><input type="checkbox" class="bCls-chk" value="Play" checked style="width:16px; height:16px; margin:0; accent-color:var(--main);"> Play</label>
    <label style="display:flex; align-items:center; gap:8px; margin-bottom:5px; cursor:pointer;"><input type="checkbox" class="bCls-chk" value="Nursery" checked style="width:16px; height:16px; margin:0; accent-color:var(--main);"> Nursery</label>
    <label style="display:flex; align-items:center; gap:8px; margin-bottom:5px; cursor:pointer;"><input type="checkbox" class="bCls-chk" value="KG" checked style="width:16px; height:16px; margin:0; accent-color:var(--main);"> KG</label>
    <label style="display:flex; align-items:center; gap:8px; margin-bottom:5px; cursor:pointer;"><input type="checkbox" class="bCls-chk" value="1" checked style="width:16px; height:16px; margin:0; accent-color:var(--main);"> Class 1</label>
    <label style="display:flex; align-items:center; gap:8px; margin-bottom:5px; cursor:pointer;"><input type="checkbox" class="bCls-chk" value="2" checked style="width:16px; height:16px; margin:0; accent-color:var(--main);"> Class 2</label>
    <label style="display:flex; align-items:center; gap:8px; margin-bottom:5px; cursor:pointer;"><input type="checkbox" class="bCls-chk" value="3" checked style="width:16px; height:16px; margin:0; accent-color:var(--main);"> Class 3</label>
    <label style="display:flex; align-items:center; gap:8px; margin-bottom:5px; cursor:pointer;"><input type="checkbox" class="bCls-chk" value="4" checked style="width:16px; height:16px; margin:0; accent-color:var(--main);"> Class 4</label>
    <label style="display:flex; align-items:center; gap:8px; margin-bottom:5px; cursor:pointer;"><input type="checkbox" class="bCls-chk" value="5" checked style="width:16px; height:16px; margin:0; accent-color:var(--main);"> Class 5</label>
    <label style="display:flex; align-items:center; gap:8px; margin-bottom:5px; cursor:pointer;"><input type="checkbox" class="bCls-chk" value="6" checked style="width:16px; height:16px; margin:0; accent-color:var(--main);"> Class 6</label>
    <label style="display:flex; align-items:center; gap:8px; margin-bottom:5px; cursor:pointer;"><input type="checkbox" class="bCls-chk" value="7" checked style="width:16px; height:16px; margin:0; accent-color:var(--main);"> Class 7</label>
    <label style="display:flex; align-items:center; gap:8px; margin-bottom:5px; cursor:pointer;"><input type="checkbox" class="bCls-chk" value="8" checked style="width:16px; height:16px; margin:0; accent-color:var(--main);"> Class 8</label>
    <label style="display:flex; align-items:center; gap:8px; margin-bottom:5px; cursor:pointer;"><input type="checkbox" class="bCls-chk" value="9" checked style="width:16px; height:16px; margin:0; accent-color:var(--main);"> Class 9</label>
    <label style="display:flex; align-items:center; gap:8px; margin-bottom:5px; cursor:pointer;"><input type="checkbox" class="bCls-chk" value="10" checked style="width:16px; height:16px; margin:0; accent-color:var(--main);"> Class 10</label>
    </div>
    <p style="font-size:11px; color:#005f40; font-weight:700; margin:2px 0 0 0;">*Select multiple classes to apply fees</p>
    </div>
    <select id="bCat" style="border-color:var(--gold); font-weight:bold; height: 50px;">
    <option value="All">All Category</option>
    <option value="Civil">Civil</option>
    <option value="Army">Army</option>
    </select>
    <select id="bType" onchange="toggleCustomUI()" style="height: 50px;">
    <option value="General">School Fees</option>
    <option value="Hostel">Hostel Fees</option>
    <option value="Custom">Custom Fees</option>
    </select>
    </div>

    <div id="customUI" style="display:none; margin-top:15px; padding:20px; background:#faf5ff; border-radius:14px; border:2px dashed #c084fc;">
    <label style="font-weight:800; color:#7e22ce; display:block; margin-bottom:12px;">Setup Multiple Custom Fees:</label>
    <div id="customFeeList">
    <div class="custom-fee-item" style="display:flex; gap:12px; margin-bottom:10px;">
    <input type="text" class="c-fee-name" placeholder="Fee Name (e.g. Picnic)">
    <input type="number" class="c-fee-amt" placeholder="Amount">
    </div>
    </div>
    <button onclick="addCustomFeeRow()" style="background:#8b5cf6; color:white; border:none; padding:10px 18px; border-radius:8px; cursor:pointer; font-weight:bold; margin-top:10px; box-shadow: 0 4px 10px rgba(139,92,246,0.3);">+ Add More Custom Fee</button>
    </div>

    <button onclick="loadBulk()" id="btnBulkLoad" class="btn" style="background:linear-gradient(135deg, #8b5cf6, #6d28d9); color:white; margin-top:15px; box-shadow: 0 6px 20px rgba(139,92,246,0.25);"><i class="fas fa-list-check"></i> Load List</button>

    <div id="bulkControls" style="display:none; margin-top:20px;">
    <div id="bulkList" style="max-height:350px; overflow-y:auto; border:2px solid #e2e8f0; border-radius:14px; margin-bottom:20px;"></div>
    <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:15px;">
    <input type="number" id="bAmt" placeholder="Total Amount (Fee)"> 
    <select id="bMon"><option>January</option><option>February</option><option>March</option><option>April</option><option>May</option><option>June</option><option>July</option><option>August</option><option>September</option><option>October</option><option>November</option><option>December</option></select>
    <select id="bYear"></select>
    </div>
    <div id="pwdZoneSetup" style="display:none; margin-top:20px; text-align:center;">
    <label style="font-weight:800; color:#ea580c; font-size:14px;">Admin Password Required to Edit Fees</label>
    <input type="password" id="setupPwd" placeholder="Enter Password" style="border: 2px solid #ea580c; margin-top:8px; max-width:300px; text-align:center;">
    </div>
    <button onclick="runBulk()" id="btnRunBulk" class="btn btn-main" style="margin-top:20px;"><i class="fas fa-check-circle"></i> Setup/Create Fees</button>
    </div>
    </div>

    <div id="resetZone" style="display:none; background:#fef2f2; border:2px dashed #ef4444; padding:25px; border-radius:16px; text-align:center; margin-top:15px;">
    <h3 style="color:#ef4444; margin-top:0; font-weight:900;"><i class="fas fa-exclamation-triangle"></i> Factory Reset Warning</h3>
    <p style="font-size:14px; color:#475569; font-weight:600; line-height:1.6;">This will clear and reset ALL CURRENT FEES to zero (0). Transaction history is safe.</p>
    <input type="password" id="resetPwd" placeholder="Enter Admin Password" style="max-width:300px; border:2px solid #ef4444; text-align:center; margin-top:15px;">
    <button onclick="executeFactoryReset()" class="btn" style="background:linear-gradient(135deg, #ef4444, #b91c1c); color:white; max-width:300px; margin:20px auto 0; font-size:15px; box-shadow: 0 6px 20px rgba(239,68,68,0.3);"><i class="fas fa-radiation"></i> PERFORM FACTORY RESET</button>
    </div>
    </div>
    </div>

    <!-- ================= REPORTS TAB ================= -->
    <div id="reportsTab" class="container">
    <div class="card" style="border-top-color: var(--gold);">
    <div style="display:flex; justify-content:space-between; align-items:center;">
    <h3 style="color:var(--gold); font-weight:900; margin:0;"><i class="fas fa-file-invoice-dollar"></i> Current Dues Reports</h3>
    <button onclick="printRep()" class="btn" style="width:auto; background:#1e293b; color:white; margin:0; padding:12px 20px;"><i class="fas fa-print"></i> Print List</button>
    </div>

