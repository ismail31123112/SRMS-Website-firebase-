async function searchStu() {
  if (!isAuthReady) return;
  let id = document.getElementById('sid').value.trim();
  if (!id) return;

  try {
    let fields = null;
    if (studentsLoadedOnce) {
      fields = allStudentsCache.find(s => String(s.studentID || "").trim() === id);
    }

    if (!fields) {
      showLoading();
      showLoaderText("শিক্ষার্থীর তথ্য খোঁজা হচ্ছে...");
      let snap = await db.collection('Students').where('studentID', '==', id).get();
      hideLoading();
      if (snap.empty) {
        Swal.fire("পাওয়া যায়নি", "এই আইডির কোনো শিক্ষার্থী ডাটাবেসে পাওয়া যায়নি!", "warning");
        return;
      }
      let doc = snap.docs[0];
      fields = doc.data();
      fields._docId = doc.id;
    }

    currentStudentDocId = fields._docId;
    currentStudentData = fields;

    let customFees = fields.customFees ? JSON.parse(fields.customFees) : [];
    let activeCustomFees = customFees.filter(cf => cf.name && parseFloat(cf.amount) > 0 && cf.status.toLowerCase() !== "paid");
    let stuCategory = (fields.category || fields.resStatus || "").toString().trim();

    if (stuCategory && !globalCategories.includes(stuCategory)) {
      globalCategories.push(stuCategory);
      populateAllCategoryDropdowns();
    }

    let d = {
      found: true,
      id: fields.studentID,
      name: fields.name || "",
      class: fields.class || "",
      section: fields.section || "",
      roll: fields.roll || "",
      category: stuCategory,
      photoUrl: resolveStudentAvatar(fields),
      year: fields.feeYear || "",
      month: fields.feeMonth || "",
      genAmt: parseFloat(fields.schoolFeeDue) || 0,
      genStatus: fields.schoolFeeStatus || "Paid",
      email: fields.email || "",
      phone: fields.phone || "",
      customFees: activeCustomFees,
      originalCustomFees: customFees
    };
    renderPaymentZone(d);
  } catch (err) {
    hideLoading();
    Swal.fire("ত্রুটি", err.message, "error");
