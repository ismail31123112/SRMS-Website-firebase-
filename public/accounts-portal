async function loadRep(forceRefresh = false) {
  if (!isAuthReady) return;
  if (forceRefresh || !studentsLoadedOnce) {
    showLoading();
    showLoaderText("রিপোর্ট প্রস্তুত করা হচ্ছে...");
  }

  let cls = document.getElementById('rClass').value;
  let reportType = document.getElementById('rType').value;
  let status = document.getElementById('rStatus').value;
  let categoryFilter = document.getElementById('rCat').value;

  try {
    let allStu = await ensureStudentsCached(forceRefresh);
    let list = [];

    allStu.forEach(f => {
      let sClass = f.class ? f.class.toString().trim() : "";
      let sCat = (f.category || f.resStatus || "").toString().trim();

      if (cls !== "All" && sClass.toLowerCase() !== cls.toString().trim().toLowerCase()) return;
      if (categoryFilter !== "All" && sCat !== categoryFilter) return;

      let stdMonth = f.feeMonth || "-";
      let stdYear = f.feeYear || "-";
      let sId = f.studentID || "";
      let sName = f.name || "";
      let sRoll = f.roll || "";
      let sSec = f.section || "";

      let addRecord = (fName, amt, fStatus, fPeriod) => {
        if (amt > 0) {
          let currentStatus = fStatus || "Due";
          if (status === "All" || currentStatus.toLowerCase() === status.toLowerCase()) {
            list.push({
              id: sId,
              name: sName,
              class: sClass,
              section: sSec,
              roll: sRoll,
              category: sCat,
              feeName: fName,
              period: fPeriod,
              amount: amt,
              status: currentStatus
            });
          }
        }
      };

      if (reportType === "All" || reportType === "General") {
        addRecord("School Fee", parseFloat(f.schoolFeeDue) || 0, f.schoolFeeStatus || "", stdMonth + " " + stdYear);
      }
      if (reportType === "All" || reportType === "Session" || reportType === "Custom") {
        let customFees = f.customFees ? JSON.parse(f.customFees) : [];
        customFees.forEach(cf => {
          let isSession = cf.name.toLowerCase().indexOf("session") !== -1;
          if (reportType === "Session" && !isSession) return;
          if (reportType === "Custom" && isSession) return;
          addRecord(cf.name, parseFloat(cf.amount) || 0, cf.status, stdMonth + " " + stdYear);
        });
      }
    });

    hideLoading();
    reportsData = list;
    filterReports();
  } catch (err) {
    hideLoading();
    Swal.fire("ত্রুটি", err.message, "error");
  }
}

function renderReports(list) {
  let pCount = 0;
  let dCount = 0;
  let tPaid = 0;
  let tDue = 0;

  let rows = list.map(x => {
    let sBadge = x.status.trim() === "Paid"
      ? '<span style="background:#dcfce7; color:#16a34a; padding:4px 8px; border-radius:6px; font-weight:800; font-size:11px;">PAID</span>'
      : '<span style="background:#fee2e2; color:#ef4444; padding:4px 8px; border-radius:6px; font-weight:800; font-size:11px;">DUE</span>';
    let cBadge = formatCategoryBadge(x.category);

    if (x.status && x.status.trim() === "Paid") {
      pCount++;
      tPaid += parseFloat(x.amount) || 0;
    } else if (x.status && x.status.trim() === "Due") {
      dCount++;
      tDue += parseFloat(x.amount) || 0;
    }

    return `<tr>
      <td><b>${x.id}</b></td>
      <td><b>${x.name}</b></td>
      <td>Class ${x.class}</td>
      <td>${x.section || '-'}</td>
      <td>${x.roll}</td>
      <td>${cBadge}</td>
      <td><b>${x.feeName}</b></td>
      <td>${x.period}</td>
      <td><b style="color:var(--main);">${x.amount} TK</b></td>
      <td>${sBadge}</td>
    </tr>`;
  });

  document.querySelector("#rTable tbody").innerHTML = rows.join('') || '<tr><td colspan="10" style="text-align:center; padding:25px; color:#94a3b8;">কোনো তথ্য পাওয়া যায়নি।</td></tr>';
  document.getElementById('tPaidVal').innerText = tPaid;
  document.getElementById('tDueVal').innerText = tDue;
  document.getElementById('tStuCount').innerText = list.length;
  document.getElementById('tPaidCount').innerText = pCount;
  document.getElementById('tDueCount').innerText = dCount;
}

function filterReports() {
  let query = document.getElementById('rSearch').value.toLowerCase().trim();
  let secQ = document.getElementById('rSec').value;

  let filtered = (reportsData || []).filter(x => {
    let matchQ = !query ||
      x.name.toLowerCase().includes(query) ||
      x.id.toLowerCase().includes(query) ||
      x.roll.toString().includes(query) ||
      (x.category && x.category.toLowerCase().includes(query)) ||
      x.feeName.toLowerCase().includes(query);
    let matchS = secQ === "" || (x.section && x.section === secQ);
    return matchQ && matchS;
  });
  renderReports(filtered);
}

