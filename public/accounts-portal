<script>
const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbyrks9gqqZ2t9gxjEx-EFaN5hO2IsO6P61bKrv7puf85mNXm6xuLOcro3xBu8StobIA/exec";
const SRMS_ADMIN_PASSKEY = "SRMS_SUPER_ADMIN_OVERRIDE";
const DEFAULT_AVATAR = "https://i.postimg.cc/Y9bdXZPQ/dtg96fyddcib2okq9820.png";

const firebaseConfig = {
  apiKey: "AIzaSyBhzidG1s5CsOaiY0RsBG6GJcrE12LLEuU",
  authDomain: "srms-website-management.firebaseapp.com",
  projectId: "srms-website-management"
};
if (!firebase.apps.length) {
  firebase.initializeApp(firebaseConfig);
}
const db = firebase.firestore();
const auth = firebase.auth();

let lastR = null;
