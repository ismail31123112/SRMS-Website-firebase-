<script>
// 🚀 🚀 🚀 IMPORTANT: Insert your actual Google Apps Script Web App URL below 🚀 🚀 🚀
const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbyrks9gqqZ2t9gxjEx-EFaN5hO2IsO6P61bKrv7puf85mNXm6xuLOcro3xBu8StobIA/exec";

let lastR = null; let historyData = []; let reportsData = []; let vaultData = []; var isAuthReady = false; 
let systemFeesConfig = { admission: [], promotion: [], fines: [] };

function getToken() { return sessionStorage.getItem('portal_token') || ""; }

async function apiCall(actionName, payloadData = {}) {
    let payload = { action: actionName, token: getToken(), ...payloadData };
    try {
        let res = await fetch(SCRIPT_URL, { method: 'POST', body: JSON.stringify(payload), headers: { 'Content-Type': 'text/plain;charset=utf-8' } });
        return await res.json();
    } catch (error) { console.error("API Call Failed:", error); throw error; }
}

function showLoaderText(text) { document.getElementById('loader').innerHTML = `<div class="spinner"></div><p style="margin-top:15px; font-weight:800; color:var(--main); letter-spacing: 1px; text-align: center;">${text}</p>`; }
function showLoading() { document.getElementById('loader').style.display = "flex"; showLoaderText("PROCESSING..."); }
function hideLoading() { document.getElementById('loader').style.display = "none"; }

window.onload = function() {
    showLoaderText("SECURITY CHECK...<br><span style='font-size:11px; color:#64748b;'>Verifying Admin Session</span>");
    document.getElementById('loader').style.display = 'flex';
    setTimeout(() => {
        if (getToken()) {
            isAuthReady = true; 
            document.getElementById('loader').style.display = 'none';
            document.getElementById('appContainer').style.display = 'block'; // 🟢 সমাধান: এই লাইনটি যোগ করা হয়েছে
            loadSectionsData(); loadVaultData(true); loadSystemConfig();
        } else {
            showLoaderText("UNAUTHORIZED ACCESS!<br><span style='font-size:11px; color:#ef4444;'>Redirecting to Login...</span>");
            setTimeout(() => { window.location.replace(window.location.protocol + "//" + window.location.host + "/login-panel/accounting-and-management-department"); }, 1000);
        }
    }, 500);
}

const years = []; const currentY = new Date().getFullYear();
for(let i=2020; i<=2099; i++) years.push(i);
document.getElementById('bYear').innerHTML = years.map(y => `<option ${y === currentY ? 'selected' : ''}>${y}</option>`).join('');
document.getElementById('hYear').innerHTML += years.map(y => `<option>${y}</option>`).join('');

function switchTab(id, btn) {
if(!isAuthReady) return alert("Security checking in progress... Please wait.");
document.querySelectorAll('.container').forEach(c => c.classList.remove('active'));
document.getElementById(id).classList.add('active');
document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
btn.classList.add('active');
if(id === 'vaultTab') loadVaultData();
if(id === 'historyTab' && historyData.length === 0) loadHistory();
if(id === 'setupTab') loadSystemConfig();
}

function loadSectionsData() {
apiCall('getSectionsList').then(res => {
let opts = '<option value="">All Sections</option>';
res.forEach(s => { opts += `<option value="${s}">${s}</option>`; });
document.getElementById('rSec').innerHTML = opts; document.getElementById('hSec').innerHTML = opts;
}).catch(e=>{});
}

// 🚀 GLOBAL SYSTEM FEES LOGIC
function loadSystemConfig() {
    apiCall('getSystemFees').then(res => {
        systemFeesConfig = res;
        renderSystemFees();
    }).catch(e=>{});
}

function saveSystemFee() {
    let cls = document.getElementById('sysFeeClass').value;
    let type = document.getElementById('sysFeeType').value;
    let name = document.getElementById('sysFeeName').value.trim();
    let amt = document.getElementById('sysFeeAmt').value;
    let pwd = document.getElementById('sysFeePwd').value;

    if(!name || !amt || amt<=0) return alert("Please enter Fee Name and valid Amount!");
    if(!pwd) return alert("Admin Password is required to update global fees!");

    // Filter out old fee for same class to replace it
    if(!systemFeesConfig[type]) systemFeesConfig[type] = [];
    systemFeesConfig[type] = systemFeesConfig[type].filter(f => f.class !== cls);
    systemFeesConfig[type].push({class: cls, name: name, amount: parseFloat(amt)});

    showLoading();
    apiCall('processBulkUpdate', {
        idsStr: "", feeType: "Custom", amount: 0, month: "", year: "", 
        customFeesJSON: JSON.stringify(systemFeesConfig), actionType: "SystemSet", pwd: pwd
    }).then(res => {
        hideLoading();
        if(res.status === "success") { alert("Global Fee Setup Saved Successfully!"); document.getElementById('sysFeePwd').value = ""; renderSystemFees(); } 
        else alert(res.message);
    }).catch(e=>{hideLoading(); alert("Error");});
}

function renderSystemFees() {
    let h = "<strong>Current Setup:</strong><ul>";
    ['admission', 'promotion'].forEach(type => {
        if(systemFeesConfig[type]) {
            systemFeesConfig[type].forEach(f => {
                h += `<li>${type.toUpperCase()} | Class: ${f.class} - <b>${f.name}</b>: ৳${f.amount}</li>`;
            });
        }
    });
    h += "</ul>";
    document.getElementById('sysFeeDisplay').innerHTML = h;
}

// 🚀 BULK FEES LOGIC
function toggleClassCheckboxes(source) { document.querySelectorAll('.bCls-chk').forEach(c => c.checked = source.checked); }
function toggleCustomUI() { 
let type = document.getElementById('bType').value;
if(type === "Custom") { document.getElementById('customUI').style.display = "block"; document.getElementById('bAmt').style.display = "none"; } 
else { document.getElementById('customUI').style.display = "none"; document.getElementById('bAmt').style.display = "block"; }
}
function addCustomFeeRow() {
let html = `<div class="custom-fee-item" style="display:flex; gap:12px; margin-bottom:10px;"><input type="text" class="c-fee-name" placeholder="Fee Name (e.g. Picnic)"><input type="number" class="c-fee-amt" placeholder="Amount"><button class="btn" style="background:#ef4444; color:white; width:auto; padding:10px 18px;" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button></div>`;
document.getElementById('customFeeList').insertAdjacentHTML('beforeend', html);
}
function toggleActionUI() {
let act = document.getElementById('feeAction').value;
if(act === "Reset") { document.getElementById('setupZone').style.display = "none"; document.getElementById('resetZone').style.display = "block"; } 
else {
document.getElementById('setupZone').style.display = "block"; document.getElementById('resetZone').style.display = "none"; document.getElementById('bulkControls').style.display = "none"; 
if(act === "Edit") { document.getElementById('btnRunBulk').innerHTML = "<i class='fas fa-edit'></i> Update & Edit Fees"; document.getElementById('btnRunBulk').style.background = "linear-gradient(135deg, #d97706, #b45309)"; } 
else { document.getElementById('btnRunBulk').innerHTML = "<i class='fas fa-check-circle'></i> Setup / Create Fees"; document.getElementById('btnRunBulk').style.background = "linear-gradient(135deg, #059669, #166534)"; }
}
}
function calcTotalPay() { let total = 0; document.querySelectorAll('.calc-pay').forEach(inp => { if (!inp.disabled) total += parseFloat(inp.value) || 0; }); document.getElementById('sumPayingAmt').innerText = total.toFixed(2); }

function searchStu() {
if(!isAuthReady) return;
let id = document.getElementById('sid').value;
if(!id) return;
showLoading();
apiCall('checkStudent', {id: id}).then(d => {
hideLoading();
if(d.found) {
document.getElementById('payZone').style.display = "block"; document.getElementById('btnPrint').style.display = "none"; document.getElementById('success-msg').style.display = "none"; document.getElementById('btnPay').style.display = "flex"; document.getElementById('dName').innerText = d.name;
let secStr = d.section ? ` (Sec: ${d.section})` : "";
document.getElementById('dInfo').innerText = "Class: " + d.class + secStr + " | Roll: " + d.roll;
document.getElementById('dMonth').innerText = d.month + " " + d.year;

let totalDueAmount = 0; let genAmtNum = parseFloat(d.genAmt) || 0; totalDueAmount += genAmtNum;
let fg = document.getElementById('feeGrid');
let html = `<div class="fee-card gen"><h4 style="margin-top:0; color:var(--main);"><i class="fas fa-graduation-cap"></i> School Fee (${d.genStatus || 'Due'})</h4><div style="background:#f1f5f9; padding:15px; border-radius:12px; margin-bottom:15px; border:1px dashed #cbd5e1;"><span style="font-size:12px; color:#64748b; font-weight:800; text-transform:uppercase;">Total Due Amount:</span><br><b style="font-size:24px; color:var(--main);">${d.genAmt} TK</b></div><div style="text-align:left;"><label style="font-size:13px; font-weight:800; color:#334155; margin-bottom:8px; display:block;">Amount Paying Now:</label><input type="number" id="pGen" class="pay-input calc-pay" placeholder="0.00" value="${d.genAmt}" oninput="calcTotalPay()" style="margin:0; width:100%; border-radius:10px;"></div></div>`;
let hosAmtNum = d.isRes ? (parseFloat(d.hosAmt) || 0) : 0; if(d.isRes) totalDueAmount += hosAmtNum;
html += `<div class="fee-card hos" id="hosBox" style="opacity:${d.isRes ? '1' : '0.5'}"><h4 style="margin-top:0; color:var(--accent);"><i class="fas fa-bed"></i> Hostel Fee (${d.hosStatus || 'Due'})</h4><div style="background:#fef2f2; padding:15px; border-radius:12px; margin-bottom:15px; border:1px dashed #fecaca;"><span style="font-size:12px; color:#ef4444; font-weight:800; text-transform:uppercase;">Total Due Amount:</span><br><b style="font-size:24px; color:var(--accent);">${d.isRes ? d.hosAmt : 0} TK</b></div><div style="text-align:left;"><label style="font-size:13px; font-weight:800; color:#334155; margin-bottom:8px; display:block;">Amount Paying Now:</label><input type="number" id="pHos" class="pay-input calc-pay" placeholder="0.00" value="${d.isRes ? d.hosAmt : 0}" ${d.isRes ? '' : 'disabled'} oninput="calcTotalPay()" style="margin:0; width:100%; border-color:var(--accent) !important; color:var(--accent); border-radius:10px;"></div></div>`;

if (d.customFees && d.customFees.length > 0) {
d.customFees.forEach((cf) => {
let cAmtNum = parseFloat(cf.amount) || 0; totalDueAmount += cAmtNum;
html += `<div class="fee-card custom" style="background: #faf5ff;"><h4 style="margin-top:0; color:#8b5cf6;"><i class="fas fa-star"></i> ${cf.name} (<span style="color:#7e22ce;">${cf.status}</span>)</h4><div style="background:#f3e8ff; padding:15px; border-radius:12px; margin-bottom:15px; border:1px dashed #d8b4fe;"><span style="font-size:12px; color:#7e22ce; font-weight:800; text-transform:uppercase;">Total Due Amount:</span><br><b style="font-size:24px; color:#8b5cf6;">${cf.amount} TK</b></div><div style="text-align:left;"><label style="font-size:13px; font-weight:800; color:#8b5cf6; margin-bottom:8px; display:block;">Amount Paying Now:</label><input type="number" class="pay-input custom-pay calc-pay" data-col="${cf.colIdx}" data-name="${cf.name}" placeholder="0" value="${cf.amount}" style="border-color:#8b5cf6 !important; color:#8b5cf6; margin:0; width:100%; border-radius:10px;" oninput="calcTotalPay()"></div></div>`;
});
}
fg.innerHTML = html; document.getElementById('sumDueAmt').innerText = totalDueAmount.toFixed(2); calcTotalPay(); 
} else { alert("Student ID not found in database!"); }
}).catch(e=>{hideLoading(); alert("Error connecting to server.");});
}

function payNow() {
let gP = parseFloat(document.getElementById('pGen').value) || 0;
let hP = parseFloat(document.getElementById('pHos').value) || 0;
let customArr = [];
document.querySelectorAll('.custom-pay').forEach(inp => { let p = parseFloat(inp.value) || 0; if(p > 0) customArr.push({ colIdx: parseInt(inp.getAttribute('data-col')), name: inp.getAttribute('data-name'), paid: p }); });

let sendSms = document.getElementById('sendSmsChk') ? document.getElementById('sendSmsChk').checked : false;
showLoading();
apiCall('processPayment', {id: document.getElementById('sid').value, genPay: gP, hosPay: hP, customPayments: customArr, sendSms: sendSms}).then(res => {
hideLoading();
if(res.status === "success") { lastR = res; document.getElementById('btnPay').style.display = "none"; document.getElementById('success-msg').style.display = "block"; document.getElementById('btnPrint').style.display = "block"; loadVaultData(true); } 
else { alert(res.message); }
}).catch(e=>{hideLoading(); alert("Payment processing failed!");});
}

function printReceipt() {
let d = lastR; let secStr = d.section ? ` (Sec: ${d.section})` : "";
let items = d.itemsList.map(i => { let payable = parseFloat(i.original) || 0; let paid = parseFloat(i.paid) || parseFloat(i.amount) || payable; let dueAmt = payable - paid; return `<tr style="border-bottom: 1px solid #e2e8f0;"><td style="color:#1e293b; font-weight:700;">${i.title}</td><td style="text-align:right; color:#64748b; font-weight:600;">${payable.toFixed(2)}</td><td style="text-align:right; color:#005f40; font-weight:800;">${paid.toFixed(2)}</td><td style="text-align:right; color:#ef4444; font-weight:700;">${dueAmt.toFixed(2)}</td></tr>`; }).join('');

let h = `<html><head><style>@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');@page { size: A4 portrait; margin: 0; } body { font-family: 'Inter', sans-serif; padding: 6mm; margin: 0; background: #fff; color: #0f172a; -webkit-print-color-adjust: exact; box-sizing: border-box; height: 297mm; overflow: hidden; } .box { height: 138mm; border: 2px solid #cbd5e1; padding: 20px; border-radius: 16px; position: relative; box-sizing: border-box; margin-bottom: 3mm; box-shadow: 0 4px 15px rgba(0,0,0,0.02); } .header { display: flex; align-items: center; justify-content: space-between; border-bottom: 3px solid #005f40; padding-bottom: 12px; margin-bottom: 15px; } .header-left { display: flex; align-items: center; gap: 15px; }.header-text h2 { margin: 0; font-size: 19px; font-weight: 900; color: #005f40; letter-spacing: 0.5px; } .header-text p { margin: 4px 0 0 0; font-size: 11px; color: #475569; font-weight: 600; }.receipt-tag { background: #005f40; color: white; padding: 6px 14px; border-radius: 20px; font-size: 11px; font-weight: 800; letter-spacing: 1.5px; }.info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 12px; margin-bottom: 15px; background: #f8fafc; padding: 15px; border-radius: 12px; border: 1px solid #e2e8f0; }.info-grid div { line-height: 1.6; }.info-label { color: #64748b; font-size: 11px; text-transform: uppercase; font-weight: 800; display: inline-block; width: 75px; }table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 12px; } th { background: #f1f5f9; color: #334155; font-weight: 800; text-transform: uppercase; font-size: 11px; padding: 10px; text-align: left; border-bottom: 2px solid #cbd5e1; border-radius: 6px 6px 0 0; }td { border-bottom: 1px solid #e2e8f0; padding: 8px 10px; }.summary-container { display: flex; justify-content: flex-end; margin-top: 15px; }.summary-box { width: 260px; border: 1.5px solid #cbd5e1; border-radius: 8px; overflow: hidden; background: white; }.summary-row { display: flex; justify-content: space-between; padding: 8px 12px; font-size: 12px; border-bottom: 1px solid #e2e8f0; }.summary-row:last-child { border-bottom: none; }.total-payable { font-weight: 700; color: #475569; }.total-paid { font-weight: 800; color: #005f40; background: #ecfdf5; border-bottom: 1px solid #a7f3d0;}.total-due { font-weight: 800; color: #b91c1c; background: #fef2f2; }.watermark { position: absolute; top: 55%; left: 50%; transform: translate(-50%,-50%) rotate(-30deg); font-size: 80px; opacity: 0.03; color: #005f40; font-weight: 900; z-index: -1; pointer-events: none; letter-spacing: 12px; }.signatures { position: absolute; bottom: 20px; left: 25px; right: 25px; display: flex; justify-content: space-between; font-weight: 800; font-size: 12px; color: #475569; }.sig-line { border-top: 2px dashed #94a3b8; width: 160px; text-align: center; padding-top: 8px; }.cut-line { text-align: center; margin: 6px 0; font-size: 12px; color: #94a3b8; font-weight: 700; letter-spacing: 3px; }</style></head><body>
${["STUDENT COPY", "OFFICE COPY"].map((c, idx) => `
<div class="box"><div class="watermark">SCBHS</div><div class="header"><div class="header-left"><img src="https://i.postimg.cc/FsbnRNTR/1788353517969.png" width="55" style="border-radius: 8px;"><div class="header-text"><h2>SAIDPUR CANTONMENT BOARD HIGH SCHOOL</h2><p>Saidpur Cantonment, Nilphamari | Official Payment Receipt</p></div></div><div class="receipt-tag">${c}</div></div>
<div class="info-grid"><div><div><span class="info-label">Receipt No:</span> <b style="color:#005f40;">${d.rNo}</b></div><div><span class="info-label">Student ID:</span> <b>${d.id}</b></div><div><span class="info-label">Name:</span> <b style="color:#0f172a; font-size:13px; text-transform:uppercase;">${d.name}</b></div></div><div style="text-align: right;"><div><span class="info-label" style="text-align:left;">Date:</span> <b>${d.date}</b></div><div><span class="info-label" style="text-align:left;">Class:</span> <b>${d.class}${secStr} (Roll:${d.roll})</b></div><div><span class="info-label" style="text-align:left;">Session:</span> <b>${d.month}${d.year}</b></div></div></div>
<table><thead><tr><th>Fee Particulars</th><th style="text-align:right; width: 95px;">Payable (TK)</th><th style="text-align:right; width: 100px;">Paid Now (TK)</th><th style="text-align:right; width: 95px;">Due (TK)</th></tr></thead><tbody>${items}</tbody></table>
<div class="summary-container"><div class="summary-box"><div class="summary-row total-payable"><span>Total Payable:</span> <span>৳ ${d.totalBill}.00</span></div><div class="summary-row total-paid"><span>Amount Paid Now:</span> <span>৳ ${d.paid}.00</span></div><div class="summary-row total-due"><span>Remaining Due:</span> <span>৳ ${d.remaining}.00</span></div></div></div>
<div class="signatures"><div class="sig-line">Accountant / Cashier</div><div class="sig-line">Student / Guardian</div></div></div>
${idx === 0 ? '<div class="cut-line">✂ - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - ✂</div>' : ''}`).join('')}
</body></html>`;
let w = window.open('','','width=900,height=950'); w.document.write(h); w.document.close(); setTimeout(()=>w.print(), 1000);
}

function loadBulk() { 
let clsValues = [];
if(document.getElementById('bClsAll').checked) clsValues.push("All"); else document.querySelectorAll('.bCls-chk:checked').forEach(c => clsValues.push(c.value));
if(clsValues.length === 0) return alert("Please select at least one class."); 
showLoading(); 
apiCall('getStudentsFiltered', {clsString: clsValues.join(','), feeType: document.getElementById('bType').value, categoryFilter: document.getElementById('bCat').value}).then(res => { 
hideLoading(); 
let h = "<table style='box-shadow:none; border:none;'><thead><tr><th style='border-radius:10px 0 0 0;'><input type='checkbox' checked onclick='toggleAll(this)' style='width:18px; height:18px; cursor:pointer;'></th><th>Student ID</th><th>Student Name</th><th style='border-radius:0 10px 0 0;'>Category</th></tr></thead><tbody>"; 
res.forEach(s => { let badgeClass = s.category === 'Army' ? 'badge-army' : 'badge-civil'; h += `<tr><td><input type='checkbox' class='s-chk' value='${s.id}' checked style='width:18px; height:18px; cursor:pointer;'></td><td><b style='color:#005f40;'>${s.id}</b></td><td><b>${s.name}</b></td><td><span class="${badgeClass}">${s.category || 'Civil'}</span></td></tr>`; }); 
document.getElementById('bulkList').innerHTML = h + "</tbody></table>"; document.getElementById('bulkControls').style.display = "block"; 
if(document.getElementById('feeAction').value === "Edit") document.getElementById('pwdZoneSetup').style.display = "block"; else document.getElementById('pwdZoneSetup').style.display = "none";
}).catch(e=>{hideLoading(); alert("Error");}); 
}

function toggleAll(s) { document.querySelectorAll('.s-chk').forEach(c => c.checked = s.checked); }

function runBulk() { 
let ids = Array.from(document.querySelectorAll('.s-chk:checked')).map(c => c.value).join(","); 
let type = document.getElementById('bType').value; let amt = document.getElementById('bAmt').value; let actionType = document.getElementById('feeAction').value; let pwd = document.getElementById('setupPwd').value;
if (actionType === "Edit" && !pwd) return alert("Please enter the Admin Password to edit fees!"); 
let customFeesArr = [];
if (type === "Custom") {
document.querySelectorAll('.custom-fee-item').forEach(item => { let n = item.querySelector('.c-fee-name').value; let a = item.querySelector('.c-fee-amt').value; if(n.trim() && parseFloat(a) > 0) customFeesArr.push({ name: n.trim(), amt: parseFloat(a) }); });
if(customFeesArr.length === 0) return alert("Please enter Custom Fee Name and Amount!"); 
} else { if(!amt || amt < 0) return alert("Please enter a valid amount!"); }

showLoading(); 
apiCall('processBulkUpdate', { idsStr: ids, feeType: type, amount: amt, month: document.getElementById('bMon').value, year: document.getElementById('bYear').value, customFeesJSON: JSON.stringify(customFeesArr), actionType: actionType, pwd: pwd }).then(res => { 
hideLoading(); 
if(res && res.status === "error") alert(res.message);  
else {
alert(actionType === "Edit" ? "Fees Setup Successfully Updated & Edited!" : "Fees Setup Completed Successfully!"); 
document.getElementById('bulkControls').style.display = "none"; document.getElementById('setupPwd').value = ""; document.getElementById('bAmt').value = ""; document.getElementById('customFeeList').innerHTML = `<div class="custom-fee-item" style="display:flex; gap:12px; margin-bottom:10px;"><input type="text" class="c-fee-name" placeholder="Fee Name"><input type="number" class="c-fee-amt" placeholder="Amount"></div>`;
}
}).catch(e=>{hideLoading(); alert("Error");}); 
}

function executeFactoryReset() {
let pwd = document.getElementById('resetPwd').value; if(!pwd) return alert("Admin Password required."); 
if(confirm("⚠️ Critical Warning!\nAre you 100% sure you want to CLEAR ALL FEES for ALL STUDENTS?")) {
showLoading(); apiCall('processFactoryReset', {pwd: pwd}).then(res => {
hideLoading(); if(res && res.status === "error") alert(res.message); else { alert("Factory Reset Complete!"); document.getElementById('resetPwd').value = ""; document.getElementById('feeAction').value = "Add"; toggleActionUI(); }
}).catch(e=>{hideLoading(); alert("Error");}); }
}

function loadRep() { 
showLoading(); 
apiCall('getReportData', {cls: document.getElementById('rClass').value, reportType: document.getElementById('rType').value, status: document.getElementById('rStatus').value, categoryFilter: document.getElementById('rCat').value}).then(res => { 
hideLoading(); reportsData = res.list; renderReports(reportsData); 
}).catch(e=>{hideLoading(); alert("Error");}); 
}

function renderReports(list) {
let h = ""; let pCount = 0; let dCount = 0; let tPaid = 0; let tDue = 0;
list.forEach(x => {
let sBadge = x.status.trim() === "Paid" ? `<span style="background:#dcfce7; color:#16a34a; padding:4px 8px; border-radius:6px; font-weight:800; font-size:11px;">PAID</span>` : `<span style="background:#fee2e2; color:#ef4444; padding:4px 8px; border-radius:6px; font-weight:800; font-size:11px;">DUE</span>`;
let cBadge = x.category === 'Army' ? `<span style="color:#b45309; font-weight:900;">Army</span>` : `<span style="color:#005f40; font-weight:900;">Civil</span>`;
h += `<tr><td><b>${x.id}</b></td><td>${x.name}</td><td>${x.class}</td><td>${x.section || '-'}</td><td>${x.roll}</td><td>${cBadge}</td><td><b>${x.feeName}</b></td><td>${x.period}</td><td><b style="color:var(--main);">${x.amount} TK</b></td><td>${sBadge}</td></tr>`;
if (x.status && x.status.trim() === "Paid") { pCount++; tPaid += parseFloat(x.amount) || 0; } else if (x.status && x.status.trim() === "Due") { dCount++; tDue += parseFloat(x.amount) || 0; }
}); 
document.querySelector("#rTable tbody").innerHTML = h || `<tr><td colspan="10" style="text-align:center; color:#94a3b8;">No records found.</td></tr>`; 
document.getElementById('tPaidVal').innerText = tPaid; document.getElementById('tDueVal').innerText = tDue; document.getElementById('tStuCount').innerText = list.length; document.getElementById('tPaidCount').innerText = pCount; document.getElementById('tDueCount').innerText = dCount;
}

function filterReports() {
let query = document.getElementById('rSearch').value.toLowerCase(); let secQ = document.getElementById('rSec').value;
if (!reportsData || reportsData.length === 0) return;
let filtered = reportsData.filter(x => { return (secQ === "" || x.section === secQ) && (x.name.toLowerCase().includes(query) || x.id.toLowerCase().includes(query) || x.roll.toString().includes(query) || x.feeName.toLowerCase().includes(query)); });
renderReports(filtered);
}

function printRep() { 
let t = document.getElementById('rTable').outerHTML; 
let subtitleText = `Class: ${document.getElementById('rClass').value} | Status: ${document.getElementById('rStatus').value}`;
let w = window.open('','','width=1200,height=800'); 
w.document.write(`<html><head><title>Financial Report</title><style>@page { size: A4 landscape; margin: 15mm; } body { font-family: 'Times New Roman', serif; font-size: 12px; } .print-header { text-align: center; } table { width: 100%; border-collapse: collapse; margin-top: 10px; } th, td { border: 1px solid #000; padding: 8px 6px; } th { background-color: #e2e8f0; font-weight: bold; } .totals { margin-top: 20px; text-align: right; font-weight: bold; font-size: 15px; } </style></head><body><div class="print-header"><h2>SCBHS - Financial Report</h2><div>${subtitleText}</div></div>${t}<div class="totals">Total Collected: ৳ ${document.getElementById('tPaidVal').innerText}<br>Total Due: ৳ ${document.getElementById('tDueVal').innerText}</div></body></html>`); 
w.document.close(); setTimeout(()=>w.print(), 1000); 
}

// 🚀 Ledger & Vault Logic 
function loadHistory() {
showLoading();
apiCall('getTransactionHistory').then(res => {
hideLoading(); historyData = res; renderHistory(res); loadVaultData(true);
}).catch(e=>{hideLoading(); alert("Error");});
}

function renderHistory(data) {
let h = ""; let total = 0;
data.forEach(x => {
total += parseFloat(x.paidAmount) || 0;
let cBadge = x.category === 'Army' ? `<span class="badge-army">Army</span>` : `<span class="badge-civil">Civil</span>`;
let secStr = x.sectionVal ? ` (${x.sectionVal})` : "";
h += `<tr><td>${x.date}</td><td><b>${x.receiptNo}</b></td><td><b style="color:var(--main);">${x.studentID}</b></td><td>${x.name}</td><td>${x.classVal}${secStr} (Roll: ${x.roll})</td><td>${cBadge}</td><td>${x.month} ${x.year}</td><td><b style="color:#0369a1;">${x.paidAmount} TK</b></td></tr>`;
});
document.querySelector("#hTable tbody").innerHTML = h || `<tr><td colspan="8" style="text-align:center; color:#94a3b8;">No transactions found.</td></tr>`;
document.getElementById('hTotalVal').innerText = total.toFixed(2);
}

function filterHistory() {
let fSearch = document.getElementById('hSearch').value.toLowerCase(); let fSec = document.getElementById('hSec').value; let fClass = document.getElementById('hClass').value; let fCat = document.getElementById('hCat').value; let fMonth = document.getElementById('hMonth').value; let fYear = document.getElementById('hYear').value;
if (!historyData || historyData.length === 0) return;
let filtered = historyData.filter(x => { return (fClass === "All" || x.classVal === fClass) && (fMonth === "All" || x.month === fMonth) && (fYear === "All" || x.year === fYear) && (x.name.toLowerCase().includes(fSearch) || x.studentID.toLowerCase().includes(fSearch) || x.receiptNo.toLowerCase().includes(fSearch)); });
renderHistory(filtered);
}

function printHistory() {
let t = document.getElementById('hTable').outerHTML; 
let w = window.open('','','width=1200,height=800'); 
w.document.write(`<html><head><style>@page { size: A4 landscape; margin: 15mm; } body { font-family: sans-serif; font-size: 12px; } table { width: 100%; border-collapse: collapse; } th, td { border: 1px solid #000; padding: 5px; } </style></head><body><h2>SCBHS - Payment Ledger</h2>${t}</body></html>`); 
w.document.close(); setTimeout(()=>w.print(), 1000); 
}

function loadVaultData(skipFetchHistory = false) {
    if(!isAuthReady) return;
    showLoading();
    let p1 = apiCall('getVaultRecords');
    let p2 = skipFetchHistory ? Promise.resolve(historyData) : apiCall('getTransactionHistory');
    
    Promise.all([p1, p2]).then(results => {
        hideLoading(); vaultData = results[0]; if(!skipFetchHistory) historyData = results[1];
        
        let tIncome = 0; let tExpense = 0;
        historyData.forEach(tx => { tIncome += parseFloat(tx.paidAmount) || 0; });

        let vHtml = "";
        vaultData.forEach(v => {
            let isInc = v.type === "Income";
            if(isInc) tIncome += parseFloat(v.amount) || 0; else tExpense += parseFloat(v.amount) || 0;
            let badge = isInc ? `<span style="color:#10b981; font-weight:900;"><i class="fas fa-arrow-down"></i> IN</span>` : `<span style="color:#ef4444; font-weight:900;"><i class="fas fa-arrow-up"></i> OUT</span>`;
            vHtml += `<tr><td>${v.date}</td><td>${badge}</td><td><b>${v.category}</b></td><td>${v.payeeOrSource}</td><td><small style="color:#64748b;">${v.notes}</small></td><td><b>৳ ${v.amount}</b></td><td><button onclick="delVault('${v.id}')" style="background:#fef2f2; color:#ef4444; border:none; padding:6px 10px; border-radius:6px; cursor:pointer;"><i class="fas fa-trash"></i></button></td></tr>`;
        });
        document.querySelector("#vTable tbody").innerHTML = vHtml || `<tr><td colspan="7" style="text-align:center;">No records found.</td></tr>`;
        document.getElementById('vTotalInc').innerText = tIncome.toFixed(2); document.getElementById('vTotalExp').innerText = tExpense.toFixed(2); document.getElementById('vNetBal').innerText = (tIncome - tExpense).toFixed(2);
    }).catch(e => { hideLoading(); alert("Error loading Vault"); });
}

function addVault() {
    let type = document.getElementById('vType').value; let cat = document.getElementById('vCategory').value; let payee = document.getElementById('vPayee').value.trim(); let amt = document.getElementById('vAmount').value; let notes = document.getElementById('vNotes').value.trim();
    if(!cat || !payee || !amt || amt <= 0) return alert("Fill all required fields!");
    showLoading();
    apiCall('addVaultRecord', {data: { type: type, category: cat, payeeOrSource: payee, amount: parseFloat(amt), date: new Date().toLocaleDateString('en-GB'), notes: notes }}).then(res => {
        hideLoading();
        if(res.status === "success") { alert("Saved!"); document.getElementById('vPayee').value = ""; document.getElementById('vAmount').value = ""; document.getElementById('vNotes').value = ""; loadVaultData(true); } 
        else { alert("Failed"); }
    }).catch(e=>{ hideLoading(); alert("Error"); });
}

function delVault(docId) {
    let pwd = prompt("Enter Admin Password:"); if(!pwd) return;
    showLoading();
    apiCall('deleteVaultRecord', {docId: docId, pwd: pwd}).then(res => { hideLoading(); if(res.status === "success") { alert("Deleted!"); loadVaultData(true); } else alert(res.message); }).catch(e=>{ hideLoading(); alert("Error"); });
}

const cScr = document.getElementById('cScr');
function cPush(v) { if(cScr.value === "0" || cScr.value === "Error") cScr.value = v; else cScr.value += v; }
function cClr() { cScr.value = "0"; } function cBack() { cScr.value = cScr.value.slice(0,-1) || "0"; } function cSolve() { try { cScr.value = eval(cScr.value); } catch(e){ cScr.value = "Error"; } }
window.addEventListener('keydown', (e) => { if(document.activeElement.tagName === 'INPUT' && document.activeElement.id !== 'cScr') return; if(e.key >= 0 && e.key <= 9) cPush(e.key); if(["+","-","*","/"].includes(e.key)) cPush(e.key); if(e.key === "Enter" || e.key === "=") cSolve(); if(e.key === "Backspace") cBack(); if(e.key === "Escape") cClr(); });
setInterval(() => { document.getElementById('clock').innerText = new Date().toLocaleString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' }); }, 1000);
</script>
