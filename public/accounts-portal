// Calculator Logic
const cScr = document.getElementById('cScr');
function cPush(v) { if (cScr.value === "0" || cScr.value === "Error") cScr.value = v; else cScr.value += v; }
function cClr() { cScr.value = "0"; }
function cBack() { cScr.value = cScr.value.slice(0, -1) || "0"; }
function cSolve() { try { cScr.value = eval(cScr.value); } catch (e) { cScr.value = "Error"; } }
window.addEventListener('keydown', (e) => {
  if (document.activeElement.tagName === 'INPUT' && document.activeElement.id !== 'cScr') return;
  if (document.activeElement.tagName === 'TEXTAREA') return;
  if (e.key >= '0' && e.key <= '9') cPush(e.key);
  if (["+", "-", "*", "/"].includes(e.key)) cPush(e.key);
  if (e.key === "Enter" || e.key === "=") cSolve();
  if (e.key === "Backspace") cBack();
  if (e.key === "Escape") cClr();
});
setInterval(() => {
  document.getElementById('clock').innerText = new Date().toLocaleString('en-US', {
    weekday: 'short', year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit'
  });
}, 1000);
