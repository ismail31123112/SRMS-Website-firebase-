          </div>
          <div class="rcp-tag">${copyLabel}</div>
        </div>

        <div class="rcp-info-grid">
          <div>
            <div><b>Receipt No:</b> <span style="color:#005f40; font-weight:800;">${d.rNo}</span></div>
            <div><b>Student ID:</b> ${d.id}${catStr}</div>
            <div><b>Student Name:</b> <span style="text-transform:uppercase; font-weight:800;">${d.name}</span></div>
          </div>
          <div style="text-align:right;">
            <div><b>Date:</b> ${d.date}</div>
