// 🚀 DIRECT FIREBASE: Load Reports
async function loadRep() { 
    if(!isAuthReady) return;
    showLoading(); showLoaderText("GENERATING REPORT...<br><span style='font-size:11px; color:#64748b;'>Querying Database securely</span>");
    
    let cls = document.getElementById('rClass').value;
    let reportType = document.getElementById('rType').value;
    let status = document.getElementById('rStatus').value;
    let categoryFilter = document.getElementById('rCat').value;
    
    try {
        let snap = await db.collection('Students').get();
        let list = []; let tPaid = 0; let tDue = 0;
        
        snap.forEach(doc => {
            let f = doc.data();
            let sClass = f.class ? f.class.trim() : "";
            if (cls !== "All" && sClass.toLowerCase() !== cls.toString().trim().toLowerCase()) return;

            let sCat = f.category || "Civil";
            if (categoryFilter !== "All" && sCat !== categoryFilter) return; 

            let stdMonth = f.feeMonth || "-";
            let stdYear = f.feeYear || "-";
            let sId = f.studentID || "";
            let sName = f.name || "";
            let sRoll = f.roll || "";
            let sSec = f.section || "";

            let addRecord = (fName, amt, fStatus, fPeriod) => {
                if(amt > 0) {
                    let currentStatus = fStatus || "Due";
                    if (status === "All" || currentStatus.toLowerCase() === status.toLowerCase()) {
                        list.push({ id: sId, name: sName, class: sClass, section: sSec, roll: sRoll, category: sCat, feeName: fName, period: fPeriod, amount: amt, status: currentStatus });
                    }
                }
            };

            if (reportType === "All" || reportType === "General") { addRecord("School Fee", parseFloat(f.schoolFeeDue)||0, f.schoolFeeStatus||"", stdMonth + " " + stdYear); }
            if ((reportType === "All" || reportType === "Hostel") && f.resStatus === "Residential") { addRecord("Hostel Fee", parseFloat(f.hostelFeeDue)||0, f.hostelFeeStatus||"", stdMonth + " " + stdYear); }
            if (reportType === "All" || reportType === "Custom") {
                let customFees = f.customFees ? JSON.parse(f.customFees) : [];
                customFees.forEach(cf => { addRecord(cf.name, parseFloat(cf.amount)||0, cf.status, stdMonth + " " + stdYear); });
            }
        });
        
        hideLoading();
        reportsData = list; 
        renderReports(reportsData); 
    } catch(err) { hideLoading(); alert("Error fetching report data."); }
}

function renderReports(list) {
    let h = ""; let pCount = 0; let dCount = 0; let tPaid = 0; let tDue = 0;
    list.forEach(x => {
        let sBadge = x.status.trim() === "Paid" ? `<span style="background:#dcfce7; color:#16a34a; padding:4px 8px; border-radius:6px; font-weight:800; font-size:11px;">PAID</span>` : `<span style="background:#fee2e2; color:#ef4444; padding:4px 8px; border-radius:6px; font-weight:800; font-size:11px;">DUE</span>`;
        let cBadge = x.category === 'Army' ? `<span style="color:#b45309; font-weight:900;">Army</span>` : `<span style="color:#005f40; font-weight:900;">Civil</span>`;
        h += `<tr><td><b>${x.id}</b></td><td>${x.name}</td><td>${x.class}</td><td>${x.section || '-'}</td><td>${x.roll}</td><td>${cBadge}</td><td><b>${x.feeName}</b></td><td>${x.period}</td><td><b style="color:var(--main);">${x.amount} TK</b></td><td>${sBadge}</td></tr>`;

        if (x.status && x.status.trim() === "Paid") { pCount++; tPaid += parseFloat(x.amount) || 0; } 
        else if (x.status && x.status.trim() === "Due") { dCount++; tDue += parseFloat(x.amount) || 0; }
    }); 

    document.querySelector("#rTable tbody").innerHTML = h || `<tr><td colspan="10" style="text-align:center; color:#94a3b8;">No matching records found.</td></tr>`; 
    document.getElementById('tPaidVal').innerText = tPaid; 
    document.getElementById('tDueVal').innerText = tDue; 
    document.getElementById('tStuCount').innerText = list.length;
    document.getElementById('tPaidCount').innerText = pCount;
    document.getElementById('tDueCount').innerText = dCount;
}

function filterReports() {
    let query = document.getElementById('rSearch').value.toLowerCase();
    let secQ = document.getElementById('rSec').value;
    if (!reportsData || reportsData.length === 0) return;

    let filtered = reportsData.filter(x => {
        let matchQ = x.name.toLowerCase().includes(query) || x.id.toLowerCase().includes(query) || x.roll.toString().includes(query) || x.feeName.toLowerCase().includes(query);
        let matchS = secQ === "" || (x.section && x.section === secQ);
        return matchQ && matchS;
    });
    renderReports(filtered);
}

